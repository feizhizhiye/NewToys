<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:NewToys.Shell.Controls"
             x:Class="NewToys.Shell.Views.SettingsView">
  <!--
    v3.65 / NT-062「应用级设置页」（需求 §4.9.2 / §6.5）。
    🔴 v3.66 第三轮：**树状（手风琴）+ 节点抬头磁吸**，⛔ 页面**没有标题栏**。
      ① 整页只有一棵"树"：每个节 = 一个节点（卡片），节点抬头 = 折叠按钮（⌄/› + 图标 + 标题 + 说明）；
      ② **首行始终显示当前节点**：节点抬头滚过页面顶部时，由一个**浮层抬头**（同一模板、可点）钉在顶部 ——
         即"树状滚动"里的 sticky 节点；
      ③ 下一个节点的抬头快顶上来时，浮层被**推着往上走**（Push 效果）；
      ④ 滚动 / 手动都能开收：点抬头 = 手动开收；**滚到的节点自动展开，⛔ 不自动折叠**
         ⇒ 高度只增不减、可一路滚到底；
      ⑤ 节自带工具条（`HasToolbar`）= **节点内渲染**（抬头下方、正文之上）。
    🔴 v3.68（用户 2026-10-18 报障后重做）：
      ① 浮层 `StuckHeader` **移出滚动内容**，改为 `PageRoot` 的兄弟层（钉子户方案）——
         原来它画在滚动内容里、靠 `RenderTransform` 反补滚动量 ⇒ 位置靠推算，实测"滚到顶部留下空白浮层 /
         顶行被裁 / 抬头与正文错位"。现在它是覆盖层，位置由自身对齐决定，**不需要任何补偿数学**；
         浮层上的鼠标滚轮由 code-behind 转发给 ScrollViewer（否则停上去滚不动）。
      ② 节点抬头有了**独立底色 + 下边框**（`ContentHeaderBrush`）⇒ 与正文行一眼能分开；
         正文区仍用卡片底色 ⇒ 整块是"带标题栏的卡片"。
      ③ 自动展开口径（code-behind）：**视口上半部里最靠上、还没展开**的那一节，每轮只开一个。
      滚动判定全在 `SettingsView.axaml.cs`（⛔ VM 不认识视口）。
    ⛔ 切节不新开标签页；⛔ 本页没有右详情卡（契约已取消，见 SettingsViewModel 注释）。
    窄界面基线（NT-053）：根 Panel 铺满 ⇒ 最窄 960×640 可用。
  -->
  <UserControl.Resources>
    <!--  节点抬头的内容（正身 / 磁吸浮层**共用同一份模板**，⛔ 不写两遍）  -->
    <DataTemplate x:Key="SectionHeaderContent">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <!--  折叠指示：展开 ⌄ / 收起 ›（两个键都在 App.axaml 资源区，24 网格描边几何）  -->
        <Path
            Grid.Column="0"
            Width="12"
            Height="12"
            VerticalAlignment="Center"
            Data="{StaticResource IconChevronDown}"
            IsVisible="{Binding IsExpanded}"
            Stroke="{DynamicResource SecondaryTextBrush}"
            StrokeThickness="1.6"
            Stretch="Uniform" />
        <Path
            Grid.Column="0"
            Width="12"
            Height="12"
            VerticalAlignment="Center"
            Data="{StaticResource IconChevronRight}"
            IsVisible="{Binding !IsExpanded}"
            Stroke="{DynamicResource SecondaryTextBrush}"
            StrokeThickness="1.6"
            Stretch="Uniform" />
        <TextBlock
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            FontSize="14"
            Text="{Binding Icon}" />
        <TextBlock
            Grid.Column="2"
            Margin="6,0,0,0"
            VerticalAlignment="Center"
            Classes="sec-title"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{Binding Title}" />
        <TextBlock
            Grid.Column="3"
            Margin="12,0,4,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{Binding Desc}"
            TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--  节点抬头标题：默认主文字色（原来硬写在模板里，挪到这里才能被 .active 覆盖）  -->
    <Style Selector="TextBlock.sec-title">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!--  🔴 v3.68：抬头 = 卡片标题栏（独立底色 + 下边框）⇒ 与正文行区分开（用户：所有节点行应该与其他行区分开）。
          底色用 `ContentHeaderBrush`（暗色 #1F1F1F / 亮色 #FFF）—— 与卡片底 `PanelBrush` 正好差一档。  -->
    <Style Selector="Button.sec-head">
      <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.sec-head:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.sec-head:pressed">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
    <!--  激活节点：底色 + 强调色文字（`Button.settings-nav.active` 的底色被上面的本地样式压过，这里再给一次）  -->
    <Style Selector="Button.sec-head.active">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
    <Style Selector="Button.sec-head.active TextBlock.sec-title">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!--  磁吸浮层里的抬头：底色由浮层自己给，这里不要再铺一层（否则悬停高亮只有半个圆角）  -->
    <Style Selector="Button.sec-head.stuck">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sec-head.stuck:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <!--  🔴 v3.66 第七轮：根上**显式给不透明背景**（ContentBrush）—— 设置页内容都在卡片里，
        页根与卡片之间本来是透明的；一旦切页时旧页面（首页）的视图有残留，就会"透出来"看到两层
        内容叠在一起。给页根铺一层背景即可保证**本页永远自成一屏**。  -->
  <Panel
      x:Name="PageRoot"
      Background="{DynamicResource ContentBrush}"
      ClipToBounds="True">
    <!--  ==================== 树本体：节点（抬头 + 正文）整体参与滚动 ====================  -->
    <ScrollViewer
        x:Name="SectionScroll"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="SectionList" Margin="12" ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--  一个节点 = 一张卡片；`sec-head` / `sec-body` 两个类名保留（code-behind 靠 `sec-head` 找抬头；
                  `sec-body` 标正文区，⛔ 别删 —— 后续若要量正文高度还用得上）  -->
            <Border Classes="card" Margin="0,0,0,10" Padding="0">
              <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0">
                  <Button
                      Classes="settings-nav sec-head"
                      Classes.active="{Binding IsActive}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding $parent[UserControl].DataContext.ToggleSectionCommand}"
                      CommandParameter="{Binding}"
                      Content="{Binding}"
                      ContentTemplate="{StaticResource SectionHeaderContent}"
                      ToolTip.Tip="{Binding Desc}" />
                  <!--  展开时抬头与正文之间一条分隔线（收起时不画，卡片就是一颗圆角小条）  -->
                  <Border
                      Height="1"
                      VerticalAlignment="Bottom"
                      Background="{DynamicResource DividerBrush}"
                      IsVisible="{Binding IsExpanded}" />
                </Grid>

                <!--  🔴 v3.66 第五轮：节**自己的工具条**（当前只有「运行环境」节有）= 就地在
                      **抬头下方、正文之上**渲染。`ToolbarHost` 的 `Source` = **节 VM**。
                      外层 `IsVisible=IsExpanded` ⇒ 节点收起时工具条跟着收起；内层 `HasToolbar` ⇒
                      ⛔ 没有工具条的节整块不占高度。  -->
                <StackPanel Grid.Row="1" IsVisible="{Binding IsExpanded}">
                  <Border Classes="toolbar" IsVisible="{Binding HasToolbar}">
                    <ctl:ToolbarHost Source="{Binding ViewModel}" />
                  </Border>

                  <ContentControl
                      Classes="sec-body"
                      Margin="14,10,14,12"
                      Content="{Binding Content}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!--  ==================== 磁吸节点抬头：覆盖在视口顶部，点它照样折叠 / 展开 ====================
          🔴 v3.68：**必须在 ScrollViewer 外面**（= 覆盖层，不参与滚动）：
             放在滚动内容里要反补滚动量才能"钉住"，位置全靠推算 ⇒ 顶部残留空白框 / 顶行被裁（用户实测）。
             现在位置 = 自身对齐（`VerticalAlignment=Top` + Margin 由 code-behind 按卡片横向对齐给出），
             ⛔ 不需要补偿数学；浮层上的滚轮由 code-behind 转发，⛔ 不会"停上去滚不动"。
             Push 效果仍用 `RenderTransform` 的负 Y 平移（纯视觉，不影响布局）。  -->
    <Border
        x:Name="StuckHeader"
        Margin="12,0,22,0"
        VerticalAlignment="Top"
        Background="{DynamicResource ContentHeaderBrush}"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0,0,0,1"
        CornerRadius="8"
        IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <Button
            Grid.Column="0"
            Classes="settings-nav sec-head stuck"
            Classes.active="{Binding IsActive}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Command="{Binding $parent[UserControl].DataContext.ToggleSectionCommand}"
            CommandParameter="{Binding}"
            Content="{Binding}"
            ContentTemplate="{StaticResource SectionHeaderContent}"
            ToolTip.Tip="{Binding Desc}" />
        <!--  全部收起 / 全部展开（只在浮层上 —— 它常驻顶部，正身那份会被浮层盖住点不到）  -->
        <Button
            Grid.Column="1"
            Margin="0,0,8,0"
            Padding="8,2"
            VerticalAlignment="Center"
            Classes="ghost"
            Command="{Binding $parent[UserControl].DataContext.ToggleAllSectionsCommand}"
            Content="{Binding $parent[UserControl].DataContext.ToggleAllText}"
            FontSize="11"
            ToolTip.Tip="全部收起 = 一屏看全所有节点，点标题直接跳过去；再点一次全部展开" />
      </Grid>
    </Border>
  </Panel>
</UserControl>
