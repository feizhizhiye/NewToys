<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.SystemTools.Views.QuickCommandView">
  <!--
    「系统工具 → 快捷命令」页（`system-quick`，NT-091）：十项本机常见设置 / 开关。
    🔴 需要管理员的项 ⛔ 不代跑（应用无提权）⇒ 那几项只有「📋 复制命令」，由用户自己在提权终端跑。
  -->
  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="24,10"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="十项常见系统开关。需要管理员的项应用不代跑 —— 点「📋 复制命令」后在提权的终端里执行。"
                 FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Border>

    <Border Grid.Row="1" Padding="24,6">
      <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}" Margin="16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="320" Margin="0,0,12,12" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}"/>
                <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding Description}"/>
                <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding TargetText}"
                           ToolTip.Tip="{Binding TargetText}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="▶ 执行" IsEnabled="{Binding $parent[UserControl].DataContext.IsNotBusy}"
                          Command="{Binding $parent[UserControl].DataContext.RunCommand}" CommandParameter="{Binding}"/>
                  <Button Classes="ghost" Content="📋 复制命令"
                          Command="{Binding $parent[UserControl].DataContext.CopyCommand}"
                          CommandParameter="{Binding TargetText}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
