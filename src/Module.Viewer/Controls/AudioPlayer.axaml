<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NewToys.Viewer.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.Viewer.Controls.AudioPlayer">
  <!--
    本地音乐播放器（查看器内）：居中歌词 + 封面 + 悬浮曲目条；播放列表是右侧悬浮层（默认收起），音色是底部音色键弹出的菜单。
    🔴 所有播放能力走注入的 IAudioPlayback（UI 库 ⛔ 不引 NAudio）；本控件只做界面与轮询刷新。
    🔴 Slider ⛔ 设 Height / MinHeight：Fluent 模板被压扁后轨道与按钮视觉错位（看着就是「不居中」）。
    🔴 图标只用非 emoji 码位：⏮ ⏭ ▶ 🔁 会被 Segoe UI Emoji 接管，渲染成彩色方块。
    🔴 主显示区布局（左右 / 只封面 / 上下）由代码改 MainGrid 的行列 + 两块的 Grid.Row/Column，⛔ 别再建第二套 XAML。
  -->
  <Grid RowDefinitions="*,Auto">

    <!--  主显示区：封面 / 歌词（布局由代码切换）+ 悬浮曲目条 + 动效层 + 播放列表浮层  -->
    <Grid Grid.Row="0">

      <!--  🔴 行列定义**固定**两行两列（Side 用 RowSpan 铺满、Stacked 用一行一格）：
            运行时不替换定义集合 —— 替换会让残留的 Grid.Row/Column 索引越界直接崩。  -->
      <Grid x:Name="MainGrid" RowDefinitions="*,*" ColumnDefinitions="*,1.1*">

        <!--  封面 + 分频柱（分频柱未播放时收起）  -->
        <StackPanel x:Name="CoverPane"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <Border x:Name="CoverBox"
                  Width="260"
                  Height="260"
                  CornerRadius="6"
                  ClipToBounds="True"
                  Background="{DynamicResource ContentBrush}">
            <Panel>
              <TextBlock x:Name="CoverPlaceholder"
                         Text="♪"
                         FontSize="32"
                         Opacity="0.22"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Image x:Name="Cover" Stretch="UniformToFill" />
            </Panel>
          </Border>

          <local:SpectrumBars x:Name="Spectrum"
                              Width="260"
                              Height="48"
                              IsVisible="False"
                              Foreground="{DynamicResource AccentInkBrush}" />
        </StackPanel>

        <!--  歌词（居中，当前行高亮 + 走到中线后跟随滚动）  -->
        <Border x:Name="LyricPane"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="Transparent">
          <!--
            贴右边不留白：滚动条落在系统拉伸热区里也能抓（Shell 的 WM_NCHITTEST 钩子让控件优先，
            见 ShellView.Win32.cs 的 HitTestEdgeControl）。
          -->
          <ScrollViewer x:Name="LyricScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LyricPanel" Margin="20,32" Spacing="8" />
          </ScrollViewer>
        </Border>
      </Grid>

      <!--  动效层：工具条「✦ 动效」开启时盖住主显示区（播放列表仍可浮在上面）  -->
      <local:GeometryVisual x:Name="GeometryStage"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsVisible="False"
                            Background="{DynamicResource ContentBrush}"
                            Foreground="{DynamicResource AccentInkBrush}" />

      <!--  曲目条：悬浮在主显示区上方（⛔ 不再占一整行，取消顶部区域）  -->
      <Border x:Name="TitleOverlay"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              MaxWidth="360"
              Margin="14,12,12,0"
              Background="Transparent"
              BorderThickness="0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="TitleText"
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ArtistText"
                     Classes="hint-text"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TechText"
                     Classes="hint-text"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!--  播放列表悬浮层：贴右侧浮在内容之上，点条目即切歌  -->
      <Border x:Name="PlaylistPanel"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Width="280"
              Margin="0,8,10,8"
              IsVisible="False"
              Background="{DynamicResource PanelBrush}"
              CornerRadius="6"
              BoxShadow="0 8 24 0 #55000000">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="10,7,6,4">
            <TextBlock Text="播放列表"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="ghost"
                    Width="24"
                    Height="24"
                    Padding="0"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="收起播放列表"
                    Click="OnClosePlaylist"
                    Content="{m:GlyphText IconClose}" ToolTip.Tip="收起播放列表" />
          </Grid>

          <ScrollViewer Grid.Row="1" Padding="0,0,0,6">
            <ListBox x:Name="TrackList"
                     Background="Transparent"
                     BorderThickness="0"
                     DoubleTapped="OnTrackDoubleTapped"
                     SelectionChanged="OnTrackSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Display}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Classes="hint-text"
                               Text="{Binding DurationText}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!--  底部：控制条（按钮一律图标 + ToolTip，⛔ 不带文字）；容器**透明**，整条嵌在主显示区里  -->
    <Border Grid.Row="1"
            Padding="10,0"
            Background="Transparent">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <Button Width="34"
                  Height="22"
                  Padding="0"
                  Classes="ghost"
                  FontSize="12"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="上一首"
                  Click="OnPrevious"
                  Content="◄◄"
                  ToolTip.Tip="上一首" />
          <Button x:Name="PlayButton"
                  Width="36"
                  Height="22"
                  Padding="0"
                  Classes="primary"
                  FontSize="12"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="播放"
                  Click="OnPlayPause"
                  Content="►"
                  ToolTip.Tip="播放" />
          <Button Width="34"
                  Height="22"
                  Padding="0"
                  Classes="ghost"
                  FontSize="12"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="下一首"
                  Click="OnNext"
                  Content="►►"
                  ToolTip.Tip="下一首" />
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock x:Name="PositionText" Classes="hint-text" VerticalAlignment="Center" />
          <Slider x:Name="ProgressSlider"
                  Grid.Column="1"
                  Margin="8,0"
                  Minimum="0"
                  Maximum="1"
                  VerticalAlignment="Center"
                  ValueChanged="OnProgressChanged" />
          <TextBlock x:Name="DurationText"
                     Grid.Column="2"
                     Classes="hint-text"
                     VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <!--  模式图标用 Path 画（字符里没有「三箭头 / 交叉双箭头」，⇶ 之类还会缺字形）：
                顺序 = 三个并列右箭头 · 随机 = 两条交叉箭头 · 单曲 = ↻1 文字  -->
          <Button x:Name="ModeButton"
                  Height="22"
                  MinWidth="34"
                  Padding="5,0"
                  Classes="ghost"
                  FontSize="12"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="播放模式"
                  Click="OnSwitchMode"
                  ToolTip.Tip="播放模式：顺序">
            <Panel Width="16" Height="12">
              <Path x:Name="ModeSeqIcon"
                    Data="M1.2,2 L11.5,2 M9,0.2 L11.5,2 L9,3.8 M1.2,6 L11.5,6 M9,4.2 L11.5,6 L9,7.8 M1.2,10 L11.5,10 M9,8.2 L11.5,10 L9,11.8"
                    Stroke="{DynamicResource PrimaryTextBrush}"
                    StrokeThickness="1.3"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
              <Path x:Name="ModeShuffleIcon"
                    Data="M1.5,2 L12.5,10 M11.5,7 L12.5,10 L9.3,9.9 M12.5,2 L1.5,10 M2.5,7 L1.5,10 L4.7,9.9"
                    IsVisible="False"
                    Stroke="{DynamicResource PrimaryTextBrush}"
                    StrokeThickness="1.3"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
              <TextBlock x:Name="ModeSingleText"
                         Text="↻1"
                         IsVisible="False"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Panel>
          </Button>
          <Button x:Name="ToneButton"
                  Height="22"
                  MinWidth="34"
                  Padding="5,0"
                  Classes="ghost"
                  FontSize="12"
                  IsVisible="False"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="音色"
                  Click="OnToggleTone"
                  Content="音色"
                  ToolTip.Tip="音色：关闭（点击选择）" />
          <Button x:Name="MuteButton"
                  Height="22"
                  MinWidth="34"
                  Padding="5,0"
                  Classes="ghost"
                  FontSize="12"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="音量"
                  Click="OnToggleMute"
                  Content="音量"
                  ToolTip.Tip="静音" />
          <Slider x:Name="VolumeSlider"
                  Width="88"
                  Minimum="0"
                  Maximum="100"
                  VerticalAlignment="Center"
                  ValueChanged="OnVolumeChanged"
                  ToolTip.Tip="音量" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
