<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.UI.Viewers.AudioPlayer">
  <!--
    本地音乐播放器（查看器内）：封面 + 信息 + 播放列表 + 歌词 + 控制条。
    🔴 所有播放能力走注入的 IAudioPlayback（UI 库 ⛔ 不引 NAudio）；本控件只做界面与轮询刷新。
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0"
            Padding="12,10"
            Background="{DynamicResource ContentHeaderBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="56"
                Height="56"
                CornerRadius="4"
                ClipToBounds="True"
                Background="{DynamicResource ContentBrush}">
          <Image x:Name="Cover" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="TitleText"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ArtistText"
                     Classes="hint-text"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <ListBox x:Name="TrackList"
               Background="Transparent"
               BorderThickness="0"
               DoubleTapped="OnTrackDoubleTapped"
               SelectionChanged="OnTrackSelected">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1"
              Width="240"
              Background="{DynamicResource ContentHeaderBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer x:Name="LyricScroller" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="LyricPanel" Margin="10" Spacing="4" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="10,6"
            Background="{DynamicResource ContentHeaderBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button Classes="ghost" Click="OnPrevious" Content="上一首" />
          <Button x:Name="PlayButton" Classes="primary" Click="OnPlayPause" Content="播放" />
          <Button Classes="ghost" Click="OnNext" Content="下一首" />
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock x:Name="PositionText" Classes="hint-text" VerticalAlignment="Center" />
          <Slider x:Name="ProgressSlider"
                  Grid.Column="1"
                  Margin="8,0"
                  Minimum="0"
                  Maximum="1"
                  ValueChanged="OnProgressChanged" />
          <TextBlock x:Name="DurationText"
                     Grid.Column="2"
                     Classes="hint-text"
                     VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button x:Name="ModeButton"
                  Classes="ghost"
                  Click="OnSwitchMode"
                  Content="顺序"
                  ToolTip.Tip="播放模式：顺序 / 单曲 / 随机" />
          <TextBlock Text="音量" Classes="hint-text" VerticalAlignment="Center" />
          <Slider x:Name="VolumeSlider"
                  Width="90"
                  Minimum="0"
                  Maximum="100"
                  ValueChanged="OnVolumeChanged"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
