<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.UI.Controls.ListFooterBar">
  <UserControl.Styles>
    <!--  翻页箭头：Path 走 Stroke、不继承 Foreground ⇒ 颜色与粗细必须由样式给（⛔ 不写本地 Stroke，否则压过禁用态）。  -->
    <Style Selector="Button.footer-nav Path">
      <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!--  分段按钮（箭头 + 页码共用一个外框，见 PagingFrame）：透明底、直角、只画右侧 1px 分隔线。
          ⛔ 不用 ghost 类：ghost 自带圆角 + 四边框，拼一条连体按钮带会变成「一串小卡片」。  -->
    <Style Selector="Button.footer-seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.footer-seg:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.footer-seg:pressed">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
    <!--  当前页：整块强调色填充、白字加粗（截图样式）。  -->
    <Style Selector="Button.footer-seg.active">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.footer-seg.active:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <!--  末格不画右侧分隔线（那条线由外框右边框承担，否则叠成 2px）。  -->
    <Style Selector="Button.footer-seg.lastend">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
  <!--
    NT-063 · 列表页底栏（UI 壳，为 NT-064 分页预留插槽）。

    · 内容物（2026-11-04 精简文案）：N 条 · N 页（左）＋ 连体翻页带 [« ‹ 1 2 3 › »]＋ Go[ ]（右）＋ 每页[25/50/100/500]
    · 「已选 M」⛔ 不在底栏 —— 改由 Shell 底部状态栏承载（选中口径 = 当前页）
    · 🔴 **默认不显示**：由宿主页把本控件的 IsVisible 绑到 VM 的 `HasFooterContent`
      （列表内容高度 > 视口高度 或 有多页时才 true）⇒ 只有列表超出页面底部，底栏才出现
    · 🔴 库内 XAML ⛔ 不许写死色值：一律 DynamicResource 引主题键 / 复用应用级样式类
      （hint-text / footer-seg / footer-nav —— 与 Shell 的 App.axaml、Styles\Controls.axaml 同源）
    · 🔴 NT-064：内部一律 **code-behind 按属性直配**（⛔ 不用 `{Binding $parent[UserControl].X}` 祖先绑定：
      库内控件的祖先绑定一旦解析不到，表现是**静默空内容**）。页码按钮组与跳转输入框
      按 PageCount / CurrentPage / JumpToPageCommand 在 code-behind 动态构建。

    2026-10-17 版式返修（用户截图 + 逐轮微调，四轮定稿）：
    ① **三段布局 = 左 `*` / 分页链 Auto / 每页 Auto**（用户定稿）：分页链**靠右、紧挨「每页」**，
       ⛔ 不做整条居中（曾试过"居中浮层"，用户看后否决 ⇒ 居中时分页链与右侧信息脱节）。
       左计数列是 `*` ⇒ 空间不足时**优先牺牲左计数**（先被压没），分页链与每页组保住。
    ② 🔴 **两个输入控件会把顶边线压断**：`TextBox`/`ComboBox` 的**隐式样式 MinHeight=28**
       （行高基线，见 Shell\Styles\Controls.axaml）+ TextBox 隐式 `MinWidth` ⇒ 显式写的
       `Width / Height=22` 被压过：实测两者都撑成 **63×28（= 整条底栏高）**，于是底色盖掉
       底栏顶边线（y=9 处 578→637 / 707→766 两段断口），四个边又与底栏边线同色 ⇒
       看着像底栏被"挖了两个缺口"。现给两者 **`MinWidth="0" MinHeight="0"`**
       （本地值 > 样式 Setter ⇒ 真能压住），边框换更亮一档的 `InputBorderBrush`（暗色下才看得出是输入框）。
       ⚠️ 页大小下拉 **Width=78**：`ComboBox` 的下拉箭头区约占 32px，"全部"两个汉字 22px + 左右内边距
       ⇒ 64 宽会把「部」字切掉一角（用户实锤）；78 才放得下最长项。
    ③ **翻页链 = 连体按钮带**（2026-11-04 用户截图定稿）：四个箭头 + 页码装进同一个
       `Border.PagingFrame`（圆角 3 + 1px 描边 + `ClipToBounds`），内部按钮**零间距**、
       各自只画右侧 1px 分隔线（`footer-seg` 的 `BorderThickness=0,0,1,0`），末格靠 `lastend` 去掉，
       当前页整块 `AccentBrush` 填充 + `AccentTextBrush` 加粗。
       🔴 圆角**只能靠外框 ClipToBounds 裁**：首格 / 末格若被当前页填色，直角会顶出圆角。
       🔴 按钮高度 20 = 外框 22 − 上下各 1px 边框 ⇒ ⛔ 别写 22，否则按钮把外框撑成 24。
    ④ **字形"光学居中"**：🔴 **数字没有降部** ⇒ 行盒里墨迹中心比几何中心**高 ~2px**
       （实测 11px 字号：数字墨迹 y17→24 中心 20.5，按钮盒中心 22.5）；
       而 `Path` 箭头几何对称、居中即可。分段按钮一律 `Padding=0` + 内容双向居中，
       ⛔ 不再用上下 padding 做光学补偿（换成数字后那套就是把数字压偏）。
  -->
  <!--  底栏底 = `FooterBarBrush`（与上方内容区、下方状态栏都不同档 ⇒ 三块之间靠色差分界，不画线）。
        输入框 / 下拉用 `ContentBrush`：比底栏暗到底色一档，控件边界才看得出来。  -->
  <Border Background="{DynamicResource FooterBarBrush}"
          Height="28">
    <Grid ColumnDefinitions="*,Auto,Auto">

      <!--  左：计数（条数 · 页数；空间不足时本列先被压没 ⇒ 优先牺牲计数）  -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="TotalTextBlock" Classes="hint-text" VerticalAlignment="Center" />
        <StackPanel x:Name="PageInfoGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="·" Classes="hint-text" VerticalAlignment="Center" />
          <TextBlock x:Name="PageCountText" Classes="hint-text" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!--  中：翻页链 —— 靠右，紧挨「每页」组（单页 / 分页挂起时整组不占位）。
            🔴 箭头 + 页码共用一个圆角外框（PagingFrame），内部按钮**无间距、以 1px 分隔线相连**，
            当前页整块强调色填充 —— 连体按钮带（用户 2026-11-04 截图定稿）。
            外框 ClipToBounds 负责裁掉首尾格的直角背景（当前页的强调色块不溢出圆角）。
            箭头一律矢量图标（⛔ 不用 « ‹ › » 字符：字形盒不匀、宽度对不齐）。  -->
      <StackPanel Grid.Column="1" x:Name="PagingGroup" Orientation="Horizontal" Spacing="0"
                  VerticalAlignment="Center">
        <Border x:Name="PagingFrame" Height="22" CornerRadius="3" ClipToBounds="True"
                VerticalAlignment="Center"
                Background="{DynamicResource ContentBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button x:Name="FirstButton" Classes="footer-nav footer-seg" Width="22" Padding="0"
                    ToolTip.Tip="第一页">
              <Path Width="12" Height="12" Data="{DynamicResource IconChevronsLeft}" Stretch="Uniform" />
            </Button>
            <Button x:Name="PrevButton" Classes="footer-nav footer-seg" Width="22" Padding="0"
                    ToolTip.Tip="上一页">
              <Path Width="12" Height="12" Data="{DynamicResource IconChevronLeft}" Stretch="Uniform" />
            </Button>
            <!--  页码按钮（1 2 3 …，当前页强调色；按 PageCount 动态构建）  -->
            <StackPanel x:Name="PageButtonsHost" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center" />
            <Button x:Name="NextButton" Classes="footer-nav footer-seg" Width="22" Padding="0"
                    ToolTip.Tip="下一页">
              <Path Width="12" Height="12" Data="{DynamicResource IconChevronRight}" Stretch="Uniform" />
            </Button>
            <Button x:Name="LastButton" Classes="footer-nav footer-seg lastend" Width="22" Padding="0"
                    ToolTip.Tip="最后一页">
              <Path Width="12" Height="12" Data="{DynamicResource IconChevronsRight}" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Border>
        <TextBox x:Name="JumpBox" Width="34" Height="22" MinWidth="0" MinHeight="0"
                 Margin="6,0,0,0"
                 Padding="4,1" FontSize="12"
                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                 TextAlignment="Center"
                 PlaceholderText="Go"
                 Background="{DynamicResource ContentBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}"
                 BorderThickness="1" CornerRadius="3"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 ToolTip.Tip="输入页码后回车直达" />
      </StackPanel>

      <!--  右：每页条数（25 / 50 / 100 / 500 / 全部，选择即落盘 + 重取；选「全部」= 不分页，全选即全量）。
            🔴 ComboBox 必须显式 Height + MinHeight=0 + 主题色：Avalonia 隐式样式给 MinHeight=28
            ⇒ 只写 Height=22 压不住，控件会撑满整条底栏并把顶边线压断（2026-10-17 用户截图实锤）。  -->
      <StackPanel Grid.Column="2" x:Name="PageSizeGroup" Orientation="Horizontal" Spacing="4"
                  VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="每页" Classes="hint-text" VerticalAlignment="Center" />
        <ComboBox x:Name="PageSizeCombo" Width="78" Height="22" MinWidth="0" MinHeight="0"
                  FontSize="12" Padding="6,0" CornerRadius="3"
                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                  Background="{DynamicResource ContentBrush}"
                  BorderBrush="{DynamicResource InputBorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  ToolTip.Tip="每页条数（选「全部」= 不分页）" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
