<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Controls"
             x:Class="NewToys.VideoTools.Views.SettingsVideoToolsView">
  <!--
    「视频工具」模块设置页（v3.64 / NT-061，自注册进 settings 分组，Key = settings-video-tools / Order 120）。
    🔴 NT-068（2026-10-18）：改用与应用级设置页同一套骨架 <ui:SettingsSectionHost>（节 = 折叠卡片），
       3 节 ⇒ `Sticky="False"`（不挂磁吸浮层、不滚动自动展开）。节内⛔ 再写 Border.card。
    规范 §4.9：数值 = 即时生效（改即落盘，⛔ 无保存按钮）；全局项只展示、⛔ 不另存一份。
  -->
  <ui:SettingsSectionHost Sticky="False">
    <ui:SettingsSectionHost.Sections>

    <!--  ============ ① 性能 ============  -->
    <ui:SettingsSection
        Title="性能"
        Icon="⚡"
        Desc="批量处理并发数"
        IsExpanded="True">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="并发数" />
          <TextBox Width="120" Text="{Binding MaxConcurrency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <TextBlock
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding ConcurrencyHint}" />
        </StackPanel>
      </StackPanel>
    </ui:SettingsSection>

    <!--  ============ ② 全局项（只读） ============  -->
    <ui:SettingsSection
        Title="全局项（本模块复用）"
        Icon="🔗"
        Desc="ffmpeg / 播放器 / 导入导出目录"
        IsExpanded="True">
      <StackPanel Spacing="10">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="下面三项是应用级设置（媒体资产模块也在用同一份）⇒ 本页不另存一份，去「设置 → 运行环境」改。" />

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="ffmpeg / ffprobe" />
          <TextBlock
              Classes="field-value"
              TextWrapping="Wrap"
              Text="{Binding FfmpegPathDisplay}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="外部播放器（视频列表「▶ 播放」）" />
          <TextBlock
              Classes="field-value"
              TextWrapping="Wrap"
              Text="{Binding PlayerPathDisplay}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="导入导出默认目录" />
          <TextBlock
              Classes="field-value"
              TextWrapping="Wrap"
              Text="{Binding ImportExportDirDisplay}" />
        </StackPanel>
      </StackPanel>
    </ui:SettingsSection>

    <!--  ============ ③ 说明 ============  -->
    <ui:SettingsSection
        Title="设置文件"
        Icon="📄"
        Desc="配置落在哪 / 备份会覆盖它"
        IsExpanded="True">
      <StackPanel Spacing="6">
        <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Text="{Binding ConfigFilePath}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="它在 config 目录下 —— 「设置 → 数据」的备份 / 导入会一起覆盖它。并发数原先存在 app.json（没有界面），首次运行已自动搬过来（⛔ 不丢配置）。" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="{Binding StatusText, StringFormat='状态：{0}'}" />
      </StackPanel>
    </ui:SettingsSection>

    </ui:SettingsSectionHost.Sections>
  </ui:SettingsSectionHost>
</UserControl>
