<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.ScriptManager.Views.CollectionView">
  <!--  集合页：单层骨架（ui.md §13 范本）—— 主显示区只有「成员表」一块 + 右侧详情列（IDetailCardSource）。
        外缘 0：工具条 / 表头 / 行区 / 状态栏直接相接，靠 ToolbarBrush(3) → ListHeaderBrush(4) → ListBodyBrush(1) 拉开档位差。
        集合选择 / 分组 / 类型三个下拉在工具条里，⛔ 不再单独占一栏。  -->
  <v:ListPageSkeleton IsEmpty="{Binding !HasMembers}"
                      EmptyMessage="没有可显示的条目。先去「脚本库」扫描 / 导入脚本，或在工具条切「📦 归档」外的下拉看全部。">
    <v:ListPageSkeleton.ListArea>
      <v:TableViewHost x:Name="MemberList" ItemsSource="{Binding Members}"
                       SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                       SelectionMode="Single">
        <v:TableViewHost.ContextMenu>
          <ContextMenu>
            <MenuItem Header="↩ 加入 / 移出本集合" Command="{Binding ToggleMembershipCommand}"
                      ToolTip.Tip="对选中行生效：未加入 ⇒ 加入；已加入 ⇒ 移出"/>
          </ContextMenu>
        </v:TableViewHost.ContextMenu>
        <v:TableViewHost.Columns>
          <TableViewColumn Width="0.9*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="list-cell" Text="{Binding StateText}"
                           ToolTip.Tip="{Binding Reason}"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>

          <TableViewColumn Width="3*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="list-cell primary" Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>

          <TableViewColumn Width="1*" Binding="{Binding RoleText}"/>

          <TableViewColumn Width="4*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="list-cell" Text="{Binding Target}"
                           TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>
        </v:TableViewHost.Columns>
      </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
