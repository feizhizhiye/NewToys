<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.PcTools.Views"
             x:Class="NewToys.PcTools.Views.PackageManagerView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid ColumnDefinitions="*,Auto" Margin="12">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行：原页头右侧「支持 / 状态」迁移至此；页名已由左侧二级菜单体现，内容区不再重复标题页头。
         本页**刻意没有「保存」按钮**：源 / 静默安装 / 排序列都是点一下立即写 config\package.json（规范 3.7）。 -->
    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->

    <!--  ==================== 工具条  ====================
          改用 WrapPanel：窗口变窄时控件自动换行，避免原先「水平 StackPanel 溢出压到右侧」导致的按钮重叠（规范 3.8 仅约束主区与右键菜单，工具条内部以不重叠、可响应式为准）。 -->
    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="源" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,6"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <!--  v3.19 / NT-008：源下拉框改按钮（选中态强调色实心；不强制互斥，可多源同时查）  -->
          <ItemsControl Margin="0,0,8,6" VerticalAlignment="Center" ItemsSource="{Binding SourceOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="src-btn" Classes.selected="{Binding IsSelected}"
                        Content="{Binding Label}"
                        Command="{Binding $parent[UserControl].DataContext.SelectSourceCommand}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBox x:Name="SearchBox" Width="230" Margin="0,0,8,6" IsEnabled="{Binding IsSupported}"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="关键字：git / Docker / ffmpeg…"
                   ToolTip.Tip="已安装 / 可升级列表里，这里就是本地过滤器；点「🔍 联网搜索」才去查 winget 源"/>

          <Button Classes="primary" Content="🔍 联网搜索" Margin="0,0,8,6" Command="{Binding SearchCommand}"
                  IsEnabled="{Binding !IsBusy}"/>
          <Button Classes="ghost" Content="📥 已安装" Margin="0,0,8,6" Command="{Binding LoadInstalledCommand}"
                  IsEnabled="{Binding !IsBusy}"/>
          <Button Classes="ghost" Content="⬆ 可升级" Margin="0,0,8,6" Command="{Binding LoadUpgradesCommand}"
                  IsEnabled="{Binding !IsBusy}"/>
          <Button Classes="ghost" Content="🔄 重新查询" Margin="0,0,8,6" Command="{Binding RefreshCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="按当前所在的列表重跑一次（搜索 / 已安装 / 可升级）—— 走 winget 联网查询，要等几秒"/>
          <!--  v3.22 §6.2.3：常用 winget 命令封成按钮 —— pin list 的结果**并入 winget list 列表**一起显示  -->
          <Button Classes="ghost" Content="📌 Pin 列表" Margin="0,0,8,6" Command="{Binding LoadPinnedCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="跑 winget pin list，把被 Pin 的包并入「已安装」列表（已存在的贴 📌，缺的补一行）"/>

          <CheckBox Content="静默安装 (--silent)" FontSize="12" Margin="0,0,8,6" IsChecked="{Binding SilentInstall, Mode=TwoWay}"/>

          <!--  v3.19 / NT-008：原顶部的「已安装（本机全部包）/ 可升级 / 搜索结果」ModeText 指示移除——
                模式与数量改由底部状态栏的 StatusText（“已安装 N 个包”等）体现，页面顶部更干净。  -->
        </WrapPanel>
        <!--  导入 / 导出已安装包清单（v3.19 / NT-008：换机恢复；控件样式同 NT-010 的 io-bar/io-btn）  -->
        <StackPanel Grid.Column="1" Classes="io-bar" Margin="0,0,8,6">
          <Button Classes="io-btn" Content="📤 导出" Click="OnExportClick"
                  ToolTip.Tip="把当前列表（建议先点「📥 已安装」）导成 json，供新系统恢复"/>
          <Button Classes="io-btn" Content="📥 导入" Click="OnImportClick"
                  ToolTip.Tip="选一个导出的 json，生成 winget 批量安装脚本(.bat)，到新系统运行即可恢复"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="detail-toggle"
                Command="{Binding ToggleDetailCommand}"
                ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
          <Panel>
            <TextBlock Text="❯" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsDetailVisible}"/>
            <TextBlock Text="❮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsDetailVisible}"/>
          </Panel>
        </Button>
      </Grid>
    </Border>



      <!--  ==================== 列表本体：可排序表头 + 列表（右键出更多功能）  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">

          <Border Grid.Row="0" Classes="list-header">
            <!-- ⚠️ 列宽规格绑 VM 的 VisibleColumnSpecs（隐藏列 = "0"，列索引保持不动）。
                 ⚠️ 必须用 ColumnGrid 而不是 Grid：Grid.ColumnDefinitions 是 CLR 属性、XAML 里不能 {Binding}（AVLN3000）。
                 右键表头任意位置弹出「显示 / 隐藏列」菜单（规范 3.8 右键增删表头项）。 -->
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" ToolTip.Tip="点一下按名称排序"
                      IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding IdHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Id" ToolTip.Tip="点一下按 Id 排序"
                      IsVisible="{Binding IsIdVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding VersionHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Version" ToolTip.Tip="点一下按版本排序（同一列再点一次反向）"
                      IsVisible="{Binding IsVersionVisible}"/>
              <Button Grid.Column="3" Classes="col-header" Content="{Binding SourceHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Source"
                      IsVisible="{Binding IsSourceVisible}"/>
              <Button Grid.Column="4" Classes="col-header" Content="{Binding StatusHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Status"
                      IsVisible="{Binding IsStatusVisible}"/>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="仅看已安装" Command="{Binding ToggleInstalledOnlyCommand}" ToolTip.Tip="只留本机已安装的（原工具条勾选，v3.19 / NT-008 并入表头右键）"/>
                  <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <!-- ⚠️ IsChecked 必须显式 Mode=OneWay：勾选只负责"显示当前状态"，
                       真正的翻转由 ToggleColumnCommand 独家负责（默认双向会写回 VM 造成二次翻转）。 -->
                  <MenuItem Header="名称" IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="Id" ToggleType="CheckBox" IsChecked="{Binding IsIdVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Id"/>
                  <MenuItem Header="版本" ToggleType="CheckBox" IsChecked="{Binding IsVersionVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Version"/>
                  <MenuItem Header="源" ToggleType="CheckBox" IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Source"/>
                  <MenuItem Header="状态" ToggleType="CheckBox" IsChecked="{Binding IsStatusVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Status"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="PkgList" Classes="list-page"
                   ItemsSource="{Binding Packages}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <!-- 右键菜单：这是「选中后更多功能」的主入口（菜单项作用对象 = 当前选中行）：
                 查（▤ 详情栏 / 🔎 详情 / 🌐 主页 / 🔗 winget.run）/ 增（⬇ 安装）/ 改（⬆ 升级 / 📌 Pin）/ 删（🗑 卸载）。 -->
            <ListBox.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="⬇ 安装" Command="{Binding InstallCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="⬆ 升级到最新" Command="{Binding UpgradeCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="🗑 卸载…" Command="{Binding UninstallCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Separator/>
                <MenuItem Header="📌 Pin（暂停更新）" Command="{Binding PinCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="📌 取消 Pin" Command="{Binding UnpinCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Separator/>
                <MenuItem Header="🔎 读取详情（winget show）" Command="{Binding LoadDetailCommand}"/>
                <MenuItem Header="📋 复制 Id" Command="{Binding CopyIdCommand}"/>
                <MenuItem Header="🌐 打开主页" Command="{Binding OpenHomepageCommand}"/>
                <MenuItem Header="🔗 在 winget.run 查看" Command="{Binding OpenInWingetRunCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- 行与表头共用同一份 VisibleColumnSpecs（规范 3.8 对齐铁律①）；每格 IsVisible 跟随列显隐。 -->
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell primary" Text="{Binding Name}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Id}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsIdVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell primary" Text="{Binding Version}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsVersionVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding Source}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"/>
                  <TextBlock Grid.Column="4" Classes="list-cell accent" Text="{Binding StatusText}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

    <!--  右：选中包的详细信息；宽度由共享样式 Border.detail-card 给 → 收起时整列不占位  -->
    <Border Grid.Column="1" Classes="detail-card" IsVisible="{Binding IsDetailVisible}">
        <Grid RowDefinitions="Auto,*">

          <!-- 有选中：动作按钮 + 字段 -->
          <StackPanel Grid.Row="0" Spacing="12" IsVisible="{Binding HasSelection}">
            <TextBlock Classes="section-title" Text="选中包"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="primary" Content="⬇ 安装" Command="{Binding InstallCommand}" IsEnabled="{Binding !IsBusy}"/>
              <Button Classes="ghost" Content="⬆ 升级" Command="{Binding UpgradeCommand}" IsEnabled="{Binding !IsBusy}"/>
              <Button Classes="ghost" Content="🔎 详情" Command="{Binding LoadDetailCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Content="📌 Pin" Command="{Binding PinCommand}" IsEnabled="{Binding !IsBusy}"
                      ToolTip.Tip="Pin 住 = 暂停更新，winget upgrade 会跳过它"/>
              <Button Classes="ghost" Content="📌 取消" Command="{Binding UnpinCommand}" IsEnabled="{Binding !IsBusy}"/>
              <Button Classes="ghost" Content="🗑 卸载" Command="{Binding UninstallCommand}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Content="📋 复制 Id" Command="{Binding CopyIdCommand}"/>
              <Button Classes="ghost" Content="🌐 主页" Command="{Binding OpenHomepageCommand}"/>
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

              <StackPanel Classes="field" IsVisible="{Binding !HasSelection}">
                <TextBlock Text="在左侧列表里选中一个包" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="选中后这里显示版本、源、状态、发布者、主页、协议与描述；右键列表还有安装 / 升级 / 卸载 / Pin 等操作。"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="名称"/>
                <TextBlock Text="{Binding Selected.Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="Id"/>
                <SelectableTextBlock Text="{Binding Selected.Id}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="版本 / 可升级到"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Selected.Version}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                  <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <TextBlock Text="{Binding Selected.Available}" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="状态"/>
                <TextBlock Text="{Binding Selected.StatusText}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="源"/>
                <TextBlock Text="{Binding Selected.Source}" FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="发布者"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.Publisher}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="协议 / 许可证"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.License}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="安装位置"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.InstallLocation}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="主页"/>
                <SelectableTextBlock Text="{Binding Selected.Homepage}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryTextBrush}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="描述"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.Description}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="（描述等信息来自「🔎 详情」，点一下才会去跑 winget show）" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
  </Grid>
</UserControl>
