<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.Reading.Views.ShelfView">
  <!--
    网络阅读 → 书架（`reading-shelf`）：搜到后加进来的书。
    🔴 工具条 / 详情卡由 Shell 按 VM 契约渲染，页内 ⛔ 不自绘工具条。
    🔴 颜色一律 DynamicResource 主题语义键（⛔ 不写死色值）。
  -->
  <Grid>
    <v:ListPageSkeleton EmptyMessage="书架是空的 —— 到「网上搜索」搜到书后，右键「＋ 加入书架」。"
                        IsEmpty="{Binding !HasItems}">

      <v:ListPageSkeleton.TopArea>
        <v:FilterBar ResetFieldsOnClear="True" ClearCommand="{Binding ClearFiltersCommand}">
          <v:FilterBar.FieldsContent>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <ComboBox Grid.Column="0" Classes="filter-combo" Width="150"
                        ItemsSource="{Binding GroupOptions}"
                        SelectedItem="{Binding GroupFilter, Mode=TwoWay}"/>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                <ComboBox Classes="filter-combo" Width="120"
                          ItemsSource="{Binding UpdateOptions}"
                          SelectedItem="{Binding UpdateFilter, Mode=TwoWay}"/>
                <Button Classes="ghost" Content="只看有更新" Command="{Binding FilterWithUpdatesCommand}"
                        ToolTip.Tip="只留「有 N 章更新」的书（跑完批量更新后看结果用）"/>
              </StackPanel>

              <TextBlock Grid.Column="3"
                         Classes="hint-text"
                         Text="{Binding FilterSummary}"
                         VerticalAlignment="Center"/>
            </Grid>
          </v:FilterBar.FieldsContent>
        </v:FilterBar>
      </v:ListPageSkeleton.TopArea>

      <v:ListPageSkeleton.ListArea>
        <v:TableViewHost x:Name="ShelfList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionMode="Single">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="240">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Tip}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="140" Binding="{Binding Author}"/>
            <TableViewColumn Width="120" Binding="{Binding Group}"/>

            <TableViewColumn Width="220">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="hint-text"
                             Text="{Binding ProgressText}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ReadTime}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="120">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Update}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding UpdateTip}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="160" Binding="{Binding SourceName}"/>
            <TableViewColumn Width="110" Binding="{Binding Added}"/>
          </v:TableViewHost.Columns>

          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Icon="🔔" Header="只看有更新" Command="{Binding FilterWithUpdatesCommand}"/>
              <Separator/>
              <MenuItem Icon="📖" Header="继续阅读" Command="{Binding ReadCommand}" IsEnabled="{Binding HasSelection}"/>
              <MenuItem Icon="＋" Header="更新这本" Command="{Binding UpdateOneCommand}" IsEnabled="{Binding IsNotUpdating}"/>
              <MenuItem Header="设置分组" Icon="{m:Glyph IconOpen}" Command="{Binding SetGroupCommand}" IsEnabled="{Binding HasSelection}"/>
              <Separator/>
              <MenuItem Header="移出书架" Icon="{m:Glyph IconTrash}" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasSelection}"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
      </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>
  </Grid>
</UserControl>
