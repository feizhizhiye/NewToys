<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.Shell.Views.DataView">
  <!--  v3.66 / NT-062 第五轮：**内层 ScrollViewer 删除** + 边距 / 卡片内距收紧
        （设置页整页已是滚动流，内层再套一个会**吃掉滚轮** ⇒ 鼠标停在本节上时整页滚不动）。

        NT-078（2026-10-19）：「备份 / 导入」从「config 全部 json 塞进一个 JSON」改成
        **zip 分节备份**：上半 = 可勾选的备份节（设置 = 默认勾，数据 / 本机环境 = 默认不勾），
        下半 = 当前配置文件清单（只读，用来确认设置到底落在哪几个文件里）。
        ⚠️ 节内**不套 Border.card**（设置页宿主的 sec-body 已提供留白）。  -->
  <StackPanel HorizontalAlignment="Stretch" MaxWidth="1080" Spacing="10">

    <!--  ==================== 操作行  ====================  -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="BtnExport" Classes="primary" Content="{m:GlyphText IconExport, '导出'}" IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="按下面勾选的节导出成一个 zip 备份包"/>
      <Button x:Name="BtnRestore" Classes="ghost" Content="{m:GlyphText IconImport, '恢复备份'}" IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="选一个 zip 备份包（旧的 json 备份也能在这里导入）"/>
      <Button x:Name="BtnLegacy" Classes="ghost" Content="{m:GlyphText IconOpen, '导入旧版'}" ToolTip.Tip="只导入 config 设置（v1 单 JSON 备份；不认 zip 里的分节）"/>
      <Button x:Name="BtnRefresh" Classes="ghost" Content="{m:GlyphText IconRefresh, '重算'}" ToolTip.Tip="重新统计各节大小 / 重列配置文件（⛔ 不备份、不修改）"/>
    </StackPanel>

    <TextBlock Classes="hint-text"
               Text="备份 = 一个 zip 包，里面按「节」分开打包，恢复时可以只取其中几节。默认勾选的是设置；「数据」和「本机环境」默认不勾 —— 前者体积大，后者是这台机器的绝对路径。"/>

    <!--  ==================== 备份节清单  ====================  -->
    <TextBlock Text="备份内容" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

    <ItemsControl ItemsSource="{Binding Sections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Padding="0,6">
            <Grid ColumnDefinitions="Auto,*,110,70">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        VerticalAlignment="Top" Margin="0,2,8,0"
                        ToolTip.Tip="勾上才会被导出 / 恢复"/>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="本机" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentInkBrush}" IsVisible="{Binding IsMachineBound}"
                             ToolTip.Tip="含绝对路径 —— 换机器恢复后可能失效，需要在设置里复核"/>
                </StackPanel>
                <TextBlock Text="{Binding Description}" Classes="hint-text"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Column="3" Text="{Binding ScopeText}" FontSize="12"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{Binding SelectionSummary}" Classes="hint-text"/>

    <!--  ==================== 当前配置文件（只读清单）  ====================  -->
    <TextBlock Text="当前配置文件" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0"
               Foreground="{DynamicResource PrimaryTextBrush}"/>
    <TextBlock Classes="hint-text"
               Text="本配置档 config 目录下的全部设置文件（只列出，不在这里改）。"/>

    <ItemsControl ItemsSource="{Binding ConfigFiles}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Padding="10,6">
            <Grid ColumnDefinitions="*,110,160">
              <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding LastWrite, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
