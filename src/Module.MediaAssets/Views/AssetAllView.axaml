<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:views="using:NewToys.MediaAssets.Views"
             xmlns:ui="using:NewToys.UI.Behaviors"
             xmlns:m="using:NewToys.UI.Markup"
             ui:FilterDropDownAlign.Attach="True"
             x:Class="NewToys.MediaAssets.Views.AssetAllView">
  <!--
    「全部资产」列表页。
    🔴 本页不带右栏详情卡 —— 详情面板由 Shell 承载（VM 实现 IDetailPanelProvider）。
    列表本体 = <v:TableViewHost>（原生 TableView 的项目派生类）：列显隐 / 表头排序 / 列宽拖拽 /
    表头⇄行右键菜单由控件统一提供，本页只声明列模板与行功能菜单。
  -->

  <UserControl.Styles>
    <!--  筛选栏压矮：只覆盖本页（全局 filter-bar / filter-combo 仍是 12,4 + MinHeight 28）  -->
    <Style Selector="Border.filter-bar">
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="ComboBox.filter-combo">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="22"/>
    </Style>

  </UserControl.Styles>

  <Panel>
  <v:ListPageSkeleton EmptyMessage="没有可显示的资产。点「导入」把导出的 json 合并进库，或用「📁 扫描」扫一个目录。"
                      EmptyActionText="导入"
                      EmptyActionCommand="{Binding ImportAssetsCommand}"
                      IsEmpty="{Binding !HasItems}"
                      ShowFooter="{Binding HasFooterContent}"
                      TotalCount="{Binding TotalCount}"
                      SelectedCount="{Binding SelectedCount}"
                      PageText="{Binding PageText}"
                      ShowPaging="{Binding HasPaging}"
                      PageCount="{Binding PageCount}"
                      CurrentPage="{Binding PageIndex}"
                      JumpToPageCommand="{Binding GoToPageCommand}"
                      FirstCommand="{Binding FirstPageCommand}"
                      PrevCommand="{Binding PrevPageCommand}"
                      NextCommand="{Binding NextPageCommand}"
                      LastCommand="{Binding LastPageCommand}"
                      PageSizes="{Binding PageSizeChoices}"
                      PageSize="{Binding PageSize, Mode=TwoWay}">

    <!--  ② 筛选条：常用下拉 + 一键复位（复位行为由 FilterBar.ResetFieldsOnClear 统一提供）。  -->
    <v:ListPageSkeleton.TopArea>
      <v:FilterBar ResetFieldsOnClear="True" ClearCommand="{Binding ClearFiltersCommand}">
        <v:FilterBar.FieldsContent>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
            <!--  combo 尺寸压到最窄窗口（960 + 详情栏展开）也放得下一行。  -->
            <ComboBox Grid.Column="0" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="12"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="按类型筛选（视频 / 音乐 / 书籍 / 图片 / 文档）"
                      ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding FilterType, Mode=TwoWay}"/>
            <ComboBox Grid.Column="1" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="12"
                      HorizontalAlignment="Left"
                      IsEnabled="{Binding CanFilterByStorageOrTag}"
                      ToolTip.Tip="按存储源筛选（扫描预览态不可用：预览行还没入库）"
                      ItemsSource="{Binding StorageOptions}" SelectedItem="{Binding FilterStorage, Mode=TwoWay}"/>
            <ComboBox Grid.Column="2" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="12"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="按状态筛选（正常 / 已丢失 / 回收站 / 已归档）"
                      ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}"/>
            <ComboBox Grid.Column="3" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="12"
                      HorizontalAlignment="Left"
                      IsEnabled="{Binding CanFilterByStorageOrTag}"
                      ToolTip.Tip="按标签筛选（扫描预览态不可用：预览行还没有标签）"
                      ItemsSource="{Binding TagOptions}" SelectedItem="{Binding FilterTag, Mode=TwoWay}"/>
          </Grid>
        </v:FilterBar.FieldsContent>
      </v:FilterBar>
    </v:ListPageSkeleton.TopArea>

    <!--  ==================== ③ 列表本体（表头由 TableViewHost 自带，骨架 HeaderArea 不填）  ====================  -->
    <v:ListPageSkeleton.ListArea>
        <!--  多选走列表原生选中：Ctrl 增选 / Shift 连选 / Ctrl+A 全选（code-behind 隧道接管）；
             无修饰键点击 = 单选替换（与资源管理器一致）。
             列显隐 / 表头文案 / 排序键由 TableViewHost 按 VM 的 ColumnLayout 对齐，⛔ XAML 里不写 IsVisible。  -->
        <v:TableViewHost x:Name="AssetList" Classes="list-page"
                         SelectionMode="Multiple"
                         ItemsSource="{Binding Items}">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="2*" Header="名称">
              
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             ToolTip.Tip="{Binding FilePath}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="54" Binding="{Binding TypeText}" Header="类型" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="1.2*" Binding="{Binding TagsText}" Header="标签"/>

            <TableViewColumn Width="1*" Binding="{Binding CategoriesText}" Header="分类"/>

            <TableViewColumn Width="1*" Binding="{Binding CollectionsText}" Header="集合"/>

            <!--  大小固定 90（按最长串 1023.99 MB 预留），与 VM 的 AssetColumns 口径一致  -->
            <TableViewColumn Width="90" Binding="{Binding SizeText}" Header="大小" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="124" Binding="{Binding ModifiedText}" Header="修改时间" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="1*" Binding="{Binding StorageName}" Header="存储源"/>

            <!--  视频专属列：非视频页由 VM 的 IsXxxVisible 关掉  -->
            <TableViewColumn Width="72" Binding="{Binding DurationText}" Header="时长" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="88" Binding="{Binding ResolutionText}" Header="分辨率" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="60" Binding="{Binding CodecText}" Header="编码" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="76" Binding="{Binding BitRateText}" Header="码率" HorizontalContentAlignment="Center"/>
          </v:TableViewHost.Columns>

          <!--
            行右键菜单 = **针对单条**的动作（§4.8 硬规则 9）：打开 / 定位 / 批量操作。
            ⛔ 这些⛔ 不上工具条（工具条只放页面级功能：扫描 / 筛选 / 入库 / 清除…）。
            表头右键（列宽自适应 / 恢复默认 / 列显隐）由 TableViewHost 统一生成，本页不声明。
          -->
          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Header="打开" Icon="{m:Glyph IconOpen}" Command="{Binding OpenFileCommand}"
                        ToolTip.Tip="用系统默认程序打开（视频=播放 / 书=阅读 / 图=看图）"/>
              <MenuItem Header="所在目录" Icon="{m:Glyph IconOpen}" Command="{Binding OpenFolderCommand}"
                        ToolTip.Tip="在资源管理器里选中这个文件"/>
              <MenuItem Icon="➡" Header="发送到视频工具" Command="{Binding SendToVideoToolsCommand}"
                        ToolTip.Tip="把选中的视频送到「视频工具 → 视频列表」页，接着定剪辑 / 转码参数（非视频自动跳过）"/>
              <!--  批量重命名：多选后按规则改（≥2 个才可用；单选用详情卡的「↗ 应用到文件」）  -->
              <MenuItem Header="重命名" Icon="{m:Glyph IconEdit}" Command="{Binding BatchRenameSelectedCommand}"
                        ToolTip.Tip="选中 ≥2 个后按规则改名（查找替换 / 前缀后缀 / 编号 / 大小写），先看预览再确认"/>
              <!--  加标签 / 加集合：只在右键（工具条不再放），支持一次选多个一起加  -->
              <MenuItem Icon="🏷" Header="加标签…" Command="{Binding AddTagToCheckedCommand}"
                        ToolTip.Tip="给选中的资产加标签：弹层里可搜索 / 多选 / 新建（只加不减，取消请到详情卡点色片）"/>
              <MenuItem Icon="📖" Header="加集合…" Command="{Binding AddToCollectionCheckedCommand}"
                        ToolTip.Tip="把选中的资产加进集合：智能集合成员由规则决定，不能手工加"/>
              <Separator/>
              <!--  **唯一**直接物理删磁盘文件的入口（破坏性最大 ⇒ 故意只放右键、还要二次确认 + 走任务队列）；  -->
              <MenuItem Header="从磁盘删除…" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteFromDiskCommand}"
                        ToolTip.Tip="永久删除磁盘文件：不进回收站、不可还原，库里的文件索引一起删。选中多条 = 批量删除（逐个确认清单一次给出）"/>
              <Separator/>
              <MenuItem Header="全选当前页" Icon="{m:Glyph IconCheckAll}" Command="{Binding SelectAllCommand}"
                        ToolTip.Tip="选中当前页所有行（等价 Ctrl+A）"/>
              <MenuItem Header="取消选择" Icon="{m:Glyph IconUncheckAll}" Command="{Binding SelectNoneCommand}"/>
              <MenuItem Header="反选当前页" Icon="{m:Glyph IconInvert}" Command="{Binding InvertSelectionCommand}"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>

  <!--  批量重命名弹层：盖在整页之上（含底栏），遮罩挡住下面的命中测试  -->
  <views:BatchRenameOverlay DataContext="{Binding BatchRename}" IsVisible="{Binding IsOpen}"/>
  <!--  加标签 / 加集合多选弹层（同一套壳，按 PickMany 的 Kind 切标签或集合）  -->
  <views:PickManyOverlay DataContext="{Binding PickMany}" IsVisible="{Binding IsOpen}"/>
  </Panel>
</UserControl>
