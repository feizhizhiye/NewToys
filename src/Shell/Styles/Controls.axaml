<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  =====================================================================
        NewToys 复用样式表（v1.35）
        目的：把**每个列表页都抄一遍**的那几段 XAML（工具条 / 状态行 / 详情卡 /
        字段组 / 表头 / 行内按钮 …）收成 Class，页面里只写一行 Classes="…"。

        用法：Shell/App.axaml 里 <StyleInclude Source="avares://NewToys/Styles/Controls.axaml"/>
        样式是**应用级**的，模块（PcTools / VideoTools / Settings / WebTools）里的
        控件直接写 Classes 即可生效，不需要各模块再抄一份。

        ⚠️ 铁律：颜色一律 DynamicResource + *Brush 语义键，禁写死 #RRGGBB
        （否则换主题后写死的那个控件不跟着变）。
        ===================================================================== -->

  <!--  ① 工具条：列表页顶部那条（背景 + 底部分隔线 + 内边距），页面里套 WrapPanel 即可  -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="Padding" Value="24,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!--  ② 页面右上角「状态行」：所有页面都有的那一行文字  -->
  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.info-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ③ 提示 / 说明文字（说明条、字段下方的灰色小字、底部数据文件提示）  -->
  <Style Selector="TextBlock.hint-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.empty-hint">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ④ 详情卡字段组：「小标签 + 值」这一对，页面里只需 Classes="field"  -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="2"/>
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.field-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>

  <!--  ⑤ 右侧详情卡（宽度 / 外边距 / 圆角统一；收起时整列不占位）  -->
  <Style Selector="Border.detail-card">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Width" Value="340"/>
    <Setter Property="Margin" Value="12,0,0,0"/>
  </Style>

  <!--  ⑥ 分隔线  -->
  <Style Selector="Border.divider-line">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!--  ⑦ 行内小按钮（列表行里的「▶ 运行」之类）与小号按钮  -->
  <Style Selector="Button.row-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!--  ⑧ 表头按钮（可排序）
        ⚠️ 关键修复（v1.35）：以前这里写了 VerticalAlignment="Center"，
           按钮高度被压成"文字那一条"，鼠标只有落在字的那十几像素上才点得到 ——
           表头空白处点了没反应。现在改成**撑满表头整行**（Stretch + 内容居中），
           整列整行都是点击区；文字仍然垂直居中。 -->
  <Style Selector="Button.col-header">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.col-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑨ 详情栏开关：**贴在表头右缘、默认几乎不占地方、鼠标靠近才弹出**（v1.35 二次优化）
        之前的 ▤ 常驻按钮会一直占着表头最后一格；现在改成：
          默认 → 只露一条 8px 窄边（Opacity 0、不可点），表头看起来是干净的；
          鼠标进入右侧热区 → 平滑弹出成 34px 的完整按钮（带边框 + 方向图标）。
        图标也换了：收起态 ❯（点它展开右侧详情），展开态 ❮（点它收起），一眼知道当前是哪种。  -->
  <Style Selector="Button.header-toggle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,4,6,4"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        <DoubleTransition Property="Width" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.header-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑨-a 右缘热区（透明，宽 64px，负责"鼠标靠近"这件事）  -->
  <Style Selector="Border.detail-hotspot">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="64"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!--  ⑨-b 收起态：只露一条窄边，且不吃鼠标事件（否则"看不见却能点到"很怪）  -->
  <Style Selector="Border.detail-hotspot Button.header-toggle">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,6,2,6"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!--  ⑨-c 鼠标进入热区 → 弹出  -->
  <Style Selector="Border.detail-hotspot:pointerover Button.header-toggle">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="Margin" Value="0,4,6,4"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <!--  ⑩ 表头容器（高度固定 36，内部按钮靠 ⑧/⑨ 撑满 —— 点击区 = 整格）  -->
  <Style Selector="Border.list-header">
    <Setter Property="Background" Value="{DynamicResource SubSiderHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="36"/>
  </Style>

  <!--  ⑪ 表格单元格：默认次要色；加 .primary / .accent 切换字的颜色  -->
  <Style Selector="TextBlock.list-cell">
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑫ 等宽输入（命令 / 脚本文件 / 时间码）  -->
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>

  <!--  ⑬ 筛选条：多项筛选那一行的容器与其中的控件  -->
  <Style Selector="Border.filter-bar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="24,6"/>
  </Style>
  <Style Selector="ComboBox.filter-combo">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="110"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.filter-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Width" Value="140"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.filter-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="Button.filter-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑭ 进度条（转码 / 剪切任务跑起来时显示百分比）  -->
  <Style Selector="ProgressBar.task-progress">
    <Setter Property="Height" Value="6"/>
    <Setter Property="MinWidth" Value="60"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <!--  ⑮ 状态徽章（任务的「等待 / 运行中 / 完成 / 失败」）  -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.badge-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

</Styles>
