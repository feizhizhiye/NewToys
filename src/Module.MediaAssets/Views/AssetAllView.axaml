<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.MediaAssets.Controls"
             x:Class="NewToys.MediaAssets.Views.AssetAllView">
  <!--
    NT-016「全部资产」样板列表页。
    🔴 与旧列表页（Ping / 视频列表）最大的不同：**本页没有右栏详情卡** —— 详情面板改由 **Shell**
       承载（VM 实现 IDetailPanelProvider，详情卡已改由 Shell 声明式渲染（NT-054））。
       ⛔ 若本页再自带一栏，右列会出现两个详情卡（Shell 一个、页面一个）。

    布局：工具条 / 筛选条 / 列表 三行（右列由 Shell 补上，凑成三列）。
  -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">

    <!--  ==================== ① 工具条  ====================  -->
    <!--  🔴 容器间距规则（v3.29，写进需求 §4.10.4）：横向流式容器（WrapPanel）**必须**给
        ItemSpacing（元素间水平距）+ LineSpacing（换行后行与行的上下距）—— ⛔ 别让换行后的
        两行按钮贴在一起（实测踩过：按钮一多换行，第二行顶死第一行）。  -->

    <!--  ==================== ② 筛选条（改任一条件即时重算：VM 的 OnFilterXxxChanged → ApplyView）  ====================  -->
    <Border Grid.Row="1" Classes="filter-bar">
      <!--  🔴 v3.41（用户定调）：筛选条**恒为一行、且⛔不许出现滚动条**。
            筛选器数量是固定的（类型 / 存储源 / 状态 / 标签）⇒ 用 Grid 排死：
            标签 Auto + 四个 combo 各占等分星号 ⇒ 窗口变窄时 combo **自己跟着变窄**，永远不会溢出、也不需要滚动条；
            再给 combo 设 MaxWidth 防止宽窗口下被拉得过宽（超出部分自然留在右侧空白）。
            ⚠️ ⛔ 别改回 WrapPanel（放不下就换行，条高会变）、⛔ 别套 ScrollViewer（用户明确不要滚动条）。
            ⚠️ 列间距用 Grid.ColumnSpacing（= §4.10.4 对横向流式容器的同一条要求），⛔ 不给每个 combo 写右 Margin。  -->
      <Grid ColumnDefinitions="Auto,*,*,*,*" ColumnSpacing="5">
        <TextBlock Grid.Column="0" Text="筛选" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <!--  v3.41：combo 尺寸再压小（Padding 4,1 + MinWidth 0 覆盖全局 filter-combo 的 MinWidth=110；
              MaxWidth 120 兜住宽窗口）—— 最窄窗口（960 + 详情栏展开）也放得下，一行不动。  -->
        <ComboBox Grid.Column="1" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按类型筛选（视频 / 音乐 / 书籍 / 图片 / 文档）"
                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding FilterType, Mode=TwoWay}"/>
        <ComboBox Grid.Column="2" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按存储源筛选"
                  ItemsSource="{Binding StorageOptions}" SelectedItem="{Binding FilterStorage, Mode=TwoWay}"/>
        <ComboBox Grid.Column="3" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按状态筛选（正常 / 已丢失 / 回收站 / 已归档）"
                  ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}"/>
        <ComboBox Grid.Column="4" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按标签筛选"
                  ItemsSource="{Binding TagOptions}" SelectedItem="{Binding FilterTag, Mode=TwoWay}"/>
      </Grid>
    </Border>

    <!--  ==================== ③ 列表本体  ====================  -->
    <Border Grid.Row="2" Padding="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
      <Grid RowDefinitions="Auto,Auto,*">

        <!--  表头（IsResizable = 列边界可拖；LockedColumns / SampleSpecs 供"示例宽 ≤ 表头宽就锁宽"用）  -->
        <Border Grid.Row="0" Classes="list-header">
          <v:ColumnGrid x:Name="HeaderGrid"
                        ColumnSpecs="{Binding VisibleColumnSpecs}"
                        IsResizable="True"
                        LockedColumns="{Binding LockedColumnMask}"
                        SampleSpecs="{Binding SampleSpecs}">
            <!--  v3.34 / NT-018：勾选列表头 —— 🔴 **原生三态 CheckBox**（⛔ 别用字符"☑"画，字体会渲染成深色块）；
                  右键菜单挂在外层透明 Border 上（整格都能右键）。
                  🔴 v3.42.1 修崩溃：菜单**只挂 Border、⛔ 不挂 CheckBox、⛔ code-behind 不手动 Open**
                  —— 挂 CheckBox 上时原生右键已自动弹一次，code-behind 再 Open 一次 → 二次 Open 抛异常直接崩。
                  与 VideoTools v3.16.1 写法对齐（那边一直是这么做的）。  -->
            <Border Grid.Column="0" x:Name="HeaderCheckHost" Background="Transparent"
                    ToolTip.Tip="勾选的行由「🏷 加标签 / 📚 加集合」批量操作（右键：全选 / 取消 / 反选）">
              <CheckBox x:Name="HeaderCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="True"
                        IsChecked="{Binding AllCheckedState, Mode=TwoWay}"/>
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="☑ 全选" Command="{Binding ToggleAllCommand}"/>
                  <MenuItem Header="☐ 取消选择" Command="{Binding SelectNoneCommand}"/>
                  <MenuItem Header="⇄ 反选" Command="{Binding InvertSelectionCommand}"/>
                </ContextMenu>
              </Border.ContextMenu>
            </Border>

            <Button Grid.Column="1" Classes="col-header" Content="{Binding NameHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Name"
                    IsVisible="{Binding IsNameVisible}"/>
            <Button Grid.Column="2" Classes="col-header" Content="{Binding TypeHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Type"
                    IsVisible="{Binding IsTypeVisible}"/>
            <Button Grid.Column="3" Classes="col-header" Content="{Binding TagsHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Tags"
                    IsVisible="{Binding IsTagsVisible}"/>
            <Button Grid.Column="4" Classes="col-header" Content="{Binding CategoriesHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Categories"
                    IsVisible="{Binding IsCategoriesVisible}"/>
            <Button Grid.Column="5" Classes="col-header" Content="{Binding CollectionsHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Collections"
                    IsVisible="{Binding IsCollectionsVisible}"/>
            <Button Grid.Column="6" Classes="col-header" Content="{Binding SizeHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Size"
                    IsVisible="{Binding IsSizeVisible}"/>
            <Button Grid.Column="7" Classes="col-header" Content="{Binding ModifiedHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Modified"
                    IsVisible="{Binding IsModifiedVisible}"/>
            <Button Grid.Column="8" Classes="col-header" Content="{Binding StorageHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Storage"
                    IsVisible="{Binding IsStorageVisible}"/>

            <!--  NT-031：视频专属列表头（仅视频页可见；非视频页 IsVisible=false 自动隐藏）  -->
            <Button Grid.Column="9" Classes="col-header" Content="{Binding DurationHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Duration"
                    IsVisible="{Binding IsDurationVisible}"/>
            <Button Grid.Column="10" Classes="col-header" Content="{Binding ResolutionHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Resolution"
                    IsVisible="{Binding IsResolutionVisible}"/>
            <Button Grid.Column="11" Classes="col-header" Content="{Binding CodecHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Codec"
                    IsVisible="{Binding IsCodecVisible}"/>

            <v:ColumnGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                  <MenuItem.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Setter Property="Header" Value="{Binding Label}"/>
                      <Setter Property="Command" Value="{Binding Command}"/>
                    </ControlTheme>
                  </MenuItem.ItemContainerTheme>
                </MenuItem>
                <Separator/>
                <MenuItem Header="名称" IsEnabled="False" ToggleType="CheckBox"
                          IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                          ToolTip.Tip="标识列固定显示，不可隐藏"/>
                <MenuItem Header="类型" ToggleType="CheckBox" IsChecked="{Binding IsTypeVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Type"/>
                <MenuItem Header="标签" ToggleType="CheckBox" IsChecked="{Binding IsTagsVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Tags"/>
                <MenuItem Header="分类" ToggleType="CheckBox" IsChecked="{Binding IsCategoriesVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Categories"/>
                <MenuItem Header="集合" ToggleType="CheckBox" IsChecked="{Binding IsCollectionsVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Collections"/>
                <MenuItem Header="大小" ToggleType="CheckBox" IsChecked="{Binding IsSizeVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Size"/>
                <MenuItem Header="修改时间" ToggleType="CheckBox" IsChecked="{Binding IsModifiedVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Modified"/>
                <MenuItem Header="存储源" ToggleType="CheckBox" IsChecked="{Binding IsStorageVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Storage"/>
                <MenuItem Header="时长" ToggleType="CheckBox" IsChecked="{Binding IsDurationVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Duration"/>
                <MenuItem Header="分辨率" ToggleType="CheckBox" IsChecked="{Binding IsResolutionVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Resolution"/>
                <MenuItem Header="编码" ToggleType="CheckBox" IsChecked="{Binding IsCodecVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Codec"/>
              </ContextMenu>
            </v:ColumnGrid.ContextMenu>
          </v:ColumnGrid>
        </Border>

        <!--
          v3.22 §4.8.1 **示例行**（空态水印）：列表为空时显示一条，让用户先看清每列是什么；
          有真实数据后整条消失。⛔ 它不在 Items 里：不参与筛选 / 排序 / 统计。
        -->
        <Border Grid.Row="1" Classes="list-header" IsVisible="{Binding ShowSampleRow}" Opacity="0.5"
                ToolTip.Tip="这是示例数据（列宽就按它判定）；导入 / 扫描到真实资产后这一行会消失">
          <v:ColumnGrid ColumnSpecs="{Binding VisibleColumnSpecs}">
            <!--  勾选列（示例行不给勾选框，保持"占位"语义）  -->
            <TextBlock Grid.Column="0" Classes="list-cell" Text=""
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding SampleRowTexts[1]}"
                       Foreground="{DynamicResource PrimaryTextBrush}" IsVisible="{Binding IsNameVisible}"/>
            <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding SampleRowTexts[2]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsTypeVisible}"/>
            <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding SampleRowTexts[3]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsTagsVisible}"/>
            <TextBlock Grid.Column="4" Classes="list-cell" Text="{Binding SampleRowTexts[4]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsCategoriesVisible}"/>
            <TextBlock Grid.Column="5" Classes="list-cell" Text="{Binding SampleRowTexts[5]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsCollectionsVisible}"/>
            <TextBlock Grid.Column="6" Classes="list-cell" Text="{Binding SampleRowTexts[6]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsSizeVisible}"/>
            <TextBlock Grid.Column="7" Classes="list-cell" Text="{Binding SampleRowTexts[7]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsModifiedVisible}"/>
            <TextBlock Grid.Column="8" Classes="list-cell" Text="{Binding SampleRowTexts[8]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsStorageVisible}"/>
            <TextBlock Grid.Column="9" Classes="list-cell" Text="{Binding SampleRowTexts[9]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsDurationVisible}"/>
            <TextBlock Grid.Column="10" Classes="list-cell" Text="{Binding SampleRowTexts[10]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsResolutionVisible}"/>
            <TextBlock Grid.Column="11" Classes="list-cell" Text="{Binding SampleRowTexts[11]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding IsCodecVisible}"/>
          </v:ColumnGrid>
        </Border>

        <ListBox Grid.Row="2" x:Name="AssetList" Classes="list-page"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 SelectionMode="Single">
          <!--
            行右键菜单 = **针对单条**的动作（§4.8 硬规则 9）：打开 / 定位 / 打开库文件。
            ⛔ 这些⛔ 不上工具条（工具条只放页面级功能：扫描 / 筛选 / 入库 / 清除…）。
            ⚠️ ContextMenu 在独立弹出树 → DataContext 由 code-behind 手工同步（硬规则 3）。
          -->
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📂 打开" Command="{Binding OpenFileCommand}"
                        ToolTip.Tip="用系统默认程序打开（视频=播放 / 书=阅读 / 图=看图）"/>
              <MenuItem Header="📁 打开所在文件夹" Command="{Binding OpenFolderCommand}"
                        ToolTip.Tip="在资源管理器里选中这个文件"/>
              <!--  「🗄 打开库文件」是**库级**操作 → 回工具条（§4.8 硬规则 9），⛔ 不放这儿重复一份  -->
              <Separator/>
              <!--  NT-058：**唯一**直接物理删磁盘文件的入口（破坏性最大 ⇒ 故意只放右键、还要二次确认 + 走任务队列）；
                    ⛔ 不上工具条、⛔ 不进详情卡（想从库里移除文件留着 ⇒ 详情卡图标组的「🗑 移入回收站」）。  -->
              <MenuItem Header="⛔ 从磁盘删除…" Command="{Binding DeleteFromDiskCommand}"
                        ToolTip.Tip="永久删除磁盘文件：不进回收站、不可还原，库里的文件索引一起删"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                <!--  v3.34 / NT-018：勾选列（行首；勾了几个就是几个，语义天然是批量）  -->
                <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsVisible="{Binding $parent[ListBox].DataContext.IsPickVisible}"/>
                <TextBlock Grid.Column="1" Classes="list-cell primary" Text="{Binding Name}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           ToolTip.Tip="{Binding FilePath}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding TypeText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsTypeVisible}"/>
                <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding TagsText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsTagsVisible}"/>
                <TextBlock Grid.Column="4" Classes="list-cell" Text="{Binding CategoriesText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsCategoriesVisible}"/>
                <TextBlock Grid.Column="5" Classes="list-cell" Text="{Binding CollectionsText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsCollectionsVisible}"/>
                <TextBlock Grid.Column="6" Classes="list-cell" Text="{Binding SizeText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsSizeVisible}"/>
                <TextBlock Grid.Column="7" Classes="list-cell" Text="{Binding ModifiedText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsModifiedVisible}"/>
                <TextBlock Grid.Column="8" Classes="list-cell" Text="{Binding StorageName}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsStorageVisible}"/>
                <TextBlock Grid.Column="9" Classes="list-cell" Text="{Binding DurationText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsDurationVisible}"/>
                <TextBlock Grid.Column="10" Classes="list-cell" Text="{Binding ResolutionText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsResolutionVisible}"/>
                <TextBlock Grid.Column="11" Classes="list-cell" Text="{Binding CodecText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsCodecVisible}"/>
              </v:ColumnGrid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
