<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.HostsView">
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="24,16,24,0" Spacing="10">
      <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                 Foreground="{DynamicResource AccentBrush}"/>
    </StackPanel>

    <!-- 工具条 -->
    <Border Grid.Row="1" Classes="toolbar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="primary" Content="➕ 新建方案" Margin="0,0,8,0" Command="{Binding NewProfileCommand}"/>
        <Button Classes="ghost" Content="🔄 刷新" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
        <TextBox Width="300" Margin="0,0,8,0" Text="{Binding ImportUrl, Mode=TwoWay}"
                 PlaceholderText="网络 hosts 文件 URL…" ToolTip.Tip="粘贴一份 hosts 文本文件的网址，点「导入」下载并解析"/>
        <Button Classes="ghost" Content="🌐 导入" Margin="0,0,8,0" Command="{Binding ImportCommand}"
                IsEnabled="{Binding !IsBusy}"/>
        <TextBlock Text="双击应用 = 写入系统 hosts（需管理员）" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </WrapPanel>
    </Border>

    <!-- 主区：左列表 + 右详情 -->
    
    <!--  ==================== 多项筛选  ====================  -->
    <Border Grid.Row="2" Classes="filter-bar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="filter-btn" Content="＋ 条件" Command="{Binding AddFilterCommand}"/>
        <Button Classes="filter-btn" Content="🧹 清空" Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasFilters}"/>
        <TextBlock Classes="hint-text" Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,8,0"/>

        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                <ComboBox Classes="filter-combo"
                          ItemsSource="{Binding $parent[UserControl].DataContext.FilterableColumns}"
                          SelectedItem="{Binding Column, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Classes="filter-combo" ItemsSource="{Binding Operators}"
                          SelectedItem="{Binding OperatorItem, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Classes="filter-value" Text="{Binding Value, Mode=TwoWay}"
                         IsVisible="{Binding NeedsValue}" PlaceholderText="值…"/>
                <Button Classes="filter-btn" Content="✕" Padding="6,2"
                        Command="{Binding $parent[UserControl].DataContext.RemoveFilterCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="16">

      <Border Grid.Column="0" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">

          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" ToolTip.Tip="点一下按名称排序"
                      IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding EntriesHeader}"
                      IsVisible="{Binding IsEntriesVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding SourceHeader}"
                      IsVisible="{Binding IsSourceVisible}"/>
              <!--  详情栏开关：贴在表头右缘，默认只露一条窄边；鼠标靠近右侧热区才弹出  -->
              <Border Grid.Column="3" Classes="detail-hotspot">
                <Button Classes="header-toggle" Command="{Binding ToggleDetailCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情">
                  <Panel>
                    <TextBlock Text="❯" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !IsDetailVisible}"/>
                    <TextBlock Text="❮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsDetailVisible}"/>
                  </Panel>
                </Button>
              </Border>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="名称" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="条目数" ToggleType="CheckBox" IsChecked="{Binding IsEntriesVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Entries"/>
                  <MenuItem Header="来源" ToggleType="CheckBox" IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Source"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="ProfileList" Classes="list-page"
                   ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="▤ 显示详情栏" Command="{Binding ShowDetailCommand}"/>
                <Separator/>
                <MenuItem Header="✅ 应用到系统 hosts" Command="{Binding ApplyCommand}"/>
                <MenuItem Header="📤 导出受管块" Command="{Binding ExportCommand}"/>
                <MenuItem Header="🗑 删除方案" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Entries.Count}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsEntriesVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Source}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 右：详情（编辑 + 应用） -->
      <Border Grid.Column="1" Classes="detail-card"
              IsVisible="{Binding IsDetailVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2" IsVisible="{Binding !HasSelection}">
              <TextBlock Text="在左侧列表里选中一套方案" FontSize="13" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
              <TextBlock Text="方案名称" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Name, Mode=TwoWay}"/>

              <TextBlock Text="条目（每行一条：IP 主机名 # 注释；行首 # 表示禁用）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding EntriesText, Mode=TwoWay}" AcceptsReturn="True" Height="160"
                       TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>

              <!-- ⚠️ Avalonia 的 WrapPanel **没有** Spacing 属性（StackPanel 才有）→ 用按钮 Margin 做间距 -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Content="💾 保存" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                <Button Classes="ghost" Content="✅ 应用" Margin="0,0,6,0" Command="{Binding ApplyCommand}"/>
                <Button Classes="ghost" Content="📤 导出" Margin="0,0,6,0" Command="{Binding ExportCommand}"/>
                <Button Classes="ghost" Content="🗑 删除" Command="{Binding DeleteCommand}"/>
              </WrapPanel>

              <TextBlock Text="无权限写入系统 hosts 时，下方会显示可复制的受管块：" FontSize="11"
                         Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding BlockPreview, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
              <SelectableTextBlock Text="{Binding BlockPreview}" FontFamily="Consolas" FontSize="11"
                                  TextWrapping="Wrap" IsVisible="{Binding BlockPreview, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
