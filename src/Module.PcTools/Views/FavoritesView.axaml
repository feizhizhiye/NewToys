<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.PcTools.Views.FavoritesView">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 操作行（右对齐、无背景条）：页名由左侧二级菜单体现，这里只放状态文字。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="24,16,24,0" Spacing="10">
      <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                 Foreground="{DynamicResource AccentBrush}"/>
    </StackPanel>

    <!-- 说明条 + 入口 -->
    <Border Grid.Row="1" Background="{DynamicResource ContentHeaderBrush}" Padding="24,10"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Grid.Column="1" Classes="ghost" Content="⚙ 打开设置与脚本"
                Command="{Binding OpenShortcutsCommand}"/>
      </Grid>
    </Border>

    <!-- 收藏卡片 -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="还没有收藏任何项 —— 去「设置与脚本」或「快捷设置」里选中一条，右键「★ 添加到收藏夹」。"
                   IsVisible="{Binding IsEmpty}" Margin="8" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- 右键 = 「✕ 取消固定」；菜单在 code-behind 里现场构造并直接挂命令（弹出树取不到父级 DataContext，见规范 3.6）。 -->
              <Border Classes="card" Width="312" Margin="6" Padding="16"
                      ContextRequested="OnCardContextRequested"
                      ToolTip.Tip="右键：运行 / 取消固定">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="★" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                  </StackPanel>

                  <TextBlock Text="{Binding Category}" FontSize="11"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>

                  <Border Background="{DynamicResource CodeBlockBrush}" CornerRadius="6" Padding="8">
                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" MaxHeight="64"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                  </Border>

                  <!-- 简化后只留最基础的「▶ 运行」；取消固定走右键菜单。 -->
                  <Button Classes="primary" Content="▶ 运行" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].DataContext.RunCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].DataContext.IsNotBusy}"
                          ToolTip.Tip="用 cmd 执行这条命令；勾选过「需要管理员权限」的会弹 UAC"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding DataFileHint}" FontSize="11" Margin="8" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
