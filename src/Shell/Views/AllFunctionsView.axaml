<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Views.AllFunctionsView">
  <!--
    功能清单：**按模块分节的列表**（像设置页那样可折叠），一行一个功能。
    ① 顶部工具行：左侧摘要 + 右侧「展开全部 / 折叠全部」；默认全部展开。
    ② 每节 = 可点的模块标题行（▾ 模块名 · 功能数）+ 该节功能行（图标 · 名称 · 简介 · ★）。
    ③ 滚动发生在**本视图内部**（首页只给它一块固定高度），所以首页的欢迎卡与收藏墙不会被推走。
    页头操作行已移入「设置 → 关于」。
  -->
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,10,4">
      <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Grid.Column="1" Classes="ghost" Padding="8,2"
              Command="{Binding ToggleAllCommand}"
              ToolTip.Tip="一次展开 / 折叠所有模块">
        <TextBlock Text="{Binding ToggleAllText}" FontSize="12"/>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,8,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,6">
              <!--  模块标题行（可点折叠）：与功能行同为 26 高，收起后整节只剩这一排  -->
              <Button Classes="list-row"
                      Command="{Binding $parent[UserControl].DataContext.ToggleGroupCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="展开 / 折叠该模块">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Glyph}" FontSize="10" Width="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                        Data="{Binding IconGeometry}" IsVisible="{Binding HasVectorIcon}"
                        Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                  <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"
                             IsVisible="{Binding !HasVectorIcon}"/>
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <TextBlock Text="{Binding Items.Count}" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource PlaceholderTextBrush}"/>
                </StackPanel>
              </Button>

              <!--  该节的功能行：统一 26 高，与列表页密度基线一致  -->
              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="list-row"
                            Tag="{Binding Key}"
                            PointerPressed="OnCardPointerPressed"
                            Command="{Binding $parent[UserControl].DataContext.NavigateCommand}"
                            CommandParameter="{Binding Key}"
                            ToolTip.Tip="{Binding Desc}">
                      <Grid ColumnDefinitions="22,Auto,*,Auto">
                        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Desc}" FontSize="12" Margin="12,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="★" FontSize="12" Margin="4,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentInkBrush}"
                                   IsVisible="{Binding IsFavorite}"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
