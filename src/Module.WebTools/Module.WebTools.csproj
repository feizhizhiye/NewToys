<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NewToys.WebTools</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Jint" />
    <!--  CodePages 编码器（GBK/GB18030）在 net10.0 已随共享框架可用 ⇒ 不显式引用（NU1510）  -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <!--  NT-063：ColumnGrid 等 View 层件来自 NewToys.UI（模块禁互引 / 禁引 Shell ⇒ 控件库是唯一解）  -->
    <ProjectReference Include="../UI/NewToys.UI.csproj" />
  </ItemGroup>
</Project>
