<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.SystemTools.Views.PackageView">
  <!--
    「软件包」页（winget）：列表 + 分页底栏（详情卡由 Shell 承载）。
    列表本体 = <v:TableViewHost>：列显隐 / 排序键按 VM 的 ColumnLayout 对齐（🔴 声明顺序必须一致），
    故骨架的 HeaderArea 不填。

    ⚠️ 批量安装 / 升级 / 卸载的作用域 = **列表选中行**（Ctrl / Shift 多选），
       全选 / 取消 / 反选与「仅看已安装」「筛选」在行右键菜单顶部。
  -->
  <v:ListPageSkeleton EmptyMessage="列表里没有包。点「📋 已安装」加载本机已安装的包，或在上面输入关键字搜索。"
                      EmptyActionText="📥 已安装"
                      EmptyActionCommand="{Binding LoadInstalledCommand}"
                      IsEmpty="{Binding !HasItems}"
                      ShowFooter="{Binding HasFooterContent}"
                      ShowPaging="{Binding HasPaging}"
                      PageCount="{Binding PageCount}"
                      CurrentPage="{Binding PageIndex}"
                      JumpToPageCommand="{Binding GoToPageCommand}"
                      TotalCount="{Binding TotalCount}"
                      PageText="{Binding PageText}"
                      FirstCommand="{Binding FirstPageCommand}"
                      PrevCommand="{Binding PrevPageCommand}"
                      NextCommand="{Binding NextPageCommand}"
                      LastCommand="{Binding LastPageCommand}"
                      PageSizes="{Binding PageSizeChoices}"
                      PageSize="{Binding PageSize, Mode=TwoWay}">

    <v:ListPageSkeleton.ListArea>
          <v:TableViewHost x:Name="PkgList"
                           ItemsSource="{Binding Packages}"
                           SelectedItem="{Binding Selected, Mode=TwoWay}"
                           SelectedItems="{Binding BatchSelection}"
                           SelectionMode="Multiple">
            <!-- 右键菜单：这是「选中后更多功能」的主入口（菜单项作用对象 = 当前选中行）：
                 查（▤ 详情栏 / 🔎 详情 / 🌐 主页 / 🔗 在线索引）/ 增（⬇ 安装）/ 改（⬆ 升级 / 🔒 锁定）/ 删（🗑 卸载）。 -->
            <v:TableViewHost.ContextMenu>
              <ContextMenu>
                <MenuItem Header="☑ 全选当前页" Command="{Binding ToggleAllCommand}"/>
                <MenuItem Header="☐ 取消选择" Command="{Binding SelectNoneCommand}"/>
                <MenuItem Header="⇄ 反选当前页" Command="{Binding InvertSelectionCommand}"/>
                <Separator/>
                <MenuItem Header="仅看已安装" Command="{Binding ToggleInstalledOnlyCommand}"
                          ToolTip.Tip="只留本机已安装的"/>
                <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                  <MenuItem.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Setter Property="Header" Value="{Binding Label}"/>
                      <Setter Property="Command" Value="{Binding Command}"/>
                    </ControlTheme>
                  </MenuItem.ItemContainerTheme>
                </MenuItem>
                <Separator/>
                <MenuItem Header="⬇ 安装" Command="{Binding InstallCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="⬆ 升级到最新" Command="{Binding UpgradeCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="🗑 卸载…" Command="{Binding UninstallCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Separator/>
                <MenuItem Header="🔒 锁定版本（暂停更新）" Command="{Binding PinCommand}" IsEnabled="{Binding !IsBusy}"/>
                <MenuItem Header="🔒 解除锁定" Command="{Binding UnpinCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Separator/>
                <MenuItem Header="🔎 读取详情" Command="{Binding LoadDetailCommand}"/>
                <MenuItem Header="📋 复制 Id" Command="{Binding CopyIdCommand}"/>
                <MenuItem Header="🌐 打开主页" Command="{Binding OpenHomepageCommand}"/>
                <MenuItem Header="🔗 在 winget.run 查看" Command="{Binding OpenInWingetRunCommand}"/>
              </ContextMenu>
            </v:TableViewHost.ContextMenu>

            <v:TableViewHost.Columns>
              <TableViewColumn Width="3*">
                <TableViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Classes="list-cell primary" Text="{Binding Name}"/>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>

              <TableViewColumn Width="3.6*" Binding="{Binding Id}"/>

              <TableViewColumn Width="1.3*">
                <TableViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Classes="list-cell primary" Text="{Binding Version}"/>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>

              <TableViewColumn Width="1.1*" Binding="{Binding Source}"/>
              <TableViewColumn Width="1.5*" Binding="{Binding StatusText}"/>
            </v:TableViewHost.Columns>
          </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
