<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Controls"
             x:Class="NewToys.MediaAssets.Views.SettingsMediaAssetsView">
  <!--
    「媒体资产」模块设置页（NT-021，自注册进 settings 分组，Order 100）。
    🔴 NT-068（2026-10-18）：改用与应用级设置页同一套骨架 <ui:SettingsSectionHost>（节 = 折叠卡片 + 磁吸抬头）。
       本页有 7 节、内容长 ⇒ 保留 `Sticky`（默认 true）：抬头磁吸 + 「全部收起」一屏总览，与应用级设置页同观感。
       节内⛔ 再写 Border.card（卡片由节自己提供）。
    规范 §4.9：开关 / 数值 / 路径 = 即时生效（⛔ 无保存按钮）；多行文本（忽略规则 / 命名模板）= 显式 💾 保存。
    状态文本由 Shell 底部状态栏统一显示（IStatusProvider）。

    ⚠️ 节内容 = `<UserControl.Resources>` 里的 `SecN` 面板；节元数据（标题/图标/说明）在 code-behind 的 `Add(...)`。
      （⛔ 不要在 XAML 里直接写 `<ui:SettingsSection>`：该页会不被预编译 ⇒ 运行时 `No precompiled XAML found`。）
  -->

  <UserControl.Resources>
    <StackPanel x:Key="Sec0" Spacing="10">
      <StackPanel Spacing="10">
        <CheckBox Content="忽略隐藏文件 / 目录" IsChecked="{Binding IgnoreHiddenFiles, Mode=TwoWay}" />
        <CheckBox Content="忽略临时文件（.tmp / .part / ~$* 等）" IsChecked="{Binding IgnoreTempFiles, Mode=TwoWay}" />

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="quick_hash 采样大小（MB，0 = 不算）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="120" Text="{Binding QuickHashSampleMb, Mode=TwoWay}" />
            <TextBlock
                Classes="hint-text"
                VerticalAlignment="Center"
                Text="越大越准、扫描越慢；首次扫描只读文件信息、不读内容" />
          </StackPanel>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="忽略的扩展名（逗号 / 分号分隔）" />
          <TextBox
              MinHeight="44"
              Text="{Binding IgnoreExtensions, Mode=TwoWay}"
              TextWrapping="Wrap"
              AcceptsReturn="True" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="忽略的目录名（按目录名匹配，⛔ 不是路径片段）" />
          <TextBox
              MinHeight="44"
              Text="{Binding IgnoreDirectories, Mode=TwoWay}"
              TextWrapping="Wrap"
              AcceptsReturn="True" />
        </StackPanel>

        <Button
            Classes="primary"
            HorizontalAlignment="Left"
            Command="{Binding SaveTextSettingsCommand}"
            Content="💾 保存忽略规则"
            ToolTip.Tip="把上面的忽略规则 / 命名模板 / 冲突策略一次写全（即时生效项无需保存）" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec1" Spacing="10">
      <StackPanel Spacing="10">
        <CheckBox Content="扫描到新文件时自动提取元数据（视频 = ffprobe；图片 = 读尺寸）" IsChecked="{Binding AutoExtractMetadata, Mode=TwoWay}" />
        <CheckBox Content="扫描到新文件时自动生成缩略图（视频抽帧 / 图片缩放）" IsChecked="{Binding AutoGenerateThumbnails, Mode=TwoWay}" />

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="读媒体信息的并发数（1~16）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="120" Text="{Binding ProbeConcurrency, Mode=TwoWay}" ToolTip.Tip="同时跑几个 ffprobe 进程；太高会把磁盘 IO 拖慢，一般 4 即可" />
            <TextBlock Classes="hint-text" VerticalAlignment="Center"
                       Text="每个视频要起一个 ffprobe 进程 —— 太大会把磁盘 IO 拖成瓶颈。"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="视频抽帧位置" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox Width="160" ItemsSource="{Binding FrameModeOptions}" SelectedItem="{Binding SelectedFrameModeOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
                Width="90"
                IsVisible="{Binding IsFramePercentMode}"
                Text="{Binding ThumbFramePercent, Mode=TwoWay}"
                ToolTip.Tip="百分比 0~100" />
            <TextBox
                Width="90"
                IsVisible="{Binding IsFrameSecondsMode}"
                Text="{Binding ThumbFrameSeconds, Mode=TwoWay}"
                ToolTip.Tip="秒" />
          </StackPanel>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="缩略图尺寸（长边像素，只缩不放）" />
          <TextBox Width="120" Text="{Binding ImageThumbSize, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="缩略图目录（留空 = 默认）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="320" PlaceholderText="留空 = cache\assets\thumbs" Text="{Binding ThumbsDirectory, Mode=TwoWay}" />
            <Button Classes="ghost" Content="📂 选目录…" Click="OnPickThumbsDirClick" />
            <Button
                Classes="ghost"
                Command="{Binding ResetDefaultsCommand}"
                Content="↺ 用默认"
                ToolTip.Tip="全部恢复默认设置" />
          </StackPanel>
          <TextBlock
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding ThumbsDirectoryEffective, StringFormat='生效目录：{0}'}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec2" Spacing="10">
      <StackPanel Spacing="10">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="占位符：{title}（显示名）/ {name}（文件名）/ {year}（年份，若有）/ {ext}（扩展名）。模板在重命名功能落地后启用。" />

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="视频" />
          <TextBox Text="{Binding NameTemplateVideo, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="音乐" />
          <TextBox Text="{Binding NameTemplateMusic, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="书籍" />
          <TextBox Text="{Binding NameTemplateBook, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="图片" />
          <TextBox Text="{Binding NameTemplateImage, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="重命名冲突策略" />
          <ComboBox Width="220" ItemsSource="{Binding ConflictOptions}" SelectedItem="{Binding SelectedConflictOption, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <Button
            Classes="primary"
            HorizontalAlignment="Left"
            Command="{Binding SaveTextSettingsCommand}"
            Content="💾 保存模板与规则" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec3" Spacing="10">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="保留天数（超过即过期）" />
          <TextBox Width="120" Text="{Binding TrashRetentionDays, Mode=TwoWay}" />
        </StackPanel>

        <CheckBox Content="到期自动清理（开启后：启动时自动把过期资产永久删除）" IsChecked="{Binding AutoCleanupTrash, Mode=TwoWay}" />
        <TextBlock
            Classes="hint-text"
            Margin="26,0,0,0"
            TextWrapping="Wrap"
            Text="⚠️ 自动清理会真删磁盘文件（⛔ 不进回收站、无法还原）。默认关闭；清理过程在「任务中心」可见、可取消。" />

        <Button
            Classes="ghost"
            HorizontalAlignment="Left"
            Command="{Binding CleanupTrashNowCommand}"
            Content="🧹 立即清理过期回收站"
            ToolTip.Tip="把超过保留天数的资产排进永久删除队列（二次确认）" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec4" Spacing="10">
      <StackPanel Spacing="10">
        <CheckBox Content="删除默认送系统回收站（可还原）" IsChecked="{Binding DeleteToRecycleBin, Mode=TwoWay}" />
        <CheckBox
            Content="破坏性物理操作前二次确认（强制开启，⛔ 不可关）"
            IsChecked="{Binding ConfirmBeforeOperation, Mode=OneWay}"
            IsEnabled="False" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec5" Spacing="10">
      <StackPanel Spacing="10">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            IsVisible="{Binding !HasImportExportDir}"
            Text="当前配置档的 store 目录尚未就绪，导入 / 导出对话框将用系统默认位置。" />
        <TextBlock
            Classes="field-value"
            IsVisible="{Binding HasImportExportDir}"
            Text="{Binding ImportExportDefaultDir, StringFormat='默认目录：{0}'}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="列表的 JSON 导入 / 导出、「导出用户数据」的文件选择器都会定位到这个目录。" />

        <Border Classes="divider-line" />

        <!--  用户手动数据（标签 / 分类 / 集合 / 关联）—— 它们落在本模块库 store\assets\assets.db，
              导出成 config\media-assets-user-data.json 才能进「数据管理」的备份（R1 缓解）。  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="用户手动数据（标签 / 分类 / 集合 / 关联）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Classes="primary"
                Command="{Binding ExportUserDataCommand}"
                Content="📤 导出用户数据"
                ToolTip.Tip="写到 config\media-assets-user-data.json（随「数据管理」备份一起走）" />
            <Button
                Classes="ghost"
                Click="OnRestoreUserDataClick"
                Content="📥 恢复用户数据…"
                ToolTip.Tip="选一个导出的 json 合并恢复（缺的才建，⛔ 不覆盖）" />
          </StackPanel>
          <TextBlock
              FontFamily="Consolas"
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding UserDataFilePath}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec6" Spacing="10">
      <StackPanel Spacing="6">
        <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Text="{Binding ConfigFilePath}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="它在 config 目录下 —— 「设置 → 数据」的备份 / 导入会覆盖它。音乐 / 书籍 / 文档的元数据提取（需要第三方库）本轮未做，⛔ 未擅引。" />
      </StackPanel>
    </StackPanel>
  </UserControl.Resources>

  <ui:SettingsSectionHost x:Name="Host" />
</UserControl>
