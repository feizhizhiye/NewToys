<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.MediaAssets.Views.Detail.TrashDetailView">
  <!--
    NT-019 回收站详情卡：资产信息 + 受影响文件位置列表 + 恢复 / 永久删除。
    ⚠️ 外壳（340px 宽 / 背景 / 左边线）由 **Shell 的右详情列**提供，⛔ 这里不套 Border.detail-card。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="10">

      <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !ShowDetailBody}"
                 Text="在左侧列表里选中一个资产，这里显示它的详情。"/>

      <StackPanel Spacing="10" IsVisible="{Binding ShowDetailBody}">

        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="名称"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.Name}" TextWrapping="Wrap"/>

          <TextBlock Classes="field-label" Text="状态"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.StatusText}"/>

          <TextBlock Classes="field-label" Text="类型"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.TypeText}"/>

          <TextBlock Classes="field-label" Text="大小"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.SizeText}"/>

          <TextBlock Classes="field-label" Text="修改时间"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.ModifiedText}"/>

          <TextBlock Classes="field-label" Text="存储源"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.StorageName}"/>

          <TextBlock Classes="field-label" Text="删除时间"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.UpdatedAtText}"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 受影响的文件位置（永久删除会真删这些） =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="文件位置（永久删除会真删这些）"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasLocations}"
                     Text="（这个资产没有登记任何文件位置）"/>
          <ItemsControl ItemsSource="{Binding Locations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,6">
                  <!--  ⚠️ FileLocation 的属性就叫 Path → **必须写 `Path=Path`**（简写会被当成给 Binding.Path 赋值）  -->
                  <SelectableTextBlock Classes="field-value" Text="{Binding Path=Path}" TextWrapping="Wrap"/>
                  <TextBlock Classes="hint-text" Text="{Binding Status}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 两个动作（v3.29 定调：详情卡允许「编辑 + 保存」这类卡内动作，⛔ 只是别放无关的全局动作） =====  -->
        <Button Classes="primary" Content="♻ 恢复" Command="{Binding RestoreCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="改回「正常」状态（⛔ 只改库里的状态，磁盘文件本来就还在）"/>
        <Button Classes="danger-btn" Content="🗑 永久删除" Command="{Binding PurgeSelectedCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="真删磁盘文件 + 删索引行（二次确认；⛔ 不进回收站、无法还原）"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
