<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Controls"
             x:Class="NewToys.WebTools.Views.SettingsWebToolsView">
  <!--
    「网页工具」模块设置页（v3.64 / NT-061，自注册进 settings 分组，Key = settings-web-tools / Order 130）。
    🔴 NT-068（2026-10-18）：**改用与应用级设置页同一套骨架** <ui:SettingsSectionHost> ——
       每节 = 折叠卡片（⌄ + 图标 + 标题 + 说明），样式 / 间距 / 页根底色全由宿主给。
       模块页只有 2 节 ⇒ `Sticky="False"`：⛔ 不挂磁吸浮层、⛔ 不滚动自动展开，只保留点抬头开收。
       节内容⛔ 再写 Border.card（卡片由节自己提供），直接放字段。
    规范 §4.9：路径 / 数值 / 文本 = 即时生效（失焦即落盘，⛔ 无保存按钮）。

    ⚠️ 节内容 = `<UserControl.Resources>` 里的 `SecN` 面板；节元数据（标题/图标/说明）在 code-behind 的 `Add(...)`。
      （⛔ 不要在 XAML 里直接写 `<ui:SettingsSection>`：该页会不被预编译 ⇒ 运行时 `No precompiled XAML found`。）
  -->

  <UserControl.Resources>
    <StackPanel x:Key="Sec0" Spacing="10">
      <StackPanel Spacing="10">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="抓取任务若没填自己的 UA / 超时，就用这里的默认值（个别任务在它的详情卡里单独填）。" />

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="默认 User-Agent（留空 = 恢复内置）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox
                Width="440"
                PlaceholderText="留空 = 用内置的 Chrome UA"
                Text="{Binding DefaultUserAgent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <Button
                Classes="ghost"
                Content="↺ 恢复内置"
                Command="{Binding ResetUserAgentCommand}" />
          </StackPanel>
          <TextBlock
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding EffectiveUserAgent, StringFormat='生效值：{0}'}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="单次抓取超时（秒）" />
          <TextBox Width="120" Text="{Binding ScrapeTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding TimeoutHint}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec2" Spacing="10">
      <TextBlock
          Classes="hint-text"
          TextWrapping="Wrap"
          Text="只影响「Hosts 管理」页的检测与应用，不改系统 hosts 文件本身；四项都是失焦即生效。" />

      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="检测单条超时（秒）" />
        <TextBox Width="120" Text="{Binding HostsCheckTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="检测并发数" />
        <TextBox Width="120" Text="{Binding HostsCheckConcurrency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="备份保留份数（超出删最旧）" />
        <TextBox Width="120" Text="{Binding HostsBackupKeep, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>

      <CheckBox Content="应用方案后自动刷新 DNS 缓存（ipconfig /flushdns）" IsChecked="{Binding HostsFlushDns, Mode=TwoWay}" />

      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding HostsRangesHint}" />
    </StackPanel>

    <StackPanel x:Key="Sec3" Spacing="10">
      <TextBlock
          Classes="hint-text"
          TextWrapping="Wrap"
          Text="「Hosts 管理」页右侧「⬇ 拉取」用的就是这里列出的开源 hosts 项目。预设源也可以删（删了不会自己回来）；新建的源填名称 + 地址，多个地址用空格分隔（第一个是主地址，其余是镜像，按顺序试）。" />

      <ListBox Height="170" MinWidth="0"
               ItemsSource="{Binding HostSources}"
               SelectedItem="{Binding SelectedHostSource, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="220,*" Height="28">
              <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Display}" />
              <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Hint}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="➕ 新建" Command="{Binding AddHostSourceCommand}"
                ToolTip.Tip="新建一个开源 hosts 项目源" />
        <Button Classes="ghost" Content="✏ 编辑" Command="{Binding EditHostSourceCommand}"
                IsEnabled="{Binding HasHostSourceSelection}"
                ToolTip.Tip="改名称 / 地址（预设源也能改）" />
        <Button Classes="ghost" Content="🗑 删除" Command="{Binding DeleteHostSourceCommand}"
                IsEnabled="{Binding HasHostSourceSelection}"
                ToolTip.Tip="只删源清单，已拉取的方案不受影响" />
        <Button Classes="ghost" Content="⬇ 测试拉取" Command="{Binding TestHostSourceCommand}"
                IsEnabled="{Binding HasHostSourceSelection}"
                ToolTip.Tip="按地址逐个试一次，报条目数（⛔ 不写方案、不动系统 hosts）" />
      </StackPanel>

      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding HostSourceHint}" />
      <TextBlock Classes="hint-text" Text="还没有源：点「➕ 新建」填名称和地址。" IsVisible="{Binding !HasHostSources}" />
    </StackPanel>

    <StackPanel x:Key="Sec1" Spacing="10">
      <StackPanel Spacing="6">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="网址收藏 / 网络 Ping / Hosts 方案的清单数据不在本文件里 —— 它们落本模块库 store\web\web.db 的 web_docs 表（bookmarks / ping-targets / hosts-profiles / hosts-sources），由各自页面维护；系统 hosts 的备份在 store\web\hosts-backup\ 下。" />
        <Border Classes="divider-line" />
        <TextBlock Classes="field-label" Text="设置文件" />
        <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Text="{Binding ConfigFilePath}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="它在 config 目录下 —— 「设置 → 数据」的备份 / 导入会一起覆盖它。两个默认值原先硬编码在程序里，现在落在这里可手改。" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="{Binding StatusText, StringFormat='状态：{0}'}" />
      </StackPanel>
    </StackPanel>
  </UserControl.Resources>

  <ui:SettingsSectionHost x:Name="Host" Sticky="False" />
</UserControl>
