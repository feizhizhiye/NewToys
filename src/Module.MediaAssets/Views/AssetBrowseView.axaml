<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:views="using:NewToys.MediaAssets.Views"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.MediaAssets.Views.AssetBrowseView">
  <!--
    「资产浏览」页（需求 §6.6.1）—— 资源管理器形态：左目录树 + 右「图标卡 / 详细信息」双视图。

    🔴 与「全部资产」的分工：那边按**元数据**找（搜索 / 标签 / 筛选），这里按**磁盘位置**翻。
    🔴 数据来源 = **磁盘实时枚举**：树是盘符 / 共享根 + 逐层子目录（展开才读，⛔ 不递归），
       右侧是当前目录的真实内容（子目录 + 全部文件）；索引只用来叠加「是否已入库」。
       未入库的条目**标灰但仍可打开 / 定位**，库操作点了会给提醒（先「加入资产库」）。
    🔴 树是**自绘**（ListBox + Button.tree-row + 按 Depth 扁平化，⛔ 不用 TreeView）—— 与分类页同一套路。
    🔴 树的**顶级是盘符 / 共享根**（资源管理器口径：源不占层级）——建树在 AssetBrowseService。
    🔴 右列沿用列表页骨架（顶区 / 表头 / 列表 / 空态 / 底栏）；两套视图共用 VM 的 Items，
       只切 IsVisible —— ⛔ 不要为两套视图各存一份数据（选中 / 详情会打架）。
  -->
  <UserControl.Styles>
    <!--  本页专用：树节点行 + 面包屑 + 图标卡（页面专用样式写在页面里，⛔ 不往全局加）  -->
    <Style Selector="Button.tree-row">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="Button.tree-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <Style Selector="Button.tree-row.selected">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!--
      左树容器：ListBox 自带 VirtualizingStackPanel + ScrollViewer。
      🔴 别换回 ItemsControl + StackPanel —— 那是不虚拟化的，节点一多（几百个目录）
      首屏就要为每一项建 Button 容器，进页面会白等几秒。
      容器底色/hover 全清空：高亮画在 Button.tree-row 自己身上（与图标卡同一套路）。
    -->
    <Style Selector="ListBox#TreeList">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox#TreeList ListBoxItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox#TreeList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#TreeList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.crumb">
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="Button.crumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>

    <!--  筛选按钮激活态：只换描边 / 文字色，⛔ 不给文案加 `✓` 之类前缀（会撑宽导致换行）。  -->
    <Style Selector="Button.ghost.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
    </Style>
    <Style Selector="Button.ghost.active:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>

    <Style Selector="Border.tile">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    </Style>

    <!--
      图标卡的选中 / 悬停高亮：**画在卡片自己身上**，不画在列表项容器上。
      🔴 应用级样式把高亮放在 `ListBoxItem /template/ ContentPresenter#PART_ContentPresenter` 的
      Background 上（`ListBox.list-page` 那两条）—— 那是**直角矩形**，而卡片自带 6px 圆角 + 外边距
      ⇒ 选中时强调色会从圆角与卡片边缘漏出来（用户实测：左上圆角、右下边缘露色）。
      这里把本列表的容器底色清空，改由卡片边框 / 底色表达选中态。
    -->
    <Style Selector="ListBox#TileList ListBoxItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="ListBox#TileList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#TileList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#TileList ListBoxItem:pointerover Border.tile">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <Style Selector="ListBox#TileList ListBoxItem:selected Border.tile">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!--  ==================== 左：目录树（可整体收起）  ====================  -->
    <Border Grid.Column="0" Width="240" Margin="8,8,6,8"
            IsVisible="{Binding IsTreeVisible}"
            Padding="0,0,6,0">
      <Grid RowDefinitions="Auto,*">
        <!--  两个动作必须并排一行（240px 树宽内）：文案已收短，沿用 `ghost` 默认字号 / 内边距即可不换行。  -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
          <Button Classes="ghost" Content="{Binding ExpandAllText}" Command="{Binding ToggleExpandAllCommand}"
                  ToolTip.Tip="展开 / 折叠已读取的层级"/>
          <Button Classes="ghost" Classes.active="{Binding OnlyLibrary}" Content="已加入资产库"
                  Command="{Binding ToggleOnlyLibraryCommand}"
                  ToolTip.Tip="左树只显示已加入资产库的目录"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,6,0,0">
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding ShowNoDiskHint}"
                     Text="没有可浏览的磁盘 / 共享目录。"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding ShowLibraryEmptyHint}"
                     Text="还没有已加入资产库的目录。关掉筛选，右键一个磁盘目录 → 加入资产库。"/>
          <ListBox x:Name="TreeList" ItemsSource="{Binding TreeNodes}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Icon="＋" Header="入库" Command="{Binding AddContextNodeToLibraryCommand}"
                          IsEnabled="{Binding CanAddContextNodeToLibrary}"
                          ToolTip.Tip="把右键的这个目录递归加入资产库（所在目录已在库里 ⇒ 整行不标灰，菜单项不可用）"/>
                <MenuItem Header="重新扫描此目录" Icon="{m:Glyph IconRefresh}" Command="{Binding RescanContextNodeCommand}"
                          IsEnabled="{Binding CanRescanContextNode}"
                          ToolTip.Tip="把这个目录里还没入库的文件补进来（已入库的按路径去重，不会重复索引）"/>
                <Separator/>
                <MenuItem Header="重命名目录源…" Icon="{m:Glyph IconEdit}" Command="{Binding RenameContextNodeStorageCommand}"
                          ToolTip.Tip="只改库里的显示名（「全部资产」的「存储源」列），⛔ 不动磁盘目录名"/>
                <MenuItem Header="目录源类型" Icon="{m:Glyph IconOpen}" IsEnabled="{Binding CanOperateContextStorage}"
                          ToolTip.Tip="{Binding ContextStorageSummary}">
                  <MenuItem Header="本地磁盘" ToggleType="Radio" GroupName="StorageType"
                            IsChecked="{Binding IsContextStorageLocal, Mode=OneWay}"
                            Command="{Binding SetContextStorageTypeCommand}" CommandParameter="local"/>
                  <MenuItem Header="移动硬盘" ToggleType="Radio" GroupName="StorageType"
                            IsChecked="{Binding IsContextStorageRemovable, Mode=OneWay}"
                            Command="{Binding SetContextStorageTypeCommand}" CommandParameter="removable"/>
                  <MenuItem Header="NAS / 网络共享" ToggleType="Radio" GroupName="StorageType"
                            IsChecked="{Binding IsContextStorageNas, Mode=OneWay}"
                            Command="{Binding SetContextStorageTypeCommand}" CommandParameter="nas"/>
                </MenuItem>
                <MenuItem Header="{Binding ContextOnlineMenuText}" Command="{Binding ToggleContextStorageOnlineCommand}"
                          IsEnabled="{Binding CanOperateContextStorage}"
                          ToolTip.Tip="下线 = 扫描跳过它（其下文件不会被标成丢失）；重新上线后再扫描即校准"/>
                <MenuItem Header="移出资产库…" Icon="{m:Glyph IconTrash}" Command="{Binding RemoveContextNodeFromLibraryCommand}"
                          ToolTip.Tip="只删这个目录的索引（文件位置），⛔ 不动磁盘文件"/>
                <MenuItem Header="扫描全部已入库" Icon="{m:Glyph IconRefresh}" Command="{Binding ScanAllLibraryCommand}"
                          ToolTip.Tip="把所有已登记目录扫一遍（增量，进度在任务中心）"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Button Classes="tree-row" Classes.selected="{Binding IsSelected}"
                        Margin="{Binding Indent}"
                        Opacity="{Binding RowOpacity}"
                        ToolTip.Tip="{Binding ToolTipText}"
                        Command="{Binding $parent[UserControl].DataContext.SelectNodeCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Arrow}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HintText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding PendingText}" FontSize="12" VerticalAlignment="Center"
                               IsVisible="{Binding HasPending}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               ToolTip.Tip="这个目录里有还没加入资产库的文件 —— 右键「重新扫描此目录」补进来"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Border>

    <!--  ==================== 右：面包屑 + 双视图 + 底栏（列表页骨架）  ====================  -->
    <v:ListPageSkeleton Grid.Column="1"
                        EmptyMessage="{Binding EmptyText}"
                        IsEmpty="{Binding !HasItems}"
                        ShowFooter="{Binding HasFooterContent}"
                        TotalCount="{Binding TotalCount}"
                        SelectedCount="{Binding SelectedCount}"
                        PageText="{Binding PageText}"
                        ShowPaging="{Binding HasPaging}"
                        PageCount="{Binding PageCount}"
                        CurrentPage="{Binding PageIndex}"
                        JumpToPageCommand="{Binding GoToPageCommand}"
                        FirstCommand="{Binding FirstPageCommand}"
                        PrevCommand="{Binding PrevPageCommand}"
                        NextCommand="{Binding NextPageCommand}"
                        LastCommand="{Binding LastPageCommand}"
                        PageSizes="{Binding PageSizeChoices}"
                        PageSize="{Binding PageSize, Mode=TwoWay}">

      <!--  顶区：面包屑（每段可点）  -->
      <v:ListPageSkeleton.TopArea>
        <Border Classes="filter-bar">
          <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Classes="crumb" Content="{Binding Label}"
                          IsEnabled="{Binding IsNavigable}"
                          Command="{Binding $parent[UserControl].DataContext.GoCrumbCommand}"
                          CommandParameter="{Binding}"/>
                  <TextBlock Text="›" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </v:ListPageSkeleton.TopArea>

      <!--  表头：仅「详细信息」视图显示（图标卡视图由骨架把这一行压成 0 高）  -->
      <v:ListPageSkeleton.HeaderArea>
        <Border Classes="list-header" IsVisible="{Binding !IsTileView}">
          <v:ColumnGrid x:Name="HeaderGrid"
                        ColumnSpecs="{Binding VisibleColumnSpecs}"
                        IsResizable="True"
                        LockedColumns="{Binding LockedColumnMask}"
                        SampleSpecs="{Binding SampleSpecs}">
            <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Name" IsVisible="{Binding IsNameVisible}"/>
            <Button Grid.Column="1" Classes="col-header" Content="{Binding TypeHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Type" IsVisible="{Binding IsTypeVisible}"/>
            <Button Grid.Column="2" Classes="col-header" Content="{Binding TagsHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Tags" IsVisible="{Binding IsTagsVisible}"/>
            <Button Grid.Column="3" Classes="col-header" Content="{Binding CategoriesHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Categories" IsVisible="{Binding IsCategoriesVisible}"/>
            <Button Grid.Column="4" Classes="col-header" Content="{Binding CollectionsHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Collections" IsVisible="{Binding IsCollectionsVisible}"/>
            <Button Grid.Column="5" Classes="col-header" Content="{Binding SizeHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Size" IsVisible="{Binding IsSizeVisible}"/>
            <Button Grid.Column="6" Classes="col-header" Content="{Binding ModifiedHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Modified" IsVisible="{Binding IsModifiedVisible}"/>
            <Button Grid.Column="7" Classes="col-header" Content="{Binding StorageHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Storage" IsVisible="{Binding IsStorageVisible}"/>
            <Button Grid.Column="8" Classes="col-header" Content="{Binding DurationHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Duration" IsVisible="{Binding IsDurationVisible}"/>
            <Button Grid.Column="9" Classes="col-header" Content="{Binding ResolutionHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Resolution" IsVisible="{Binding IsResolutionVisible}"/>
            <Button Grid.Column="10" Classes="col-header" Content="{Binding CodecHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Codec" IsVisible="{Binding IsCodecVisible}"/>
            <Button Grid.Column="11" Classes="col-header" Content="{Binding BitrateHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Bitrate" IsVisible="{Binding IsBitrateVisible}"/>

            <v:ColumnGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="名称" IsEnabled="False" ToggleType="CheckBox"
                          IsChecked="{Binding IsNameVisible, Mode=OneWay}" ToolTip.Tip="标识列固定显示，不可隐藏"/>
                <MenuItem Header="类型" ToggleType="CheckBox" IsChecked="{Binding IsTypeVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Type"/>
                <MenuItem Header="标签" ToggleType="CheckBox" IsChecked="{Binding IsTagsVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Tags"/>
                <MenuItem Header="分类" ToggleType="CheckBox" IsChecked="{Binding IsCategoriesVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Categories"/>
                <MenuItem Header="集合" ToggleType="CheckBox" IsChecked="{Binding IsCollectionsVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Collections"/>
                <MenuItem Header="大小" ToggleType="CheckBox" IsChecked="{Binding IsSizeVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Size"/>
                <MenuItem Header="修改时间" ToggleType="CheckBox" IsChecked="{Binding IsModifiedVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Modified"/>
                <MenuItem Header="存储源" ToggleType="CheckBox" IsChecked="{Binding IsStorageVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Storage"/>
                <MenuItem Header="时长" ToggleType="CheckBox" IsChecked="{Binding IsDurationVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Duration"/>
                <MenuItem Header="分辨率" ToggleType="CheckBox" IsChecked="{Binding IsResolutionVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Resolution"/>
                <MenuItem Header="编码" ToggleType="CheckBox" IsChecked="{Binding IsCodecVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Codec"/>
                <MenuItem Header="码率" ToggleType="CheckBox" IsChecked="{Binding IsBitrateVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Bitrate"/>
              </ContextMenu>
            </v:ColumnGrid.ContextMenu>
          </v:ColumnGrid>
        </Border>
      </v:ListPageSkeleton.HeaderArea>

      <v:ListPageSkeleton.ListArea>
        <Panel>
          <!--  ① 图标卡视图：WrapPanel 换行；缩略图**按可视区懒解码**（VM.ReportViewport），
               容器数上限 = 当前页 ⇒ 大目录靠分页把容器量与解码量一起压住  -->
          <ListBox x:Name="TileList" Classes="list-page" SelectionMode="Multiple"
                   IsVisible="{Binding IsTileView}"
                   ItemsSource="{Binding TileSource}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Icon="＋" Header="入库" Command="{Binding AddToLibraryCommand}"
                          ToolTip.Tip="把选中的文件 / 文件夹加入资产库（文件夹递归扫描）；已在库里的自动跳过"/>
                <Separator/>
                <MenuItem Header="打开" Icon="{m:Glyph IconOpen}" Command="{Binding OpenSelectedCommand}"
                          ToolTip.Tip="用系统默认程序打开（文件夹 = 进入）；也可以双击卡片"/>
                <MenuItem Header="所在目录" Icon="{m:Glyph IconOpen}" Command="{Binding OpenFolderSelectedCommand}"
                          ToolTip.Tip="在资源管理器里定位它（未入库的项也能用）"/>
                <MenuItem Icon="➡" Header="发送到视频列表" Command="{Binding SendToVideoToolsCommand}"
                          ToolTip.Tip="把选中的视频送去「视频工具 → 视频列表」（非视频自动跳过；未入库的也能发）"/>
                <Separator/>
                <MenuItem Header="重命名…" Icon="{m:Glyph IconEdit}" Command="{Binding RenameSelectedCommand}"
                          ToolTip.Tip="真改磁盘文件名（走任务队列 + 日志先行；同名冲突按「追加序号」，⛔ 不覆盖）"/>
                <MenuItem Header="重命名" Icon="{m:Glyph IconEdit}" Command="{Binding BatchRenameSelectedCommand}"
                          ToolTip.Tip="选中 ≥2 个已入库文件后按规则改名（查找替换 / 前缀后缀 / 编号 / 大小写），先看预览再确认"/>
                <MenuItem Header="移回收站" Icon="{m:Glyph IconTrash}" Command="{Binding TrashSelectedCommand}"
                          ToolTip.Tip="只改库里的状态，⛔ 不动磁盘文件；回收站里能恢复"/>
                <MenuItem Header="移除" Icon="{m:Glyph IconTrash}" Command="{Binding RemoveFromLibraryCommand}"
                          ToolTip.Tip="只删索引（文件留着）；清理重复行的正确手段"/>
                <MenuItem Header="从磁盘删除…" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteFromDiskCommand}"
                          ToolTip.Tip="永久删除磁盘文件：不进回收站、不可还原"/>
                <Separator/>
                <MenuItem Header="全选当前页" Icon="{m:Glyph IconCheckAll}" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="取消选择" Icon="{m:Glyph IconUncheckAll}" Command="{Binding SelectNoneCommand}"/>
                <MenuItem Header="反选当前页" Icon="{m:Glyph IconInvert}" Command="{Binding InvertSelectionCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="tile" Width="{Binding Width}"
                        Opacity="{Binding RowOpacity}">
                  <StackPanel Spacing="4">
                    <Border Height="{Binding ThumbHeight}" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ContentBrush}">
                      <Panel>
                        <!--  缩略图缺失 / 还没解码 / 解码失败 ⇒ 类型占位（⛔ 不弹窗、⛔ 不抛）  -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"
                                    IsVisible="{Binding !HasThumb}">
                          <Path Data="{DynamicResource IconMediaAssets}" Width="26" Height="26"
                                Stretch="Uniform" Stroke="{DynamicResource SecondaryTextBrush}"
                                StrokeThickness="1.2" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding TypeText}" FontSize="12" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" IsVisible="{Binding HasThumb}"/>
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding SubText}" FontSize="12" MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!--  ② 详细视图：与「全部资产」同一套列（列定义共享 AssetColumns）  -->
          <ListBox x:Name="DetailList" Classes="list-page" SelectionMode="Multiple"
                   IsVisible="{Binding !IsTileView}"
                   ItemsSource="{Binding DetailSource}">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Icon="＋" Header="入库" Command="{Binding AddToLibraryCommand}"/>
                <Separator/>
                <MenuItem Header="打开" Icon="{m:Glyph IconOpen}" Command="{Binding OpenSelectedCommand}"/>
                <MenuItem Header="所在目录" Icon="{m:Glyph IconOpen}" Command="{Binding OpenFolderSelectedCommand}"/>
                <MenuItem Icon="➡" Header="发送到视频列表" Command="{Binding SendToVideoToolsCommand}"/>
                <Separator/>
                <MenuItem Header="重命名…" Icon="{m:Glyph IconEdit}" Command="{Binding RenameSelectedCommand}"/>
                <MenuItem Header="重命名" Icon="{m:Glyph IconEdit}" Command="{Binding BatchRenameSelectedCommand}"/>
                <MenuItem Header="移回收站" Icon="{m:Glyph IconTrash}" Command="{Binding TrashSelectedCommand}"/>
                <MenuItem Header="移除" Icon="{m:Glyph IconTrash}" Command="{Binding RemoveFromLibraryCommand}"/>
                <MenuItem Header="从磁盘删除…" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteFromDiskCommand}"/>
                <Separator/>
                <MenuItem Header="全选当前页" Icon="{m:Glyph IconCheckAll}" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="取消选择" Icon="{m:Glyph IconUncheckAll}" Command="{Binding SelectNoneCommand}"/>
                <MenuItem Header="反选当前页" Icon="{m:Glyph IconInvert}" Command="{Binding InvertSelectionCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}"
                              Opacity="{Binding RowOpacity}">
                  <TextBlock Grid.Column="0" Classes="list-cell primary" Text="{Binding Row.Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="{Binding Row.FilePath}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Row.TypeText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsTypeVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Row.TagsText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsTagsVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding Row.CategoriesText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsCategoriesVisible}"/>
                  <TextBlock Grid.Column="4" Classes="list-cell" Text="{Binding Row.CollectionsText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsCollectionsVisible}"/>
                  <TextBlock Grid.Column="5" Classes="list-cell" Text="{Binding Row.SizeText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsSizeVisible}"/>
                  <TextBlock Grid.Column="6" Classes="list-cell" Text="{Binding Row.ModifiedText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsModifiedVisible}"/>
                  <TextBlock Grid.Column="7" Classes="list-cell" Text="{Binding Row.StorageName}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsStorageVisible}"/>
                  <TextBlock Grid.Column="8" Classes="list-cell" Text="{Binding Row.DurationText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsDurationVisible}"/>
                  <TextBlock Grid.Column="9" Classes="list-cell" Text="{Binding Row.ResolutionText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsResolutionVisible}"/>
                  <TextBlock Grid.Column="10" Classes="list-cell" Text="{Binding Row.CodecText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsCodecVisible}"/>
                  <TextBlock Grid.Column="11" Classes="list-cell" Text="{Binding Row.BitRateText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsBitrateVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>

    <!--  批量重命名弹层：跨两列盖整页（⛔ 只盖右半边会把左树露在外面）  -->
    <views:BatchRenameOverlay Grid.ColumnSpan="2" DataContext="{Binding BatchRename}" IsVisible="{Binding IsOpen}"/>
  </Grid>
</UserControl>
