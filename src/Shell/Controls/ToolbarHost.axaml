<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Controls.ToolbarHost">
  <!--
    工具条按钮样式统一（NT-055 收尾 / 需求 §4.10.4「按钮样式全局统一」）：
    三个语义变体（primary / ghost 默认 / danger-btn）只管**配色**，**尺寸一律由本控件这一处给**
    —— 原先 `io-btn` / `danger-btn` / `src-btn` 各自带 FontSize=11 + Padding=10,4，与 `ghost`(10,5) /
    `primary`(12,6) 混在同一排里字号与高度不齐。现在统一为：字号 12 / 内边距 10,5 / 最小高 28 / 圆角 6。
    ⛔ 本控件内的样式优先级高于 App 级（离控件更近）⇒ `primary` 的 12,6 也被压成 10,5，一排按钮等高。
    输入框 / 下拉框同步取 28 高，与按钮基线对齐。
    ⛔ 页面⛔ 不得再自造工具条按钮尺寸（这是"实现只存在一份"的一部分）。
  -->
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="SplitButton">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <!--
    NT-055 工具条宿主（需求 §4.8.5）：页面 VM 实现 IToolbarSource ⇒ 由本控件统一渲染。

    结构（两条硬规则都在这里落地）：
      ① 左侧 = WrapPanel（按优先级排列的项 + **末尾固定「⋯」**，由 code-behind 追加）；
         Code-behind 负责「两行放得下就全显示、放不下才折尾部」的容量计算
         （算法由「全部资产」页原样搬迁，保留**两条防抖**：项宽首帧缓存一次 + 容量幂等短路）。
      ② 右侧 = **详情开关浮层**（v3.53 新口径）：与 WrapPanel **同格叠放**、右上角对齐，
         ⛔ 不占独立列、⛔ 不参与工具条容器宽度计算；但容量计算里**给它留安全区**（⛔ 不遮按钮）。
         ⚠️ 它是 Panel 的第二个子元素 ⇒ 绘制在最上层；样式与容器内按钮同源（ghost），
            宽度更窄（20）且固定（防开合抖动）。

    ⛔ 不给本控件设 DataContext：所有绑定由 code-behind 用 `Source` 显式指定（与 DetailCardHost 同口径）。
  -->
  <Panel>
    <WrapPanel x:Name="ItemsPanel"
               Orientation="Horizontal"
               VerticalAlignment="Center"
               ItemSpacing="8"
               LineSpacing="4" />

    <Button x:Name="DetailToggle"
            Classes="ghost"
            Width="20"
            MinWidth="20"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsVisible="False"
            Click="OnDetailToggleClick"
            ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
      <Panel>
        <TextBlock x:Name="GlyphClosed" Text="❯" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="True" />
        <TextBlock x:Name="GlyphOpen" Text="❮" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
      </Panel>
    </Button>
  </Panel>
</UserControl>
