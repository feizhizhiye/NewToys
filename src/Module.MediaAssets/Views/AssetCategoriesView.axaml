<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.MediaAssets.Views.AssetCategoriesView">
  <!--
    「分类管理」页 —— 本模块**唯一的非列表页**：左树 + 右成员表格。
    🔴 本页**不实现** IDetailPanelProvider（HasDetailPanel=false）→ Shell 不会显示右详情列（需求 §6.6 页面清单）。
    🔴 树是**自绘**（ItemsControl + Button.tree-row，规范 §2.1 ⛔ 不用 TreeView）；节点由 VM 按 Depth 扁平化。
    ⛔ 往分类里加资产的入口在**详情卡**（全部资产页选中资产 → 勾分类 → 💾 保存），本页只做「摘出」。
    右侧表格 = <v:TableViewHost>（列显隐 / 排序键按 VM 的 ColumnLayout 对齐，🔴 声明顺序必须一致）。
  -->
  <UserControl.Styles>
    <!--  本页专用：树节点行（规范 §2：页面专用样式写 UserControl.Styles，⛔ 不往全局加）  -->
    <Style Selector="Button.tree-row">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="Button.tree-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <!--  🔴 选中态用「强调色文字 + 加粗 + 淡底」，⛔ 不用已删除的 CardSelectedBrush（v3.22 已移除）  -->
    <Style Selector="Button.tree-row.selected">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="280,*" Margin="12">

    <!--  ==================== 左：分类树 ====================  -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid RowDefinitions="Auto,Auto,*">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
          <Button Classes="ghost" Content="➕ 新建分类" Command="{Binding NewRootCommand}"
                  ToolTip.Tip="新建一个**根**分类"/>
          <Button Classes="ghost" Content="➕ 子分类" Command="{Binding NewChildCommand}"
                  ToolTip.Tip="在选中的分类下新建子分类"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0,6,0,0">
          <Button Classes="ghost" Content="{Binding ExpandAllText}" Command="{Binding ToggleExpandAllCommand}"
                  ToolTip.Tip="还有折叠着的分类就展开，全展开了再点就折叠"/>
          <Button Classes="ghost" Content="🔄 重读分类" Command="{Binding RefreshCategoriesCommand}"
                  ToolTip.Tip="重新读取分类树（⛔ 不扫盘）"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasNodes}"
                       Text="还没有分类。点上面「➕ 新建分类」开一个根分类。"/>
            <ItemsControl ItemsSource="{Binding TreeNodes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="tree-row" Classes.selected="{Binding IsSelected}"
                          Margin="{Binding Indent}"
                          Command="{Binding $parent[UserControl].DataContext.SelectNodeCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Arrow}" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding MemberText}" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!--  ==================== 右：成员列表 ====================  -->
    <v:ListPageSkeleton Grid.Column="1" Margin="8,0,0,0">

      <v:ListPageSkeleton.TopArea>
      <Border Classes="filter-bar">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding FilterSummary}" FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="往这个分类里加资产：到「全部资产」选中资产 → 详情卡里勾选分类 → 💾 保存。"/>
        </StackPanel>
      </Border>
      </v:ListPageSkeleton.TopArea>

      <v:ListPageSkeleton.ListArea>
        <v:TableViewHost x:Name="MemberList" Margin="0,6,0,0"
                         ItemsSource="{Binding Members}" SelectionMode="Single"
                         SelectedItem="{Binding SelectedMember, Mode=TwoWay}">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="2.6*">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="0.8*" Binding="{Binding TypeText}"/>
            <TableViewColumn Width="90" Binding="{Binding SizeText}" HorizontalContentAlignment="Center"/>
            <TableViewColumn Width="1.3*" Binding="{Binding ModifiedText}"/>
            <TableViewColumn Width="1.2*" Binding="{Binding StorageName}"/>
          </v:TableViewHost.Columns>

          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Header="⛔ 摘出选中" Command="{Binding RemoveMembersCommand}"
                        ToolTip.Tip="把选中的资产从当前分类摘出（⛔ 不删资产）"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
      </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>
  </Grid>
</UserControl>
