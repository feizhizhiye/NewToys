<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.ScriptManager.Views.ScriptInfoView">
  <!--
    「脚本管理器 → 信息面板」（NT-068 S5/S6；原 NT-067 的 manifest 驱动模型已废弃）。

    结构：
      ├ 主体：Card 里一个 ScrollViewer → 每个采集器一节（节头 + 节体表）
      ├ 空态：没集合 / 集合里没采集器（一段文案 + 一个按钮，⛔ 不做按钮墙）
      └ 底栏：本次耗时 · 节数 · 总行数（分节模式**不分页**）

    🔴 点节任意处（Tapped）= 把右侧详情卡切到这一节（**不主动打开面板**）；打开面板走右键菜单第一项。
    🔴 一次只显示一个集合：切集合靠工具条的「集合 ▾」选择框，⛔ 没有 Chip 条 / 横向集合按钮。
    🔴 节体列是运行时变的（每个采集器自己的列）⇒ 表头与行都用 v:DynamicColumnGrid（⛔ 不用静态列）。
    🔴 颜色一律 DynamicResource 引主题语义键（⛔ 不写死色值）。
  -->
  <UserControl.Styles>
    <!--  节头状态点：未采集=次要色 / 正常=强调色 / 警告=强调派生亮色 / 出错=危险色  -->
    <Style Selector="Border.status-dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.ok">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.warn">
      <Setter Property="Background" Value="{DynamicResource CardSelectedTextBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.error">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!--  状态文字与点同色  -->
    <Style Selector="TextBlock.status-text">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-text.ok">
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-text.warn">
      <Setter Property="Foreground" Value="{DynamicResource CardSelectedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-text.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!--  节容器：底部一条分隔线，节与节之间不留空白块；
          整节可点（Tapped）⇒ 把详情卡切到这一节，Background 必须非 null 才参与命中测试  -->
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--  节头（吸顶未做：见 NT-068 执行记录）—— 可点提示：手型 + 悬停底色  -->
    <Style Selector="Border.section-head">
      <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.section-head:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>

    <!--  数据行：可点选（选中效果走详情卡，行本身不再画选中底）  -->
    <Style Selector="Border.info-row">
      <Setter Property="Padding" Value="0,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Border.info-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <!--  ==================== 主体  ====================  -->
    <Border Grid.Row="0" Classes="card" Padding="0">
      <Grid RowDefinitions="Auto,*">

        <!--  ② 节列表（一个集合的全部采集器）  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="section" PointerPressed="OnSectionPressed">
                  <StackPanel Spacing="0">

                    <!--  节头：状态点 + 标题 + 状态 / 时间 / 行数 + 局部刷新 + 折叠  -->
                    <Border Classes="section-head" CornerRadius="3">
                      <!--  右键这一节 ⇒ 详情卡按这一节渲染（NT-069）  -->
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="显示这一节的详情 / 设置" Icon="{m:Glyph IconGear}" Command="{Binding OpenDetailCommand}"/>
                          <MenuItem Icon="⟳" Header="只刷新这一节" Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding CanRefresh}"/>
                          <Separator/>
                          <MenuItem Icon="▾" Header="折叠 / 展开" Command="{Binding ToggleCollapseCommand}"/>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Classes="status-dot" Margin="0,0,8,0"
                                Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                                Classes.error="{Binding IsError}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Text="{Binding Title}" ToolTip.Tip="{Binding Subtitle}"/>
                          <TextBlock Classes="status-text" Text="{Binding StatusLabel}"
                                     Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                                     Classes.error="{Binding IsError}"/>
                          <TextBlock Classes="hint-text" VerticalAlignment="Center" Text="{Binding CapturedText}"/>
                          <TextBlock Classes="hint-text" VerticalAlignment="Center" Text="{Binding RowCountText}"/>
                          <TextBlock Classes="hint-text" VerticalAlignment="Center" Text="{Binding Error}"
                                     IsVisible="{Binding IsError}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="ghost" Content="⟳" Width="24" Height="22" Padding="0"
                                FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="只刷新这一节" Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding CanRefresh}"/>
                        <Button Grid.Column="3" Classes="ghost" Content="▾" Width="24" Height="22" Padding="0"
                                FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="折叠 / 展开这一节" Command="{Binding ToggleCollapseCommand}"
                                IsVisible="{Binding IsExpanded}"/>
                        <Button Grid.Column="3" Classes="ghost" Content="›" Width="24" Height="22" Padding="0"
                                FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="折叠 / 展开这一节" Command="{Binding ToggleCollapseCommand}"
                                IsVisible="{Binding IsCollapsed}"/>
                      </Grid>
                    </Border>

                    <!--  节体：这一采集器自己的列  -->
                    <StackPanel IsVisible="{Binding IsExpanded}" Spacing="0">

                      <!--  还没有列（首次采集前）  -->
                      <TextBlock Classes="hint-text" Margin="12,8" TextWrapping="Wrap"
                                 Text="{Binding EmptyBodyText}" IsVisible="{Binding !HasColumns}"/>

                      <StackPanel IsVisible="{Binding HasColumns}" Spacing="0">
                        <Border Classes="list-header" Margin="0,4,0,0">
                          <v:DynamicColumnGrid ColumnSpecs="{Binding ColumnSpecs}"
                                               HeaderCells="{Binding HeaderCells}"
                                               SortCommand="{Binding SortCommand}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="info-row" PointerPressed="OnRowPressed">
                                <v:DynamicColumnGrid ColumnSpecs="{Binding $parent[ItemsControl].DataContext.ColumnSpecs}"
                                                     Cells="{Binding Cells}"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="hint-text" Margin="12,8" TextWrapping="Wrap"
                                   Text="这次没有采集到行。"
                                   IsVisible="{Binding ShowNoRowsHint}"/>

                        <Button Classes="ghost" Content="{Binding ShowAllText}" ToolTip.Tip="展开全部行 / 只显示前 20 行" Margin="0,6,0,2"
                                HorizontalAlignment="Left" IsVisible="{Binding CanToggleShowAll}"
                                Command="{Binding ToggleShowAllCommand}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!--  ③ 空态（没集合 / 集合里没采集器）：一段文案 + 一个按钮  -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !HasSections}">
          <TextBlock Classes="hint-text" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding EmptyMessage}"/>
          <Button Classes="ghost" HorizontalAlignment="Center" Content="{Binding EmptyActionText}"
                  IsVisible="{Binding HasEmptyAction}" Command="{Binding OpenEmptyActionCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!--  ==================== 底栏：摘要（分节模式不分页）  ====================  -->
    <Border Grid.Row="1" Height="28" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource HairlineBrush}">
      <TextBlock Classes="hint-text" VerticalAlignment="Center" Margin="12,0" Text="{Binding FooterSummary}"/>
    </Border>
  </Grid>
</UserControl>
