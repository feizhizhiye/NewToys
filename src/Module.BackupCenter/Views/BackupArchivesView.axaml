<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.BackupCenter.Views.BackupArchivesView">
  <!--
    「备份中心 → 备份包」（`backup-archives`）：本地包清单 + 还原弹层。
    还原目标 / 冲突策略只在弹层里填，⛔ 不在列表行内联编辑。
  -->
  <Grid>
    <v:ListPageSkeleton EmptyMessage="还没有归档包。到「备份任务」页选中任务点「▶ 立即备份」，包会出现在这里。"
                        IsEmpty="{Binding !HasItems}">

      <v:ListPageSkeleton.TopArea>
        <Border Background="{DynamicResource ContentHeaderBrush}" Padding="12,6" IsVisible="{Binding IsBusy}">
          <StackPanel Spacing="4">
            <TextBlock Classes="hint-text" Text="{Binding BusyPhase}"/>
            <ProgressBar IsIndeterminate="True" Height="3"/>
          </StackPanel>
        </Border>
      </v:ListPageSkeleton.TopArea>

      <v:ListPageSkeleton.HeaderArea>
        <Border Classes="list-header">
          <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}"
                        IsResizable="True" LockedColumns="{Binding LockedColumnMask}"
                        SampleSpecs="{Binding SampleSpecs}">
            <Button Grid.Column="0" Classes="col-header" Content="{Binding FileNameHeader}"
                    Command="{Binding SortCommand}" CommandParameter="FileName" IsVisible="{Binding IsNameVisible}"/>
            <Button Grid.Column="1" Classes="col-header" Content="{Binding PlanNameHeader}"
                    Command="{Binding SortCommand}" CommandParameter="PlanName" IsVisible="{Binding IsPlanVisible}"/>
            <Button Grid.Column="2" Classes="col-header" Content="{Binding SizeHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Size" IsVisible="{Binding IsSizeVisible}"/>
            <Button Grid.Column="3" Classes="col-header" Content="{Binding CreatedHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Created" IsVisible="{Binding IsCreatedVisible}"/>
            <Button Grid.Column="4" Classes="col-header" Content="{Binding ShaHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Sha" IsVisible="{Binding IsShaVisible}"/>
            <Button Grid.Column="5" Classes="col-header" Content="{Binding EncryptedHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Encrypted" IsVisible="{Binding IsEncryptedVisible}"/>
            <v:ColumnGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="包文件" IsEnabled="False" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="FileName"/>
                <MenuItem Header="任务" ToggleType="CheckBox" IsChecked="{Binding IsPlanVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="PlanName"/>
                <MenuItem Header="大小" ToggleType="CheckBox" IsChecked="{Binding IsSizeVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Size"/>
                <MenuItem Header="生成时间" ToggleType="CheckBox" IsChecked="{Binding IsCreatedVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Created"/>
                <MenuItem Header="SHA256" ToggleType="CheckBox" IsChecked="{Binding IsShaVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Sha"/>
                <MenuItem Header="加密" ToggleType="CheckBox" IsChecked="{Binding IsEncryptedVisible, Mode=OneWay}"
                          Command="{Binding ToggleColumnCommand}" CommandParameter="Encrypted"/>
              </ContextMenu>
            </v:ColumnGrid.ContextMenu>
          </v:ColumnGrid>
        </Border>
      </v:ListPageSkeleton.HeaderArea>

      <v:ListPageSkeleton.ListArea>
        <ListBox x:Name="ArchiveList" Classes="list-page"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="↩ 还原…" Command="{Binding BeginRestoreCommand}" IsEnabled="{Binding HasSelection}"/>
              <MenuItem Header="📋 复制 SHA256" Command="{Binding CopyShaCommand}" IsEnabled="{Binding HasSelection}"/>
              <Separator/>
              <MenuItem Header="🗑 删除包" Command="{Binding DeleteArchiveCommand}" IsEnabled="{Binding HasSelection}"/>
              <Separator/>
              <MenuItem Header="🔄 重新扫描" Command="{Binding RefreshCommand}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                <TextBlock Grid.Column="0" Classes="list-cell primary" Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding PlanName}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsPlanVisible}"/>
                <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding SizeText}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsSizeVisible}"/>
                <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding CreatedText}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsCreatedVisible}"/>
                <TextBlock Grid.Column="4" Classes="list-cell" Text="{Binding ShaText}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsShaVisible}"/>
                <TextBlock Grid.Column="5" Classes="list-cell accent" Text="{Binding EncryptedText}"
                           IsVisible="{Binding $parent[ListBox].DataContext.IsEncryptedVisible}"/>
              </v:ColumnGrid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>

    <!--  ==================== 还原弹层  ====================  -->
    <Border Background="{DynamicResource LoadingOverlayBrush}" IsVisible="{Binding IsRestoreOpen}">
      <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Classes="section-title" Text="{Binding RestoreTitle}"/>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="还原到"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="380" Text="{Binding RestoreTargetDir}" Watermark="选择目标目录…"/>
              <Button Classes="ghost" Content="📂 选择" Command="{Binding PickRestoreFolderCommand}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="同名文件怎么处理"/>
            <ComboBox Width="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding RestorePolicies}"
                      SelectedIndex="{Binding RestorePolicyIndex, Mode=TwoWay}"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="默认「跳过」——不动目标目录里已有的文件；「覆盖」会直接替换；「重命名」会加 (1)(2) 后缀。"/>
          </StackPanel>

          <TextBlock Classes="hint-text" TextWrapping="Wrap"
                     Text="🔴 包里的密码从密码库取，所以必须先解锁密码库。解包先解到暂存目录并校验条目名，成功后才搬到目标目录。"/>

          <TextBlock Classes="hint-text" Text="{Binding StatusText}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelRestoreCommand}"/>
            <Button Classes="primary" Content="↩ 开始还原" Command="{Binding ConfirmRestoreCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
