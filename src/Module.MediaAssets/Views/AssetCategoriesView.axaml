<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.MediaAssets.Views.AssetCategoriesView">
  <!--
    「分类管理」页：与「标签管理」同构的表格页（名称 / 路径 / 成员数 / 排序 / 创建时间）+ 详情卡（Shell 承载）。
    🔴 分类是树，层级靠**首列缩进 + 路径列**表达（⛔ 不画左树）；改挂父级在详情卡的「父分类」chips。
    ⚠️ 列表本体 = <v:TableViewHost>：表头粘顶 / 列宽可拖 / 列显隐与排序键按 VM 的 ColumnLayout 对齐，
       ⇒ 骨架的 HeaderArea 不填，XAML ⛔ 不写 IsXxxVisible 绑定。
    🔴 Columns 的声明顺序必须与 VM 的 ColumnLayout 一致。
  -->
  <v:ListPageSkeleton EmptyMessage="还没有分类。点「➕ 新建分类」开一个根分类。"
                      EmptyActionText="＋ 新建分类"
                      EmptyActionCommand="{Binding NewRootCommand}"
                      IsEmpty="{Binding !HasItems}">

    <v:ListPageSkeleton.TopArea>
      <Border Classes="filter-bar">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" LineSpacing="4">
          <TextBlock Text="{Binding FilterSummary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Text="左键表头排序；右键表头选列 / 筛选；改父级在右侧详情卡点 chips" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
      </Border>
    </v:ListPageSkeleton.TopArea>

    <v:ListPageSkeleton.ListArea>
      <v:TableViewHost x:Name="CategoryList" Classes="list-page"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}"
                       SelectionMode="Single">
        <v:TableViewHost.Columns>
          <TableViewColumn Width="2*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Border Width="3" Height="14" CornerRadius="2" Margin="{Binding Indent}"
                          Background="{DynamicResource AccentBrush}" Opacity="0.55"/>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>

          <TableViewColumn Width="2.2*" Binding="{Binding PathText}"/>
          <TableViewColumn Width="0.9*" Binding="{Binding MemberText}"/>
          <TableViewColumn Width="0.7*" Binding="{Binding SortText}"/>
          <TableViewColumn Width="1.4*" Binding="{Binding CreatedText}"/>
        </v:TableViewHost.Columns>

        <v:TableViewHost.ContextMenu>
          <ContextMenu>
            <MenuItem Header="🔍 筛选" ItemsSource="{Binding QuickFilters}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Setter Property="Header" Value="{Binding Label}"/>
                  <Setter Property="Command" Value="{Binding Command}"/>
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <Separator/>
            <MenuItem Header="＋ 子分类…" Command="{Binding NewChildCommand}"/>
            <MenuItem Header="✏ 重命名…" Command="{Binding RenameCategoryCommand}"/>
            <MenuItem Header="⬆ 移到根分类" Command="{Binding MoveToRootCommand}"/>
            <Separator/>
            <MenuItem Header="🗑 删除分类（含子树）" Command="{Binding DeleteCategoryCommand}"/>
          </ContextMenu>
        </v:TableViewHost.ContextMenu>
      </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
