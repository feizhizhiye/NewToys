<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NewToys.Reading.Views"
             x:Class="NewToys.Reading.Views.SearchView">
  <!--
    网络阅读 → 网上搜索（`reading-search`）：关键词 + 结果行列表。
    书源多选收进「📚 书源」弹出的浮层（⛔ 不常驻占一栏）；点一条结果弹书籍卡。
    🔴 正文只在阅读页渲染，本页 ⛔ 不内嵌目录与正文。
  -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!--  ==================== 上段：关键词 + 书源入口  ====================  -->
    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="12,8">
      <StackPanel Spacing="6">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
            <Button Classes="primary" Content="🔍 搜索" Command="{Binding SearchCommand}"/>
            <Button Classes="ghost" Content="✕ 取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
          </StackPanel>

          <TextBox x:Name="KeywordBox"
                   Text="{Binding Keyword, Mode=TwoWay}"
                   PlaceholderText="书名 / 作者，回车即搜索"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="📚 书源" Command="{Binding ToggleSourcesCommand}"
                  ToolTip.Tip="弹出书源多选（勾哪个搜哪个）"/>
          <TextBlock Classes="hint-text" Text="{Binding SourceSummary}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!--  ==================== 忙 / 错误条  ====================  -->
    <StackPanel Grid.Row="1">
      <Border Background="{DynamicResource ContentHeaderBrush}" Padding="12,4" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="4">
          <TextBlock Classes="hint-text" Text="{Binding BusyPhase}"/>
          <ProgressBar IsIndeterminate="True" Height="3"/>
        </StackPanel>
      </Border>

      <Border Padding="12,4" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   FontSize="12"/>
      </Border>
    </StackPanel>

    <!--  ==================== 结果（行列表）  ====================  -->
    <Border Grid.Row="2"
            Margin="8,6,8,6">
      <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="10,8,10,6">
          <TextBlock DockPanel.Dock="Left" Classes="section-title" Text="{Binding ResultTitle}" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Classes="ghost" Content="＋ 书架" Command="{Binding AddToShelfCommand}"
                    IsEnabled="{Binding HasSelection}"/>
            <Button Classes="primary" Content="📖 阅读" Command="{Binding OpenInReaderCommand}"
                    IsEnabled="{Binding HasSelection}"/>
          </StackPanel>
        </DockPanel>

        <ListBox x:Name="ResultList"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,0,8,8">
          <ListBox.ContextMenu>
            <ContextMenu x:Name="ResultMenu">
              <MenuItem Header="📖 阅读" Command="{Binding OpenInReaderCommand}"/>
              <MenuItem Header="＋ 书架" Command="{Binding AddToShelfCommand}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Height="46">
                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="list-cell primary"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="hint-text"
                             Text="{Binding AuthorText}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Classes="hint-text"
                             Text="{Binding LastChapter}"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="240"
                             HorizontalAlignment="Right"/>
                  <TextBlock Classes="hint-text"
                             Text="{Binding SourceName}"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="240"
                             HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!--  ==================== 书源多选浮层（点「📚 书源」才出现）  ====================  -->
    <Grid Grid.Row="2" IsVisible="{Binding ShowSources}">
      <Border Background="{DynamicResource LoadingOverlayBrush}" Tapped="OnSourceBackdropTapped"/>

      <Border Width="320"
              Height="420"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="8,6,0,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="section-title" Margin="10,8,10,6" Text="书源（勾哪个搜哪个）"/>

          <TextBox DockPanel.Dock="Top"
                   Text="{Binding SourceFilter, Mode=TwoWay}"
                   PlaceholderText="过滤书源名 / 分组"
                   Margin="10,0,10,6"/>

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="10,0,10,6">
            <Button Classes="ghost" Content="☑ 全选" Command="{Binding SelectAllSourcesCommand}"/>
            <Button Classes="ghost" Content="☐ 全不选" Command="{Binding ClearSourcesCommand}"/>
            <TextBlock Classes="hint-text" Text="{Binding SourceSummary}" VerticalAlignment="Center"/>
          </StackPanel>

          <Button DockPanel.Dock="Bottom"
                  Classes="primary"
                  Content="完成"
                  Command="{Binding ToggleSourcesCommand}"
                  HorizontalAlignment="Stretch"
                  Margin="10,6,10,10"/>

          <ListBox ItemsSource="{Binding VisibleSources}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="6,0,6,6"
                   SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Content="{Binding Name}"
                          ToolTip.Tip="{Binding Hint}"
                          Margin="0,1"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!--  ==================== 书籍卡浮层  ====================  -->
    <views:BookCardOverlay Grid.Row="0" Grid.RowSpan="3"/>
  </Grid>
</UserControl>
