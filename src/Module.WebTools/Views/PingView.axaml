<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.PingView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid ColumnDefinitions="*,Auto" Margin="16">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->

    <Border Grid.Row="1" Classes="toolbar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BtnImport" Classes="primary" Content="📥 导入文件" Margin="0,0,8,0" ToolTip.Tip="选择一行一个主机的文本文件"/>
        <Button Classes="ghost" Content="➕ 新建" Margin="0,0,8,0" Command="{Binding NewTargetCommand}"/>
        <Button Classes="ghost" Content="📡 批量 Ping" Margin="0,0,8,0" Command="{Binding PingAllCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Classes="ghost" Content="🔄 刷新" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
        <ComboBox ItemsSource="{Binding DnsPresets}" SelectedItem="{Binding SelectedDns, Mode=TwoWay}"
                  Width="200" Margin="0,0,8,0" ToolTip.Tip="切换 DNS：批量 Ping 与未单独设置 DNS 的目标都按此解析"/>
        <TextBox Width="200" Margin="0,0,8,0" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="搜索主机…"/>
        <TextBlock Text="右键列表项：发送到书签 / 网页抓取 / Ping / 编辑 / 删除" FontSize="11"
                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      </WrapPanel>
    </Border>

    
    <!--  ==================== 多项筛选  ====================  -->
    <Border Grid.Row="2" Classes="filter-bar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="filter-btn" Content="＋ 条件" Command="{Binding AddFilterCommand}"/>
        <Button Classes="filter-btn" Content="🧹 清空" Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasFilters}"/>
        <TextBlock Classes="hint-text" Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,8,0"/>

        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                <ComboBox Classes="filter-combo"
                          ItemsSource="{Binding $parent[UserControl].DataContext.FilterableColumns}"
                          SelectedItem="{Binding Column, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Classes="filter-combo" ItemsSource="{Binding Operators}"
                          SelectedItem="{Binding OperatorItem, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Classes="filter-value" Text="{Binding Value, Mode=TwoWay}"
                         IsVisible="{Binding NeedsValue}" PlaceholderText="值…"/>
                <Button Classes="filter-btn" Content="✕" Padding="6,2"
                        Command="{Binding $parent[UserControl].DataContext.RemoveFilterCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
    </Border>

      <!--  ==================== 列表本体  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding HostHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Host" IsVisible="{Binding IsHostVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding IpHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Ip" IsVisible="{Binding IsIpVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding StatusHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Status" IsVisible="{Binding IsStatusVisible}"/>
              <Button Grid.Column="3" Classes="col-header" Content="{Binding RoundtripHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Roundtrip" IsVisible="{Binding IsRoundtripVisible}"/>
              <Button Grid.Column="4" Classes="col-header" Content="{Binding DnsHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Dns" IsVisible="{Binding IsDnsVisible}"/>
              <!--  详情栏开关：贴在表头右缘，默认只露一条窄边；鼠标靠近右侧热区才弹出  -->
              <Border Grid.Column="5" Classes="detail-hotspot">
                <Button Classes="header-toggle" Command="{Binding ToggleDetailCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情">
                  <Panel>
                    <TextBlock Text="❯" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !IsDetailVisible}"/>
                    <TextBlock Text="❮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsDetailVisible}"/>
                  </Panel>
                </Button>
              </Border>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="主机" ToggleType="CheckBox" IsChecked="{Binding IsHostVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Host"/>
                  <MenuItem Header="解析 IP" ToggleType="CheckBox" IsChecked="{Binding IsIpVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Ip"/>
                  <MenuItem Header="状态" ToggleType="CheckBox" IsChecked="{Binding IsStatusVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Status"/>
                  <MenuItem Header="时延(ms)" ToggleType="CheckBox" IsChecked="{Binding IsRoundtripVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Roundtrip"/>
                  <MenuItem Header="DNS" ToggleType="CheckBox" IsChecked="{Binding IsDnsVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Dns"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="TargetList" Classes="list-page"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="▤ 显示详情栏" Command="{Binding ShowDetailCommand}"/>
                <Separator/>
                <MenuItem Header="📡 Ping" Command="{Binding PingCommand}"/>
                <MenuItem Header="🔖 发送到书签" Command="{Binding SendToBookmarkCommand}"/>
                <MenuItem Header="🕷 发送到网页抓取" Command="{Binding SendToScrapeCommand}"/>
                <Separator/>
                <MenuItem Header="✏ 编辑" Command="{Binding ShowDetailCommand}"/>
                <MenuItem Header="🗑 删除" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Host}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsHostVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding LastIp}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsIpVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding LastStatus}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding LastRoundtripMs}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsRoundtripVisible}"/>
                  <TextBlock Grid.Column="4" Classes="list-cell" Text="{Binding DnsOverride}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsDnsVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

    <!--  右：详情（编辑 + 切换 DNS）；宽度由共享样式 Border.detail-card 给  -->
    <Border Grid.Column="1" Classes="detail-card"
              IsVisible="{Binding IsDetailVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2" IsVisible="{Binding !HasSelection}">
              <TextBlock Text="在左侧列表里选中一个目标" FontSize="13" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
              <TextBlock Text="主机（域名或 IP）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Host, Mode=TwoWay}"/>

              <TextBlock Text="专属 DNS（留空 = 用全局 DNS）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.DnsOverride, Mode=TwoWay}" PlaceholderText="如 8.8.8.8"/>

              <!-- ⚠️ Avalonia 的 WrapPanel **没有** Spacing 属性（StackPanel 才有）→ 用按钮 Margin 做间距 -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Content="📡 Ping" Margin="0,0,6,0" Command="{Binding PingCommand}"/>
                <Button Classes="ghost" Content="💾 保存" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                <Button Classes="ghost" Content="🗑 删除" Command="{Binding DeleteCommand}"/>
              </WrapPanel>

              <StackPanel Spacing="2"
                          IsVisible="{Binding Selected.LastStatus, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="最近结果" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <SelectableTextBlock Text="{Binding Selected.LastStatus}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.LastIp, StringFormat='解析 IP：{0}'}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding Selected.LastTime, StringFormat='检测时间：{0:yyyy-MM-dd HH:mm}'}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
  </Grid>
</UserControl>
