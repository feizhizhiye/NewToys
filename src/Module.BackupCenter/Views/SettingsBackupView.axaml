<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Controls"
             x:Class="NewToys.BackupCenter.Views.SettingsBackupView">
  <!--
    「备份中心设置」（`settings-backup`）：归档引擎 / 主密码 / 保留份数与目录 / 文件位置。
    🔴 节内容写在 <UserControl.Resources> 的 SecN 面板里，节元数据由 code-behind 的 Add(...) 建
      （⛔ 别在 XAML 里直接写 ui:SettingsSection：该页会不被预编译）；节内 ⛔ 再包 ScrollViewer。
  -->
  <UserControl.Resources>

    <!--  ==================== 主密码 ====================  -->
    <StackPanel x:Key="Sec1" Spacing="10">
      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="密码库状态"/>
        <TextBlock Classes="field-value" Text="{Binding VaultStateText}"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="包密码与（以后的）投递凭据都保存在一个加密密码库里；主密码本身不落盘，只用来派生加解密密钥。"/>
      </StackPanel>

      <!--  首次设置  -->
      <StackPanel Classes="field" Spacing="6" IsVisible="{Binding ShowSetupVault}">
        <TextBlock Classes="field-label" Text="设置主密码（至少 8 位）"/>
        <TextBox PasswordChar="●" Text="{Binding MasterInput}" PlaceholderText="主密码"/>
        <TextBox PasswordChar="●" Text="{Binding MasterConfirmInput}" PlaceholderText="再输一次"/>
        <Button Classes="primary" Content="🔐 主密码" Command="{Binding SetupVaultCommand}"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="🔴 主密码丢了，密码库里的包密码就再也取不回来（归档包也会打不开）。请记到你的密码管理器里。"/>
      </StackPanel>

      <!--  解锁  -->
      <StackPanel Classes="field" Spacing="6" IsVisible="{Binding ShowUnlockVault}">
        <TextBlock Classes="field-label" Text="解锁密码库（本次会话有效）"/>
        <TextBox PasswordChar="●" Text="{Binding MasterInput}" PlaceholderText="主密码"/>
        <Button Classes="primary" Content="🔓 解锁" Command="{Binding UnlockVaultCommand}"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding RemainingAttemptsText}"/>
      </StackPanel>

      <!--  已解锁：锁库 / 改密码  -->
      <StackPanel Classes="field" Spacing="6" IsVisible="{Binding ShowUnlockedActions}">
        <Button Classes="ghost" HorizontalAlignment="Left" Content="🔒 锁库" Command="{Binding LockVaultCommand}"/>
        <TextBlock Classes="field-label" Text="修改主密码"/>
        <TextBox PasswordChar="●" Text="{Binding OldMasterInput}" PlaceholderText="旧主密码"/>
        <TextBox PasswordChar="●" Text="{Binding NewMasterInput}" PlaceholderText="新主密码"/>
        <TextBox PasswordChar="●" Text="{Binding NewMasterConfirmInput}" PlaceholderText="再输一次新主密码"/>
        <Button Classes="ghost" HorizontalAlignment="Left" Content="💾 改主密码" Command="{Binding ChangeMasterCommand}"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="改主密码会用新密码把库里所有条目重新加密一次；已经生成的归档包⛔ 不受影响（它们用各自的包密码）。"/>
      </StackPanel>
    </StackPanel>

    <!--  ==================== 保留份数 / 目录 ====================  -->
    <StackPanel x:Key="Sec2" Spacing="10">
      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="新建任务的默认保留份数"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="120" Text="{Binding KeepText}"/>
          <Button Classes="ghost" Content="💾 保存" Command="{Binding SaveKeepCommand}"/>
        </StackPanel>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="1~999；只影响新建任务的初值，单个任务的份数在任务里改。"/>
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="默认备份目录"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="380" Text="{Binding ArchiveDirText}"/>
          <Button Classes="ghost" Content="📂 选择" Command="{Binding BrowseArchiveDirCommand}"/>
          <Button Classes="ghost" Content="↗ 打开" Command="{Binding OpenBackupDirCommand}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="💾 保存" Command="{Binding SaveArchiveDirCommand}"/>
          <Button Classes="ghost" Content="恢复默认" Command="{Binding ResetArchiveDirCommand}"/>
        </StackPanel>
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="归档包生成到哪。默认放在用户目录下一层（默认值见下），想手动翻包 / 往里丢文件都不用再钻配置档目录；改成 D:\ 之类的浅路径更顺手。"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding DefaultBackupDir}"/>
      </StackPanel>
    </StackPanel>

    <!--  ==================== 邮件投递 ====================  -->
    <StackPanel x:Key="SecMail" Spacing="12">
      <TextBlock Classes="field-label" Text="发信（SMTP）"/>
      <Grid ColumnDefinitions="*,90" >
        <StackPanel Spacing="4">
          <TextBox Text="{Binding SmtpHostText}" PlaceholderText="smtp.qq.com"/>
          <TextBlock Classes="hint-text" Text="服务器地址"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBox Text="{Binding SmtpPortText}" PlaceholderText="465"/>
          <TextBlock Classes="hint-text" Text="端口"/>
        </StackPanel>
      </Grid>
      <StackPanel Spacing="4">
        <TextBox Text="{Binding SmtpUserText}" PlaceholderText="yourname@qq.com"/>
        <TextBlock Classes="hint-text" Text="发信账号（也是收信账号，除非下面另填）"/>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBox Text="{Binding SmtpToText}" PlaceholderText="留空 = 发给自己"/>
        <TextBlock Classes="hint-text" Text="收件人"/>
      </StackPanel>

      <TextBlock Classes="field-label" Text="收信（IMAP）"/>
      <Grid ColumnDefinitions="*,90">
        <StackPanel Spacing="4">
          <TextBox Text="{Binding ImapHostText}" PlaceholderText="imap.qq.com"/>
          <TextBlock Classes="hint-text" Text="服务器地址"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBox Text="{Binding ImapPortText}" PlaceholderText="993"/>
          <TextBlock Classes="hint-text" Text="端口"/>
        </StackPanel>
      </Grid>
      <StackPanel Spacing="4">
        <TextBox Text="{Binding ImapUserText}" PlaceholderText="留空 = 与发信账号相同"/>
        <TextBlock Classes="hint-text" Text="收信账号"/>
      </StackPanel>

      <TextBlock Classes="field-label" Text="授权码"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="320" PasswordChar="●" Text="{Binding AuthCodeInput}"
                 PlaceholderText="{Binding AuthCodePlaceholder}"/>
        <Button Classes="ghost" Content="💾 存密码" Command="{Binding SaveMailCommand}"/>
        <Button Classes="ghost" Content="🗑 清授权码" Command="{Binding ClearAuthCommand}"/>
      </StackPanel>
      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding AuthStateText}"/>
      <TextBlock Classes="hint-text" TextWrapping="Wrap"
                 Text="🔴 QQ / 163 邮箱要用「授权码」而不是登录密码：网页版 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成授权码。授权码存在密码库里（密文），⛔ 不写配置文件。"/>

      <TextBlock Classes="field-label" Text="分卷大小"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="120" ItemsSource="{Binding VolumeOptions}" SelectedItem="{Binding VolumeMb}"/>
        <TextBlock Classes="hint-text" VerticalAlignment="Center" Text="MB（上限 30）"/>
      </StackPanel>
      <TextBlock Classes="hint-text" TextWrapping="Wrap"
                 Text="🔴 别再调大：邮件附件走 base64 编码，体积会涨约 1/3 —— 30 MB 的包编码后约 40 MB，正好在 QQ 邮箱单封 50 MB 之内；填 48 MB 必然被服务器拒收。"/>

      <TextBlock Classes="field-label" Text="待发目录"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="380" Text="{Binding OutboxDirText}"/>
        <Button Classes="ghost" Content="📂 选择" Command="{Binding BrowseOutboxDirCommand}"/>
        <Button Classes="ghost" Content="↗ 打开" Command="{Binding OpenOutboxDirCommand}"/>
      </StackPanel>
      <TextBlock Classes="hint-text" TextWrapping="Wrap"
                 Text="分卷先落这里再发信；发完保留 3 天（留出复查 / 重发的窗口），到期自动清理。⛔ 与「默认备份目录」是两套规则：那里按保留份数轮转，这里发完即清。"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="🔌 测连接" Command="{Binding TestMailCommand}"/>
        <Button Classes="ghost" Content="🧹 清理分卷" Command="{Binding PurgeOutboxCommand}"/>
      </StackPanel>
      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding MailStatusText}"/>
    </StackPanel>

    <!--  ==================== 文件位置 ====================  -->
    <StackPanel x:Key="Sec3" Spacing="10">
      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="设置文件"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding SettingsFile}"/>
      </StackPanel>
      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="备份数据库（任务 / 包清单 / 运行记录 / 待办 / 密码库）"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding DatabaseFile}"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="一个 SQLite 文件；密码库条目在里面是密文（主密码不落盘）。旧版遗留的 plans.json / vault.json 等只作为首次迁移来源，已不再读写。"/>
      </StackPanel>
      <StackPanel Classes="field">
        <TextBlock Classes="field-label" Text="还原暂存目录（可随时清理）"/>
        <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding StagingRoot}"/>
      </StackPanel>
      <Button Classes="ghost" HorizontalAlignment="Left" Content="📂 数据目录" Command="{Binding OpenDataDirCommand}"/>
      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding StatusText}"/>
    </StackPanel>
  </UserControl.Resources>

  <ui:SettingsSectionHost x:Name="Host" Sticky="False"/>
</UserControl>
