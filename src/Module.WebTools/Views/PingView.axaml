<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.WebTools.Views.PingView">
  <Grid RowDefinitions="Auto,*">
    <!-- 操作行：原页头右侧按钮迁移至此；页名已由左侧二级菜单体现，内容区不再重复标题页头。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="24,16,24,0" Spacing="8">
      <Button Classes="primary" Content="▶ 开始检测"/>
      <Button Classes="ghost" Content="⏹ 停止"/>
      <Button Classes="ghost" Content="🗑 清空"/>
    </StackPanel>
    <Border Grid.Row="1" Margin="24,8,24,16">
      <Border Classes="card">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4"><StackPanel Spacing="8"><TextBox PlaceholderText="输入目标（一行一个：域名或 IP，支持 :端口）" Height="100" AcceptsReturn="True"/></StackPanel></StackPanel></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
