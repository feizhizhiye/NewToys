<UserControl
    x:Class="NewToys.VideoTools.Views.VideoBatchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:NewToys.VideoTools.Views">
    <!--  v3.29 / NT-054：**详情卡已迁到 Shell 的声明式渲染**（`IDetailCardSource` + `DetailCardHost`）⇒
          本页只剩「列表列」一列；卡片的声明在 `VideoBatchViewModel.BuildCard()` 里，⛔ 不再页内自绘。  -->
    <Grid Margin="12">

        <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

            <!--
                操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
                Row0 保持空着（Auto → 高度 0），不动下面各行的行号。
            -->

            <!--  ==================== 工具条  ====================  -->
            <Border Grid.Row="1" Classes="toolbar">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">


                        <Button
                            x:Name="PickFilesBtn"
                            Margin="0,0,8,6"
                            Classes="primary"
                            Content="📂 添加文件"
                            ToolTip.Tip="按左边选的类型建任务；只是建任务，不立刻跑" />


                        <ComboBox
                            Width="220"
                            Margin="0,0,8,6"
                            ItemsSource="{Binding Presets}"
                            SelectedValue="{Binding DefaultPresetId, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}"
                            ToolTip.Tip="只影响随后加入的**转码**任务；已存在的任务在右侧详情卡里单独改">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>



                        <TextBox
                            Width="180"
                            Margin="0,0,8,6"
                            PlaceholderText="按文件名 / 输出过滤…"
                            Text="{Binding SearchText, Mode=TwoWay}" />

                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="primary"
                            Command="{Binding RunAllCommand}"
                            Content="▶▶ 批量运行"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip.Tip="按列表顺序依次处理（剪辑 / 转码各按自己的参数），跑完自动探测输出文件" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding RunSelectedCommand}"
                            Content="▶ 只跑选中"
                            IsEnabled="{Binding IsNotBusy}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding StopCommand}"
                            Content="⏹ 停止"
                            IsEnabled="{Binding IsRunning}" />

                        <!--  v3.12：详情卡里原本那排按钮全部上移到工具条（详情卡只留参数 + 命令）  -->
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding SaveCommand}"
                            Content="💾 保存修改"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="把详情卡里改的参数写回选中的任务" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding DeleteCommand}"
                            Content="🗑 删除"
                            IsEnabled="{Binding IsNotBusy}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="📂 输出目录"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding CopyCommandLineCommand}"
                            Content="📋 复制命令"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ResetCommandCommand}"
                            Content="↺ 重置为自动"
                            IsEnabled="{Binding IsArgsEdited}"
                            IsVisible="{Binding IsArgsEdited}"
                            ToolTip.Tip="丢弃手改的命令，恢复成由参数自动生成" />
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            x:Name="ExportBtn"
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Content="📤 导出任务"
                            ToolTip.Tip="把当前队列（剪辑 + 转码）导出成 JSON 文件，可用外部脚本批量加工后再导入" />
                        <Button
                            x:Name="ImportBtn"
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Content="📥 导入任务"
                            ToolTip.Tip="从导出的 JSON 里追加任务进当前队列（不覆盖已有）" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ClearFinishedCommand}"
                            Content="🧹 清理已结束"
                            IsEnabled="{Binding IsNotBusy}" />
                        <!--  v3.16.1 §6.4.11：只清页面缓存（⛔ 不叫"清除队列"，不动磁盘上的 json）  -->
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ClearCacheCommand}"
                            Content="🧹 清除缓存"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip.Tip="只清页面上的这条列表（不再显示它们）：⛔ 磁盘上的 config\video-tasks.json 不会动，点「📥 导入任务」可以再读回来" />
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="primary"
                            Command="{Binding SendToPreviewCommand}"
                            Content="➡ 送预览"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="把选中的任务源文件送进「视频预览」页（一次只编一个，进入后自动载入）" />
                    </WrapPanel>
                    <Button
                        Grid.Column="1"
                        Classes="detail-toggle"
                        Command="{Binding ToggleDetailPanelCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
                        <Panel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding !IsDetailVisible}"
                                Text="❯" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding IsDetailVisible}"
                                Text="❮" />
                        </Panel>
                    </Button>
                </Grid>
            </Border>


            <!--  ==================== 列表本体：剪辑 + 转码混排的统一队列  ====================  -->
            <Border
                Grid.Row="3"
                Padding="0"
                Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0" Classes="list-header">
                        <!--  v3.20 §6.4.15：IsResizable = 表头列边界可拖动手动调列宽（事件在 code-behind 转给 VM）  -->
                        <v:ColumnGrid
                            x:Name="HeaderGrid"
                            ColumnSpecs="{Binding VisibleColumnSpecs}"
                            IsResizable="True"
                            LockedColumns="{Binding LockedColumnMask}"
                            SampleSpecs="{Binding SampleSpecs}">
                            <!--
                                v3.16.1：第一列 = 行首勾选框；表头改用**原生 CheckBox**（三态：全勾 ✓ / 部分 ■ / 没勾）
                                —— 之前用字符"☑"，字体渲染成一坨深色块，跟行内勾选框风格不搭。
                                点 = 全选/取消；右键 = 菜单（全选 / 取消选择 / 反选，与「视频列表」页同一套）。
                                外面套透明 Border：整个 34px 列格都是右键热区。
                                ⚠️ ContextMenu 挂在 Border 上，code-behind 同步 DataContext 用 HeaderCheckHost。
                            -->
                            <Border
                                x:Name="HeaderCheckHost"
                                Grid.Column="0"
                                Background="Transparent"
                                Cursor="Hand"
                                IsEnabled="{Binding HasItems}"
                                IsVisible="{Binding IsPickVisible}"
                                ToolTip.Tip="点 = 全选 / 取消；右键 = 全选 / 取消选择 / 反选">
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleAllCommand}"
                                    IsChecked="{Binding AllCheckedState, Mode=OneWay}" />
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding CheckAllCommand}" Header="☑ 全选（当前列表）" />
                                        <MenuItem Command="{Binding UncheckAllCommand}" Header="☐ 取消选择" />
                                        <MenuItem Command="{Binding InvertCheckedCommand}" Header="🔄 反选" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <Button
                                Grid.Column="1"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Kind"
                                Content="{Binding KindHeader}"
                                IsVisible="{Binding IsKindVisible}" />
                            <Button
                                Grid.Column="2"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Name"
                                Content="{Binding NameHeader}"
                                IsVisible="{Binding IsNameVisible}" />
                            <Button
                                Grid.Column="3"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Param"
                                Content="{Binding ParamHeader}"
                                IsVisible="{Binding IsParamVisible}" />
                            <Button
                                Grid.Column="4"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Before"
                                Content="{Binding BeforeHeader}"
                                IsVisible="{Binding IsBeforeVisible}" />
                            <Button
                                Grid.Column="5"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="After"
                                Content="{Binding AfterHeader}"
                                IsVisible="{Binding IsAfterVisible}" />
                            <Button
                                Grid.Column="6"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Status"
                                Content="{Binding StatusHeader}"
                                IsVisible="{Binding IsStatusVisible}" />
                            <TextBlock
                                Grid.Column="7"
                                Classes="list-cell"
                                FontWeight="SemiBold"
                                IsVisible="{Binding IsProgressVisible}"
                                Text="进度" />
                            <!--  v3.15 §6.4.8 扩充列（列索引 7~9，与 Columns 元数据一一对应）  -->
                            <Button
                                Grid.Column="8"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Source"
                                Content="{Binding SourceHeader}"
                                IsVisible="{Binding IsSourceVisible}" />
                            <Button
                                Grid.Column="9"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Command"
                                Content="{Binding CommandHeader}"
                                IsVisible="{Binding IsCommandVisible}" />
                            <Button
                                Grid.Column="10"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Created"
                                Content="{Binding CreatedHeader}"
                                IsVisible="{Binding IsCreatedVisible}" />
                            <v:ColumnGrid.ContextMenu>
                                <ContextMenu>
                                <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                      <Setter Property="Header" Value="{Binding Label}"/>
                                      <Setter Property="Command" Value="{Binding Command}"/>
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                    <Separator />
                                    <!--  v3.16：勾选列也进「列显隐」（⛔ IsChecked 必须 Mode=OneWay，翻转由 ToggleColumnCommand 独家负责）  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Pick"
                                        Header="勾选框"
                                        IsChecked="{Binding IsPickVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Kind"
                                        Header="类型"
                                        IsChecked="{Binding IsKindVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Name"
                                        Header="文件"
                                        IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Param"
                                        Header="参数"
                                        IsChecked="{Binding IsParamVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Before"
                                        Header="处理前"
                                        IsChecked="{Binding IsBeforeVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="After"
                                        Header="处理后"
                                        IsChecked="{Binding IsAfterVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Status"
                                        Header="状态"
                                        IsChecked="{Binding IsStatusVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Progress"
                                        Header="进度"
                                        IsChecked="{Binding IsProgressVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Source"
                                        Header="源文件"
                                        IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Command"
                                        Header="命令摘要"
                                        IsChecked="{Binding IsCommandVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Created"
                                        Header="创建时间"
                                        IsChecked="{Binding IsCreatedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                </ContextMenu>
                            </v:ColumnGrid.ContextMenu>
                        </v:ColumnGrid>
                    </Border>

                    <!--  v3.22 §4.8.1：示例行（水印）—— 队列为空时显示，有真实任务后消失；⛔ 不进 Items  -->
                    <Border
                        Grid.Row="1"
                        Classes="list-header"
                        IsVisible="{Binding ShowSampleRow}"
                        Opacity="0.5"
                        ToolTip.Tip="这是示例数据（列宽就按它判定）；加入任务后这一行会消失">
                        <v:ColumnGrid ColumnSpecs="{Binding VisibleColumnSpecs}">
                            <TextBlock Grid.Column="1" Classes="list-cell" IsVisible="{Binding IsKindVisible}" Text="{Binding SampleRowTexts[1]}" />
                            <TextBlock Grid.Column="2" Classes="list-cell primary" IsVisible="{Binding IsNameVisible}" Text="{Binding SampleRowTexts[2]}" />
                            <TextBlock Grid.Column="3" Classes="list-cell" IsVisible="{Binding IsParamVisible}" Text="{Binding SampleRowTexts[3]}" />
                            <TextBlock Grid.Column="4" Classes="list-cell" IsVisible="{Binding IsBeforeVisible}" Text="{Binding SampleRowTexts[4]}" />
                            <TextBlock Grid.Column="5" Classes="list-cell" IsVisible="{Binding IsAfterVisible}" Text="{Binding SampleRowTexts[5]}" />
                            <TextBlock Grid.Column="6" Classes="list-cell" IsVisible="{Binding IsStatusVisible}" Text="{Binding SampleRowTexts[6]}" />
                            <TextBlock Grid.Column="7" Classes="list-cell" IsVisible="{Binding IsProgressVisible}" Text="{Binding SampleRowTexts[7]}" />
                            <TextBlock Grid.Column="8" Classes="list-cell" IsVisible="{Binding IsSourceVisible}" Text="{Binding SampleRowTexts[8]}" />
                            <TextBlock Grid.Column="9" Classes="list-cell" IsVisible="{Binding IsCommandVisible}" Text="{Binding SampleRowTexts[9]}" />
                            <TextBlock Grid.Column="10" Classes="list-cell" IsVisible="{Binding IsCreatedVisible}" Text="{Binding SampleRowTexts[10]}" />
                        </v:ColumnGrid>
                    </Border>

                    <ListBox
                        x:Name="TaskList"
                        Grid.Row="2"
                        Classes="list-page"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <Separator />
                                <MenuItem Command="{Binding SaveCommand}" Header="💾 保存修改" />
                                <MenuItem
                                    Command="{Binding RunSelectedCommand}"
                                    Header="▶ 只跑选中"
                                    IsEnabled="{Binding IsNotBusy}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding DeleteCommand}"
                                    Header="🗑 删除任务"
                                    IsEnabled="{Binding IsNotBusy}" />
                                <MenuItem Command="{Binding OpenOutputFolderCommand}" Header="📂 打开输出目录" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                                    <!--  v3.16 §6.4.10：行首勾选框（配合表头 ☑ 的 全选 / 取消 / 反选）  -->
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[ListBox].DataContext.ItemCheckedCommand}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsPickVisible}"
                                        ToolTip.Tip="勾上后可以配合表头 ☑ 做批量勾选" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsKindVisible}"
                                        Text="{Binding KindDisplay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsParamVisible}"
                                        Text="{Binding ParamDisplay}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsBeforeVisible}"
                                        Text="{Binding BeforeDisplay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Classes="list-cell accent"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsAfterVisible}"
                                        Text="{Binding OutputSizeDisplay}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"
                                        Text="{Binding StatusDisplay}" />
                                    <ProgressBar
                                        Grid.Column="7"
                                        Classes="task-progress"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsProgressVisible}"
                                        Maximum="100"
                                        Value="{Binding Progress}" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <TextBlock
                                        Grid.Column="8"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"
                                        Text="{Binding SourcePath}" />
                                    <!--
                                        命令摘要是 **VM 现算的**（不是模型属性）：往上找 ListBox 的 DataContext 调不了带参方法，
                                        所以这里绑到模型自带的 RawArgs / ParamDisplay 兜底显示；完整命令行仍在详情卡命令区。
                                    -->
                                    <TextBlock
                                        Grid.Column="9"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCommandVisible}"
                                        Text="{Binding CommandSummaryDisplay}" />
                                    <TextBlock
                                        Grid.Column="10"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCreatedVisible}"
                                        Text="{Binding CreatedDisplay}" />
                                </v:ColumnGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>