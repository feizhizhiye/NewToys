<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Controls"
             xmlns:v="using:NewToys.ScriptManager.Views"
             x:Class="NewToys.ScriptManager.Views.SettingsScriptView">
  <!--
    「脚本管理器」模块设置页（v3.64 / NT-061，自注册进 settings 分组，Key = settings-script / Order 110）。
    v3.65 / NT-062：三个解释器路径已回迁应用级（「设置 → 运行环境」），本页只剩**脚本目录**一项；
                    原「软件源」页（Key settings-package）并入本页。
    🔴 NT-068（2026-10-18）：改用与应用级设置页同一套骨架 <ui:SettingsSectionHost>（节 = 折叠卡片），
       3 节 ⇒ `Sticky="False"`。节内⛔ 再写 Border.card；子控件 PackageSourceView 自带 ScrollViewer 已去。
    规范 §4.9：路径 = 即时生效（失焦即落盘，⛔ 无保存按钮）；无效路径 ⇒ 底栏红字 + ⛔ 不写盘。

    ⚠️ 节内容 = `<UserControl.Resources>` 里的 `SecN` 面板；节元数据（标题/图标/说明）在 code-behind 的 `Add(...)`。
      （⛔ 不要在 XAML 里直接写 `<ui:SettingsSection>`：该页会不被预编译 ⇒ 运行时 `No precompiled XAML found`。）
  -->

  <UserControl.Resources>
    <StackPanel x:Key="Sec0" Spacing="10">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="脚本目录（留空 = 默认目录）" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox
                Width="360"
                PlaceholderText="留空 = 默认脚本目录"
                Text="{Binding ScriptsFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <Button Classes="ghost" Content="📂 选目录…" Command="{Binding PickScriptsFolderCommand}" />
            <Button Classes="ghost" Content="↺ 用默认" Command="{Binding ResetScriptsFolderCommand}" />
          </StackPanel>
          <TextBlock
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding ScriptsFolderEffective, StringFormat='生效目录：{0}'}" />
          <TextBlock
              Classes="hint-text"
              TextWrapping="Wrap"
              Text="{Binding DefaultScriptsFolder, StringFormat='默认目录：{0}（用应用根 —— 多配置共享同一份脚本）'}" />
        </StackPanel>

        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="「脚本库」页工具条上的「脚本目录」框和这里是同一份值：那条框改完（回车 / 点开别处）也写进本页的设置文件。" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec1" Spacing="10">
      <StackPanel Spacing="10">
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="原「设置 → 软件源」页 v3.65 起并入本页（不再单独占菜单项）；数据仍落 config\package.json，会被「设置 → 数据」的备份一起带走。" />
        <v:PackageSourceView DataContext="{Binding PackageSource}" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Key="Sec2" Spacing="10">
      <StackPanel Spacing="6">
        <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Text="{Binding ConfigFilePath}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="它在 config 目录下 —— 「设置 → 数据」的备份 / 导入会一起覆盖它。" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="三个解释器路径（pwsh / Python / Windows PowerShell 5.1）属于「运行环境」（应用级，跨配置共享），在「设置 → 运行环境」页配置。" />
        <TextBlock
            Classes="hint-text"
            TextWrapping="Wrap"
            Text="{Binding StatusText, StringFormat='状态：{0}'}" />
      </StackPanel>
    </StackPanel>
  </UserControl.Resources>

  <ui:SettingsSectionHost x:Name="Host" Sticky="False" />
</UserControl>
