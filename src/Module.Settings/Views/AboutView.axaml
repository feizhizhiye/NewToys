<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Settings.Views.AboutView">
  <Grid RowDefinitions="Auto,*">
    <!-- 操作行：原页头右侧按钮迁移至此；页名已由左侧二级菜单体现，内容区不再重复标题页头。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="24,16,24,0" Spacing="8">
      <Button Classes="primary" Content="🔄 检查更新"/>
      <Button Classes="ghost" Content="📂 打开项目主页"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="24,8,24,16">
      <Border Classes="card">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4"><StackPanel Spacing="12"><Border Classes="card"><StackPanel Spacing="4"><TextBlock Text="NewToys" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="个人高强度使用工具集 · 跨平台（Windows / macOS / Linux）" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="4"><TextBlock Text="技术栈" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text=".NET 10 · Avalonia 12.1.3 · CommunityToolkit.Mvvm 8.4.2 · Microsoft.Extensions.DependencyInjection 9.0.0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></StackPanel></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
