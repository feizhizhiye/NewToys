<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.ScrapeView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid ColumnDefinitions="*,Auto" Margin="12">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->

    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="primary" Content="➕ 新建任务" Margin="0,0,8,0" Command="{Binding NewTaskCommand}"/>
          <Button Classes="ghost" Content="▶ 运行全部" Margin="0,0,8,0" Command="{Binding RunAllCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Classes="ghost" Content="🔄 重读任务" Margin="0,0,8,0" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="重新读一遍本地的抓取任务配置（⛔ 不开始抓取）"/>
          <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="搜索名称 / 网址 / 规则…"/>
          <TextBlock Text="右键列表项：运行 / 发送到书签 / 编辑 / 删除" FontSize="11"
                     VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
        <Button Grid.Column="1" Classes="detail-toggle"
                Command="{Binding ToggleDetailCommand}"
                ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
          <Panel>
            <TextBlock Text="❯" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsDetailVisible}"/>
            <TextBlock Text="❮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsDetailVisible}"/>
          </Panel>
        </Button>
      </Grid>
    </Border>

    

      <!--  ==================== 列表本体  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding UrlHeader}"
                      IsVisible="{Binding IsUrlVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding RuleHeader}"
                      IsVisible="{Binding IsRuleVisible}"/>
              <Button Grid.Column="3" Classes="col-header" Content="{Binding LastRunHeader}"
                      IsVisible="{Binding IsLastRunVisible}"/>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="名称" IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="起始网址" ToggleType="CheckBox" IsChecked="{Binding IsUrlVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Url"/>
                  <MenuItem Header="规则" ToggleType="CheckBox" IsChecked="{Binding IsRuleVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Rule"/>
                  <MenuItem Header="最近运行" ToggleType="CheckBox" IsChecked="{Binding IsLastRunVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="LastRun"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="TaskList" Classes="list-page"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="▶ 运行" Command="{Binding RunCommand}"/>
                <MenuItem Header="🔖 发送到书签" Command="{Binding SendToBookmarkCommand}"/>
                <Separator/>
                <MenuItem Header="✏ 编辑" Command="{Binding ShowDetailCommand}"/>
                <MenuItem Header="🗑 删除" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding StartUrl}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsUrlVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Rule}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsRuleVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell"
                             Text="{Binding LastRunAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsLastRunVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

    <!--  右：详情（配置 + 输出）；这一页更宽（要放规则 / 脚本），只覆盖 Width，其余沿用共享样式  -->
    <Border Grid.Column="1" Classes="detail-card" Width="420"
              IsVisible="{Binding IsDetailVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2" IsVisible="{Binding !HasSelection}">
              <TextBlock Text="在左侧列表里选中一个任务" FontSize="13" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
              <TextBlock Text="任务名" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Name, Mode=TwoWay}"/>

              <TextBlock Text="起始网址" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.StartUrl, Mode=TwoWay}"/>

              <TextBlock Text="抓取规则类型" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <ComboBox ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding Selected.RuleType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>

              <TextBlock Text="抓取规则（CSS 选择器如 div.news a；或正则）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Rule, Mode=TwoWay}"/>

              <TextBlock Text="User-Agent（留空用默认）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.UserAgent, Mode=TwoWay}"/>

              <TextBlock Text="整合脚本（JavaScript）：变量 items 为抓取到的字符串数组，返回最终文本" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.JsScript, Mode=TwoWay}" AcceptsReturn="True" Height="90"
                       TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       PlaceholderText="留空 = 直接拼接。示例：items.map(s=>s.trim()).filter(Boolean).join('\n')"/>

              <!-- ⚠️ Avalonia 的 WrapPanel **没有** Spacing 属性（StackPanel 才有）→ 用按钮 Margin 做间距 -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Content="▶ 运行" Margin="0,0,6,0" Command="{Binding RunCommand}"/>
                <Button Classes="ghost" Content="💾 保存" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                <Button Classes="ghost" Content="🗑 删除" Command="{Binding DeleteCommand}"/>
              </WrapPanel>

              <StackPanel Spacing="2"
                          IsVisible="{Binding Selected.LastOutput, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Selected.LastCount, StringFormat='最近运行：{0} 条'}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding Selected.LastRunAt, StringFormat='运行时间：{0:yyyy-MM-dd HH:mm}'}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="输出" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <SelectableTextBlock Text="{Binding Selected.LastOutput}" FontFamily="Consolas" FontSize="11"
                                    TextWrapping="Wrap" MaxHeight="240"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
  </Grid>
</UserControl>
