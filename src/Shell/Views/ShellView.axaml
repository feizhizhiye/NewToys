<!--  NT-040 · 🔴 2026-10-15 定案：窗口装饰走 **Avalonia 12 官方 CSD 路线**（需求 §4.1.1）。
      `WindowDecorations="Full"` 只为拿到**完整标准窗口样式**（贴靠资格 / 系统菜单 / 最小化动画），
      ⛔ **不等于让 Avalonia 画默认那套窗框** —— 顶掉默认主题靠 `App.axaml` 里以**隐式键**
      `{x:Type chrome:WindowDrawnDecorations}` 注册的 ControlTheme（不设 Template → 无模板 → 不画装饰视觉）。
      🔴 12.1.3 里**没有可用的装饰模板类型**（`WindowDrawnDecorationsTemplate` 是 internal，`Template` 是接口）
      → ⛔ 别试图写自定义装饰模板，会报 AVLN2000（详见 `App.axaml` 注释）。
      ⛔ **不要改回 `BorderOnly` / `None`**：`BorderOnly` 时 Avalonia 不设 `WS_CAPTION`，贴靠资格得靠 code-behind
      手工补样式位（v3.28 野路子，NT-041 已删）；`None` 不设 `WS_THICKFRAME` → 贴靠后尺寸偏、露桌面背景（NT-034 实测）。
      主题引用用 **`DynamicResource`**（⛔ 不用 StaticResource）：装饰主题在合并字典完成前就可能被解析，
      StaticResource 那一刻会取不到（AtomUI 实战指南 §15 的已知坑）。
      🔴 **客户区零内缩由我们接管**（Windows 独有的那一处例外，原理见 `ShellView.axaml.cs` 的 `InstallSnapFrameFix`）：
      Avalonia CSD 会按 `WS_CAPTION|WS_THICKFRAME` 扣掉 ≈8px **非客户区**，贴靠态系统不画那圈 → 露缝（左右下）；
      零内缩让「客户区 = 外框」消除它，自绘 1px 外框（NT-039）正好落在窗口外沿。
      ℹ️ 残留（系统级，Firefox 同复现 ⇒ 接受）：**首次分屏左右下偏大 1~2px**；常规态左右不对称（左重叠 / 右缝隙）。
      ⛔ 不做外部几何纠偏（NT-048 那套已证伪并删除）。  -->
<Window
    x:Class="NewToys.Shell.Views.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:ctl="clr-namespace:NewToys.Shell.Controls"
    Title="NewToys"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="640"
    Background="{DynamicResource ContentBrush}"
    ExtendClientAreaTitleBarHeightHint="40"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="Full"
    WindowDecorationsTheme="{DynamicResource {x:Type chrome:WindowDrawnDecorations}}"
    CanResize="True"
    WindowState="Normal">

    <!--  v3.45：标签项模板提为共享资源 —— 首页标签（固定列，不滚动）与滚动区标签（ScrollableTabs）
          共用同一份 DataTemplate（⛔ 不复制两份，防样式漂移）。  -->
    <Window.Resources>
        <DataTemplate x:Key="TabItemTemplate">
            <!--  标签项 = 纯标题（无图标）；✕ 仅在鼠标悬停本标签时显示（样式控制）  -->
            <Border Classes="tab-item" Classes.active="{Binding IsActive}">
                <!--  单格 Grid：标题按钮撑开标签宽度，关闭按钮**叠在上层贴右端**（不占位 → 标签更窄）  -->
                <Grid>
                    <Button
                        Classes="tab-btn"
                        Command="{Binding $parent[Window].DataContext.ActivateTabCommand}"
                        CommandParameter="{Binding}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Title}" />
                    </Button>
                    <!--
                        v3.22：套 **裸按钮主题** —— Fluent 的 Button 模板会在 :pointerover
                        自己画背景、把前景改成主题色（表现为"白 ✕ + 能看出底"），Style 压不过它。
                    -->
                    <!--  NT-045：✕ 改**矢量 Path**（原为 TextBlock 字符）——
                         颜色走 `Button.tab-close Path` 样式、悬停变红 + 放大（ScaleTransform）。  -->
                    <Button
                        Classes="tab-close"
                        Theme="{StaticResource BareButtonTheme}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding $parent[Window].DataContext.CloseTabCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding CanClose}"
                        ToolTip.Tip="关闭标签">
                        <Path
                            Width="12"
                            Height="12"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconTabClose}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!--  外层 Grid 无 RowDefinitions：装「内容层 + 窗口外框 + 缩放热区」三层叠加。  -->
    <Grid>

        <!--  ==================== 内容层  ==================== -->
        <Grid RowDefinitions="40,*">

        <!--  ==================== ① 标题栏（40px，底色 = 主题背景）  ====================
              左：≡折叠 ｜ ⟳重建当前页
              中：标签页 + ＋（**左右各 16px 固定留白**，留白处可拖拽窗口）
              右：窗口按钮
              ⛔ v3.4 已删：🏠 主页按钮 / ⚙ 设置按钮 / 🌓 主题开关
              ⛔ v3.5 已删：◀ ▶ 前进/后退按钮
              ⚠️ 拖拽过滤按「命中祖先是不是 Button」通用判定，新增按钮无需登记。 -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource ContentBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
            <!--  v3.28 修贴靠：标题栏标成 **TitleBar** 角色 → 由**系统**处理拖动（含拖到边缘贴靠、拖到顶边最大化、
                  双击最大化）；⛔ 不再依赖我们自己的 BeginMoveDrag（它发 WM_SYSCOMMAND/SC_MOUSEMOVE，
                  系统不认作"拖标题栏"→ 不触发贴靠，这正是之前贴靠失效的根因）。
                  🔴 **TitleBar 区域内的交互控件必须另标 `User`**（放行点击）——否则整块按"标题栏"处理，
                     里面的按钮 / 标签页收不到点击（v3.28 实测：外观正常但五个按钮与标签栏全部不可用）。
                     标在三处容器上：左按钮组 / 标签条（含 ＋）/ 右窗口按钮组；中间的 24px 留白保持 TitleBar
                     → 那里仍是系统拖动（贴靠有效）。  -->
            <Grid
                x:Name="TitleBarGrid"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                ColumnDefinitions="Auto,*,Auto">

                <!--  左：窗口功能按钮  -->
                <!--  NT-045：图标**一律矢量 `Path` + `App.axaml` 的 `Icon*` 几何键**（24×24 网格），
                     粗细 / 端帽 / 拐角 / 颜色全由 `Button.title-btn Path` 样式给，XAML 里只写 Data + 尺寸。
                     折叠按钮的图案 = 面板 + 左栏（Lucide `panel-left`）。
                     NT-052：「🔄 重载模块」按钮已移入**功能清单页**「增加功能」操作区（标题栏 3→2 按钮）。  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="4,0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    chrome:WindowDecorationProperties.ElementRole="User">
                    <Button Classes="title-btn" Command="{Binding ToggleTreeCommand}" ToolTip.Tip="折叠 / 展开左侧菜单">
                        <Path
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{StaticResource IconMenuPanel}" />
                    </Button>
                    <Button Classes="title-btn" Command="{Binding RefreshCommand}" ToolTip.Tip="重建当前页（丢掉筛选 / 排序 / 未保存的编辑，回到刚打开时的状态）">
                        <Path
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{StaticResource IconRefresh}" />
                    </Button>
                </StackPanel>

                <!--  中：标签页。**左右各留 24px 固定空白**（独立占位列，标签再多也挤不掉），空白处可拖拽窗口；滚轮可切换标签  -->
                <Grid Grid.Column="1" ColumnDefinitions="24,*,24">
                    <Panel Grid.Column="0" Background="Transparent" />
                    <Grid
                        x:Name="TabStrip"
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        ColumnDefinitions="Auto,*">
                        <!--  v3.45：首页标签 = **唯一固定元素**（单独一列、不进 ScrollViewer）；其余全部参与横向滚动。
                              数据 = ShellViewModel.HomeTab；模板与滚动区共用 TabItemTemplate。
                              ⛔ 不做「固定其他标签页」功能（「固定」需求走首页收藏夹 / 常用功能，见需求 §4.2）。  -->
                        <ContentControl Grid.Column="0" Content="{Binding HomeTab}"
                                        ContentTemplate="{StaticResource TabItemTemplate}"
                                        VerticalAlignment="Center"/>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ItemsControl x:Name="TabsControl" ItemsSource="{Binding ScrollableTabs}"
                                          ItemTemplate="{StaticResource TabItemTemplate}"
                                          VerticalAlignment="Center">
                                <!--  🔴 必须显式横排面板：默认竖排 StackPanel + 竖滚禁用 = 只显示第一个（v3.44 踩过）  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!--  ＋ 打开「功能清单」页（当选择器用；已打开则激活）—— 参与横向滚动（v3.45 回归原位）。
                                 NT-045：图标改矢量 `IconPlus`（24×24 网格，等比缩到 14px），颜色 / 粗细走
                                 `Button.tab-new Path` 样式。  -->
                            <Button
                                Classes="tab-new"
                                Command="{Binding OpenFunctionListCommand}"
                                Margin="4,0,0,0"
                                ToolTip.Tip="功能清单（打开新页面）">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource IconPlus}" />
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Panel Grid.Column="2" Background="Transparent" />
                </Grid>

                <!--  右：窗口按钮  -->
                <!--  NT-045 统一：窗口按钮图标**一律矢量 `Path` + `App.axaml` 的 `Icon*` 几何键**
                     （最小化 `IconWinMinimize` / 最大化 `IconWinMaximize` / 还原 `IconWinRestore` /
                      关闭 `IconWinClose` / 全屏 `IconFullScreen` / 退出全屏 `IconExitFullScreen`），
                     形状与 WinUI `Symbol` 同款但**不再依赖 `Segoe MDL2 Assets` 图标字体**。
                     ⛔ 不再用 `Rectangle` 画横线、`Border` 拼方框、`TextBlock` 字形 —— 框架层只剩一种载体。
                     颜色由 `Button.win-btn Path` 样式给（关闭悬停转白由 `.close:pointerover Path` 给）。
                     ✅ 旧结论「`Path` 在裸主题里渲染不出来」的真因（模板 ∞ 约束 → NaN 尺寸）NT-045 已修、
                         **NT-046 实机截图取证确认**（方框 / ✕ 正常显示）。
                     🔴 NT-046：最小化图标几何上"只有 1 单位高"，`Stretch="Uniform"` 等比缩放后会被**贴到方框顶部**（实机偏上约 7px）
                         ⇒ 它是本组**唯一**用 `Stretch="None"` 的图标（几何写成 16×16 控件坐标，`y=8` 居中）。
                         其余图标仍一律 24×24 网格 + `Stretch="Uniform"`（框架层几何必须有非零宽高，见 `App.axaml` 资源区注释）。  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    chrome:WindowDecorationProperties.ElementRole="User">
                    <!--  NT-044：全屏按钮（⛶）—— 位置在最小化左边。
                         ⚠️ **不单设** `ElementRole="FullScreenButton"` —— 切换一律由 code-behind 的 Click 处理；
                            父 StackPanel 已标 `User`（点击照常放行）。若框架也自动切一次，就会和我们重复触发。  -->
                    <Button
                        x:Name="BtnFullScreen"
                        Width="46"
                        Height="40"
                        Classes="win-btn"
                        Theme="{StaticResource BareButtonTheme}"
                        ToolTip.Tip="全屏 (F11)">
                        <Grid
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!--  进入全屏 NT-046 改型：**两个朝外的斜箭头**（Lucide `maximize-2`）  -->
                            <Path
                                x:Name="FullScreenIcon"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Data="{StaticResource IconFullScreen}" />
                            <!--  退出全屏：**两个朝内的斜箭头**（Lucide `minimize-2`）  -->
                            <Path
                                x:Name="ExitFullScreenIcon"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                IsVisible="False"
                                Data="{StaticResource IconExitFullScreen}" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="BtnMin"
                        Width="46"
                        Height="40"
                        Classes="win-btn"
                        Theme="{StaticResource BareButtonTheme}"
                        ToolTip.Tip="最小化">
                        <!--  🔴 NT-046 收尾：横杠**必须** `Stretch="None"` —— 几何是 16×16 控件坐标（`y=8` = 竖直居中）。
                              ⛔ 用 `Stretch="Uniform"` 会因"包围盒只有 1 单位高"被等比缩放贴到方框顶部（实机偏上约 7px）。
                              外层 Grid（16×16 居中）与最大化 / 全屏按钮同结构，保证与 □ ✕ ⛶ 落在同一水平线。  -->
                        <Grid
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Path
                                Width="16"
                                Height="16"
                                Stretch="None"
                                Data="{StaticResource IconWinMinimize}" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="BtnMax"
                        Width="46"
                        Height="40"
                        Classes="win-btn"
                        Theme="{StaticResource BareButtonTheme}"
                        ToolTip.Tip="最大化">
                        <Grid
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!--  最大化：单个方框  -->
                            <Path
                                x:Name="MaximizeIcon"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Data="{StaticResource IconWinMaximize}" />
                            <!--  还原：前后两个错位方框  -->
                            <Path
                                x:Name="RestoreIcon"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                IsVisible="False"
                                Data="{StaticResource IconWinRestore}" />
                        </Grid>
                    </Button>
                    <!--  class 必须是 win-btn + close：App.axaml 里定义的是 Button.win-btn.close:pointerover（关闭变红）  -->
                    <Button
                        x:Name="BtnClose"
                        Width="46"
                        Height="40"
                        Classes="win-btn close"
                        Theme="{StaticResource BareButtonTheme}"
                        ToolTip.Tip="关闭">
                        <!--  ⚠️ 套 BareButtonTheme：Fluent 模板在 :pointerover 于模板子元素上自己画背景，
                             Style 压不过 → 悬停红底画不出来。裸主题用 Border 接 Background 才生效。
                             🔴 图标是 `Path`：描边色走样式（普通态 `PrimaryTextBrush`、悬停 `TitleBarCloseHoverTextBrush` = 白）。  -->
                        <Path
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{StaticResource IconWinClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==================== ②③④⑤ 左树 + (内容 + 右详情 + 底部状态栏)  ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!--  左树（240px / 折叠 48px）：首页 + 一级分组（矢量图标、加粗、默认折叠）+ 二级功能（缩进、次要色、无图标）  -->
            <Border
                x:Name="TreePanel"
                Grid.Column="0"
                Width="{Binding TreePanelWidth}"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0"
                Classes="tree-panel"
                Classes.collapsed="{Binding IsTreeCollapsed}">
              <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TreeControl" ItemsSource="{Binding TreeNodes}" Margin="8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!--  一级：分组（可展开）/ 首页（叶子）；图标为矢量图、文字加粗  -->
                                    <Button
                                        Classes="tree-row"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding $parent[Window].DataContext.TreeClickCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Title}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!--  一级图标 = 矢量（`VectorIcon` 由 VM 按几何键解析）。颜色由样式给
                                                 （`Button.tree-row Path` / `.active Path`）→ 折叠态也能显主题色。
                                                 ⛔ 不再有 emoji 回退：键名必须在 `App.axaml` 定义。
                                                 🔴 NT-046：行首**展开箭头已去掉** —— 左树只有一级有图标，
                                                    行首再占 12px 会让一级 / 二级行不对齐（`IconChevronDown/Right`
                                                    两个键留在资源库里备后续可折叠区块用）。  -->
                                            <Path
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Data="{Binding VectorIcon}"
                                                IsVisible="{Binding HasVectorIcon}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="tree-title"
                                                FontSize="15"
                                                Text="{Binding Title}" />
                                        </Grid>
                                    </Button>
                                    <!--  二级：功能叶子（缩进 + 次要色，无图标）  -->
                                    <!--  Margin 上边距 4：一级行与其下第一个二级行之间留出层级间隔
                                          （否则两行都激活时圆角背景块贴合、看着连成一整块）。⛔ 不是行高、别改 Height。  -->
                                    <ItemsControl
                                        Classes="tree-children"
                                        ItemsSource="{Binding Children}"
                                        IsVisible="{Binding IsExpanded}"
                                        Margin="16,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Classes="tree-row sub"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[Window].DataContext.TreeClickCommand}"
                                                    CommandParameter="{Binding}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="tree-title"
                                                        FontSize="13"
                                                        Text="{Binding Title}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  左树底部：版本号区（v3.9；**折叠态隐藏**）。⚠️ 独立占位值，与「设置 → 关于」的版本号无关。  -->
                <Border Grid.Row="1" Classes="tree-version" ToolTip.Tip="当前配置 · 版本号">
                  <TextBlock Classes="tree-version-text" Text="{Binding TreeVersionText}" />
                </Border>
              </Grid>
            </Border>

            <!--  中右区：内容 + 右详情 + **底部状态栏**（状态栏横贯内容区与详情区）  -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                <!--  内容列 = 声明式工具条（NT-055）+ 页面本体  -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">

                  <!--  🔴 NT-055 / 需求 §4.8.5：工具条由 **Shell 统一承载**（页面 VM 实现 IToolbarSource 才有这一行；
                        未接契约的页继续用自己的页内自绘工具条 ⇒ ⛔ 不会两处同时渲染）。
                        Margin 12,12,12,0 = 与页面根 Margin="12" 的左 / 右 / 上对齐。  -->
                  <Border
                      Grid.Row="0"
                      Classes="toolbar"
                      Margin="12,12,12,0"
                      IsVisible="{Binding IsToolbarActive}">
                    <ctl:ToolbarHost Source="{Binding ToolbarSource}" />
                  </Border>

                  <!--  内容区：绑定当前激活标签页缓存的 View 实例  -->
                  <ContentControl
                      x:Name="ContentArea"
                      Grid.Row="1"
                      Background="{DynamicResource ContentBrush}"
                      Content="{Binding ActiveTab.Content}" />
                </Grid>

                <!--  右详情面板（340px，可开合）：由 Shell 统一承载。
                     内容两轨（NT-054 需求 §4.5.1）：
                     ① 声明式（新）—— 页面 VM 实现 IDetailCardSource 且 Card 非 null → 用 DetailCardHost 统一渲染
                        （外壳 / 滚动 / 空态 / 示例态只实现一次，页面不再各写一份）；
                     ② 自绘（老）—— 尚未迁移的页仍返回 IDetailPanelProvider.DetailContent，原样承载。
                     ⚠️ DetailCardHost 的 DataContext 必须是**页面 VM**（描述符路径的解析根），
                        所以 Source 绑页面 VM、Card 绑描述符，⛔ 不给控件本身设 DataContext。  -->
                <Border
                    x:Name="DetailPanel"
                    Grid.Column="1"
                    Width="340"
                    IsVisible="{Binding IsDetailPanelVisible}"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0">
                    <Panel>
                        <ContentControl Content="{Binding DetailPanelContent}" IsVisible="{Binding !IsDetailCardActive}" />
                        <ctl:DetailCardHost
                            Card="{Binding DetailCard}"
                            IsVisible="{Binding IsDetailCardActive}"
                            Source="{Binding DetailCardSource}" />
                    </Panel>
                </Border>
              </Grid>

              <!--  底部状态栏（v3.9）：Shell 统一承载，内容来自当前页的 IStatusProvider；页面没接契约就为空。
                    模块/功能数改由**首页 VM** 经 IStatusProvider 提供（仅首页显示，见 NT-009 / HomeViewModel）。  -->
              <Border Grid.Row="1" Classes="status-bar">
                <TextBlock Classes="status-bar-text" Text="{Binding StatusBarText}" />
              </Border>
            </Grid>
        </Grid>

        </Grid>

        <!--  ==================== 窗口外框（NT-039） ====================
              根因：开了客户区扩展后 DWM 把边框交给应用画，而 Avalonia 在 Win32 上只接管标题栏
              （`:has-border` 恒 false）→ 应用不画就没有边界，窗口叠在同色窗口上完全混淆（需求 §4.1.1 ③）。
              🔴 三个要点：
              ① **叠在最上层、不占布局**（外层 Grid 无行列定义，它是覆盖层）→ ⛔ 不会把内容 inset 1px；
              ② `IsHitTestVisible="False"` → ⛔ 不吃鼠标，下方的缩放热区 / 标题栏按钮照常工作；
              ③ 最大化时收掉外框（Win11 最大化本就无边框，留着贴屏幕边很脏）。
              🔴 **颜色 / 厚度一律由 `App.axaml` 的 `Border.window-frame` 样式给**（⛔ 这里不写本地值）——
                 本地值会压过样式，也就压死了「失焦切淡色」和主题切换。code-behind 只切 Classes。  -->
        <Border
            x:Name="WindowFrameBorder"
            Classes="window-frame"
            IsHitTestVisible="False" />

        <!--  ==================== 窗口缩放抓取区（v3.26，需求 §4.1；v3.28 改走系统命中测试） ====================
              四边 5px + 四角 10px 透明热区，标成 `ResizeN/S/E/W/NE/NW/SE/SW` 角色 → 由**系统**处理缩放
              （光标 / 吸附 / 贴靠一并由系统给）。code-behind 的 BeginResizeDrag 作为角色失效时的兜底保留。
              🔴 Avalonia 12 的托管装饰在 Win32 上不可用（规范 附录A）→ 自绘 + 角色标注是唯一路线。
              ⚠️ 承装 Grid **不设 Background**（否则整层吃掉所有点击）；8 个 Border 必须 Background="Transparent"
                 才有命中测试。最大化时整层 IsHitTestVisible=False（见 code-behind）。  -->
        <Grid x:Name="ResizeGrips">
          <Border x:Name="GripTop" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeN" />
          <Border x:Name="GripBottom" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeS" />
          <Border x:Name="GripLeft" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeW" />
          <Border x:Name="GripRight" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeE" />
          <Border x:Name="GripTopLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
          <Border x:Name="GripTopRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeNE" />
          <Border x:Name="GripBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
          <Border x:Name="GripBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="ResizeSE" />
        </Grid>
    </Grid>
</Window>
