<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Settings.Views.DnsView">
  <Grid RowDefinitions="Auto,*">
    <!-- 操作行：原页头右侧「状态提示」迁移至此；页名已由左侧二级菜单体现，内容区不再重复标题页头。
         ⚠️ 刻意**不放"应用"按钮** —— 开关/下拉/URL 都是即时写盘（见 DnsViewModel 类注释）。 -->
    <TextBlock Grid.Row="0" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,16,24,0"
               Foreground="{DynamicResource SecondaryTextBrush}"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

        <Border Classes="card">
          <StackPanel Spacing="12">
            <CheckBox Content="启用加密 DNS（DoH）" IsChecked="{Binding Enabled, Mode=TwoWay}"
                      FontWeight="SemiBold"/>

            <StackPanel Spacing="6">
              <TextBlock Text="提供商" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <ComboBox SelectedIndex="{Binding ProviderIndex, Mode=TwoWay}"
                        ItemsSource="{Binding Providers}" Width="300" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="自定义 DoH 端点" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding CustomUrl, Mode=TwoWay}"
                       PlaceholderText="https://…（需支持 JSON 接口：?name=x&amp;type=A）"
                       IsEnabled="{Binding CustomEnabled}" MaxWidth="560" HorizontalAlignment="Left"/>
              <TextBlock Text="仅当提供商选「自定义」时可填；其他提供商自动使用内置端点。" FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="当前生效端点" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Text="{Binding Endpoint}" FontSize="12" TextWrapping="Wrap"
                         FontFamily="Consolas" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="测试解析" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
              <TextBlock Text="用当前配置真解析一次，验证 DoH 是否可用（未启用时走系统 DNS）。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding TestHost, Mode=TwoWay}" Width="260"
                       PlaceholderText="要解析的主机名，如 www.baidu.com"/>
              <Button Classes="primary" Content="🧪 解析" Command="{Binding TestCommand}"
                      IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
            <TextBlock Text="{Binding TestResult}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
