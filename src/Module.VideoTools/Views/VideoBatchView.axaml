<UserControl
    x:Class="NewToys.VideoTools.Views.VideoBatchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup">
    <!--  v3.29 / NT-054：**详情卡已迁到 Shell 的声明式渲染**（`IDetailCardSource` + `DetailCardHost`）⇒
          本页只剩「列表列」一列；卡片的声明在 `VideoBatchViewModel.BuildCard()` 里，⛔ 不再页内自绘。
          NT-063 P1：改用列表页骨架 <v:ListPageSkeleton>（card / 空态 / 底栏由骨架提供；⛔ 行模板自写）。  -->
    <v:ListPageSkeleton EmptyMessage="队列是空的。点「导入任务」从导出的 JSON 追加任务。"
                        EmptyActionText="导入任务"
                        EmptyActionCommand="{Binding ImportTasksCommand}"
                        IsEmpty="{Binding !HasItems}">

        <!--  ==================== 列表本体（本页无筛选条 ⇒ TopArea 留空）  ====================  -->
        <v:ListPageSkeleton.HeaderArea>
            <Border Classes="list-header">
                        <!--  v3.20 §6.4.15：IsResizable = 表头列边界可拖动手动调列宽（事件在 code-behind 转给 VM）  -->
                        <v:ColumnGrid
                            x:Name="HeaderGrid"
                            ColumnSpecs="{Binding VisibleColumnSpecs}"
                            IsResizable="True"
                            LockedColumns="{Binding LockedColumnMask}"
                            SampleSpecs="{Binding SampleSpecs}">
                            <!--  列：类型 / 文件 / 参数 / 处理前 / 处理后 / 状态 / 进度 / 源文件 / 命令摘要 / 创建时间 / 完成时间
                                  勾选列已撤（多选走原生 Ctrl / Shift 点选，见 code-behind）  -->
                            <Button
                                Grid.Column="0"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Kind"
                                Content="{Binding KindHeader}"
                                IsVisible="{Binding IsKindVisible}" />
                            <Button
                                Grid.Column="1"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Name"
                                Content="{Binding NameHeader}"
                                IsVisible="{Binding IsNameVisible}" />
                            <Button
                                Grid.Column="2"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Param"
                                Content="{Binding ParamHeader}"
                                IsVisible="{Binding IsParamVisible}" />
                            <Button
                                Grid.Column="3"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Before"
                                Content="{Binding BeforeHeader}"
                                IsVisible="{Binding IsBeforeVisible}" />
                            <Button
                                Grid.Column="4"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="After"
                                Content="{Binding AfterHeader}"
                                IsVisible="{Binding IsAfterVisible}" />
                            <Button
                                Grid.Column="5"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Status"
                                Content="{Binding StatusHeader}"
                                IsVisible="{Binding IsStatusVisible}" />
                            <TextBlock
                                Grid.Column="6"
                                Classes="list-cell"
                                FontWeight="SemiBold"
                                IsVisible="{Binding IsProgressVisible}"
                                Text="进度" />
                            <!--  v3.15 §6.4.8 扩充列（列索引 7~10，与 Columns 元数据一一对应）  -->
                            <Button
                                Grid.Column="7"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Source"
                                Content="{Binding SourceHeader}"
                                IsVisible="{Binding IsSourceVisible}" />
                            <Button
                                Grid.Column="8"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Command"
                                Content="{Binding CommandHeader}"
                                IsVisible="{Binding IsCommandVisible}" />
                            <Button
                                Grid.Column="9"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Created"
                                Content="{Binding CreatedHeader}"
                                IsVisible="{Binding IsCreatedVisible}" />
                            <Button
                                Grid.Column="10"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Finished"
                                Content="{Binding FinishedHeader}"
                                IsVisible="{Binding IsFinishedVisible}" />
                            <v:ColumnGrid.ContextMenu>
                                <ContextMenu>
                                <MenuItem Header="筛选" Icon="{m:Glyph IconSearch}" ItemsSource="{Binding QuickFilters}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                      <Setter Property="Header" Value="{Binding Label}"/>
                                      <Setter Property="Command" Value="{Binding Command}"/>
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Kind"
                                        Header="类型"
                                        IsChecked="{Binding IsKindVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Name"
                                        Header="文件"
                                        IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Param"
                                        Header="参数"
                                        IsChecked="{Binding IsParamVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Before"
                                        Header="处理前"
                                        IsChecked="{Binding IsBeforeVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="After"
                                        Header="处理后"
                                        IsChecked="{Binding IsAfterVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Status"
                                        Header="状态"
                                        IsChecked="{Binding IsStatusVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Progress"
                                        Header="进度"
                                        IsChecked="{Binding IsProgressVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Source"
                                        Header="源文件"
                                        IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Command"
                                        Header="命令摘要"
                                        IsChecked="{Binding IsCommandVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Created"
                                        Header="创建时间"
                                        IsChecked="{Binding IsCreatedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Finished"
                                        Header="完成时间"
                                        IsChecked="{Binding IsFinishedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                </ContextMenu>
                            </v:ColumnGrid.ContextMenu>
                        </v:ColumnGrid>
            </Border>
        </v:ListPageSkeleton.HeaderArea>

        <v:ListPageSkeleton.ListArea>
          <!--  上区 = 还有事要做的任务（待处理 / 运行中 / 失败 / 已取消）；下区 = 已完成，单独一块  -->
          <Grid RowDefinitions="*,Auto">
                    <ListBox
                        Grid.Row="0"
                        x:Name="TaskList"
                        Classes="list-page"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Multiple">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding SelectAllCommand}" Header="全选（当前列表）" Icon="{m:Glyph IconCheckAll}" />
                                <MenuItem Command="{Binding SelectNoneCommand}" Header="取消选择" Icon="{m:Glyph IconUncheckAll}" />
                                <MenuItem Command="{Binding InvertSelectionCommand}" Header="反选" Icon="{m:Glyph IconInvert}" />
                                <Separator />
                                <MenuItem Command="{Binding SaveCommand}" Header="保存修改" Icon="{m:Glyph IconSave}" />
                                <MenuItem
                                    Command="{Binding RunSelectedCommand}"
                                    Header="只跑选中" Icon="{m:Glyph IconPlay}" IsEnabled="{Binding CanActOnSelection}" />
                                <MenuItem
                                    Command="{Binding RequeueSelectedCommand}"
                                    Header="重新排队（清状态再跑）" Icon="{m:Glyph IconReset}" IsEnabled="{Binding CanActOnSelection}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding DeleteCommand}"
                                    Header="删除任务" Icon="{m:Glyph IconTrash}" IsEnabled="{Binding CanActOnSelection}" />
                                <MenuItem Command="{Binding OpenOutputFolderCommand}" Header="打开输出目录" Icon="{m:Glyph IconOpen}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                                    <TextBlock
                                        Grid.Column="0"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsKindVisible}"
                                        Text="{Binding KindDisplay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsParamVisible}"
                                        Text="{Binding ParamDisplay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsBeforeVisible}"
                                        Text="{Binding BeforeDisplay}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Classes="list-cell accent"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsAfterVisible}"
                                        Text="{Binding OutputSizeDisplay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"
                                        Text="{Binding StatusDisplay}" />
                                    <ProgressBar
                                        Grid.Column="6"
                                        Classes="task-progress"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsProgressVisible}"
                                        Maximum="100"
                                        Value="{Binding Progress}" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <TextBlock
                                        Grid.Column="7"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"
                                        Text="{Binding SourcePath}" />
                                    <!--
                                        命令摘要是 **VM 现算的**（不是模型属性）：往上找 ListBox 的 DataContext 调不了带参方法，
                                        所以这里绑到模型自带的 CommandSummaryDisplay（VM 刷新时填）；完整命令行仍在详情卡命令区。
                                    -->
                                    <TextBlock
                                        Grid.Column="8"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCommandVisible}"
                                        Text="{Binding CommandSummaryDisplay}" />
                                    <TextBlock
                                        Grid.Column="9"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCreatedVisible}"
                                        Text="{Binding CreatedDisplay}" />
                                    <TextBlock
                                        Grid.Column="10"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsFinishedVisible}"
                                        Text="{Binding FinishedDisplay}" />
                                </v:ColumnGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  ==================== 下区：已完成（跑成功的结果）  ====================  -->
                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource ContentHeaderBrush}"
                        CornerRadius="6"
                        IsVisible="{Binding HasFinished}">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Border Grid.Row="0" Height="28" Padding="10,0">
                                <TextBlock
                                    Classes="hint-text"
                                    VerticalAlignment="Center"
                                    Text="{Binding FinishedHeaderText}" />
                            </Border>
                            <!--  精简表头：只标下区真正显示的四列；列位与上区共用同一份 VisibleColumnSpecs 保证对齐  -->
                            <Border Grid.Row="1" Classes="list-header">
                                <v:ColumnGrid
                                    ColumnSpecs="{Binding VisibleColumnSpecs}"
                                    LockedColumns="{Binding LockedColumnMask}"
                                    SampleSpecs="{Binding SampleSpecs}">
                                    <TextBlock Grid.Column="1" Classes="list-cell" FontWeight="SemiBold" Text="文件" IsVisible="{Binding IsNameVisible}" />
                                    <TextBlock Grid.Column="4" Classes="list-cell" FontWeight="SemiBold" Text="处理后" IsVisible="{Binding IsAfterVisible}" />
                                    <TextBlock Grid.Column="5" Classes="list-cell" FontWeight="SemiBold" Text="状态" IsVisible="{Binding IsStatusVisible}" />
                                    <TextBlock Grid.Column="10" Classes="list-cell" FontWeight="SemiBold" Text="完成时间" IsVisible="{Binding IsFinishedVisible}" />
                                </v:ColumnGrid>
                            </Border>
                            <ListBox
                                Grid.Row="2"
                                x:Name="FinishedList"
                                Classes="list-page"
                                MaxHeight="220"
                                ItemsSource="{Binding FinishedItems}"
                                SelectedItem="{Binding SelectedFinished, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PlayOutputCommand}" Header="播放输出文件" Icon="{m:Glyph IconPlay}" />
                                        <MenuItem Command="{Binding RevealOutputCommand}" Header="在资源管理器中定位" Icon="{m:Glyph IconOpen}" />
                                        <MenuItem Command="{Binding OpenOutputFolderCommand}" Header="打开输出目录" Icon="{m:Glyph IconOpen}" />
                                        <Separator />
                                        <MenuItem Command="{Binding DeleteFinishedCommand}" Header="从队列删除（不动文件）" Icon="{m:Glyph IconTrash}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                                            <TextBlock
                                                Grid.Column="1"
                                                Classes="list-cell primary"
                                                IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Classes="list-cell accent"
                                                IsVisible="{Binding $parent[ListBox].DataContext.IsAfterVisible}"
                                                Text="{Binding OutputSizeDisplay}" />
                                            <TextBlock
                                                Grid.Column="5"
                                                Classes="list-cell"
                                                IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"
                                                Text="{Binding StatusDisplay}" />
                                            <TextBlock
                                                Grid.Column="10"
                                                Classes="list-cell"
                                                IsVisible="{Binding $parent[ListBox].DataContext.IsFinishedVisible}"
                                                Text="{Binding FinishedDisplay}" />
                                        </v:ColumnGrid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
          </Grid>
        </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>
</UserControl>