<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Views.LaunchConfigView">
  <!--  🔴 本页是设置页的一个节内容，**不许再套内层 ScrollViewer**（会吃掉滚轮，整页滚不动）。
        字段一律「标签 + 输入框」同行（Grid Auto/*），纵排会在大屏上拉出很长的空行。  -->
  <StackPanel
      HorizontalAlignment="Stretch"
      MaxWidth="1080"
      Spacing="10">

    <!--  操作行：保存 = 唯一落盘入口；还原默认只预填输入框。与内容同列左对齐（右对齐会飘到全屏边缘）。  -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="primary" Content="💾 保存" Command="{Binding SaveCommand}" Padding="14,4"
              ToolTip.Tip="改动只在本页暂存，点保存才落盘"/>
      <Button Classes="ghost" Content="🔄 还原默认" Command="{Binding RestoreDefaultsCommand}" Padding="12,4"
              ToolTip.Tip="仅把默认示例填进输入框，点保存才生效"/>
    </StackPanel>

    <!-- ============ 按钮 1 ============ -->
    <Border Classes="card">
      <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="8" ColumnSpacing="10">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" VerticalAlignment="Center"
                Data="{StaticResource IconWeb}" Stretch="Uniform"
                Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round"/>
          <TextBlock Text="按钮 1：浏览器批量开网址" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="（首页颜色：蓝）" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="field-label" Text="按钮名称" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Btn1Name, Mode=TwoWay}"
                 PlaceholderText="浏览器1 批量开网址"/>

        <TextBlock Grid.Row="2" Classes="field-label" Text="浏览器程序" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Btn1Path, Mode=TwoWay}"
                 PlaceholderText="C:/Program Files/Google/Chrome/Application/chrome.exe（留空 = 用系统默认浏览器）"/>

        <TextBlock Grid.Row="3" Classes="field-label" Text="启动参数" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Btn1Args, Mode=TwoWay}"
                 PlaceholderText="留空即可；网址会自动追加到后面（可用 {url} 占位）"/>

        <TextBlock Grid.Row="4" Classes="field-label" Text="网址清单" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Btn1Urls, Mode=TwoWay}" Height="96" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 PlaceholderText="一行一个网址，# 开头为注释"/>
      </Grid>
    </Border>

    <!-- ============ 按钮 2 ============ -->
    <Border Classes="card">
      <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="8" ColumnSpacing="10">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" VerticalAlignment="Center"
                Data="{StaticResource IconWeb}" Stretch="Uniform"
                Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round"/>
          <TextBlock Text="按钮 2：浏览器批量开网址" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="（首页颜色：绿）" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="field-label" Text="按钮名称" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Btn2Name, Mode=TwoWay}"
                 PlaceholderText="浏览器2 批量开网址"/>

        <TextBlock Grid.Row="2" Classes="field-label" Text="浏览器程序" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Btn2Path, Mode=TwoWay}"
                 PlaceholderText="Edge / Firefox 路径；留空 = 系统默认浏览器"/>

        <TextBlock Grid.Row="3" Classes="field-label" Text="启动参数" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Btn2Args, Mode=TwoWay}" PlaceholderText="启动参数"/>

        <TextBlock Grid.Row="4" Classes="field-label" Text="网址清单" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Btn2Urls, Mode=TwoWay}" Height="88" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 PlaceholderText="一行一个网址；留空则该按钮点了也不做事"/>
      </Grid>
    </Border>

    <!-- ============ 按钮 3 ============ -->
    <Border Classes="card">
      <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="8" ColumnSpacing="10">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" VerticalAlignment="Center"
                Data="{StaticResource IconPuzzle}" Stretch="Uniform"
                Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round"/>
          <TextBlock Text="按钮 3：批量打开软件" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="（首页颜色：橙）" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="field-label" Text="按钮名称" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Btn3Name, Mode=TwoWay}"
                 PlaceholderText="批量打开软件"/>

        <TextBlock Grid.Row="2" Classes="field-label" Text="软件清单" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProgramsText, Mode=TwoWay}" Height="104" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 PlaceholderText="记事本 = notepad.exe&#x0a;计算器 = &quot;C:/Windows/System32/calc.exe&quot;"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint-text"
                   Text="一行一个，格式：显示名 = 程序路径 参数（路径含空格请用英文双引号包住）；空行与 # 注释被忽略，不存在的路径自动跳过。"/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
