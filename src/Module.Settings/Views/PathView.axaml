<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.Settings.Views"
             x:Class="NewToys.Settings.Views.PathView">
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行（右对齐、无背景条）：页名由左侧二级菜单体现，这里只放状态文字。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="24,16,24,0" Spacing="10">
      <TextBlock Classes="status-text" Text="{Binding StatusText}" MaxWidth="560"/>
    </StackPanel>

    <!--  ==================== 工具条  ====================  -->
    <Border Grid.Row="1" Classes="toolbar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="ghost" Content="📂 打开配置目录" Margin="0,0,8,0"
                Command="{Binding OpenConfigDirCommand}"/>
        <Button Classes="primary" Content="💾 保存" Margin="0,0,8,0"
                Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelection}"
                ToolTip.Tip="把右侧详情里改过的值写进 app.json（路径是自由文本，不适合边打边存）"/>
        <TextBlock Classes="hint-text" VerticalAlignment="Center" Margin="0,0,0,6"
                   Text="留空的项 = 用系统默认（PATH 里的 python / pwsh 等）；「📂 浏览…」选出来的路径会立即生效。"/>
      </WrapPanel>
    </Border>

    <!--  ==================== 多项筛选  ====================  -->
    <Border Grid.Row="2" Classes="filter-bar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="filter-btn" Content="＋ 条件" Command="{Binding AddFilterCommand}"/>
        <Button Classes="filter-btn" Content="🧹 清空" Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasFilters}"/>
        <TextBlock Classes="hint-text" Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,8,0"/>

        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                <ComboBox Classes="filter-combo"
                          ItemsSource="{Binding $parent[UserControl].DataContext.FilterableColumns}"
                          SelectedItem="{Binding Column, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Classes="filter-combo" ItemsSource="{Binding Operators}"
                          SelectedItem="{Binding OperatorItem, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" FontSize="12"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Classes="filter-value" Text="{Binding Value, Mode=TwoWay}"
                         IsVisible="{Binding NeedsValue}" PlaceholderText="值…"/>
                <Button Classes="filter-btn" Content="✕" Padding="6,2"
                        Command="{Binding $parent[UserControl].DataContext.RemoveFilterCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
    </Border>

    <!--  ==================== 主区：左列表 + 右详情  ====================
          右栏宽度写在 Border 上（不是 Grid 列上）：列用 Auto，收起时右栏不占位 → 列表自动铺满。 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="16">

      <Border Grid.Column="0" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">

          <Border Grid.Row="0" Classes="list-header">
            <!-- ⚠️ 表头与行模板用同一份列宽规格（规范 3.6 对齐铁律①）；列宽绑 VM 的 VisibleColumnSpecs。
                 ⚠️ 必须用 ColumnGrid 而不是 Grid：Grid.ColumnDefinitions 是 CLR 属性、XAML 里不能 {Binding}（AVLN3000）。 -->
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" ToolTip.Tip="点一下按名称排序"
                      IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding ValueHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Value" ToolTip.Tip="点一下按当前值排序"
                      IsVisible="{Binding IsValueVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding KindHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Kind"
                      IsVisible="{Binding IsKindVisible}"/>
              <TextBlock Grid.Column="3" Classes="list-cell" Text="说明" FontWeight="SemiBold"
                         IsVisible="{Binding IsDescriptionVisible}"/>
              <TextBlock Grid.Column="4" Classes="list-cell" Text="操作" FontWeight="SemiBold"
                         IsVisible="{Binding IsActionVisible}"/>
                   所有带详情卡的列表页统一这个交互。 -->
              <!--  详情栏开关：贴在表头右缘，默认只露一条窄边；鼠标靠近右侧热区才弹出  -->
              <Border Grid.Column="5" Classes="detail-hotspot">
                <Button Classes="header-toggle" Command="{Binding ToggleDetailCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）；你的选择会被记住">
                  <Panel>
                    <TextBlock Text="❯" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !IsDetailVisible}"/>
                    <TextBlock Text="❮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsDetailVisible}"/>
                  </Panel>
                </Button>
              </Border>

              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="▤ 显示详情栏" Command="{Binding ShowDetailCommand}"/>
                  <Separator/>
                  <!-- ⚠️ IsChecked 必须显式 Mode=OneWay：勾选只负责"显示当前状态"，
                       真正的翻转由 ToggleColumnCommand 独家负责（默认双向会写回 VM 造成二次翻转）。 -->
                  <MenuItem Header="名称" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="当前值" ToggleType="CheckBox" IsChecked="{Binding IsValueVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Value"/>
                  <MenuItem Header="类型" ToggleType="CheckBox" IsChecked="{Binding IsKindVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Kind"/>
                  <MenuItem Header="说明" ToggleType="CheckBox" IsChecked="{Binding IsDescriptionVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Description"/>
                  <MenuItem Header="操作（浏览 / 打开）" ToggleType="CheckBox" IsChecked="{Binding IsActionVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Action"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="PathList" Classes="list-page"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <!-- 右键 = 「选中项更多功能」的主入口：查（▤ 详情栏）/ 改（📂 浏览 / 💾 保存 / ↩ 还原默认）/ 打开 -->
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="▤ 显示详情栏" Command="{Binding ShowDetailCommand}"/>
                <Separator/>
                <MenuItem Header="📂 浏览…" Click="OnBrowseMenuClick"/>
                <MenuItem Header="↗ 打开位置" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}"/>
                <Separator/>
                <MenuItem Header="💾 保存修改" Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelection}"/>
                <MenuItem Header="↩ 还原默认" Command="{Binding RestoreDefaultCommand}" IsEnabled="{Binding HasSelection}"/>
              </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- 行与表头共用同一份 VisibleColumnSpecs（规范 3.6 对齐铁律①）；每格 IsVisible 跟随列显隐。 -->
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell primary" Text="{Binding Name}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding ValueDisplay}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsValueVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding KindText}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsKindVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding Description}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsDescriptionVisible}"/>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="12,4"
                              VerticalAlignment="Center"
                              IsVisible="{Binding $parent[ListBox].DataContext.IsActionVisible}">
                    <Button Classes="ghost small" Content="📂 浏览"
                            IsEnabled="{Binding IsEditable}"
                            Click="OnBrowseRowClick" ToolTip.Tip="选文件 / 选目录（选完立即生效）"/>
                    <Button Classes="ghost small" Content="↗"
                            Command="{Binding $parent[ListBox].DataContext.OpenCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="打开所在目录 / 定位该文件"/>
                  </StackPanel>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 右：选中项的详情（可编辑 = CRUD 的 U/C）；宽度写在这里 → 收起时整列不占位 -->
      <Border Grid.Column="1" Classes="detail-card" IsVisible="{Binding IsDetailVisible}">
        <Grid RowDefinitions="Auto,*">

          <StackPanel Grid.Row="0" Spacing="8" IsVisible="{Binding HasSelection}">
            <TextBlock Classes="section-title" Text="选中项"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="primary" Content="💾 保存" Command="{Binding SaveCommand}"/>
              <Button Classes="ghost" Content="↩ 还原默认" Command="{Binding RestoreDefaultCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="BrowseDetailBtn" Classes="ghost" Content="📂 浏览…"/>
              <Button Classes="ghost" Content="↗ 打开" Command="{Binding OpenCommand}"
                      CommandParameter="{Binding Selected}"/>
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

              <StackPanel Classes="field" IsVisible="{Binding !HasSelection}">
                <TextBlock Classes="empty-hint" Text="在左侧列表里选中一项"/>
                <TextBlock Classes="hint-text" Margin="0,4,0,0"
                           Text="这些是「运行环境」相关的路径：ffmpeg / 播放器 / 三个解释器 / 脚本目录。留空 = 用系统默认。数据目录与配置目录是只读展示项。"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="名称"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.Name}" FontSize="13" FontWeight="SemiBold"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="当前值"/>
                <TextBox Classes="code" Text="{Binding EditValue, Mode=TwoWay}" FontSize="12"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         IsReadOnly="{Binding Selected.IsReadOnly}"
                         IsEnabled="{Binding Selected.IsEditable}"/>
                <TextBlock Classes="hint-text" Margin="0,4,0,0"
                           Text="改完点「💾 保存」；点「📂 浏览…」选的路径会立即生效。"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="类型"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.KindText}"/>
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="field-label" Text="说明"/>
                <TextBlock Classes="field-value" Text="{Binding Selected.Description}"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>

              <Border Classes="divider-line"/>

              <TextBlock Classes="hint-text"
                         Text="配置文件：%LocalAppData%\NewToys\config\app.json（会被「设置 → 数据管理」的备份一起覆盖）"/>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
