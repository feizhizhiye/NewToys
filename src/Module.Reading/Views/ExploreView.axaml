<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Reading.Views.ExploreView">
  <!--
    阅读 → 发现（`reading-explore`）：按书源自带的分类表浏览，不用输关键词。
    选源 → 左列分类 → 中间该书单；双击一本 = 去「网上搜索」读目录与正文。
  -->
  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="12,8">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Classes="hint-text" Text="书源" VerticalAlignment="Center" Margin="0,0,8,0"/>

        <ComboBox DockPanel.Dock="Left"
                  Width="300"
                  ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button DockPanel.Dock="Left" Classes="ghost" Content="🔄 重读书源"
                Command="{Binding ReloadSourcesCommand}" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Left" Classes="primary" Content="📖 读这本书"
                Command="{Binding ReadCommand}" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Left" Classes="ghost" Content="✖ 取消"
                Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="8,0,0,0"/>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <Border Background="{DynamicResource ContentHeaderBrush}" Padding="12,4" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="4">
          <TextBlock Classes="hint-text" Text="{Binding BusyPhase}"/>
          <ProgressBar IsIndeterminate="True" Height="3"/>
        </StackPanel>
      </Border>

      <Border Padding="12,4" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   FontSize="12"/>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="200,*" Margin="12,0,12,12">

      <Border Grid.Column="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Margin="0,8,8,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="section-title" Margin="10,8,10,6" Text="分类"/>
          <ListBox ItemsSource="{Binding Categories}"
                   SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Classes="list-cell" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Margin="0,8,0,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="section-title" Margin="10,8,10,6"
                     Text="{Binding StatusText}"/>
          <ListBox x:Name="ResultList"
                   ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                   DoubleTapped="OnResultDoubleTapped"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,2">
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="hint-text" Text="{Binding AuthorText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
