<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.MediaAssets.Views.AssetTagsView">
  <!--  NT-014 骨架占位：本页真正的列表 / 详情 / 工具条 / 筛选在后续待办（NT-016~022）依次落地。  -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="24,16,24,0" Spacing="4">
      <TextBlock Classes="section-title" Text="标签管理"/>
      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="标签：名称 / 命名空间 / 颜色 / 使用数；支持合并与清理未使用"/>
    </StackPanel>
    <Border Grid.Row="1" Margin="24,12,24,16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Classes="hint-text" HorizontalAlignment="Center" Text="🚧 骨架占位（NT-014）"/>
        <TextBlock Classes="hint-text" HorizontalAlignment="Center" Text="页面实现在后续待办落地"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
