<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.MediaAssets.Views.Detail.StorageDetailView">
  <!--
    NT-020 存储源详情卡：只读展示（编辑走行右键：重命名 / 切换类型）+ 统计 + 最近错误。
    ⚠️ 外壳（340px 宽 / 背景 / 左边线）由 **Shell 的右详情列**提供，这里 ⛔ 不套 Border.detail-card（否则双层卡片）。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="10">

      <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !ShowDetailBody}"
                 Text="在左侧列表里选中一个存储源，这里显示它的详情与统计。"/>

      <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding IsDetailSample}"
                 Text="（示例数据）在左侧选中一个存储源后，这里显示它的真实信息。"/>

      <StackPanel Spacing="10" IsVisible="{Binding ShowDetailBody}">

        <TextBlock Classes="section-title" Text="{Binding DetailStorage.Name}" TextWrapping="Wrap"/>

        <!--  ===== 基本信息 =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="根路径"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRootPath}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="field-label" Text="类型"/>
            <TextBlock Classes="field-value" Text="{Binding DetailType}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="field-label" Text="状态"/>
            <TextBlock Classes="field-value" Text="{Binding DetailStatus}"/>
          </StackPanel>
        </Grid>

        <Border Classes="divider-line"/>

        <!--  ===== 统计 =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="文件位置数"/>
          <TextBlock Classes="field-value" Text="{Binding DetailFileCount}"/>

          <TextBlock Classes="field-label" Text="已用大小"/>
          <TextBlock Classes="field-value" Text="{Binding DetailSize}"/>

          <TextBlock Classes="field-label" Text="缺失位置"/>
          <TextBlock Classes="field-value" Text="{Binding DetailMissing}"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 按类型分布 =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="按类型分布"/>
          <TextBlock Classes="hint-text" IsVisible="{Binding !HasTypeStats}" Text="（还没有文件位置）"/>
          <ItemsControl ItemsSource="{Binding DetailTypeStats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding TypeText}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding CountText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding SizeText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 最近错误 =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="最近扫描错误"/>
          <TextBlock Classes="hint-text" IsVisible="{Binding !HasErrors}" Text="（没有记录错误）"/>
          <ItemsControl ItemsSource="{Binding DetailErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,2">
                  <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                  <TextBlock Text="{Binding Path}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 登记时间 =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="登记时间"/>
          <TextBlock Classes="field-value" Text="{Binding DetailCreated}"/>

          <TextBlock Classes="field-label" Text="最近更新"/>
          <TextBlock Classes="field-value" Text="{Binding DetailUpdated}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
