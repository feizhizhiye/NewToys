<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:ui="using:NewToys.UI.Behaviors"
             ui:FilterDropDownAlign.Attach="True"
             x:Class="NewToys.MediaAssets.Views.AssetAllView">
  <!--
    「全部资产」样板列表页。
    🔴 与旧列表页（Ping / 视频列表）最大的不同：**本页没有右栏详情卡** —— 详情面板改由 **Shell**
       承载（VM 实现 IDetailPanelProvider，详情卡已改由 Shell 声明式渲染（NT-054））。
       ⛔ 若本页再自带一栏，右列会出现两个详情卡（Shell 一个、页面一个）。

    列表页骨架 <v:ListPageSkeleton>（四段：顶区 = 筛选条 / 列表区 / 空态 / 底栏）—— card 容器、空态块、
    底栏壳由骨架统一提供（⛔ 行模板仍本页自写）。

    ⚠️ 列表本体已换 **Avalonia 12.1 核心控件 TableView**（列宽拖拽 / 行与单元格回收由框架提供）。
       表头由 TableView 自带且粘顶（主题里表头在 ScrollContentPresenter 之外），因此骨架的 HeaderArea 留空；
       列显隐仍由 VM 下发（IsXxxVisible），在 code-behind 里按索引绑定到对应的 TableViewColumn。
  -->

  <UserControl.Resources>
    <!--  🔴 主题给的是 6,9,6,12 —— 表头外层 Border 和每一行都吃这份 padding，
         不覆盖的话表头再设 MinHeight 也压不矮（高 = 内容 + 9 + 12）。密度由行/单元格自己兜。  -->
    <Thickness x:Key="TableViewRowPadding">0</Thickness>
    <!--  单元格内边距同理：主题的 TableViewCellPadding 带垂直份量，会把行撑高并把文字顶到上方  -->
    <Thickness x:Key="TableViewCellPadding">8,0</Thickness>
    <!--  🔴 列宽拖拽把手（resizer）的命中区：主题是 0,-9,-6,-12，**下边多出 12px**，
         且表头 ClipToBounds=False ⇒ 那根 1px 竖线会戳进表头下面第一行（肉眼像「表头没画完」）。
         只留右侧 -6（让竖线正好压在列边界上），上下不再外扩。  -->
    <Thickness x:Key="TableViewColumnResizerMargin">0,0,-6,0</Thickness>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--  与 ListBox.list-page 的密度基线对齐（行 28 / 字 12 / 表头 SemiBold 次要色）：
         TableView 默认继承主题的 13px 与主色前景，不覆盖就会比其它列表页「字大一档」。  -->
    <Style Selector="TableViewRow">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!--  选中 / 悬停底色：覆盖主题的 TableViewRowBackground*（那是 Fluent 强调色，不是本项目的语义键）  -->
    <Style Selector="TableViewRow:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <Style Selector="TableViewRow:selected /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
    </Style>
    <Style Selector="TableViewRow:selected:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
    </Style>
    <Style Selector="TableViewCell">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <!--  行高 28 由行兜底后，单元格内容必须自己垂直居中（默认 Top，会顶着上沿）  -->
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TableViewColumnHeader">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!--  Transparent 才会参与命中测试：表头空白处也能点中（排序激活区 = 整列头，⛔ 只有文字能点是错的）  -->
      <Setter Property="Background" Value="Transparent"/>
      <!--  表头压矮：默认主题按 32 走，这里给 28 的基线与 8/0 内边距（与单元格 8,0 对齐，否则表头字比行字偏左）  -->
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!--  筛选栏压矮：只覆盖本页（全局 filter-bar / filter-combo 仍是 12,4 + MinHeight 28）  -->
    <Style Selector="Border.filter-bar">
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="ComboBox.filter-combo">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="22"/>
    </Style>

    <!--  表头条：主题用 Fluent 的灰色 Chrome 笔刷 + 无分隔线；换成本项目的 SubSiderHeaderBrush + 1px 底边，
         与其它列表页的 Border.list-header 视觉一致。  -->
    <Style Selector="TableView ScrollViewer /template/ DockPanel#ContentPanel > Border">
      <Setter Property="Background" Value="{DynamicResource SubSiderHeaderBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!--  垂直滚动条从表头下沿开始：主题把滚动条铺在整个 ScrollViewer 上（含表头行），
         这里按表头高度下移 28，避免滚动条顶到表格最上沿。  -->
    <Style Selector="TableView ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Margin" Value="0,28,0,0"/>
    </Style>
  </UserControl.Styles>

  <v:ListPageSkeleton EmptyMessage="没有可显示的资产。点「📥 导入」把导出的 json 合并进库，或用「📁 扫描」扫一个目录。"
                      EmptyActionText="📥 导入"
                      EmptyActionCommand="{Binding ImportAssetsCommand}"
                      IsEmpty="{Binding !HasItems}"
                      ShowFooter="{Binding HasFooterContent}"
                      TotalCount="{Binding TotalCount}"
                      SelectedCount="{Binding SelectedCount}"
                      PageText="{Binding PageText}"
                      ShowPaging="{Binding HasPaging}"
                      PageCount="{Binding PageCount}"
                      CurrentPage="{Binding PageIndex}"
                      JumpToPageCommand="{Binding GoToPageCommand}"
                      FirstCommand="{Binding FirstPageCommand}"
                      PrevCommand="{Binding PrevPageCommand}"
                      NextCommand="{Binding NextPageCommand}"
                      LastCommand="{Binding LastPageCommand}"
                      PageSizes="{Binding PageSizeChoices}"
                      PageSize="{Binding PageSize, Mode=TwoWay}">

    <!--  ==================== ② 筛选条（改任一条件即时重算：VM 的 OnFilterXxxChanged → ApplyView）  ====================  -->
    <v:ListPageSkeleton.TopArea>
    <Border Classes="filter-bar">
      <!--  🔴 筛选条**恒为一行、且⛔不许出现滚动条**。
            筛选器数量是固定的（类型 / 存储源 / 状态 / 标签）⇒ 用 Grid 排死：
            标签 Auto + 四个 combo 各占等分星号 ⇒ 窗口变窄时 combo **自己跟着变窄**，永远不会溢出、也不需要滚动条；
            再给 combo 设 MaxWidth 防止宽窗口下被拉得过宽（超出部分自然留在右侧空白）。
            ⚠️ ⛔ 别改回 WrapPanel（放不下就换行，条高会变）、⛔ 别套 ScrollViewer（用户明确不要滚动条）。
            ⚠️ 列间距用 Grid.ColumnSpacing（= §4.10.4 对横向流式容器的同一条要求），⛔ 不给每个 combo 写右 Margin。  -->
      <Grid ColumnDefinitions="Auto,*,*,*,*" ColumnSpacing="5">
        <TextBlock Grid.Column="0" Text="筛选" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <!--  combo 尺寸压到最窄窗口（960 + 详情栏展开）也放得下一行。  -->
        <ComboBox Grid.Column="1" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按类型筛选（视频 / 音乐 / 书籍 / 图片 / 文档）"
                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding FilterType, Mode=TwoWay}"/>
        <ComboBox Grid.Column="2" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanFilterByStorageOrTag}"
                  ToolTip.Tip="按存储源筛选（扫描预览态不可用：预览行还没入库）"
                  ItemsSource="{Binding StorageOptions}" SelectedItem="{Binding FilterStorage, Mode=TwoWay}"/>
        <ComboBox Grid.Column="3" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="按状态筛选（正常 / 已丢失 / 回收站 / 已归档）"
                  ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}"/>
          <ComboBox Grid.Column="4" Classes="filter-combo" MinWidth="0" MaxWidth="120" Padding="4,1" FontSize="11"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding CanFilterByStorageOrTag}"
                    ToolTip.Tip="按标签筛选（扫描预览态不可用：预览行还没有标签）"
                    ItemsSource="{Binding TagOptions}" SelectedItem="{Binding FilterTag, Mode=TwoWay}"/>
      </Grid>
    </Border>
    </v:ListPageSkeleton.TopArea>

    <!--  ==================== ③ 列表本体（表头由 TableView 自带，故骨架 HeaderArea 不填）  ====================  -->
    <v:ListPageSkeleton.ListArea>
        <!--  多选走列表原生选中：Ctrl 增选 / Shift 连选 / Ctrl+A 全选（code-behind 隧道接管）；
             无修饰键点击 = 单选替换（与资源管理器一致）。
             列显隐由 VM 的 IsXxxVisible 下发（code-behind 按索引绑定），⛔ 别在 XAML 里写死 IsVisible。  -->
        <TableView x:Name="AssetList" Classes="list-page"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Items}">
          <TableView.Columns>
            <TableViewColumn Width="2*" Header="名称">
              
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             ToolTip.Tip="{Binding FilePath}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="54" Binding="{Binding TypeText}" Header="类型" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="1.2*" Binding="{Binding TagsText}" Header="标签"/>

            <TableViewColumn Width="1*" Binding="{Binding CategoriesText}" Header="分类"/>

            <TableViewColumn Width="1*" Binding="{Binding CollectionsText}" Header="集合"/>

            <!--  大小固定 90（按最长串 1023.99 MB 预留），与 VM 的 AssetColumns 口径一致  -->
            <TableViewColumn Width="90" Binding="{Binding SizeText}" Header="大小" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="124" Binding="{Binding ModifiedText}" Header="修改时间" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="1*" Binding="{Binding StorageName}" Header="存储源"/>

            <!--  视频专属列：非视频页由 VM 的 IsXxxVisible 关掉  -->
            <TableViewColumn Width="72" Binding="{Binding DurationText}" Header="时长" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="88" Binding="{Binding ResolutionText}" Header="分辨率" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="60" Binding="{Binding CodecText}" Header="编码" HorizontalContentAlignment="Center"/>

            <TableViewColumn Width="76" Binding="{Binding BitRateText}" Header="码率" HorizontalContentAlignment="Center"/>
          </TableView.Columns>

          <!--
            行右键菜单 = **针对单条**的动作（§4.8 硬规则 9）：打开 / 定位 / 打开库文件。
            ⛔ 这些⛔ 不上工具条（工具条只放页面级功能：扫描 / 筛选 / 入库 / 清除…）。
            ⚠️ ContextMenu 在独立弹出树 → DataContext 由 code-behind 手工同步（硬规则 3）。
            ⚠️ 列显隐菜单原先挂表头，TableView 表头无独立控件可挂 ⇒ 并入本菜单顶部。
          -->
          <TableView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="▤ 列">
                <MenuItem Header="名称" IsEnabled="False" ToggleType="CheckBox"
                          IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                          ToolTip.Tip="标识列固定显示，不可隐藏"/>
                <MenuItem Header="类型" ToggleType="CheckBox" IsChecked="{Binding IsTypeVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Type"/>
                <MenuItem Header="标签" ToggleType="CheckBox" IsChecked="{Binding IsTagsVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Tags"/>
                <MenuItem Header="分类" ToggleType="CheckBox" IsChecked="{Binding IsCategoriesVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Categories"/>
                <MenuItem Header="集合" ToggleType="CheckBox" IsChecked="{Binding IsCollectionsVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Collections"/>
                <MenuItem Header="大小" ToggleType="CheckBox" IsChecked="{Binding IsSizeVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Size"/>
                <MenuItem Header="修改时间" ToggleType="CheckBox" IsChecked="{Binding IsModifiedVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Modified"/>
                <MenuItem Header="存储源" ToggleType="CheckBox" IsChecked="{Binding IsStorageVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Storage"/>
                <MenuItem Header="时长" ToggleType="CheckBox" IsChecked="{Binding IsDurationVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Duration"/>
                <MenuItem Header="分辨率" ToggleType="CheckBox" IsChecked="{Binding IsResolutionVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Resolution"/>
                <MenuItem Header="编码" ToggleType="CheckBox" IsChecked="{Binding IsCodecVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Codec"/>
                <MenuItem Header="码率" ToggleType="CheckBox" IsChecked="{Binding IsBitrateVisible, Mode=OneWay}"
                          Command="{Binding ToggleAssetColumnCommand}" CommandParameter="Bitrate"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="📂 打开" Command="{Binding OpenFileCommand}"
                        ToolTip.Tip="用系统默认程序打开（视频=播放 / 书=阅读 / 图=看图）"/>
              <MenuItem Header="📁 打开所在文件夹" Command="{Binding OpenFolderCommand}"
                        ToolTip.Tip="在资源管理器里选中这个文件"/>
              <MenuItem Header="➡ 发送到视频工具" Command="{Binding SendToVideoToolsCommand}"
                        ToolTip.Tip="把选中的视频送到「视频工具 → 视频列表」页，接着定剪辑 / 转码参数（非视频自动跳过）"/>
              <Separator/>
              <!--  **唯一**直接物理删磁盘文件的入口（破坏性最大 ⇒ 故意只放右键、还要二次确认 + 走任务队列）；  -->
              <MenuItem Header="⛔ 从磁盘删除…" Command="{Binding DeleteFromDiskCommand}"
                        ToolTip.Tip="永久删除磁盘文件：不进回收站、不可还原，库里的文件索引一起删"/>
              <Separator/>
              <MenuItem Header="☑ 全选当前页" Command="{Binding SelectAllCommand}"
                        ToolTip.Tip="选中当前页所有行（等价 Ctrl+A）"/>
              <MenuItem Header="☐ 取消选择" Command="{Binding SelectNoneCommand}"/>
              <MenuItem Header="⇄ 反选当前页" Command="{Binding InvertSelectionCommand}"/>
            </ContextMenu>
          </TableView.ContextMenu>
        </TableView>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
