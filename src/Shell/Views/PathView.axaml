<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.Shell.Views.PathView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。
        v3.53 / NT-055：工具条由 Shell 的 ToolbarHost 声明式承载 ⇒ 页内⛔ 不再写 Border.toolbar
        （两处同时渲染会出现两条工具条）。
        v3.66 / NT-062 第五轮：本页**只作为设置页「运行环境」节的正文**使用 ⇒ 根 Margin 由 12 改 0
        （缩进交给宿主节点的 `sec-body`，⛔ 不再叠加一层）；节的工具条由**宿主节点**里的 ToolbarHost
        渲染（抬头下方、正文之上），本页⛔ 依旧不写工具条。
        NT-063 P1：改用列表页骨架 <v:ListPageSkeleton>（card / 空态 / 底栏由骨架提供；⛔ 行模板自写）。 -->
  <v:ListPageSkeleton Margin="0"
                      HorizontalAlignment="Stretch"
                      MaxWidth="1080"
                      EmptyMessage="没有可显示的配置行。点「＋ 新建配置」建一个新的配置档。"
                      EmptyActionText="＋ 新建配置"
                      EmptyActionCommand="{Binding NewProfileCommand}"
                      IsEmpty="{Binding !HasItems}">

    <v:ListPageSkeleton.ListArea>
          <v:TableViewHost x:Name="PathList"
                           ItemsSource="{Binding Items}"
                           SelectedItem="{Binding Selected, Mode=TwoWay}"
                           SelectionMode="Single">
            <!-- 右键 = 「选中项更多功能」的主入口：查（▤ 详情）/ 路径侧（📂 浏览 / 💾 保存 / ↩ 还原 / ↗ 打开）
                 / 配置侧（⇄ 切换 / ⭐ 设为默认 / ✏ 重命名 / 🗑 删除 / 🚀 新开）。
                 🔴 按分类启停：不适用当前分类行的项 IsEnabled=false。 -->
            <v:TableViewHost.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="选目录" Icon="{m:Glyph IconOpen}" Command="{Binding PickPathCommand}" IsEnabled="{Binding CanSavePath}"/>
                <MenuItem Header="打开位置" Icon="{m:Glyph IconOpen}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}"
                          IsEnabled="{Binding IsPathRowSelected}"/>
                <Separator/>
                <MenuItem Header="保存修改" Icon="{m:Glyph IconSave}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSavePath}"/>
                <MenuItem Header="还原默认" Icon="{m:Glyph IconReset}" Command="{Binding RestoreDefaultCommand}" IsEnabled="{Binding CanSavePath}"/>
                <Separator/>
                <MenuItem Header="切换到此配置" Icon="{m:Glyph IconInvert}" Command="{Binding SwitchProfileCommand}" IsEnabled="{Binding CanSwitchProfile}"/>
                <MenuItem Header="🚀 新开一个窗口" Command="{Binding LaunchProfileNewCommand}" IsEnabled="{Binding CanSwitchProfile}"/>
                <MenuItem Header="设为默认" Icon="{m:Glyph IconStar}" Command="{Binding SetProfileDefaultCommand}" IsEnabled="{Binding IsProfileRowSelected}"/>
                <MenuItem Header="重命名" Icon="{m:Glyph IconEdit}" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding IsProfileRowSelected}"/>
                <MenuItem Header="删除" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanDeleteProfile}"/>
                <Separator/>
                <MenuItem Header="＋ 新建配置" Command="{Binding NewProfileCommand}"/>
                <MenuItem Header="配置目录" Icon="{m:Glyph IconOpen}" Command="{Binding OpenConfigDirCommand}"/>
              </ContextMenu>
            </v:TableViewHost.ContextMenu>

            <v:TableViewHost.Columns>
              <TableViewColumn Width="1*">
                <TableViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Classes="list-cell accent" Text="{Binding CategoryText}"/>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>

              <TableViewColumn Width="2.2*">
                <TableViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="list-cell primary" Text="{Binding Name}"/>
                      <TextBlock Classes="list-cell accent" Text="{Binding Mark}" IsVisible="{Binding IsProfileRow}"/>
                    </StackPanel>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>

              <TableViewColumn Width="4*" Binding="{Binding ValueDisplay}"/>
              <TableViewColumn Width="1*" Binding="{Binding KindText}"/>
              <TableViewColumn Width="3*" Binding="{Binding Description}"/>

              <!-- 「操作」列按分类分派：路径行 = 📂 浏览 / ↗；
                   配置行 = ⇄ 切换 / 🚀 新开 / ⭐ 设为默认 / ✏ 重命名 / 🗑 删除；
                   `↗ 打开位置` 每行都有（配置行 = 打开该配置的目录，路径行 = 打开所在目录 / 定位文件）。 -->
              <TableViewColumn Width="3.8*" Header="操作">
                <TableViewColumn.CellTemplate>
                  <DataTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="8,2"
                               VerticalAlignment="Center">
                      <Button Classes="ghost small" Content="{m:GlyphText IconOpen, '选择'}" IsVisible="{Binding IsPathRow}"
                              IsEnabled="{Binding IsEditable}"
                              Command="{Binding $parent[UserControl].DataContext.PickRowPathCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="选文件 / 选目录（选完立即生效）"/>
                      <Button Classes="ghost small" Content="{m:GlyphText IconOpen}" Command="{Binding $parent[UserControl].DataContext.OpenCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{Binding OpenTargetTip}"/>
                      <Button Classes="ghost small" Content="{m:GlyphText IconInvert}" IsVisible="{Binding IsProfileRow}"
                              Command="{Binding $parent[UserControl].DataContext.SwitchProfileCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="切换到此配置（本窗口重启）"/>
                      <Button Classes="ghost small" Content="🚀" IsVisible="{Binding IsProfileRow}"
                              Command="{Binding $parent[UserControl].DataContext.LaunchProfileNewCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="以该配置新开一个窗口"/>
                      <Button Classes="ghost small" Content="{m:GlyphText IconStar}" IsVisible="{Binding IsProfileRow}"
                              Command="{Binding $parent[UserControl].DataContext.SetProfileDefaultCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="设为全局默认（以后不带参数启动用它）"/>
                      <Button Classes="ghost small" Content="{m:GlyphText IconEdit}" IsVisible="{Binding IsProfileRow}"
                              Command="{Binding $parent[UserControl].DataContext.RenameProfileCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="重命名该配置"/>
                      <Button Classes="ghost small" Content="{m:GlyphText IconTrash}" IsVisible="{Binding IsProfileRow}"
                              Command="{Binding $parent[UserControl].DataContext.DeleteProfileCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="删除该配置的全部数据（不能删当前配置）"/>
                    </WrapPanel>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
            </v:TableViewHost.Columns>
          </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
