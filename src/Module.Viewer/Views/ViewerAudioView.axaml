<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.Viewer.Controls"
             x:Class="NewToys.Viewer.Views.ViewerAudioView">
  <!--
    查看器页内容（文档查看 / 图片查看 / 音乐播放三页**共用同一份 XAML**）：
    条目条 + 渲染区（单图宿主 / 分屏网格叠放）+ 历史浮层。
    🔴 三份 XAML 必须保持完全一致（只有 x:Class 不同）：基类 ViewerPageBase 按 x:Name 取控件，
       少一个就抛「ViewerPage 的 XAML 缺少名为 X 的控件」。
    🔴 工具条由 Shell 的 ToolbarHost 渲染（VM 实现 IToolbarSource），本页 ⛔ 不写 Border.toolbar。
    🔴 渲染器全部在本模块 Controls/（短文本 / 图片 / 音频外壳），本模块只做分派与持久化。
  -->
  <UserControl.Styles>
    <!--  条目压到 20px 行高（默认项高撑得整条过高）  -->
    <Style Selector="ListBox#ArchiveList ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!--  条目条：压缩包内图片 / 同目录图片  -->
    <Border Grid.Row="0"
            Background="{DynamicResource ContentHeaderBrush}"
            IsVisible="{Binding IsArchive}"
            Padding="12,4">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <TextBlock VerticalAlignment="Center"
                   Classes="hint-text"
                   FontSize="12"
                   Margin="0,0,10,0"
                   Text="{Binding ArchiveInfo}" />
        <!--  节跳转：同目录图多到需要分节时才出现（每 100 张一节）  -->
        <ComboBox x:Name="SectionBox"
                  Grid.Column="1"
                  Width="86"
                  Height="22"
                  MinHeight="0"
                  Padding="6,0"
                  FontSize="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasSections}"
                  ItemsSource="{Binding SectionItems}"
                  SelectionChanged="OnSectionSelected"
                  ToolTip.Tip="每 100 张一节：选一节直接跳过去" />
        <ListBox x:Name="ArchiveList"
                 Grid.Column="2"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding ArchiveEntries}"
                 SelectionChanged="OnArchiveSelected">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!--  横向虚拟化：几千张的压缩包只实例化可见条目，切回页面不再全量重排  -->
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <!--  节标：范围文字（仅节首条可见）  -->
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Classes="hint-text"
                           IsVisible="{Binding IsSectionStart}"
                           Text="{Binding SectionLabel}" />
                <TextBlock MaxWidth="200"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!--  渲染区：单图宿主与分屏网格叠放，同一时刻只显示一个（切换由基类控制 IsVisible）  -->
    <Grid Grid.Row="1">
      <ui:ViewerHost x:Name="Host" />
      <Grid x:Name="SplitGrid"
            IsVisible="False"
            Background="{DynamicResource ContentBrush}" />
    </Grid>

    <!--  历史浮层：工具条「🕘 历史」展开；点一项重新打开，打开后自动收起  -->
    <Border x:Name="HistoryPanel"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="320"
            MaxHeight="320"
            Margin="0,6,12,0"
            IsVisible="{Binding IsHistoryOpen}"
            Background="{DynamicResource PanelBrush}"
            CornerRadius="6"
            BoxShadow="0 8 24 0 #55000000">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="10,7,6,4">
          <TextBlock Text="最近打开"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="ghost"
                    FontSize="12"
                    Padding="6,2"
                    Content="清空"
                    Command="{Binding ClearRecentCommand}" />
            <Button Classes="ghost"
                    FontSize="12"
                    Padding="6,2"
                    Content="✕"
                    Command="{Binding ToggleHistoryCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" MaxHeight="260" Padding="0,0,0,6">
          <ListBox x:Name="RecentList"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding RecentItems}"
                   SelectionChanged="OnRecentSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="12"
                           MaxWidth="280"
                           Text="{Binding}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
