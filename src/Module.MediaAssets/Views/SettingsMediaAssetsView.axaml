<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.MediaAssets.Views.SettingsMediaAssetsView">
  <!--
    NT-021「媒体资产」模块设置页（View/VM 归本模块，自行注册进 settings 分组，Order 100）。
    规范 §4.9：开关 / 数值 / 路径 = 即时生效（⛔ 无保存按钮）；多行文本（忽略规则 / 命名模板）= 显式 💾 保存。
    状态文本由 Shell 底部状态栏统一显示（IStatusProvider）。
  -->
  <Grid RowDefinitions="Auto,*">

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

        <!--  ============ ① 扫描 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="扫描" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <CheckBox Content="忽略隐藏文件 / 目录" IsChecked="{Binding IgnoreHiddenFiles, Mode=TwoWay}"/>
            <CheckBox Content="忽略临时文件（.tmp / .part / ~$* 等）" IsChecked="{Binding IgnoreTempFiles, Mode=TwoWay}"/>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="quick_hash 采样大小（MB，0 = 不算）"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="120" Text="{Binding QuickHashSampleMb, Mode=TwoWay}"/>
                <TextBlock Classes="hint-text" VerticalAlignment="Center"
                           Text="越大越准、扫描越慢；首次扫描只读文件信息、不读内容"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="忽略的扩展名（逗号 / 分号分隔）"/>
              <TextBox Text="{Binding IgnoreExtensions, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="忽略的目录名（按目录名匹配，⛔ 不是路径片段）"/>
              <TextBox Text="{Binding IgnoreDirectories, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
            </StackPanel>

            <Button Classes="primary" Content="💾 保存忽略规则" HorizontalAlignment="Left"
                    Command="{Binding SaveTextSettingsCommand}"
                    ToolTip.Tip="把上面的忽略规则 / 命名模板 / 冲突策略一次写全（即时生效项无需保存）"/>
          </StackPanel>
        </Border>

        <!--  ============ ② 元数据与缩略图 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="元数据与缩略图" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <CheckBox Content="扫描到新文件时自动提取元数据（视频 = ffprobe；图片 = 读尺寸）"
                      IsChecked="{Binding AutoExtractMetadata, Mode=TwoWay}"/>
            <CheckBox Content="扫描到新文件时自动生成缩略图（视频抽帧 / 图片缩放）"
                      IsChecked="{Binding AutoGenerateThumbnails, Mode=TwoWay}"/>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="视频抽帧位置"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox Width="160" ItemsSource="{Binding FrameModeOptions}"
                          SelectedValue="{Binding ThumbFrameMode, Mode=TwoWay}" SelectedValuePath="Value">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Width="90" Text="{Binding ThumbFramePercent, Mode=TwoWay}"
                         IsVisible="{Binding IsFramePercentMode}"
                         ToolTip.Tip="百分比 0~100"/>
                <TextBox Width="90" Text="{Binding ThumbFrameSeconds, Mode=TwoWay}"
                         IsVisible="{Binding IsFrameSecondsMode}"
                         ToolTip.Tip="秒"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="缩略图尺寸（长边像素，只缩不放）"/>
              <TextBox Width="120" Text="{Binding ImageThumbSize, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="缩略图目录（留空 = 默认）"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="320" Text="{Binding ThumbsDirectory, Mode=TwoWay}" PlaceholderText="留空 = data\thumbs"/>
                <Button Classes="ghost" Content="📂 选目录…" Click="OnPickThumbsDirClick"/>
                <Button Classes="ghost" Content="↺ 用默认" Command="{Binding ResetDefaultsCommand}"
                        ToolTip.Tip="全部恢复默认设置"/>
              </StackPanel>
              <TextBlock Classes="hint-text" TextWrapping="Wrap"
                         Text="{Binding ThumbsDirectoryEffective, StringFormat='生效目录：{0}'}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!--  ============ ③ 命名模板与冲突策略 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="命名模板与冲突策略" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
              <TextBlock Classes="hint-text" TextWrapping="Wrap"
                         Text="占位符：{title}（显示名）/ {name}（文件名）/ {year}（年份，若有）/ {ext}（扩展名）。模板在重命名功能落地后启用。"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="视频"/>
              <TextBox Text="{Binding NameTemplateVideo, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="音乐"/>
              <TextBox Text="{Binding NameTemplateMusic, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="书籍"/>
              <TextBox Text="{Binding NameTemplateBook, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="图片"/>
              <TextBox Text="{Binding NameTemplateImage, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="重命名冲突策略"/>
              <ComboBox Width="220" ItemsSource="{Binding ConflictOptions}"
                        SelectedValue="{Binding ConflictPolicy, Mode=TwoWay}" SelectedValuePath="Value">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Button Classes="primary" Content="💾 保存模板与规则" HorizontalAlignment="Left"
                    Command="{Binding SaveTextSettingsCommand}"/>
          </StackPanel>
        </Border>

        <!--  ============ ④ 回收站 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="回收站" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="保留天数（超过即过期）"/>
              <TextBox Width="120" Text="{Binding TrashRetentionDays, Mode=TwoWay}"/>
            </StackPanel>

            <CheckBox Content="到期自动清理（开启后：启动时自动把过期资产永久删除）"
                      IsChecked="{Binding AutoCleanupTrash, Mode=TwoWay}"/>
            <TextBlock Classes="hint-text" Margin="26,0,0,0" TextWrapping="Wrap"
                       Text="⚠️ 自动清理会真删磁盘文件（⛔ 不进回收站、无法还原）。默认关闭；清理过程在「任务中心」可见、可取消。"/>

            <Button Classes="ghost" Content="🧹 立即清理过期回收站" HorizontalAlignment="Left"
                    Command="{Binding CleanupTrashNowCommand}"
                    ToolTip.Tip="把超过保留天数的资产排进永久删除队列（二次确认）"/>
          </StackPanel>
        </Border>

        <!--  ============ ⑤ 物理操作 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="物理操作" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <CheckBox Content="删除默认送系统回收站（可还原）" IsChecked="{Binding DeleteToRecycleBin, Mode=TwoWay}"/>
            <CheckBox Content="破坏性物理操作前二次确认（强制开启，⛔ 不可关）"
                      IsChecked="{Binding ConfirmBeforeOperation, Mode=OneWay}" IsEnabled="False"/>
          </StackPanel>
        </Border>

        <!--  ============ ⑥ 导入导出 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="导入导出" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasImportExportDir}"
                       Text="尚未设置「导入导出默认目录」——到「设置 → 路径」里配（全局项，本模块复用，⛔ 不另存一份）。"/>
            <TextBlock Classes="field-value" TextWrapping="Wrap" IsVisible="{Binding HasImportExportDir}"
                       Text="{Binding ImportExportDefaultDir, StringFormat='默认目录：{0}'}"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="列表的 JSON 导入 / 导出、「导出用户数据」的文件选择器都会定位到这个目录。"/>

            <Border Classes="divider-line"/>

            <!--  NT-022：用户手动数据（标签 / 分类 / 集合 / 关联）—— 它们落在"不进备份"的 newtoys.db，
                  导出成 config\media-assets-user-data.json 才能进「数据管理」的备份（R1 缓解）。  -->
            <StackPanel Spacing="4">
              <TextBlock Classes="field-label" Text="用户手动数据（标签 / 分类 / 集合 / 关联）"/>
              <TextBlock Classes="hint-text" TextWrapping="Wrap"
                         Text="这些是手工维护的数据，却存在会被重建的资产库里——导出后即使删掉 newtoys.db 也能找回来（按名字 / 路径恢复，⛔ 不清空已有数据）。"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="📤 导出用户数据" Command="{Binding ExportUserDataCommand}"
                        ToolTip.Tip="写到 config\media-assets-user-data.json（随「数据管理」备份一起走）"/>
                <Button Classes="ghost" Content="📥 恢复用户数据…" Click="OnRestoreUserDataClick"
                        ToolTip.Tip="选一个导出的 json 合并恢复（缺的才建，⛔ 不覆盖）"/>
              </StackPanel>
              <TextBlock Classes="hint-text" TextWrapping="Wrap" FontFamily="Consolas"
                         Text="{Binding UserDataFilePath}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!--  ============ ⑦ 说明 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="📄 设置文件" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{Binding ConfigFilePath}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="它在 config 目录下 —— 「设置 → 数据管理」的备份 / 导入会覆盖它。音乐 / 书籍 / 文档的元数据提取（需要第三方库）本轮未做，⛔ 未擅引。"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
