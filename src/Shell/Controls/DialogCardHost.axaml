<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Controls.DialogCardHost">
  <!--
    全局弹出卡片层（NT-084）：确认框 / 提示框 / 输入框的唯一呈现器。
    原先三种对话框都是**独立系统 Window**（ShowDialog）——标题栏是系统装饰，明暗主题下
    和主窗口割裂；且 Shell/DataView 各写了一份（视觉漂移）。现在统一收编到这一层：

    结构 = 全窗口遮罩（LoadingOverlayBrush）+ 居中卡片：
      · 卡片底 = PanelBrush / 1px DividerBrush 描边 / 圆角 8（与 Border.card 一致）/ 投影；
      · 标题行 = 强调色圆底白符号（三角=确认 / i=提示 / 铅笔=输入）+ 标题；
      · 消息区带滚动（长消息不顶破窗口）；输入卡片多一个 TextBox；
      · 按钮沿用全局 primary / ghost 样式。
    🔴 只许 DynamicResource 引主题键（⛔ 写死色值）——明暗切换自动跟随。
    🔴 交互：点遮罩 / ESC = 取消；Enter = 确定（输入框内回车 = 确定）。
    调用方：App.axaml.cs 的 DialogHooks 宿主实现 + DataView；⛔ 页面⛔ 不得自造弹窗。
  -->
  <Grid x:Name="Root" IsVisible="False">

    <!--  遮罩：铺满整个窗口（含标题栏）⇒ 模态感；点击 = 取消  -->
    <Border x:Name="Scrim"
            Background="{DynamicResource LoadingOverlayBrush}"
            PointerPressed="OnScrimPointerPressed" />

    <!--  卡片：固定宽 460（与原独立窗口一致），高度随内容；长消息由 MessageScroll 收敛  -->
    <Border x:Name="Card"
            Width="460"
            MaxHeight="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0,8,32,#66000000"
            Padding="20"
            Focusable="True"
            KeyDown="OnCardKeyDown">
      <StackPanel Spacing="14">

        <!--  标题行：强调色圆底 + 白色符号  -->
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28"
                  Height="28"
                  CornerRadius="14"
                  Background="{DynamicResource AccentBrush}">
            <Path x:Name="CardIcon"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Stroke="{DynamicResource AccentTextBrush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
          </Border>
          <TextBlock x:Name="CardTitle"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!--  消息区：短消息自然高度；超 320 才出滚动条（原 DataView 弹窗同款收敛）  -->
        <ScrollViewer x:Name="MessageScroll"
                      MaxHeight="320"
                      HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="CardMessage"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </ScrollViewer>

        <!--  输入框：仅输入卡片可见  -->
        <TextBox x:Name="CardInput"
                 FontSize="13"
                 MinWidth="0"
                 MinHeight="0"
                 IsVisible="False"
                 KeyDown="OnInputKeyDown" />

        <!--  按钮行：右对齐；取消仅确认/输入/消息卡片出现  -->
        <StackPanel Orientation="Horizontal"
                     HorizontalAlignment="Right"
                     Spacing="10">
          <Button x:Name="BtnCancel"
                  Classes="ghost"
                  Width="88"
                  Content="取消"
                  IsVisible="False"
                  Click="OnCancelClick" />
          <Button x:Name="BtnOk"
                  Classes="primary"
                  Width="96"
                  Click="OnOkClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
