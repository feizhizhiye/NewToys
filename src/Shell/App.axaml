<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.App">
    <Application.Styles>

        <!--  ⚠️ 顺序：主题在前、应用样式在后。
             Avalonia 的 Styles 是**有序**集合，同一个属性被多个样式命中时"后写的赢"。
             FluentTheme 必须排在最前面（它是底座），本应用的 StyleInclude 与内联 <Style>
             都要排在它后面 —— 否则将来 FluentTheme 里任何一个同属性 setter 都会顶掉我们的配色。  -->
        <FluentTheme/>

        <!--  复用样式表（工具条 / 状态行 / 详情卡 / 表头 / 筛选条 …）
              v1.35：把各列表页反复抄写的那段 XAML 收成 Class，页面里只写 Classes="…"；
              「表头点击区太小」的修复（Button.col-header 撑满整行）也在里面。  -->
        <StyleInclude Source="avares://NewToys/Styles/Controls.axaml"/>

        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SiderIconBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SiderSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SiderIconActiveBrush}"/>
        </Style>
        <!-- 选中态用 class 切换（而不是 code-behind 写 Background 本地值）：
             本地值优先级高于样式，写了本地值后 :pointerover 就再也不生效了。
             ShellView.UpdateSelection() 只负责增删 active class。 -->
        <!-- 一级菜单选中态：背景用强调色派生（CardSelectedBrush），图标用强调色（AccentBrush），
             让侧栏也跟随主题强调色；这两个键都是 DynamicResource，换肤时自动更新（无需 code-behind）。 -->
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.win-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.win-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}"/>
        </Style>
        <Style Selector="Button.win-btn.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}"/>
        </Style>
        <Style Selector="Button.win-btn.close:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TitleBarCloseHoverTextBrush}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!--  列表本体（行高 / 悬停 / 选中底色）；表头与单元格的样式见 Styles/Controls.axaml  -->
        <Style Selector="ListBox.list-page">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <!-- ⚠️ 必须 Stretch：行模板用星号列跟表头对齐，不拉伸就永远错位 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
        </Style>

        <!--  收藏按钮墙（首页常用功能 / PcTools 收藏夹）：一排按钮，点即执行  -->
        <Style Selector="Button.fav-btn">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
    </Application.Styles>
</Application>
