<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.ScrapeView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid Margin="12">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->


    

      <!--  ==================== 列表本体  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding UrlHeader}"
                      IsVisible="{Binding IsUrlVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding RuleHeader}"
                      IsVisible="{Binding IsRuleVisible}"/>
              <Button Grid.Column="3" Classes="col-header" Content="{Binding LastRunHeader}"
                      IsVisible="{Binding IsLastRunVisible}"/>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="名称" IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="起始网址" ToggleType="CheckBox" IsChecked="{Binding IsUrlVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Url"/>
                  <MenuItem Header="规则" ToggleType="CheckBox" IsChecked="{Binding IsRuleVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Rule"/>
                  <MenuItem Header="最近运行" ToggleType="CheckBox" IsChecked="{Binding IsLastRunVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="LastRun"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <!--  v3.32 §4.8.3：示例行（列表为空时显示；有真实数据后整条消失，⛔ 不参与统计 / 筛选 / 排序）  -->
          <Border Grid.Row="1" Classes="list-header" IsVisible="{Binding ShowSampleRow}" Opacity="0.5"
                  ToolTip.Tip="这是示例数据（列宽就按它判定）；新增 / 导入任务后这一行会消失">
            <v:ColumnGrid ColumnSpecs="{Binding VisibleColumnSpecs}">
              <TextBlock Grid.Column="0" Classes="list-cell primary" IsVisible="{Binding IsNameVisible}" Text="{Binding SampleRowTexts[0]}"/>
              <TextBlock Grid.Column="1" Classes="list-cell" IsVisible="{Binding IsUrlVisible}" Text="{Binding SampleRowTexts[1]}"/>
              <TextBlock Grid.Column="2" Classes="list-cell" IsVisible="{Binding IsRuleVisible}" Text="{Binding SampleRowTexts[2]}"/>
              <TextBlock Grid.Column="3" Classes="list-cell" IsVisible="{Binding IsLastRunVisible}" Text="{Binding SampleRowTexts[3]}"/>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="2" x:Name="TaskList" Classes="list-page"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="▶ 运行" Command="{Binding RunCommand}"/>
                <MenuItem Header="🔖 发送到书签" Command="{Binding SendToBookmarkCommand}"/>
                <Separator/>
                <MenuItem Header="✏ 编辑" Command="{Binding ShowDetailCommand}"/>
                <MenuItem Header="🗑 删除" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding StartUrl}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsUrlVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Rule}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsRuleVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell"
                             Text="{Binding LastRunAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsLastRunVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

  </Grid>
</UserControl>
