<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.MediaAssets.Views.AssetTrashView">
  <!--
    「回收站」页：`assets.status='trashed'` 的资产表格（右详情卡由 **Shell** 承载，⛔ 本页不自带右栏）。
    ⚠️ 「♻ 恢复」= 只改库状态（逻辑操作）；「🗑 永久删除 / 清空」= 真删磁盘 + 删索引（物理操作 → 任务中心可见）。

    列表本体 = <v:TableViewHost>：表头自带、列宽可拖、行回收；列显隐 / 排序键按 VM 的 ColumnLayout 对齐
    （🔴 Columns 声明顺序必须与之一致），故骨架的 HeaderArea 不填。
  -->
  <v:ListPageSkeleton EmptyMessage="没有可显示的资产。删除的资产会先放到回收站，可以在这儿恢复。"
                      EmptyActionText="🔄 重读回收站"
                      EmptyActionCommand="{Binding RefreshTrashCommand}"
                      IsEmpty="{Binding !HasItems}">

    <v:ListPageSkeleton.TopArea>
    <Border Classes="filter-bar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" LineSpacing="4">
        <TextBlock Text="{Binding FilterSummary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="左键表头排序 · 右键表头选列 / 筛选" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </WrapPanel>
    </Border>
    </v:ListPageSkeleton.TopArea>

    <v:ListPageSkeleton.ListArea>
        <v:TableViewHost x:Name="TrashList"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionMode="Single">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="2.6*">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             ToolTip.Tip="{Binding FilePath}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="0.8*" Binding="{Binding TypeText}"/>
            <TableViewColumn Width="90" Binding="{Binding SizeText}" HorizontalContentAlignment="Center"/>
            <TableViewColumn Width="1.3*" Binding="{Binding ModifiedText}"/>
            <TableViewColumn Width="1.2*" Binding="{Binding StorageName}"/>
          </v:TableViewHost.Columns>

          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Header="♻ 恢复" Command="{Binding RestoreCommand}"
                        ToolTip.Tip="改回「正常」状态（库操作，磁盘文件没动）"/>
              <MenuItem Header="📁 打开所在文件夹" Command="{Binding OpenFolderCommand}"/>
              <Separator/>
              <MenuItem Header="🗑 永久删除" Command="{Binding PurgeSelectedCommand}"
                        ToolTip.Tip="真删磁盘文件（二次确认；无法还原）"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
