<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.MediaAssets.Views.AssetCollectionsView">
  <!--
    「集合管理」页：与「标签管理」同构的表格页（名称 / 类型 / 成员数 / 创建时间）+ 详情卡（Shell 承载）。
    🔴 成员与顺序都在**详情卡**里（点一行选中 → ⬆ / ⬇ / 移出），本页 ⛔ 不再有第二张表格。
    ⚠️ 列表本体 = <v:TableViewHost>：表头粘顶 / 列宽可拖 / 列显隐与排序键按 VM 的 ColumnLayout 对齐，
       ⇒ 骨架的 HeaderArea 不填，XAML ⛔ 不写 IsXxxVisible 绑定。
    🔴 Columns 的声明顺序必须与 VM 的 ColumnLayout 一致。
  -->
  <v:ListPageSkeleton EmptyMessage="还没有集合。点「新建集合」开一个手动集合。"
                      EmptyActionText="＋ 新建集合"
                      EmptyActionCommand="{Binding NewCollectionCommand}"
                      IsEmpty="{Binding !HasItems}">

    <v:ListPageSkeleton.TopArea>
      <Border Classes="filter-bar">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" LineSpacing="4">
          <TextBlock Text="{Binding FilterSummary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Text="左键表头排序；右键表头选列 / 筛选；成员与顺序在右侧详情卡" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
      </Border>
    </v:ListPageSkeleton.TopArea>

    <v:ListPageSkeleton.ListArea>
      <v:TableViewHost x:Name="CollectionList" Classes="list-page"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}"
                       SelectionMode="Single">
        <v:TableViewHost.Columns>
          <TableViewColumn Width="2.4*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Border Width="3" Height="14" CornerRadius="2" Background="{Binding AccentBrush}"/>
                  <TextBlock Text="{Binding TypeIcon}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>

          <TableViewColumn Width="0.8*" Binding="{Binding TypeText}"/>
          <TableViewColumn Width="0.9*" Binding="{Binding MemberText}"/>
          <TableViewColumn Width="1.4*" Binding="{Binding CreatedText}"/>
        </v:TableViewHost.Columns>

        <v:TableViewHost.ContextMenu>
          <ContextMenu>
            <MenuItem Header="重命名…" Icon="{m:Glyph IconEdit}" Command="{Binding RenameCollectionCommand}"/>
            <MenuItem Icon="＋" Header="新建智能集合…" Command="{Binding NewSmartCommand}"/>
            <Separator/>
            <MenuItem Header="删除集合" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteCollectionCommand}"/>
          </ContextMenu>
        </v:TableViewHost.ContextMenu>
      </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
