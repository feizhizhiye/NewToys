<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.ScriptManager.Views.CrawlPanelView">
  <!--
    「网络工具 → 爬虫面板」（web-crawl，NT-086 批 D）。

    形态（需求 §6.3.1 D）：顶部「脚本 ▾」（Shell 工具条承载）+
    三节（节头仿信息面板：状态点 / 标题 / 计数 / ⟳ / 折叠）：
      ① 链接·目录（动态列 DynamicColumnGrid；双击 url 行 = 下钻；右键 试下载/复制诊断）
      ② 试下载预览（期② NT-087 占位）
      ③ 下载进度（期② NT-087 占位）
    底栏摘要：条数 · 字段数 · 错误数 · 耗时。

    🔴 列是运行时变的（每脚本自己的 RULES）⇒ 表头与行都用 v:DynamicColumnGrid（⛔ 不用静态列）。
    🔴 颜色一律 DynamicResource 引主题语义键（⛔ 不写死色值）。
    🔴 行右键命令挂在行对象上（ContextMenu 在弹出树，取不到页面 VM）。
  -->
  <UserControl.Styles>
    <!--  节头状态点：未抓=次要色 / 正常=强调色 / 有警告=强调派生亮色 / 出错=危险色  -->
    <Style Selector="Border.status-dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.ok">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.warn">
      <Setter Property="Background" Value="{DynamicResource CardSelectedTextBrush}"/>
    </Style>
    <Style Selector="Border.status-dot.error">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!--  节头  -->
    <Style Selector="Border.section-head">
      <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!--  节容器：底部一条分隔线  -->
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--  数据行：悬停底色（选中效果不走行底，与信息面板同口径）  -->
    <Style Selector="Border.info-row">
      <Setter Property="Padding" Value="0,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Border.info-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <!--  已勾选（= 「下载」范围）：行底色即状态，⛔ 不用行首勾选框  -->
    <Style Selector="Border.info-row.selected">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <!--  ==================== 主体：四节  ====================  -->
    <Border Grid.Row="0" Classes="card" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="section">
                <StackPanel Spacing="0">

                  <!--  节头：状态点 + 标题 + 计数 + ⟳（仅目录节）+ 折叠  -->
                  <Border Classes="section-head" CornerRadius="3">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                      <Border Grid.Column="0" Classes="status-dot" Margin="0,0,8,0"
                              Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                              Classes.error="{Binding IsError}"/>

                      <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Text="{Binding Title}"/>

                      <TextBlock Grid.Column="2" Classes="hint-text" FontSize="12" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Text="{Binding CountText}"/>

                      <!--  ⟳ 重跑（⛔ 只有目录节能跑；命令挂在节对象上）  -->
                      <Button Grid.Column="3" Classes="ghost" Content="⟳" Width="24" Height="22" Padding="0"
                              FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="重跑这一节（目录 = 重新抓取；试下载 = 再跑一次）"
                              Command="{Binding RefreshCommand}" IsVisible="{Binding !IsProgress}"/>

                      <Button Grid.Column="4" Classes="ghost" Content="▾" Width="24" Height="22" Padding="0"
                              FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="折叠 / 展开这一节"
                              Command="{Binding ToggleCommand}" IsVisible="{Binding IsExpanded}"/>
                      <Button Grid.Column="4" Classes="ghost" Content="›" Width="24" Height="22" Padding="0"
                              FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="折叠 / 展开这一节"
                              Command="{Binding ToggleCommand}" IsVisible="{Binding !IsExpanded}"/>
                    </Grid>
                  </Border>

                  <StackPanel IsVisible="{Binding IsExpanded}" Spacing="0">

                    <!--  ① 链接·目录（行内勾选 = 「下载」的作用域；单击行切换，⛔ 不再有勾选框列）  -->
                    <StackPanel IsVisible="{Binding IsLinks}" Spacing="0">
                      <Border Classes="list-header" Margin="0,4,0,0">
                        <v:DynamicColumnGrid ColumnSpecs="{Binding ColumnSpecs}"
                                             HeaderCells="{Binding HeaderCells}"/>
                      </Border>

                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="info-row" DoubleTapped="OnRowDoubleTapped"
                                    Classes.selected="{Binding IsSelected}"
                                    PointerPressed="OnRowPointerPressed">
                              <Border.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="全选 / 取消勾选" Icon="{m:Glyph IconCheckAll}" Command="{Binding ToggleAllLinksCommand}"/>
                                  <Separator/>
                                  <MenuItem Header="🧪 试下载" Command="{Binding TryDownloadCommand}"/>
                                  <MenuItem Header="复制" Icon="{m:Glyph IconCopy}" Command="{Binding CopyDiagCommand}"/>
                                </ContextMenu>
                              </Border.ContextMenu>
                              <v:DynamicColumnGrid
                                  ColumnSpecs="{Binding $parent[ItemsControl].DataContext.ColumnSpecs}"
                                  Cells="{Binding Cells}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Classes="hint-text" Margin="12,8" TextWrapping="Wrap"
                                 Text="{Binding EmptyText}" IsVisible="{Binding !HasEntries}"/>
                    </StackPanel>

                    <!--  ② 试下载预览（NT-087：⛔ 不落最终产物，临时副本在 trials\）  -->
                    <StackPanel IsVisible="{Binding IsPreview}" Margin="12,6" Spacing="4"
                                DataContext="{Binding $parent[ItemsControl].DataContext}">
                      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding Trial.Error}"
                                 IsVisible="{Binding Trial.HasError}"/>

                      <StackPanel Spacing="4" IsVisible="{Binding Trial.Ok}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Trial.Title}"/>
                        <TextBlock Classes="hint-text" Text="{Binding Trial.KindText}"/>

                        <!--  文件清单（形态 = files 时才有）  -->
                        <ItemsControl ItemsSource="{Binding Trial.FileLines}"
                                      IsVisible="{Binding Trial.HasFiles}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Classes="hint-text" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  正文预览（形态 = text 时才有；前 600 字）  -->
                        <Border Classes="section" CornerRadius="3" Padding="8"
                                IsVisible="{Binding Trial.HasText}">
                          <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding Trial.TextPreview}"/>
                        </Border>

                        <TextBlock Classes="hint-text"
                                   Text="{Binding Trial.Pages, StringFormat='共 {0} 页'}"/>
                      </StackPanel>

                      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding Hint}"
                                 IsVisible="{Binding !Trial.HasResult}"/>
                    </StackPanel>

                    <!--  ③ 下载进度（NT-087：逐行结局 + 进度条 + 当前条目）  -->
                    <StackPanel IsVisible="{Binding IsProgress}" Margin="12,6" Spacing="6"
                                DataContext="{Binding $parent[ItemsControl].DataContext}">
                      <Grid ColumnDefinitions="*,Auto">
                        <ProgressBar Grid.Column="0" Height="4" MinWidth="0" MinHeight="0"
                                     VerticalAlignment="Center" Value="{Binding DlDone}"
                                     Maximum="{Binding DlMax}"
                                     IsIndeterminate="{Binding DlIndeterminate}"/>
                        <TextBlock Grid.Column="1" Classes="hint-text" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Text="{Binding DlProgressText}"/>
                      </Grid>

                      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding DlCurrent}"
                                 IsVisible="{Binding HasDlCurrent}"/>

                      <ItemsControl ItemsSource="{Binding DownloadRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="20,*">
                              <TextBlock Grid.Column="0" Classes="hint-text" Text="{Binding StatusText}"/>
                              <TextBlock Grid.Column="1" Classes="hint-text" TextWrapping="Wrap"
                                         Text="{Binding Detail}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding Hint}"
                                 IsVisible="{Binding !HasDownloadRows}"/>
                    </StackPanel>

                    <!--  ④ 运行记录（NT-090：历史 run + 打开目录 / 日志 / 复制诊断）  -->
                    <StackPanel IsVisible="{Binding IsHistory}" Margin="12,6" Spacing="0"
                                DataContext="{Binding $parent[ItemsControl].DataContext}">
                      <ItemsControl ItemsSource="{Binding HistoryRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="info-row" DoubleTapped="OnHistoryDoubleTapped">
                              <Border.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="打开目录" Icon="{m:Glyph IconOpen}" Command="{Binding OpenDirCommand}"/>
                                  <MenuItem Header="📄 打开日志" Command="{Binding OpenLogCommand}"/>
                                  <MenuItem Header="复制" Icon="{m:Glyph IconCopy}" Command="{Binding CopyDiagCommand}"/>
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Grid ColumnDefinitions="110,*,170">
                                <TextBlock Grid.Column="0" Classes="hint-text" VerticalAlignment="Center"
                                           Text="{Binding AtText}"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Url}" Text="{Binding Url}"/>
                                <TextBlock Grid.Column="2" Classes="hint-text" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Text="{Binding Summary}"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Classes="hint-text" Margin="0,8" TextWrapping="Wrap"
                                 Text="{Binding HistoryEmptyText}" IsVisible="{Binding !HasHistoryRows}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!--  ==================== 底栏：摘要（条数 · 字段数 · 错误数 · 耗时）  ====================  -->
    <TextBlock Grid.Row="1" Classes="hint-text" VerticalAlignment="Center" Margin="12,4"
               Text="{Binding FooterSummary}"/>
  </Grid>
</UserControl>
