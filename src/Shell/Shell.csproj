<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NewToys.Shell</RootNamespace>
    <AssemblyName>NewToys</AssemblyName>
    <!--  NT-057：应用图标。**exe 图标** = 本文件（编译进 Windows 资源，⛔ 不需要复制到输出目录）；
          **窗口 / 托盘图标** = 运行时按当前强调色重画的同一形状（见 App.axaml.cs 的 CreateAppIcon），
          形状口径与本 ICO 一致（圆角 + N），改一处必须同步另一处。  -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <!--  ⛔ 模块独有第三方依赖「提级」到主程序声明（Release 依赖缺失修复）。
        根因：功能模块都是类库，.NET 默认 CopyLocalLockFileAssemblies=false，类库 build 不复制
        自己的 NuGet 依赖 DLL；Debug 下靠 Shell 的 ProjectReference 传递引用兜底，Release 下模块
        独立编译 → 这些 DLL 丢失，运行时（默认 ALC 从程序根目录解析）找不到。
        解法：把这些「模块独有、主程序本不引用」的包也声明在主程序，让 DLL 随主程序复制到
        程序根目录一份，模块 LoadFrom 后默认 ALC 即可解析。版本走 Directory.Packages.props 集中管理。
        ⚠️ 只覆盖「自己仓库里的模块」；「第三方编译、带全新依赖的模块」仍不在此列（见 ModuleLoader 的 ModuleAlc）。  -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Jint" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="TagLibSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <!--  NT-063：跨模块复用的 View 层件（ColumnGrid / 详情卡渲染 / ListFooterBar）收进 NewToys.UI  -->
    <ProjectReference Include="../UI/NewToys.UI.csproj" />
    <!--  NT-062：应用级设置归 Shell 自带（原 Module.Settings 已撤销），此处不再有无条件模块引用。  -->
  </ItemGroup>

  <!--  默认数据：随程序发布到 <程序目录>\defaults\ —— 由各模块的 Seeder 首次运行时复制到配置根（⛔ 不是 Core 复制）。
        现在三处：defaults\sysinfo\（内置采集脚本，Module.ScriptManager.BuiltinCollectorSeeder，缺了就补）、
        defaults\scripts\（示例脚本 + 采集器模板，ExampleSeeder，只播种一次）、
        defaults\env-scripts\（环境脚本 + 依赖清单，EnvScriptsSeeder，只播种一次）。
        （2026-10-20：原 defaults\tools\convert_legado.py 随 Legado 兼容一并移除，该目录已空。）
        ⚠️ 用 None Update（不是 Content/None Include）：这些文件本来就在 SDK 的默认 None 通配里，
           Update 只改"要不要复制到输出"，再加一条 Include 会撞 NETSDK1022 重复项。
        ⚠️ 放在 Shell 而不是 Core：Shell 是被引用的终点（模块不会引用它），
           默认数据只会在程序根目录出现一份，不会连带复制进 Release 的 Modules\。  -->
  <ItemGroup>
    <None Update="defaults\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--  Debug 才引用**功能模块**项目：支持断点与热重载，并与 App.axaml.cs 的 #if DEBUG 显式类型清单配套。
        Release 下 Shell 不引用功能模块，模块 DLL 由 src\Directory.Build.props 直接产出到
        artifacts\release\Modules\，运行时由 ModuleLoader 扫描该目录。
        ⛔ 跳过某个功能模块要同时注释这里和 App.axaml.cs 的 typeof(...) 两处。  -->
  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <ProjectReference Include="../Module.ScriptManager/Module.ScriptManager.csproj" />
    <ProjectReference Include="../Module.WebTools/Module.WebTools.csproj" />
    <ProjectReference Include="../Module.VideoTools/Module.VideoTools.csproj" />
    <ProjectReference Include="../Module.MediaAssets/Module.MediaAssets.csproj" />
    <!--  NT-091：系统工具（Order 25）  -->
    <ProjectReference Include="../Module.SystemTools/Module.SystemTools.csproj" />
    <!--  备份中心（Order 60）  -->
    <ProjectReference Include="../Module.BackupCenter/Module.BackupCenter.csproj" />
    <!--  查看器（Order 55，NT-124）  -->
    <ProjectReference Include="../Module.Viewer/Module.Viewer.csproj" />
    <!--  阅读（Order 56，NT-125）  -->
    <ProjectReference Include="../Module.Reading/Module.Reading.csproj" />
  </ItemGroup>
</Project>