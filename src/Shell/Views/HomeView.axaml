<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Views.HomeView">
  <!--
    布局契约（需求 §6.1）：四行固定分区，页面本身不整体滚动。
      Row0 欢迎卡           —— 固定
      Row1 常用功能（收藏墙） —— 固定
      Row2 功能清单         —— 唯一滚动区（`*` 占满剩余高度，滚动发生在 AllFunctionsView 内部）
      Row3 一键按钮条        —— 恒定贴底
    展开 / 收起功能清单只改 Row2 的内容，**不推走**上面两块、也不顶动下面的按钮条。
    收藏按钮墙与一键按钮同一套外观（`fav-btn accent`）；一键按钮的设置在「设置 → 一键按钮」，
    本页只留一个齿轮入口，与三个按钮同行、贴右上角。
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--  ==================== Row0：欢迎卡（固定）  ====================  -->
    <Border Grid.Row="0" Classes="card" Padding="24" Margin="36,24,36,0">
      <StackPanel>
        <TextBlock Text="欢迎使用 NewToys" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Text="个人高强度使用工具集 · Avalonia 12 + CommunityToolkit.Mvvm + .NET 10" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock Text="这里是你的常用功能区，点按钮直达对应页面；末尾「＋ 更多」在下方就地展开功能清单（按模块分节，可折叠），在清单里右键可固定 / 取消固定。右键收藏按钮可「取消固定」。底部三个一键按钮的设置统一在应用级设置页的「一键按钮」节里。"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!--  ==================== Row1：常用功能 / 收藏墙（固定）  ====================  -->
    <StackPanel Grid.Row="1" Margin="36,16,36,0">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Path
          Width="18"
          Height="18"
          Classes="icon-accent"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Data="{StaticResource IconStar}" />
        <TextBlock Text="常用功能  " FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="点击按钮进入页面；右键「取消固定」移出" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Classes="empty-hint" Margin="8,8" Text="还没有固定任何功能 —— 点末尾的「＋ 更多」展开功能清单，右键一个功能选「📌 固定到首页」。"
                 IsVisible="{Binding !HasFavorites}"/>

      <!--  收藏卡 + 尾部「更多」卡同容器同流转（「更多」卡由 VM 恒追加在集合末尾）  -->
      <ItemsControl ItemsSource="{Binding Favorites}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--  右键菜单在 code-behind 现场构造（ContextMenu 挂在独立弹出树，模板内声明取不到页面 VM）  -->
            <Button Classes="fav-btn accent"
                    Command="{Binding Command}"
                    CommandParameter="{Binding CommandParameter}"
                    ContextRequested="OnFavContextRequested"
                    ToolTip.Tip="{Binding Desc}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!--  ==================== Row2：功能清单（唯一滚动区）  ====================  -->
    <ContentControl Grid.Row="2"
                    Margin="36,12,36,0"
                    Content="{Binding FunctionListContent}"
                    IsVisible="{Binding IsFunctionListOpen}" />

    <!--  ==================== Row3：一键操作条（恒定贴底）  ====================  -->
    <Border Grid.Row="3" Background="{DynamicResource ContentHeaderBrush}" Padding="24,8,24,10">
      <Grid ColumnDefinitions="*,*,*,Auto">
        <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding QuickButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!--  与收藏按钮同一套外观（fav-btn accent）；文字颜色**继承**按钮前景色，
                    悬停变实心时自动转成 AccentTextBrush，副标题用透明度区分层级。  -->
              <Button Classes="fav-btn accent"
                      Height="44"
                      Margin="6,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="14,0"
                      Command="{Binding RunCommand}"
                      ToolTip.Tip="点击执行；设置请用右侧齿轮">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.75"/>
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  一键按钮设置入口：缩小到 24，与三个按钮同行、贴右上角  -->
        <Button Grid.Column="3" Classes="ghost" Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                VerticalAlignment="Top"
                Command="{Binding NavigateCommand}" CommandParameter="settings-launch"
                ToolTip.Tip="一键按钮设置：改按钮名称、浏览器程序与参数、网址清单、批量启动的软件清单">
          <Path
            Width="14"
            Height="14"
            Classes="icon-primary"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Uniform"
            Data="{StaticResource IconGear}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
