<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Settings.Views.AllFunctionsView">
  <Grid RowDefinitions="Auto,*">
    <!-- NT-052：「增加功能」操作区（页面级功能入口）——「🔄 重载模块」由标题栏移入此处。
         放在 ScrollViewer **外** = 不随内容滚动；重载 = 给本清单增加新模块的功能，语义最顺。
         结果反馈走壳级底栏（ShellViewModel 订阅 IModuleReloadService.Reloaded），本页不设状态行。 -->
    <Border Grid.Row="0" Padding="24,16,24,0">
      <StackPanel Spacing="8">
        <TextBlock Text="把新的模块 DLL 放进 Modules\ 目录后，点「🔄 重载模块」即可装进来 —— 重载后本清单与左侧菜单会立即刷新（只新增；移除模块要重启）。"
                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Classes="ghost" HorizontalAlignment="Left" Content="🔄 重载模块"
                Command="{Binding ReloadModulesCommand}"
                ToolTip.Tip="重扫 Modules\ 目录，把新放的模块 DLL 装进来（只新增；移除模块要重启）"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Groups}" Margin="24,16">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,20">
            <!-- 模块分组标题：图标（v3.2 矢量，取不到时回退文本） + 名称 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
              <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                    Data="{Binding IconGeometry}" IsVisible="{Binding HasVectorIcon}"
                    Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5"/>
              <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"
                         IsVisible="{Binding !HasVectorIcon}"/>
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 该模块下的二级功能：可换行卡片，点击跳转，右键固定到首页收藏夹 -->
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,10,10" Classes="ghost"
                          Tag="{Binding Key}"
                          PointerPressed="OnCardPointerPressed"
                          Command="{Binding $parent[UserControl].DataContext.NavigateCommand}"
                          CommandParameter="{Binding Key}"
                          ToolTip.Tip="{Binding Title}">
                    <Border Classes="card" Padding="14,10" MinWidth="180">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Title}" FontSize="14"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                          <!-- ★ 已固定标记：固定到首页收藏夹后显示 -->
                          <TextBlock Text="★" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock.IsVisible>
                              <Binding Path="IsFavorite"/>
                            </TextBlock.IsVisible>
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Desc}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   MaxWidth="220"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
  </Grid>
</UserControl>
