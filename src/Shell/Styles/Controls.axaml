<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  =====================================================================
        NewToys 复用样式表（v1.35）
        目的：把**每个列表页都抄一遍**的那几段 XAML（工具条 / 状态行 / 详情卡 /
        字段组 / 表头 / 行内按钮 …）收成 Class，页面里只写一行 Classes="…"。

        用法：Shell/App.axaml 里 <StyleInclude Source="avares://NewToys/Styles/Controls.axaml"/>
        样式是**应用级**的，模块（PcTools / VideoTools / Settings / WebTools）里的
        控件直接写 Classes 即可生效，不需要各模块再抄一份。

        ⚠️ 铁律：颜色一律 DynamicResource + *Brush 语义键，禁写死 #RRGGBB
        （否则换主题后写死的那个控件不跟着变）。
        ===================================================================== -->

  <!--  ① 工具条：列表页顶部那条（背景 + 底部分隔线 + 内边距），页面里套 WrapPanel 即可  -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!--  ② 页面右上角「状态行」：所有页面都有的那一行文字  -->
  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.info-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ③ 提示 / 说明文字（说明条、字段下方的灰色小字、底部数据文件提示）  -->
  <Style Selector="TextBlock.hint-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.empty-hint">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ④ 详情卡字段组：「小标签 + 值」这一对，页面里只需 Classes="field"  -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="2"/>
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.field-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>

  <!--  ⑤ 右侧详情卡（宽度 / 外边距 / 圆角统一；收起时整列不占位）
       v3.12 密度：内边距 14 → 12。
       ⚠️ **宽度 340 是硬约定（需求 §4.5），别动**；滚动条是覆盖式的、需要右侧留位的那两页
          （video-cut / video-batch）在**本页 XAML 里覆盖 Padding**，不要改这里 —— 会波及 12 个列表页。  -->
  <Style Selector="Border.detail-card">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Width" Value="340"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>

  <!--  ⑤-b 详情卡里的下拉框（需求 §6.4.1 规则 6）：
        ① 宽度拉满 → 与同卡里其它控件（TextBox 等）左对齐、同样宽；
        ② 限制弹出高度 → 长列表不会盖住 / 顶到别处控件（Popup 是浮层，本就不挤布局，这里只做视觉收敛）。
        ⚠️ 只作用于 detail-card 内的 ComboBox，不影响筛选条等其它下拉。  -->
  <Style Selector="Border.detail-card ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MaxDropDownHeight" Value="260"/>
  </Style>

  <!--  ⑥ 分隔线  -->
  <Style Selector="Border.divider-line">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!--  ⑦ 行内小按钮（列表行里的「▶ 运行」之类）与小号按钮  -->
  <Style Selector="Button.row-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!--  ⑧ 表头按钮（可排序）
        ⚠️ 关键修复（v1.35）：以前这里写了 VerticalAlignment="Center"，
           按钮高度被压成"文字那一条"，鼠标只有落在字的那十几像素上才点得到 ——
           表头空白处点了没反应。现在改成**撑满表头整行**（Stretch + 内容居中），
           整列整行都是点击区；文字仍然垂直居中。 -->
  <Style Selector="Button.col-header">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.col-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑨ 详情栏开关（v3.12：**从表头右缘挪到工具条末位**）
        旧做法 `Border.detail-hotspot` + `Button.header-toggle`（64px 透明热区、收起态只露 8px、鼠标靠近才弹）
        已**整体废除**：它占掉一整列表头宽度（列元数据里还得挂一个 `Detail` 占位列）、不把鼠标移过去就点不到、
        还和表头的"排序 / 列显隐"两种交互挤在一处。
        现做法：工具条右侧（`Grid ColumnDefinitions="*,Auto"` 的右列）放一个**常驻**小按钮，
        图标 ❯ = 展开右侧详情、❮ = 收起 —— 一眼知道当前是哪种。  -->
  <Style Selector="Button.detail-toggle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="MinWidth" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="Button.detail-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑩ 表头容器（高度固定 32，内部按钮靠 ⑧ 撑满 —— 点击区 = 整格；v3.12 由 36 收紧）  -->
  <Style Selector="Border.list-header">
    <Setter Property="Background" Value="{DynamicResource SubSiderHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="32"/>
  </Style>

  <!--  ⑪ 表格单元格：默认次要色；加 .primary / .accent 切换字的颜色。
       v3.12 密度：行高 32→28、左右内边距 12→8（**表头 ⑧ 的 Padding 必须同步改，否则表头与行错位**）。
       v3.16.1：⛔ 删掉 MinHeight=28 —— TextBlock 的文本永远绘制在**元素框顶部**，框被 MinHeight 撑高后
       文字就整体偏上（勾选列把行撑高后尤其明显）。行高基线改由 `ListBox.list-page ListBoxItem` 的
       MinHeight=28 兜底（见 App.axaml），元素高度=文本高度，VerticalAlignment=Center 才是真居中。  -->
  <Style Selector="TextBlock.list-cell">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑫ 等宽输入（命令 / 脚本文件 / 时间码）  -->
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>

  <!--  ⑬ 筛选条：多项筛选那一行的容器与其中的控件  -->
  <Style Selector="Border.filter-bar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="12,4"/>
  </Style>
  <Style Selector="ComboBox.filter-combo">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="110"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.filter-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Width" Value="140"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.filter-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="Button.filter-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑭ 进度条（转码 / 剪切任务跑起来时显示百分比）  -->
  <Style Selector="ProgressBar.task-progress">
    <Setter Property="Height" Value="6"/>
    <Setter Property="MinWidth" Value="60"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <!--  ⑮ 状态徽章（任务的「等待 / 运行中 / 完成 / 失败」）  -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.badge-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑯ 导入导出控件条（列表页通用：快捷设置 / 设置与脚本 / 视频列表 / 软件包已装导出 同一套）
        容器 = io-bar（与筛选条同款底，但独立键避免和筛选条语义混），按钮 = io-btn（与 filter-btn 同款外观）。
        各列表页直接用 Classes="io-bar" / Classes="io-btn"，不各自造配色（需求 §4.10.4）。  -->
  <Style Selector="Border.io-bar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style Selector="Button.io-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="Button.io-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

</Styles>
