<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:NewToys.Shell.Controls"
             xmlns:ui="using:NewToys.UI.Controls"
             x:Class="NewToys.Shell.Views.SettingsView">
  <!--
    v3.65 / NT-062「应用级设置页」（需求 §4.9.2 / §6.5）。
    🔴 NT-068（2026-10-18）：**整页骨架搬到 UI 库** <ui:SettingsSectionHost> ——
       树状手风琴 / 磁吸抬头 / Push / 滚动自动展开 / 全部收起 / 节内工具条 / 滚动定位全在那边，
       本页只剩「把节的集合交给宿主 + 把 ToolbarHost 作为节内工具条模板传进去」。
       ⛔ 本页不再有折叠逻辑（VM 也不再有 ToggleSection / ToggleAllSections 命令）。
    ⛔ 切节不新开标签页；⛔ 本页没有右详情卡（契约已取消，见 SettingsViewModel 注释）。
  -->
  <ui:SettingsSectionHost x:Name="Host" ItemsSource="{Binding Sections}">
    <!--  节内工具条（当前只有「运行环境」节有）：DataContext = 节的 VM  -->
    <ui:SettingsSectionHost.ToolbarTemplate>
      <DataTemplate>
        <ctl:ToolbarHost Source="{Binding}" />
      </DataTemplate>
    </ui:SettingsSectionHost.ToolbarTemplate>
  </ui:SettingsSectionHost>
</UserControl>
