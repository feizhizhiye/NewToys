<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NewToys.Reading.Views"
             x:Class="NewToys.Reading.Views.ExploreView">
  <!--
    网络阅读 → 发现（`reading-explore`）：左「书源 → 分类」树 + 右书单行列表。
    点一行 = 弹书籍卡（阅读 / 加书架都在卡里），⛔ 本页不内嵌正文。
  -->
  <UserControl.Styles>
    <!--  树与列表的行都要撑满栏宽，否则每项底色只包住文字、宽度参差不齐  -->
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="12,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost" Content="🔄 重读书源" Command="{Binding ReloadSourcesCommand}"/>
          <Button Classes="ghost" Content="✖ 取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding CanPage}">
          <Button Classes="ghost" Content="◀" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}"/>
          <TextBlock Classes="hint-text" Text="{Binding PageText}" VerticalAlignment="Center"/>
          <Button Classes="ghost" Content="▶" Command="{Binding NextPageCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <Border Background="{DynamicResource ContentHeaderBrush}" Padding="12,4" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="4">
          <TextBlock Classes="hint-text" Text="{Binding BusyPhase}"/>
          <ProgressBar IsIndeterminate="True" Height="3"/>
        </StackPanel>
      </Border>

      <Border Padding="12,4" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   FontSize="12"/>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="258,*" Margin="12,0,12,12">

      <!--  ==================== 左：书源 → 分类（折叠树，行宽一致）  ====================  -->
      <Border Grid.Column="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Margin="0,8,8,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="section-title" Margin="10,8,10,6" Text="书源 / 分类"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SourceTree" ItemsSource="{Binding Nodes}" Margin="4,0,4,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander HorizontalAlignment="Stretch"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            Margin="0,0,0,2">
                    <Expander.Header>
                      <!--  书源名整段显示（⛔ 不截断、宽度不够就换行），下面的能力 / 分类数用更小的字  -->
                      <StackPanel Margin="0,3" Spacing="1">
                        <TextBlock Classes="list-cell primary"
                                   Text="{Binding Name}"
                                   TextWrapping="Wrap"
                                   Padding="0"
                                   LineHeight="16"/>
                        <TextBlock Classes="hint-text"
                                   Text="{Binding Hint}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Padding="0"/>
                      </StackPanel>
                    </Expander.Header>
                    <ListBox x:Name="CategoryList"
                             ItemsSource="{Binding Children}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="6,2,0,4">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <!--  分类是这棵树的主角 ⇒ 比书源名大一号  -->
                          <TextBlock Text="{Binding Name}"
                                     FontSize="14"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     Padding="8,0,0,0"/>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!--  ==================== 右：书单行列表（点一行弹书籍卡）  ====================  -->
      <Border Grid.Column="1"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Margin="0,8,0,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="section-title" Margin="10,8,10,6" Text="{Binding ListTitle}"/>

          <ListBox x:Name="ResultList"
                   ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="8,0,8,8">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Height="46">
                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="list-cell primary"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="hint-text"
                               Text="{Binding AuthorText}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0">
                    <TextBlock Classes="hint-text"
                               Text="{Binding LastChapter}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"
                               HorizontalAlignment="Right"/>
                    <TextBlock Classes="hint-text"
                               Text="{Binding SourceName}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"
                               HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!--  书籍卡浮层（盖住整页，IsVisible 由 VM 的 IsCardOpen 控制）  -->
    <views:BookCardOverlay Grid.Row="0" Grid.RowSpan="3"/>
  </Grid>
</UserControl>
