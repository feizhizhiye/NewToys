<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.SystemTools.Views.FavoritesView">
  <!--
    「系统工具 → 收藏夹」（`script-favorites`，NT-091 自脚本中心平移）。
    形态 = **按钮墙**；操作逻辑与首页「常用功能」按钮一致：
    左键点击执行 · 右键菜单「▶ 运行 / ✕ 移出收藏夹」（⛔ 不再用行内 ✕ 按钮）。
  -->
  <Grid RowDefinitions="Auto,Auto,*">

    <!--  说明条  -->
    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="24,10">
      <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap"
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Border>

    <Border Grid.Row="1" Padding="24,6">
      <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="还没有收藏任何项 —— 去「命令库」里选中一条，点工具条的「★ 收藏」。"
                   IsVisible="{Binding IsEmpty}" Margin="8" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!--  右键菜单在 code-behind 现场构造（ContextMenu 挂在独立弹出树里，模板内声明取不到页面 VM）。  -->
              <Button Classes="fav-btn accent" Content="{Binding Title}"
                      Command="{Binding $parent[UserControl].DataContext.RunCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding $parent[UserControl].DataContext.IsNotBusy}"
                      ContextRequested="OnItemContextRequested"
                      ToolTip.Tip="{Binding Command}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding DataFileHint}" FontSize="12" Margin="8" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
