<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.MediaAssets.Views.AssetCollectionsView">
  <!--
    「集合管理」页：左集合列表（📦 手动 / ⚡ 智能）+ 右成员表格。
    🔴 成员顺序 = `collection_assets.sort_order`，用「⬆ 上移 / ⬇ 下移」写（⛔ 未做鼠标拖放）。
    ⛔ 本页不实现 IDetailPanelProvider（两栏都在页内，Shell 不再显示右详情列）。
    右侧表格 = <v:TableViewHost>（列显隐 / 排序键按 VM 的 ColumnLayout 对齐，🔴 声明顺序必须一致）。
  -->
  <UserControl.Styles>
    <Style Selector="Button.coll-row">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.coll-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <!--  🔴 选中态：强调色文字 + 加粗 + 淡底（⛔ 不用已删除的 CardSelectedBrush）  -->
    <Style Selector="Button.coll-row.selected">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="260,*" Margin="12">

    <!--  ==================== 左：集合列表 ====================  -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid RowDefinitions="Auto,Auto,*">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
          <Button Classes="ghost" Content="➕ 新建集合" Command="{Binding NewCollectionCommand}"
                  ToolTip.Tip="新建一个手动集合（成员靠手工加 / 排序）"/>
          <Button Classes="ghost" Content="⚡ 新建智能" Command="{Binding NewSmartCommand}"
                  ToolTip.Tip="新建智能集合（⚠️ 本轮只存规则文本，规则求值未实装）"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0,6,0,0">
          <Button Classes="ghost" Content="✏ 改名" Command="{Binding RenameCollectionCommand}"/>
          <Button Classes="danger-btn" Content="🗑 删除" Command="{Binding DeleteCollectionCommand}"/>
          <Button Classes="ghost" Content="🔄 重读集合" Command="{Binding RefreshCollectionsCommand}"
                  ToolTip.Tip="重新读取集合表（⛔ 不扫盘）"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasCollections}"
                       Text="还没有集合。点上面「➕ 新建集合」开一个。"/>
            <ItemsControl ItemsSource="{Binding Collections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="coll-row" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].DataContext.SelectCollectionItemCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="4" Height="14" CornerRadius="2" Background="{Binding AccentBrush}"
                              VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding TypeIcon}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding MemberText}" FontSize="10" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!--  ==================== 右：成员列表 ====================  -->
    <v:ListPageSkeleton Grid.Column="1" Margin="8,0,0,0">

      <v:ListPageSkeleton.TopArea>
      <Border Classes="filter-bar">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding CollectionHint}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="往集合里加资产：到「全部资产」选中资产 → 详情卡里勾选集合 → 💾 保存。"/>
        </StackPanel>
      </Border>
      </v:ListPageSkeleton.TopArea>

      <v:ListPageSkeleton.ListArea>
        <v:TableViewHost x:Name="MemberList"
                         ItemsSource="{Binding Members}" SelectionMode="Single"
                         SelectedItem="{Binding SelectedMember, Mode=TwoWay}">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="2.6*">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="0.8*" Binding="{Binding TypeText}"/>
            <TableViewColumn Width="90" Binding="{Binding SizeText}" HorizontalContentAlignment="Center"/>
            <TableViewColumn Width="1.3*" Binding="{Binding ModifiedText}"/>
            <TableViewColumn Width="1.2*" Binding="{Binding StorageName}"/>
          </v:TableViewHost.Columns>

          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Header="⬆ 上移" Command="{Binding MoveUpCommand}"/>
              <MenuItem Header="⬇ 下移" Command="{Binding MoveDownCommand}"/>
              <Separator/>
              <MenuItem Header="⛔ 移出本集合" Command="{Binding RemoveMemberCommand}"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
      </v:ListPageSkeleton.ListArea>
    </v:ListPageSkeleton>
  </Grid>
</UserControl>
