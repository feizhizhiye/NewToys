<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.HostsView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid Margin="12">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->

    <!-- 工具条 -->
    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="primary" Content="➕ 新建方案" Margin="0,0,8,0" Command="{Binding NewProfileCommand}"/>
          <Button Classes="ghost" Content="🔄 重读方案" Margin="0,0,8,0" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="重新读一遍本地的 hosts 方案清单（⛔ 不动系统 hosts、不导入）"/>
          <TextBox Width="300" Margin="0,0,8,0" Text="{Binding ImportUrl, Mode=TwoWay}"
                   PlaceholderText="网络 hosts 文件 URL…" ToolTip.Tip="粘贴一份 hosts 文本文件的网址，点「导入」下载并解析"/>
          <Button Classes="ghost" Content="🌐 导入" Margin="0,0,8,0" Command="{Binding ImportCommand}"
                  IsEnabled="{Binding !IsBusy}"/>
          <TextBlock Text="双击应用 = 写入系统 hosts（需管理员）" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
        <Button Grid.Column="1" Classes="detail-toggle"
                Command="{Binding ToggleDetailPanelCommand}"
                ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
          <Panel>
            <TextBlock Text="❯" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsDetailVisible}"/>
            <TextBlock Text="❮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsDetailVisible}"/>
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!-- 主区：左列表 + 右详情 -->
    

      <!--  ==================== 列表本体  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">

          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding NameHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Name" ToolTip.Tip="点一下按名称排序"
                      IsVisible="{Binding IsNameVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding EntriesHeader}"
                      IsVisible="{Binding IsEntriesVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding SourceHeader}"
                      IsVisible="{Binding IsSourceVisible}"/>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="名称" IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" ToggleType="CheckBox" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Name"/>
                  <MenuItem Header="条目数" ToggleType="CheckBox" IsChecked="{Binding IsEntriesVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Entries"/>
                  <MenuItem Header="来源" ToggleType="CheckBox" IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                            Command="{Binding ToggleColumnCommand}" CommandParameter="Source"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <!--  v3.32 §4.8.3：示例行（列表为空时显示；有真实数据后整条消失，⛔ 不参与统计 / 筛选 / 排序）  -->
          <Border Grid.Row="1" Classes="list-header" IsVisible="{Binding ShowSampleRow}" Opacity="0.5"
                  ToolTip.Tip="这是示例数据（列宽就按它判定）；新建 / 导入方案后这一行会消失">
            <v:ColumnGrid ColumnSpecs="{Binding VisibleColumnSpecs}">
              <TextBlock Grid.Column="0" Classes="list-cell primary" IsVisible="{Binding IsNameVisible}" Text="{Binding SampleRowTexts[0]}"/>
              <TextBlock Grid.Column="1" Classes="list-cell" IsVisible="{Binding IsEntriesVisible}" Text="{Binding SampleRowTexts[1]}"/>
              <TextBlock Grid.Column="2" Classes="list-cell" IsVisible="{Binding IsSourceVisible}" Text="{Binding SampleRowTexts[2]}"/>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="2" x:Name="ProfileList" Classes="list-page"
                   ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="✅ 应用到系统 hosts" Command="{Binding ApplyCommand}"/>
                <MenuItem Header="📤 导出受管块" Command="{Binding ExportCommand}"/>
                <MenuItem Header="🗑 删除方案" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Entries.Count}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsEntriesVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Source}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

  </Grid>
</UserControl>
