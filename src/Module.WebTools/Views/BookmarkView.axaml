<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.WebTools.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NewToys.WebTools.Views.BookmarkView">
  <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。 -->
  <Grid ColumnDefinitions="*,Auto" Margin="12">

    <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
         Row0 保持空着（Auto → 高度 0），不动下面各行的行号。 -->

    <!-- 工具条 -->
    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnImport" Classes="primary" Content="📥 导入书签" Margin="0,0,8,0" ToolTip.Tip="选择浏览器导出的书签 HTML 文件"/>
          <Button Classes="ghost" Content="➕ 新建" Margin="0,0,8,0" Command="{Binding NewBookmarkCommand}"/>
          <Button Classes="ghost" Content="🔗 检测全部" Margin="0,0,8,0" Command="{Binding CheckAllCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Classes="ghost" Content="🚀 批量打开" Margin="0,0,8,0" Command="{Binding OpenBatchCommand}"/>
          <Button Classes="ghost" Content="🔄 重读书签" Margin="0,0,8,0" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="重新读一遍本地书签配置（⛔ 不联网、不导浏览器）"/>
          <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="搜索标题 / 网址 / 分组…"/>
          <TextBlock Text="右键列表项：联通检测 · 批量打开 · 打开 · 发送到抓取 · 编辑 · 删除" FontSize="11"
                     VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
        <Button Grid.Column="1" Classes="detail-toggle"
                Command="{Binding ToggleDetailCommand}"
                ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
          <Panel>
            <TextBlock Text="❯" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsDetailVisible}"/>
            <TextBlock Text="❮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsDetailVisible}"/>
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!-- 主区：左列表 + 右详情 -->
    

      <!--  ==================== 列表本体  ====================  -->
      <Border Grid.Row="3" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="list-header">
            <v:ColumnGrid x:Name="HeaderGrid" ColumnSpecs="{Binding VisibleColumnSpecs}">
              <Button Grid.Column="0" Classes="col-header" Content="{Binding TitleHeader}"
                      Command="{Binding SortCommand}" CommandParameter="Title" IsVisible="{Binding IsTitleVisible}"/>
              <Button Grid.Column="1" Classes="col-header" Content="{Binding UrlHeader}"
                      IsVisible="{Binding IsUrlVisible}"/>
              <Button Grid.Column="2" Classes="col-header" Content="{Binding FolderHeader}"
                      IsVisible="{Binding IsFolderVisible}"/>
              <Button Grid.Column="3" Classes="col-header" Content="{Binding StatusHeader}"
                      IsVisible="{Binding IsStatusVisible}"/>
              <v:ColumnGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="标题" IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" ToggleType="CheckBox" IsChecked="{Binding IsTitleVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Title"/>
                  <MenuItem Header="网址" ToggleType="CheckBox" IsChecked="{Binding IsUrlVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Url"/>
                  <MenuItem Header="分组" ToggleType="CheckBox" IsChecked="{Binding IsFolderVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Folder"/>
                  <MenuItem Header="状态" ToggleType="CheckBox" IsChecked="{Binding IsStatusVisible, Mode=OneWay}" Command="{Binding ToggleColumnCommand}" CommandParameter="Status"/>
                </ContextMenu>
              </v:ColumnGrid.ContextMenu>
            </v:ColumnGrid>
          </Border>

          <ListBox Grid.Row="1" x:Name="BookmarkList" Classes="list-page"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single">
            <ListBox.ContextMenu>
              <ContextMenu>
                <Separator/>
                <MenuItem Header="🔗 联通检测" Command="{Binding CheckCommand}"/>
                <MenuItem Header="📌 加入 / 移出批量打开" Command="{Binding ToggleBatchCommand}"/>
                <MenuItem Header="🌐 打开" Command="{Binding OpenCommand}"/>
                <MenuItem Header="🕷 发送到网页抓取" Command="{Binding SendToScrapeCommand}"/>
                <Separator/>
                <MenuItem Header="✏ 编辑" Command="{Binding ShowDetailCommand}"/>
                <MenuItem Header="🗑 删除" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Title}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsTitleVisible}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Url}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsUrlVisible}"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Folder}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsFolderVisible}"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding CheckStatus}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"/>
                </v:ColumnGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

    <!--  右：详情（编辑）；宽度由共享样式 Border.detail-card 给  -->
    <Border Grid.Column="1" Classes="detail-card"
              IsVisible="{Binding IsDetailVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2" IsVisible="{Binding !HasSelection}">
              <TextBlock Text="在左侧列表里选中一条书签" FontSize="13" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
              <TextBlock Text="标题" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Title, Mode=TwoWay}"/>

              <TextBlock Text="网址" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Url, Mode=TwoWay}"/>

              <TextBlock Text="分组" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Folder, Mode=TwoWay}" PlaceholderText="如：工作 / 学习"/>

              <TextBlock Text="备注" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox Text="{Binding Selected.Notes, Mode=TwoWay}" AcceptsReturn="True" Height="80"
                       TextWrapping="Wrap" FontSize="12"/>

              <CheckBox Content="加入「批量打开」" IsChecked="{Binding Selected.IsBatchOpen, Mode=TwoWay}"/>

              <!-- ⚠️ Avalonia 的 WrapPanel **没有** Spacing 属性（StackPanel 才有）→ 用按钮 Margin 做间距 -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Content="💾 保存" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                <Button Classes="ghost" Content="🌐 打开" Margin="0,0,6,0" Command="{Binding OpenCommand}"/>
                <Button Classes="ghost" Content="🔗 检测" Margin="0,0,6,0" Command="{Binding CheckCommand}"/>
                <Button Classes="ghost" Content="🗑 删除" Command="{Binding DeleteCommand}"/>
              </WrapPanel>

              <StackPanel Spacing="2"
                          IsVisible="{Binding Selected.CheckStatus, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="最近检测" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <SelectableTextBlock Text="{Binding Selected.CheckStatus}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.CheckedAt, StringFormat='检测时间：{0:yyyy-MM-dd HH:mm}'}"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
  </Grid>
</UserControl>
