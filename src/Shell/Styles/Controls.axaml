<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:NewToys.Shell.Behaviors">

  <!--  =====================================================================
        NewToys 复用样式表（v1.35）
        目的：把**每个列表页都抄一遍**的那几段 XAML（工具条 / 状态行 / 详情卡 /
        字段组 / 表头 / 行内按钮 …）收成 Class，页面里只写一行 Classes="…"。

        用法：Shell/App.axaml 里 <StyleInclude Source="avares://NewToys/Styles/Controls.axaml"/>
        样式是**应用级**的，模块（PcTools / VideoTools / Settings / WebTools）里的
        控件直接写 Classes 即可生效，不需要各模块再抄一份。

        ⚠️ 铁律：颜色一律 DynamicResource + *Brush 语义键，禁写死 #RRGGBB
        （否则换主题后写死的那个控件不跟着变）。
        ===================================================================== -->

  <!--  ① 工具条：列表页顶部那条（背景 + 底部分隔线 + 内边距），页面里套 WrapPanel 即可  -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!--  ② 页面右上角「状态行」：所有页面都有的那一行文字  -->
  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.info-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ③ 提示 / 说明文字（说明条、字段下方的灰色小字、底部数据文件提示）  -->
  <Style Selector="TextBlock.hint-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.empty-hint">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <!--  NT-055：工具条里的纯文字标签（「源」「脚本目录」这类前缀）与输入框水印同级 -->
  <Style Selector="TextBlock.toolbar-label">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!--  ④ 详情卡字段组：「小标签 + 值」这一对，页面里只需 Classes="field"  -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="2"/>
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.field-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>

  <!--  ⑤ 右侧详情卡（宽度 / 外边距 / 圆角统一；收起时整列不占位）
       v3.12 密度：内边距 14 → 12。
       ⚠️ **宽度 340 是硬约定（需求 §4.5），别动**；滚动条是覆盖式的、需要右侧留位的那两页
          （video-cut / video-batch）在**本页 XAML 里覆盖 Padding**，不要改这里 —— 会波及 12 个列表页。  -->
  <Style Selector="Border.detail-card">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Width" Value="340"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>

  <!--  ⑤-b 详情卡里的下拉框（需求 §6.4.1 规则 6）：
        ① 宽度拉满 → 与同卡里其它控件（TextBox 等）左对齐、同样宽；
        ② 限制弹出高度 → 长列表不会盖住 / 顶到别处控件（Popup 是浮层，本就不挤布局，这里只做视觉收敛）。
        ⚠️ 只作用于 detail-card 内的 ComboBox，不影响筛选条等其它下拉。  -->
  <Style Selector="Border.detail-card ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MaxDropDownHeight" Value="260"/>
  </Style>

  <!--  ⑥ 分隔线  -->
  <Style Selector="Border.divider-line">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!--  ⑦ 行内小按钮（列表行里的「▶ 运行」之类）与小号按钮  -->
  <Style Selector="Button.row-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!--  ⑧ 表头按钮（可排序）
        ⚠️ 关键修复（v1.35）：以前这里写了 VerticalAlignment="Center"，
           按钮高度被压成"文字那一条"，鼠标只有落在字的那十几像素上才点得到 ——
           表头空白处点了没反应。现在改成**撑满表头整行**（Stretch + 内容居中），
           整列整行都是点击区；文字仍然垂直居中。 -->
  <Style Selector="Button.col-header">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.col-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑨ 详情栏开关（v3.12：**从表头右缘挪到工具条末位**）
        旧做法 `Border.detail-hotspot` + `Button.header-toggle`（64px 透明热区、收起态只露 8px、鼠标靠近才弹）
        已**整体废除**：它占掉一整列表头宽度（列元数据里还得挂一个 `Detail` 占位列）、不把鼠标移过去就点不到、
        还和表头的"排序 / 列显隐"两种交互挤在一处。
        现做法：工具条右侧（`Grid ColumnDefinitions="*,Auto"` 的右列）放一个**常驻**小按钮，
        图标 ❯ = 展开右侧详情、❮ = 收起 —— 一眼知道当前是哪种。  -->
  <Style Selector="Button.detail-toggle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="MinWidth" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="Button.detail-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑩ 表头容器（高度固定 32，内部按钮靠 ⑧ 撑满 —— 点击区 = 整格；v3.12 由 36 收紧）  -->
  <Style Selector="Border.list-header">
    <Setter Property="Background" Value="{DynamicResource SubSiderHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="32"/>
  </Style>

  <!--  ⑪ 表格单元格：默认次要色；加 .primary / .accent 切换字的颜色。
       v3.12 密度：行高 32→28、左右内边距 12→8（**表头 ⑧ 的 Padding 必须同步改，否则表头与行错位**）。
       v3.16.1：⛔ 删掉 MinHeight=28 —— TextBlock 的文本永远绘制在**元素框顶部**，框被 MinHeight 撑高后
       文字就整体偏上（勾选列把行撑高后尤其明显）。行高基线改由 `ListBox.list-page ListBoxItem` 的
       MinHeight=28 兜底（见 App.axaml），元素高度=文本高度，VerticalAlignment=Center 才是真居中。  -->
  <Style Selector="TextBlock.list-cell">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.list-cell.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑪-2 标签色片（v3.20 视频工具 tags；⛔ 颜色不在这里——原来自数据色板 Module.VideoTools/Services/TagPalette.cs，
             这里只定形状：淡底 + 同色描边 + 同色文字由chip 数据绑定给）
       ⚠️ v3.32：视频工具的标签功能已移除（需求 §6.4.6），这几条样式当前**无引用**（死代码）；
       暂留 —— 媒体资产的标签页（NT-018）若复用同款 chip 可直接用，届时由数据侧提供 Brush。  -->
  <Style Selector="Border.tag-chip">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="Margin" Value="0,0,4,2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.tag-chip-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!--  .off = 详情卡「标签选择器」里**还没打上**的一枚（整枚淡显；⛔ 不改绑来的颜色数据）  -->
  <Style Selector="Border.tag-chip.off">
    <Setter Property="Opacity" Value="0.45"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.tag-chip:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!--  ⑫ 等宽输入（命令 / 脚本文件 / 时间码）  -->
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>

  <!--  ⑭ 详情卡分区标题按钮 + 集合 chips（NT-054 声明式详情卡，需求 §4.5.1 / 规范 §3.6）
        ⚠️ 这两个类归 **Shell** 的 `DetailCardHost` 用：卡片外壳与字段形态由 Shell 统一渲染，
           各页不再各写一份（模块侧也能直接用这两个类，它们是全局样式）。  -->
  <Style Selector="Button.section-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="Button.section-toggle:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <!--  折叠箭头：Path 走 Stroke、不继承 Foreground（App.axaml 的既有约定）→ 由样式给颜色与粗细  -->
  <Style Selector="Button.section-toggle Path">
    <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="Button.section-toggle:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  chips（Kind=Chips 的集合编辑器）：选中 = 强调色描边 + 强调色文字  -->
  <Style Selector="Button.chip-toggle">
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="Button.chip-toggle:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.chip-toggle.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!--  chips 的**色块模式**（NT-054 v3.33 / 描述符 ChipBrushPath 非空）：chip 内是「色块 + 可选文字」，
        未选中时也要显边框（色块本身要看得见轮廓），选中态沿用 .selected 的强调色边框。  -->
  <Style Selector="Button.chip-toggle.swatch">
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style Selector="Button.chip-toggle.swatch Border">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
  </Style>

  <!--  ===== 详情卡「图标动作组」（NT-058 / FieldKind.IconBar） =====
        方形小按钮（32×32，图标 16×16）：一组高频动作收成一行，替掉原来一堆撑满宽度的文字按钮。
        ① 尺寸 / 圆角 / 内边距**只在这里给一次**；② 图标颜色**只由下面的后代选择器给**
           （Path 走 Stroke、不继承 Foreground；⛔ 不在 XAML 里写本地 Stroke —— 本地值会压过 :pointerover / .active）；
        ③ `.active` = 已生效状态（如已收藏）：强调色；`.danger-btn` 复用既有红按钮配色（悬停红底白图标）。  -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.icon-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>
  <Style Selector="Button.icon-btn:disabled">
    <Setter Property="Opacity" Value="0.35"/>
  </Style>
  <Style Selector="Button.icon-btn Path">
    <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="Button.icon-btn:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="Button.icon-btn.active Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.icon-btn.icon-danger Path">
    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <!--  组内分隔：1px 竖线（与卡内 Divider 同色，高度跟着按钮行 20px）  -->
  <Style Selector="Border.icon-sep">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!--  List 行容器（NT-054 v3.33 / 描述符 ItemCommandPath）：常态**长得跟只读行一样**。
        ⛔ 没给命令就不加 .link —— 点击无操作、也没有悬停高亮，避免"看着能点其实不能"。
        ⚠️ 悬停只改背景，⛔ 不改文字色：模板里的 TextBlock 有本地 Foreground，样式压不过本地值。  -->
  <Style Selector="Button.list-row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style Selector="Button.list-row.link">
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.list-row.link:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <!--  ⑬ 筛选条：多项筛选那一行的容器与其中的控件  -->
  <Style Selector="Border.filter-bar">
    <Setter Property="Background" Value="{DynamicResource ContentHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="12,4"/>
  </Style>
  <Style Selector="ComboBox.filter-combo">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="110"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.filter-value">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Width" Value="140"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.filter-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="Button.filter-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑭ 进度条（转码 / 剪切任务跑起来时显示百分比）  -->
  <Style Selector="ProgressBar.task-progress">
    <Setter Property="Height" Value="6"/>
    <Setter Property="MinWidth" Value="60"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <!--  ⑮ 状态徽章（任务的「等待 / 运行中 / 完成 / 失败」）  -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.badge-text">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!--  ⑯（NT-055 收尾后**已删除**）原「列表页导入 / 导出组」`StackPanel.io-bar` + `Button.io-btn`：
        工具条改由 Shell 的 `ToolbarHost` 统一渲染后，导入 / 导出就是**工具条里的普通按钮**（`ghost`），
        尺寸与配色都由 `ToolbarHost` 一处给（需求 §4.10.4）⇒ 这组样式已无引用，删除。⛔ 别再加回来。  -->
  <!--  danger 语义（红）的破坏性按钮（如「🧹 清空本页」，v3.19 / NT-006）：
        ⛔ 只给"会丢数据"的动作（清空 / 永久删除）用，别当普通按钮的默认样式。  -->
  <Style Selector="Button.danger-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.danger-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
  </Style>

  <!--  源选择按钮（v3.19 / NT-008）：源下拉框改按钮；选中态（.selected）用强调色实心。  -->
  <Style Selector="Button.src-btn">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.src-btn:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.src-btn.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
  </Style>

  <!--  ⑰ 全局 TextBox 右键编辑菜单（v3.19 / 需求 §4.10.4「文本框右键 paste/copy/cut 符合配色」）：
        Avalonia 的 TextBox 默认**没有**右键菜单（键盘 Ctrl+X/C/V 仍可用），这里用挂载属性统一挂上
        「剪切 / 复制 / 粘贴 / 全选」，外观走 Fluent 默认 ContextMenu（随明暗主题）。
        实现见 Shell/Behaviors/TextBoxContextMenu.cs。  -->
  <Style Selector="TextBox">
    <Setter Property="(b:TextBoxMenu.Attach)" Value="True"/>
  </Style>

  <!--  ⑱ 菜单项「折叠标识」（v3.42.2 用户定调）：凡**带二级菜单**的菜单项，右侧统一显示 ▸。
        🔴 标识**由 Fluent 的 MenuItem 模板自带**（`Path#PART_ChevronPath`，10×20 几何、8×16 尺寸），
           显隐由模板的 `:empty` 伪类控制 —— 即 `ItemCount == 0`（没有子项）时自动隐藏，
           ⛔ 不要往 `MenuItem.Header` 里拼字符 / Path 自绘箭头（那是重复实现，且会跟图标列错位）。
        这里只做一件事：把它的 Fill 从 Fluent 默认的次要色（`MenuFlyoutSubItemChevron`，暗色下偏淡、
           看不出"还有下一级"）统一到本应用的正文语义键，保证明暗主题下都清晰可辨。
        ⚠️ 全局 Style 优先级高于 ControlTheme ⇒ 此 Fill 对 hover / pressed / disabled / 展开态**一律生效**
           （有子菜单的项本来也不该在禁用态出现，故放弃这几个状态色差是无损的）。  -->
  <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
    <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>

</Styles>
