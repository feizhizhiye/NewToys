<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.Shell.Views.GeneralView">
  <!--
    v3.66 / NT-062 第五轮：「通用」节拆成三个节（用户要求"拆开、删除通用"）——
    本 View = **启动与退出**（节锚点 `settings-general`，Key ⛔ 不变）。
      ① 内层 `ScrollViewer` **已删除**：设置页整页就是滚动流，内层再套一个会**吃掉滚轮**
         （鼠标停在本节上时滚的是本节、不是整页 ⇒ 用户感受成"滚不动 / 像循环"）；
      ② 原来的「更新」（→ `UpdateView`）/「主题外观」（→ `ThemeView`）两张卡已**拆到各自的节**，
         「实现状态（v1.35）」那张纯说明卡**删除**（属过时的进度叙述，不是设置项）。
    三个 View 共用同一个 `GeneralViewModel`（数据同源，只是显示位置分开）。
  -->
  <StackPanel
      HorizontalAlignment="Left"
      MaxWidth="720"
      Spacing="10">

    <CheckBox Content="开机时启动 NewToys" IsChecked="{Binding StartWithSystem, Mode=TwoWay}" />
    <TextBlock Classes="hint-text" Margin="26,0,0,0" Text="{Binding StartupStateText}" />
    <CheckBox Content="启动时最小化到托盘" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
    <CheckBox Content="关闭按钮最小化到托盘" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    <CheckBox Content="启动时检查更新" IsChecked="{Binding CheckUpdateOnStartup, Mode=TwoWay}" />
    <TextBlock Classes="hint-text" Text="{Binding TrayHint}" />

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="ghost" Content="🗂 系统启动项管理" Command="{Binding OpenStartupSettingsCommand}"
              ToolTip.Tip="打开任务管理器的「启动」页，可自行核对 / 禁用" />
      <Button Classes="ghost" Content="🔄 重读启动状态" Command="{Binding RefreshStartupCommand}"
              ToolTip.Tip="重新读一次注册表，看开机启动项到底在不在" />
    </StackPanel>
  </StackPanel>
</UserControl>
