<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Viewers"
             x:Class="NewToys.Reading.Views.ReaderView">
  <!--
    网络阅读 → 阅读（`reading-read`）：沉浸式读一本书。
    正文占满内容区；目录改成「点 📑 目录 才弹出」的覆盖层（⛔ 不常驻占一栏）。
    排版参数（字号 / 行距 / 字体 / 页宽 / 配色 / 首行缩进 / 段间距）与「设置 → 网络阅读设置」同一份；
    「🎨 样式」弹出样式卡 —— 内置 4 套预设，可导入 / 导出一份 `.json` 样式文件。
    🔴 正文控件 = NewToys.UI 的 TextViewer，⛔ 本页不自绘渲染；配色由 code-behind 写入（不写死色值）。
  -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource ContentHeaderBrush}" Padding="12,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost" Content="📑 目录" Command="{Binding ToggleTocCommand}" ToolTip.Tip="弹出章节目录"/>
          <TextBlock Classes="section-title" Text="{Binding BookName}" VerticalAlignment="Center"/>
          <TextBlock Classes="hint-text" Text="{Binding Author}" VerticalAlignment="Center"/>
          <TextBlock Classes="hint-text" Text="{Binding SourceName}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="hint-text" Text="{Binding TypographyText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button Classes="ghost" Content="A-" Command="{Binding FontSmallerCommand}" ToolTip.Tip="字号变小"/>
          <Button Classes="ghost" Content="A+" Command="{Binding FontBiggerCommand}" ToolTip.Tip="字号变大"/>
          <Button Classes="ghost" Content="≡" Command="{Binding LineWiderCommand}" ToolTip.Tip="行距变宽"/>
          <Button Classes="ghost" Content="⋮" Command="{Binding LineNarrowerCommand}" ToolTip.Tip="行距变窄"/>
          <Button Classes="ghost" Content="🎨" Command="{Binding CycleThemeCommand}" ToolTip.Tip="白底 → 米黄 → 暗色"/>
          <Button Classes="ghost" Content="🎨 样式" Command="{Binding ToggleStyleCommand}"
                  ToolTip.Tip="内置样式 / 导入导出一份样式文件"/>
          <Button Classes="ghost" Content="＋ 书架" Command="{Binding AddToShelfCommand}" ToolTip.Tip="把这本书加进书架"/>
          <Button Classes="ghost" Content="🔀 换源" Command="{Binding SwitchSourceAsyncCommand}" ToolTip.Tip="多源比对这本书，选最优源续读"/>
          <Button Classes="ghost" Content="⬇ 下载" Command="{Binding DownloadBookCommand}"
                  ToolTip.Tip="整本下载：全部章节抓下来合成一份 TXT（已缓存的章节不再请求）"/>
          <Button Classes="ghost" Content="🎧 听书" Command="{Binding StartListenCommand}"
                  IsVisible="{Binding !IsListening}"
                  ToolTip.Tip="用系统语音朗读本章；正文下方会出现暂停 / 语速 / 停止控制条"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <Border Background="{DynamicResource ContentHeaderBrush}" Padding="12,4" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="4">
          <TextBlock Classes="hint-text" Text="{Binding BusyPhase}"/>
          <ProgressBar IsIndeterminate="True" Height="3"/>
        </StackPanel>
      </Border>

      <Border Padding="12,4" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   FontSize="12"/>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2">

      <!--  ==================== 正文  ====================  -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="16,10,16,6">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Classes="section-title" Text="{Binding ChapterTitle}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Content="▲ 上一章" Command="{Binding PrevChapterCommand}"/>
              <Button Classes="ghost" Content="▼ 下一章" Command="{Binding NextChapterCommand}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!--  听书控制条：开始朗读后才出现；暂停 / 继续只在句子边界生效  -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsListening}"
                Background="{DynamicResource ContentHeaderBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="ghost" Content="⏸ 暂停" Command="{Binding ToggleListenPauseCommand}"
                      IsVisible="{Binding !IsListenPaused}" ToolTip.Tip="读完当前这句就停住"/>
              <Button Classes="ghost" Content="▶ 继续" Command="{Binding ToggleListenPauseCommand}"
                      IsVisible="{Binding IsListenPaused}"/>
              <TextBlock Classes="hint-text" Text="{Binding ListenStatus}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="hint-text" Text="语速" VerticalAlignment="Center"/>
              <Button Classes="ghost" Content="−" Command="{Binding TtsSlowerCommand}" ToolTip.Tip="读慢一点（从当前句重起）"/>
              <TextBlock Classes="list-cell primary" Width="28" TextAlignment="Center"
                         Text="{Binding TtsRate}" VerticalAlignment="Center"/>
              <Button Classes="ghost" Content="＋" Command="{Binding TtsFasterCommand}" ToolTip.Tip="读快一点（从当前句重起）"/>
              <Button Classes="ghost" Content="⏹ 停止" Command="{Binding StopListenCommand}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border x:Name="ReaderSurface" Padding="0">
          <ui:TextViewer x:Name="Body" HorizontalAlignment="Center"/>
        </Border>
      </DockPanel>

      <!--  ==================== 目录浮层（点 📑 目录 才出现）  ====================  -->
      <Grid IsVisible="{Binding ShowToc}">
        <Border Background="{DynamicResource LoadingOverlayBrush}" Tapped="OnTocBackdropTapped"/>

        <Border Width="320"
                HorizontalAlignment="Left"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="10,10,10,6">
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Classes="section-title" Text="目录" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Content="▲" Command="{Binding PrevChapterCommand}" ToolTip.Tip="上一章"/>
                  <Button Classes="ghost" Content="▼" Command="{Binding NextChapterCommand}" ToolTip.Tip="下一章"/>
                  <Button Classes="ghost" Content="✕" Command="{Binding ToggleTocCommand}" ToolTip.Tip="收起目录"/>
                </StackPanel>
              </DockPanel>
              <TextBox Text="{Binding TocFilter, Mode=TwoWay}" PlaceholderText="过滤章节名"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding VisibleChapters}"
                     SelectedItem="{Binding SelectedChapter, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6,0,6,6">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!--  ==================== 样式卡浮层（点 🎨 样式 才出现；与确认对话卡片同一套观感）  ====================  -->
      <Grid IsVisible="{Binding ShowStylePanel}">
        <Border Background="{DynamicResource LoadingOverlayBrush}" Tapped="OnStyleBackdropTapped"/>

        <Border Width="460"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 32 0 #66000000"
                Padding="20">
          <DockPanel LastChildFill="True">

            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
              <TextBlock DockPanel.Dock="Left" Text="阅读样式" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Classes="ghost" Content="✕" Command="{Binding CloseStyleCommand}"
                      ToolTip.Tip="收起样式卡"/>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0"
                        HorizontalAlignment="Right">
              <Button Classes="ghost" Content="📥 导入" Command="{Binding ImportStyleCommand}"
                      ToolTip.Tip="选一个样式 JSON 文件并套用（缺的项保持原值）"/>
              <Button Classes="ghost" Content="📤 导出" Command="{Binding ExportStyleCommand}"
                      ToolTip.Tip="把当前排版导成一个样式 JSON 文件"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <TextBlock Classes="hint-text" Text="{Binding TypographyText}"/>

                <TextBlock Classes="section-title" Text="内置样式"/>
                <ItemsControl ItemsSource="{Binding StylePresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="ghost" Margin="0,0,6,6" Content="{Binding Name}"
                              Command="{Binding $parent[UserControl].DataContext.ApplyPresetCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="整套套用（会覆盖字号 / 行距 / 配色等）"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="section-title" Text="段落"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="hint-text" Text="首行缩进" VerticalAlignment="Center" Width="60"/>
                  <Button Classes="ghost" Content="−" Command="{Binding IndentSmallerCommand}"/>
                  <TextBlock Classes="list-cell primary" Width="24" TextAlignment="Center"
                             Text="{Binding Indent}" VerticalAlignment="Center"/>
                  <Button Classes="ghost" Content="＋" Command="{Binding IndentBiggerCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="hint-text" Text="段间距" VerticalAlignment="Center" Width="60"/>
                  <Button Classes="ghost" Content="−" Command="{Binding ParagraphNarrowerCommand}"/>
                  <TextBlock Classes="list-cell primary" Width="24" TextAlignment="Center"
                             Text="{Binding ParagraphSpacing}" VerticalAlignment="Center"/>
                  <Button Classes="ghost" Content="＋" Command="{Binding ParagraphWiderCommand}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
      <!--  ==================== 换源浮层（点 🔀 换源 才出现；多源比对 + 选源续读）  ====================  -->
      <Grid IsVisible="{Binding ShowSwitchPanel}">
        <Border Background="{DynamicResource LoadingOverlayBrush}" Tapped="OnSwitchBackdropTapped"/>

        <Border Width="520"
                MaxHeight="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 32 0 #66000000"
                Padding="20">
          <DockPanel LastChildFill="True">

            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
              <TextBlock DockPanel.Dock="Left" Text="换源" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Classes="hint-text" Text="{Binding BookName}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Button DockPanel.Dock="Right" Classes="ghost" Content="✕" Command="{Binding CloseSwitchCommand}"
                      ToolTip.Tip="收起换源" Margin="8,0,0,0"/>
            </DockPanel>

            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         IsVisible="{Binding IsSwitching}" Margin="0,0,0,10"/>

            <ListBox ItemsSource="{Binding SwitchCandidates}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Classes="list-cell"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[UserControl].DataContext.ChooseSwitchCandidateCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Classes="hint-text" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding RankText}"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!--  ==================== 整本下载浮层（进度 / 取消）  ====================  -->
    <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding DownloadIsOpen}">
      <Border Background="{DynamicResource LoadingOverlayBrush}" Tapped="OnDownloadBackdropTapped"/>

      <Border Width="540"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="20"
              BoxShadow="0 8 32 0 #40000000">
        <StackPanel Spacing="10">
          <TextBlock Text="整本下载"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Classes="hint-text" Text="{Binding DownloadPhase}" TextWrapping="Wrap"/>
          <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost" Content="✖ 取消" Command="{Binding CancelDownloadCommand}"
                    IsEnabled="{Binding IsDownloading}"/>
            <Button Classes="primary" Content="关闭" Command="{Binding CloseDownloadCommand}"
                    IsEnabled="{Binding !IsDownloading}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
