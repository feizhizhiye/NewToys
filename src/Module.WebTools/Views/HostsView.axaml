<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.WebTools.Views.HostsView">
  <!--
    Hosts 管理页（Key web-hosts）= 双列表工作台。
    ① 信息条（路径 / 文件信息 / 受管块 / 权限 / 差异汇总）
    ② 左「目标」（当前系统 hosts 或备份快照，可切文本视图）| 右「来源」（拉取的方案）
    ③ 底栏：应用与写入按钮
    🔴 左栏改动是内存草稿，「✅ 写入系统 hosts」才落盘（二次确认 + 自动备份）。
  -->
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">

    <!--  ① 信息条  -->
    <Border Grid.Row="0" Classes="card" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Classes="hint-text" Text="{Binding SystemHostsPath}" FontFamily="Consolas"/>
        <TextBlock Classes="hint-text" Text="{Binding FileInfoText}"/>
        <TextBlock Classes="hint-text" Text="{Binding ManagedInfoText}"/>
        <TextBlock Classes="hint-text" Text="{Binding PermissionText}"/>
        <TextBlock Classes="hint-text" Text="{Binding DiffSummary}"/>
      </StackPanel>
    </Border>

    <!--  ② 双列表  -->
    <Grid Grid.Row="1" ColumnDefinitions="*,10,*">

      <!--  左：目标（系统 hosts / 备份）  -->
      <Border Grid.Column="0" Classes="card" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="section-title" Text="目标" VerticalAlignment="Center"/>
            <ComboBox x:Name="TargetBox" MinWidth="0" Width="230" VerticalAlignment="Center"
                      ItemsSource="{Binding TargetSources}"
                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                      ToolTip.Tip="左栏看什么：当前系统 hosts，或某一份备份（备份只读，可直接还原）">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="差异" IsChecked="{Binding LeftDiffOnly, Mode=TwoWay}" VerticalAlignment="Center"/>
            <CheckBox Content="条目" IsChecked="{Binding ShowEntriesOnly, Mode=TwoWay}" VerticalAlignment="Center"/>
            <TextBlock Classes="hint-text" Text="{Binding LeftCountText}" VerticalAlignment="Center"/>
          </StackPanel>

          <Border Grid.Row="1" Classes="list-header">
            <Grid ColumnDefinitions="26,140,*,132">
              
              <Button Grid.Column="1" Classes="col-header" Content="IP" IsHitTestVisible="False"/>
              <Button Grid.Column="2" Classes="col-header" Content="主机名" IsHitTestVisible="False"/>
              <Button Grid.Column="3" Classes="col-header" Content="状态" IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <!--  条目视图（Ctrl 增选 / Shift 连选 / Ctrl+A 全选，见 ui.md §6.10）  -->
          <ListBox Grid.Row="2" x:Name="SystemList" Classes="list-page"
                   IsVisible="{Binding IsListMode}"
                   ItemsSource="{Binding SystemRows}"
                   SelectedItem="{Binding SelectedSystemRow, Mode=TwoWay}"
                   SelectionMode="Multiple"
                   SelectionChanged="OnSystemSelectionChanged"
                   KeyDown="OnListKeyDown"
                   ContextRequested="OnRowContextRequested">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="🧪 检测选中" Command="{Binding CheckSelectedCommand}"
                          ToolTip.Tip="只测选中行（未多选 = 检测右栏整份方案）"/>
                <MenuItem Header="✅ 启用选中" Command="{Binding EnableSelectedCommand}"/>
                <MenuItem Header="⏸ 禁用选中" Command="{Binding DisableSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="📦 备份当前" Command="{Binding BackupNowCommand}"/>
                <MenuItem Header="🧹 清除受管块" Command="{Binding ClearManagedCommand}"/>
                <Separator/>
                <MenuItem Header="✅ 写入系统 hosts" Command="{Binding WriteCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="26,140,*,132" Height="28">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Mark}"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Ip}" FontFamily="Consolas"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Host}" FontFamily="Consolas"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding StatusColumnText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!--  文本视图（可改整份文件；备份快照只读）  -->
          <TextBox Grid.Row="2" Classes="code" IsVisible="{Binding IsTextView}"
                   IsReadOnly="{Binding TargetIsBackup}"
                   AcceptsReturn="True" TextWrapping="NoWrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   Text="{Binding DraftText, Mode=TwoWay}"/>

          <TextBlock Grid.Row="2" Classes="hint-text" Text="{Binding EmptyLeftHint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding HasNoSystemRows}"/>
        </Grid>
      </Border>

      <!--  右：来源（拉取的方案）  -->
      <Border Grid.Column="2" Classes="card" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="section-title" Text="来源" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProfileBox" MinWidth="0" Width="170" VerticalAlignment="Center"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                      ToolTip.Tip="右栏看哪份方案（拉取结果也是方案）">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox MinWidth="0" Width="140" VerticalAlignment="Center"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      ToolTip.Tip="{Binding SourceHint}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="ghost" Content="⬇ 拉取" Command="{Binding FetchSourceCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="按源的地址逐个试，拉到一份映射集写进右栏方案（⛔ 不自动写系统 hosts）"/>
            <CheckBox Content="差异" IsChecked="{Binding RightDiffOnly, Mode=TwoWay}" VerticalAlignment="Center"/>
            <TextBlock Classes="hint-text" Text="{Binding RightCountText}" VerticalAlignment="Center"/>
          </StackPanel>

          <Border Grid.Row="1" Classes="list-header">
            <Grid ColumnDefinitions="26,140,*,132">
              
              <Button Grid.Column="1" Classes="col-header" Content="IP" IsHitTestVisible="False"/>
              <Button Grid.Column="2" Classes="col-header" Content="主机名" IsHitTestVisible="False"/>
              <Button Grid.Column="3" Classes="col-header" Content="状态" IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <ListBox Grid.Row="2" x:Name="ProfileList" Classes="list-page"
                   ItemsSource="{Binding ProfileRows}"
                   SelectedItem="{Binding SelectedProfileRow, Mode=TwoWay}"
                   SelectionMode="Multiple"
                   SelectionChanged="OnProfileSelectionChanged"
                   KeyDown="OnListKeyDown"
                   ContextRequested="OnRowContextRequested">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="🧪 检测选中" Command="{Binding CheckSelectedCommand}"
                          ToolTip.Tip="只测选中行（未多选 = 检测右栏整份方案）"/>
                <MenuItem Header="✅ 启用选中" Command="{Binding EnableSelectedCommand}"/>
                <MenuItem Header="⏸ 禁用选中" Command="{Binding DisableSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="⬅ 应用到左侧" Command="{Binding ApplyToTargetCommand}"/>
                <MenuItem Header="🔍 检测可用性" Command="{Binding CheckCommand}"/>
                <Separator/>
                <MenuItem Header="💾 保存方案" Command="{Binding SaveProfileCommand}"/>
                <MenuItem Header="🗑 删除方案" Command="{Binding DeleteProfileCommand}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="26,140,*,132" Height="28">
                  <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding Mark}"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding Ip}" FontFamily="Consolas"/>
                  <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Host}" FontFamily="Consolas"/>
                  <TextBlock Grid.Column="3" Classes="list-cell" Text="{Binding StatusColumnText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Classes="hint-text" Text="{Binding EmptyRightHint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding HasNoProfileRows}"/>
        </Grid>
      </Border>
    </Grid>

    <!--  ③ 底栏：应用 + 写入  -->
    <Border Grid.Row="2" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <Button Grid.Column="1" Classes="ghost" Content="⬅ 应用到左侧"
                Command="{Binding ApplyToTargetCommand}"
                IsEnabled="{Binding CanApplyToTarget}"
                ToolTip.Tip="把右栏方案的启用条目写进左栏草稿的受管块（⛔ 先不落盘）"/>
        <Button Grid.Column="2" Classes="primary" Content="{Binding WriteButtonText}"
                Command="{Binding WriteCommand}"
                IsEnabled="{Binding CanEditTarget}"
                ToolTip.Tip="把左栏草稿写入系统 hosts（需管理员；写前自动备份 + 二次确认）"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
