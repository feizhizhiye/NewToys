<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="NewToys.Shell.App">

    <!--  ==================== v3.2 矢量图标（Geometry） ====================
          一级菜单图标 + 首页图标。24×24 网格、描边型路径；使用时用 <Path Stroke=... Stretch="Uniform"/>。
          ⚠️ 需求 §3.2：模块 RegisterModule 的 icon 传的就是这里的键名（不再是 emoji）。  -->
    <Application.Resources>
        <!--  首页：房子  -->
        <StreamGeometry x:Key="IconHome">M3,10 L12,3 L21,10 L21,21 L14,21 L14,15 L10,15 L10,21 L3,21 Z</StreamGeometry>
        <!--  电脑工具：显示器  -->
        <StreamGeometry x:Key="IconPc">M3,5 L21,5 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21</StreamGeometry>
        <!--  网络工具：地球  -->
        <StreamGeometry x:Key="IconWeb">M2,12 A10,10 0 1,1 22,12 A10,10 0 1,1 2,12 Z M2,12 L22,12 M12,2 A6,10 0 0,0 12,22 A6,10 0 0,0 12,2 Z</StreamGeometry>
        <!--  视频工具：摄像机  -->
        <StreamGeometry x:Key="IconVideo">M3,6 L15,6 L15,18 L3,18 Z M15,10 L21,7 L21,17 L15,14 Z</StreamGeometry>
        <!--  系统设置：滑块  -->
        <StreamGeometry x:Key="IconSettings">M21,4 L14,4 M10,4 L3,4 M21,12 L12,12 M8,12 L3,12 M21,20 L16,20 M12,20 L3,20 M14,2 L14,6 M8,10 L8,14 M16,18 L16,22</StreamGeometry>
        <!--  媒体资产：层叠（资产库）—— NT-035：补齐一级分组矢量键，去掉 emoji 占位  -->
        <StreamGeometry x:Key="IconMediaAssets">M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16</StreamGeometry>

        <!--  ==================== NT-045：框架层图标（窗口 / 标题栏 / 标签 / 左树 / 首页） ====================
              统一口径（规范 §2）：
              ① 几何**一律 24×24 网格**（与 Lucide / Feather 同网格，摘公开图标集路径不用换算）；
              ② 使用方式固定 = <Path Data="{StaticResource IconXxx}" Width="16" Height="16" Stretch="Uniform"/>；
              ③ 颜色**一律由样式给 Stroke**（Path 不继承 Foreground；写本地值会压过 :pointerover / .active），
                 例外只有「无状态装饰图标」（首页 ★ / ⚡ / ⚙，用 Path.icon-accent / Path.icon-primary 类）；
              ④ 键名必须在**本文件**定义 —— 模块 RegisterModule 的一级 icon、左树 `ResolveIcon()`、
                 设置页「功能清单」都按键名来这里取，⛔ 键名不存在就地没图标（不再有 emoji 回退）。
              ⚠️ 数据驱动的图标（首页「常用功能」按钮 / 「一键按钮」的可配置 Icon 字段）不在本口径内 —— 仍是字符串（技术债）。  -->

        <!--  折叠 / 展开左侧菜单：面板 + 左栏（Lucide `panel-left`，ISC）  -->
        <StreamGeometry x:Key="IconMenuPanel">M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M9,3 V21</StreamGeometry>
        <!--  重建当前页：循环箭头（NT-045 由 ShellView 内联数据收进资源库）  -->
        <StreamGeometry x:Key="IconRefresh">M23,4 L23,10 L17,10 M1,20 L1,14 L7,14 M3.51,9 A9,9 0 0 1 18.36,5.64 L23,10 M1,14 L5.64,18.36 A9,9 0 0 0 20.49,15</StreamGeometry>
        <!--  重载模块：拼图块（Lucide `puzzle`，ISC；浏览器扩展那个图案）。规范 §3.7：只做「新增」、失败 DLL 隔离  -->
        <StreamGeometry x:Key="IconPuzzle">M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z</StreamGeometry>

        <!--  窗口控制（NT-045：由图标字体字形改为矢量 —— 与 WinUI `Symbol` 同形，但不再依赖 `Segoe MDL2 Assets`）  -->
        <StreamGeometry x:Key="IconWinMinimize">M4,12 H20</StreamGeometry>
        <StreamGeometry x:Key="IconWinMaximize">M4.5,4.5 H19.5 V19.5 H4.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconWinRestore">M9,4.5 H19.5 V15 M4.5,9 H15 V19.5 H4.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconWinClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
        <!--  全屏 / 退出全屏：四角括弧（朝外 = 进入全屏；朝内 = 退出全屏）  -->
        <StreamGeometry x:Key="IconFullScreen">M9,3 H3 V9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15</StreamGeometry>
        <StreamGeometry x:Key="IconExitFullScreen">M3,9 H9 V3 M21,9 H15 V3 M15,21 V15 H21 M3,15 V9 H9</StreamGeometry>

        <!--  标签：新建（＋）/ 关闭（✕）  -->
        <StreamGeometry x:Key="IconPlus">M12,5 V19 M5,12 H19</StreamGeometry>
        <StreamGeometry x:Key="IconTabClose">M7,7 L17,17 M17,7 L7,17</StreamGeometry>

        <!--  左树展开指示：展开（▾）/ 折叠（▸）  -->
        <StreamGeometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M9,18 L15,12 L9,6</StreamGeometry>

        <!--  首页装饰图标：收藏（★）/ 一键操作（⚡）/ 设置入口（⚙）—— 一律 Lucide（ISC）  -->
        <StreamGeometry x:Key="IconStar">M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z</StreamGeometry>
        <StreamGeometry x:Key="IconZap">M15.914 4a1.5 1.5 0 0 0-2.474-1.561l-9 9A1.5 1.5 0 0 0 5.5 14h4.002a.5.5 0 0 1 .471.666L8.086 20a1.5 1.5 0 0 0 2.475 1.56l9-9A1.5 1.5 0 0 0 18.5 10h-3.997a.5.5 0 0 1-.472-.667z</StreamGeometry>
        <StreamGeometry x:Key="IconGear">M9.671 4.136a2.34 2.34 0 0 1 4.659 0a2.34 2.34 0 0 0 3.319 1.915a2.34 2.34 0 0 1 2.33 4.033a2.34 2.34 0 0 0 0 3.831a2.34 2.34 0 0 1-2.33 4.033a2.34 2.34 0 0 0-3.319 1.915a2.34 2.34 0 0 1-4.659 0a2.34 2.34 0 0 0-3.32-1.915a2.34 2.34 0 0 1-2.33-4.033a2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z</StreamGeometry>

        <!--
            v3.22：「裸按钮」主题 —— 只有内容、没有 Fluent 的任何状态绘制。
            用途：像标签页关闭 ✕ 这种"要自己完全控制底色 / 图标颜色"的小按钮。
            🔴 为什么需要：Fluent 的 Button 模板在 :pointerover 会自己画背景并把前景改成主题色，
            **Style setter 压不过模板状态**（实测：写了红 ✕ + Transparent 仍是白图标 + 有底）。
            → 给按钮套 Theme="{StaticResource BareButtonTheme}"，状态绘制全没了，样式才真正说了算。
        -->
        <ControlTheme x:Key="BareButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!--  ⚠️ 必须包一层 Border 接住 Background —— 否则样式里写的 Background 画不出来
                          （ContentPresenter 自身不渲染 Background；这正是"关闭按钮 hover 背景不变色"的根因）。  -->
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!--  ⚠️ NT-045：这里的写法**按推断**改造，目的是让裸主题里也能渲染 `Path`（未实机验证）：
                             旧写法把 Button 的 `HorizontalContentAlignment` 绑到 ContentPresenter **自身**的
                             `HorizontalAlignment` → Presenter 不再撑满、改用**无限约束**测量内容，
                             推断 `Path`（`Stretch=Uniform`）在 ∞ 约束下会算出 NaN 尺寸 → 图标整个不渲染
                             （能解释 v3.22「TextBlock / Rectangle 正常、唯独 Path 消失」，但无实机复现证据）。
                             ✅ 现改成与 Fluent 模板一致的写法：Presenter 自身撑满，对齐交给 ContentAlignment 属性。
                             🔴 兜底：若图标仍不显示 → 窗口按钮 / 标签 ✕ 的 `Path` 改 `Stretch="None"`，或退回图标字体方案。  -->
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!--  ==================== 窗口装饰：空主题（v3.28） ====================
              背景：为了拿到**系统级贴靠**（Win+方向键 / 拖到边缘贴半屏 / 拖到顶边最大化），ShellView 走的是
                    「`ExtendClientAreaToDecorationsHint="True"` + `WindowDecorationProperties.ElementRole`」官方路线
                    （系统负责拖动 / 缩放 / 命中测试，我们自绘标题栏与抓取区）。
              问题：`WindowDecorations="Full"` 会让 Avalonia **自己画一套窗框**（`Window.cs::ComputeDecorationParts`
                    里 TitleBar 部件只在 `== Full` 时加入）→ 实测标题文字重叠、右侧多一个点坏状态的按钮。
              修法：装饰模式改 `BorderOnly`（那时 Avalonia 的部件集合为 None → 什么都不画）**并**给他一个不绘制任何
                    内容的 ControlTheme 兜底（不设 Template = 无模板 = 不画），双保险。
              ⚠️ 该段为**历史注释**（v3.28 的 `BorderOnly` 路线，已被下方 NT-040 官方 CSD 主题取代，仅作留档）。
                 贴靠资格曾由 code-behind 的 `ApplySnapEligibleStyles()` 手工补 `WS_CAPTION/WS_THICKFRAME`；
                 NT-040 改回官方 `Full` 装饰后 Avalonia 自带这些样式位，该补丁已于 NT-041 删除。  -->
        <!--
            ==================== 窗口装饰：官方 CSD 主题（NT-040，需求 §4.1.1 ①） ====================
            背景：为了拿系统级贴靠，窗口走 `ExtendClientAreaToDecorationsHint="True"` + `WindowDecorations="Full"`。
                  但 `Full` 会让 Avalonia **真的去画一套窗框**（默认主题含标题文字 + 窗口图标 + caption 按钮）
                  → 与自绘标题栏重叠（2026-10-14 首版实测：左上 "NewToys default" 叠在标签栏上、右侧多一个全屏按钮）。

            解法 = 两件事，缺一不可：
            ① **键必须是隐式键 `{x:Type chrome:WindowDrawnDecorations}`** —— Fluent 默认装饰主题就注册在这个键下，
               用同键定义在 `Application.Resources` 里才能**覆盖**它（资源查找先 Application.Resources 后各 Style）。
               🔴 首版用自定义字符串键 `NewToysWindowDecorations` + `WindowDecorationsTheme` 指它 —— 没生效
                  （框架按类型查主题，字符串键的显式指定在 12.1.3 不被吃），出现上述重叠。
            ② **不给 `Template`** → 无模板可应用 → 框架不生成任何装饰视觉，可见 UI 全部来自自绘标题栏。

            🔴 **12.1.3 版本事实（2026-10-14 编译实测，⛔ 别再试）**：
               `Avalonia.Controls.Chrome` 的**公共类型只有 6 个**：
               `WindowDrawnDecorations` / `WindowDrawnDecorationsContent` / `IWindowDrawnDecorationsTemplate` /
               `DrawnWindowDecorationParts` / `WindowDecorationProperties` / `ResizeGripLayer`。
               ⛔ **没有 `WindowDrawnDecorationsTemplate` 具体类**（它是 internal），且 `Template` 属性是
               **接口** `IWindowDrawnDecorationsTemplate` → XAML 里既写不出模板元素、也实例化不了接口。
               硬写会报 `AVLN2000: Unable to resolve type WindowDrawnDecorationsTemplate`
               + `ResolveContentPropertyTransformer` 内部错误（Index out of range）。
               ⇒ **12.1.3 上「自定义装饰模板」这条路不存在**。AtomUI 那份指南对应的是它的 6.0 分支，不适用于本版本。
        -->
        <ControlTheme x:Key="{x:Type chrome:WindowDrawnDecorations}" TargetType="chrome:WindowDrawnDecorations">
            <!--  与 `ExtendClientAreaTitleBarHeightHint="40"` 保持一致：告诉框架标题栏占多高。  -->
            <Setter Property="DefaultTitleBarHeight" Value="40"/>
            <!--  Win32 上边框 / 阴影归 DWM（`:has-border` / `:has-shadow` 恒 false），这两个值不生效；
                 写 0 只为跨平台一致。窗口边界由 `Border.window-frame`（NT-039 自绘 1px 外框）负责。  -->
            <Setter Property="DefaultFrameThickness" Value="0"/>
            <Setter Property="DefaultShadowThickness" Value="0"/>
            <!--  🔴 故意**不设 Template**：见上方版本事实说明。⛔ 不要试图在这里补模板。  -->
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>

        <!--  ⚠️ 顺序：主题在前、应用样式在后。
             Avalonia 的 Styles 是**有序**集合，同一个属性被多个样式命中时"后写的赢"。
             FluentTheme 必须排在最前面（它是底座），本应用的 StyleInclude 与内联 <Style>
             都要排在它后面 —— 否则将来 FluentTheme 里任何一个同属性 setter 都会顶掉我们的配色。  -->
        <FluentTheme/>

        <!--  复用样式表（工具条 / 状态行 / 详情卡 / 表头 / 筛选条 …）  -->
        <StyleInclude Source="avares://NewToys/Styles/Controls.axaml"/>

        <!--  ==================== v3.1 仿浏览器外壳 ====================  -->

        <!--  ==================== 窗口外框（NT-039，需求 §4.1.1 ③） ====================
              只画 1px 描边；厚度 / 颜色全在这里给（⛔ XAML 那边不许写本地值，否则压死状态切换）。
              两个伪类由 `ShellView.axaml.cs` 的 `UpdateWindowFrame()` 切：
                `.maximized` → 收掉外框（Win11 最大化本就无边框）
                `.inactive`  → 窗口失焦，边框切淡色（回答「哪个窗口在前台」）  -->
        <Style Selector="Border.window-frame">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.window-frame.maximized">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.window-frame.inactive">
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderInactiveBrush}"/>
        </Style>

        <!--  标题栏工具按钮（≡ ◀ ▶ ⟳）：高 32、无边框、图标 18px。
             ⚠️ v3.4：标题栏底色 = ContentBrush（跟随主题明暗）→ 文字/图标必须用主题色 PrimaryTextBrush，
                 ⛔ 不要再用 Sider* 系（那是深色侧栏专用，浅底白字会看不见）。  -->
        <!--  v3.22：≡ / ⟳ **撑满标题栏整高**（40）、点击区放大到 40×40、无圆角（容器不要圆角）  -->
        <Style Selector="Button.title-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.title-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Button.title-btn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!--  v3.22（第三轮）：≡ / ⟳ 由 TextBlock 改为 Path 后，描边颜色必须显式给（Path 走 Stroke、不继承 Foreground，否则图标不可见）。
              ⚠️ 由样式给，⛔ 不写本地 Stroke —— 本地值会压过 :pointerover 状态切换。
              NT-045：粗细 / 端帽 / 拐角一并收进样式（XAML 里只留 Data + 尺寸），图标之间不再各写一套。  -->
        <Style Selector="Button.title-btn Path">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>

        <!--  NT-045：无状态**装饰**图标（首页 ★ / ⚡ / ⚙ 这类不参与 hover / active 的）—— 允许用类给死颜色。
              ⚠️ 有状态的图标（标题栏 / 标签 / 左树）一律走各自按钮的后代选择器，⛔ 别用这两个类。  -->
        <Style Selector="Path.icon-accent">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Path.icon-primary">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>

        <!--  标签项容器：激活态 = 强调色派生底 + 下方 2px 强调色指示条。
             ⚠️ v3.4：标签栏在标题栏内（底色 = ContentBrush 跟随主题），文字/底色一律用主题色系。  -->
        <!--  v3.22：不再有"下方指示条"（BorderThickness 归 0）—— 那条线被误认成阴影；激活只看文字颜色。  -->
        <Style Selector="Border.tab-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <!--  v3.22：上下留白 4→2 —— 标签项长高，充分利用 40px 标题栏 -->
            <Setter Property="Margin" Value="2,2,2,2"/>
        </Style>
        <Style Selector="Border.tab-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <!--  v3.22：激活态 = **只有文字变强调色**，就跟普通按钮一样 ——
             ⛔ 不垫背景色（会盖住关闭按钮、激活/悬停分不清）；⛔ 也不画下方指示条（看着像阴影）。  -->
        <Style Selector="Border.tab-item.active">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!--  v3.22：标签按钮**撑满标签项高度**（以前 Padding 10,4 + Center → 只占 24px，标题栏空一大截）  -->
        <!--  NT-036：右侧**预留 ✕ 宽度**（padding 右 28）—— 文字随之左移，悬停出现的 ✕ 落在文字右侧的
             空白处（不再压在文字上）；宽度常驻、显隐用 Opacity → 悬停不引起标签宽度跳动。  -->
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,0,28,0"/>
            <!--  v3.22：字号 = 13，与左侧二级菜单（Button.tree-row.sub）同大  -->
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <!--  激活标签：**文字用强调色**（v3.22 简化：激活 = 强调色条 + 强调色字，没有底色）  -->
        <Style Selector="Border.tab-item.active Button.tab-btn">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!--  关闭标签按钮：**默认隐藏，鼠标悬停本标签时才出现**（v3.4）。
             用 Opacity 而不是 IsVisible —— 宽度不变，鼠标扫过时标签不会抖动。  -->
        <!--  v3.21 §4.2 + 本轮：悬停 = **更大 + 红底(DangerBrush) + 白 ✕**（红 = 删除类动作的警示色；
              背景要生效需 BareButtonTheme 的 ControlTemplate 用 Border 接住 Background —— 否则背景画不出来）。  -->
        <Style Selector="Button.tab-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.tab-item:pointerover Button.tab-close">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <!--
            ⚠️ 必须用**后代选择器**写：单写 `Button.tab-close:pointerover` 会被 Fluent 主题的
            `Button:pointerover`（灰底 + 前景色）盖掉。后代选择器优先级更高，红底 + 白 ✕ 才真正生效。
        -->
        <!--
            v3.22（第三轮）：悬停 = **透明底 + 红 ✕**（用户明确要求"标签页栏的关闭按钮就要透明的"）。
            ⚠️ 仍走 BareButtonTheme（Background 由 Border 接住），只是把红底撤掉；红 ✕ 作警示色保留。
            错开：Margin 0,0,4,0；放大到 24×24 悬停态更易命中，多标签聚拢时利用标签间空白。
            NT-045：✕ 由 `TextBlock` 字符改**矢量 Path** —— 原来的"字号 11→14 放大"改由 `ScaleTransform` 承担。
        -->
        <Style Selector="Button.tab-close Path">
            <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
        </Style>
        <Style Selector="Border.tab-item Button.tab-close:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style Selector="Button.tab-close:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <!--  Path **不继承 Foreground** → 红 ✕ 必须直接给 Path 的 Stroke（用后代选择器，两级都写以覆盖两种命中路径）  -->
        <Style Selector="Border.tab-item Button.tab-close:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
            </Setter>
        </Style>
        <Style Selector="Button.tab-close:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
            </Setter>
        </Style>

        <!--  新建标签页「＋」按钮：图标用 Path 十字（天然居中、比文字清晰），竖直/水平都居中、略微放大；
              颜色走样式（⛔ 不写本地 Stroke —— 本地值会压过 :pointerover 样式，红/强调色切换失效）。  -->
        <Style Selector="Button.tab-new">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-new:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Button.tab-new Path">
            <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
        </Style>
        <Style Selector="Button.tab-new:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!--  左树行：一级 = 图标 + **加粗**；行高 30（v3.12 由 32 收紧）、缩进由子级 ItemsControl 的 Margin 给（每级 16）
              + **层级间距 4**（同上 Margin 的第二段，见 ShellView.axaml：一级行↔其下第一个二级行之间留缝，
              避免两行同时激活时圆角背景块贴合连成一片）。  -->
        <Style Selector="Button.tree-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tree-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource ContentBrush}"/>
        </Style>
        <Style Selector="Button.tree-row.active">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!--  二级行（.sub）：常规字重 + 次要色，与一级区分（v3.4）。
             ⚠️ 定义在 .active 之后，保证二级激活时仍取强调色。  -->
        <Style Selector="Button.tree-row.sub">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style Selector="Button.tree-row.sub.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!--  一级分组/首页的**矢量图标**颜色（v3.5）。
             ⚠️ 必须由样式给，不能在 XAML 里写本地值 —— 本地值优先级高于样式，写了 active 就永远不变色。
             折叠态（48px）时文字被隐藏，只剩这个图标 → 靠它显示"当前在哪个模块"的主题色。  -->
        <Style Selector="Button.tree-row Path">
            <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.tree-row.active Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!--  左树折叠态（48px）：只留一级图标，隐藏展开箭头 / 标题 / 子级
              NT-045：箭头由 TextBlock 字符改矢量 Path，外面包一层 Panel.tree-glyph —— 用 Panel 承载 IsVisible，
              因为内部的 Path 自己绑了 IsVisible（本地值，样式压不过）。  -->
        <Style Selector="Border.tree-panel.collapsed Panel.tree-glyph">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.tree-panel.collapsed TextBlock.tree-title">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.tree-panel.collapsed ItemsControl.tree-children">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!--  窗口控制按钮（标题栏底色 = ContentBrush，配色随主题）  -->
        <!--  v3.22：窗口按钮**不要圆角**、垂直撑满标题栏（容器不设圆角，最大化利用空间）  -->
        <Style Selector="Button.win-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.win-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Button.win-btn.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}"/>
            <!--  ✕ 是 TextBlock、前景色靠**属性继承**（⛔ 不写本地值、也不用后代选择器）——
                  这里直接改 Button 自己的 Foreground，子元素自动跟着变白。继承不受模板影响，可靠。  -->
            <Setter Property="Foreground" Value="{DynamicResource TitleBarCloseHoverTextBrush}"/>
        </Style>
        <!--  NT-045：窗口按钮图标改**矢量 `Path`**（原先用 `Rectangle` / `Border` / 图标字体三种混用）。
              🔴 `Path` **不继承 Foreground** → 必须显式给 Stroke；⛔ 仍不写本地值（本地值会压过关闭的悬停态）。
              ⚠️「Path 在裸主题里渲染不出来」的旧结论已按**推断**改造模板（见 `BareButtonTheme` 内注释），
                 并有兜底（改 `Stretch="None"` 或退回图标字体）—— 本地验证时优先看这几个图标。  -->
        <Style Selector="Button.win-btn Path">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.win-btn.close:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TitleBarCloseHoverTextBrush}"/>
        </Style>

        <!--  ==================== 通用（沿用） ====================  -->

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <!--  视频列表「📂 导入」拆分按钮：沿用 ghost 外观，主钮 + 下拉两半都透明、悬停同卡片色  -->
        <Style Selector="SplitButton.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="SplitButton.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="SplitButton.ghost /template/ Button#PART_PrimaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="SplitButton.ghost /template/ Button#PART_SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="SplitButton.ghost:pointerover /template/ Button#PART_PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <!--  v3.12 密度：卡片圆角 8、内边距 14 → 12  -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!--  列表本体（行高 / 悬停 / 选中底色）；表头与单元格的样式见 Styles/Controls.axaml  -->
        <Style Selector="ListBox.list-page">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <!-- v3.16.1：行高基线 28 从 TextBlock.list-cell 挪到这里 —— TextBlock 的 MinHeight 只会把
                 元素框撑高、文本还是画在框顶（文字偏上）；行高由容器兜底，文字才能真正垂直居中。 -->
            <Setter Property="MinHeight" Value="28"/>
            <!-- ⚠️ 必须 Stretch：行模板用星号列跟表头对齐，不拉伸就永远错位 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- v3.16.1：垂直也要 Stretch —— Fluent 默认 Top，行里出现比文字高的控件（勾选框）后文字整体偏上 -->
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.list-page ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
        </Style>

        <!--  收藏按钮墙（首页常用功能 / PcTools 收藏夹）：一排按钮，点即执行  -->
        <Style Selector="Button.fav-btn">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <!--  收藏夹页（PcTools）的按钮（v3.9）：透明底 + **强调色描边**；悬停 / 按下变**强调色实心**。
             ⚠️ 单独做一个 .accent 变体 —— 首页「常用功能」那排按钮用的是**模块底色**（本地 Background，优先级高于样式），
                直接改基础 .fav-btn 会把首页一起带偏，所以这个变体只给收藏夹页用。  -->
        <Style Selector="Button.fav-btn.accent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.fav-btn.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style Selector="Button.fav-btn.accent:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <!--  左树底部版本号（v3.9）：低调一行小字；折叠态整体隐藏。
             ⚠️ 这是**独立占位值**（ShellViewModel.TreeVersionText），与「设置 → 关于」的版本号无关。  -->
        <Style Selector="Border.tree-version">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="TextBlock.tree-version-text">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tree-panel.collapsed Border.tree-version">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!--  底部状态栏（v3.9）：横贯「内容区 + 详情区」，由 Shell 统一承载（内容来自 IStatusProvider）。  -->
        <Style Selector="Border.status-bar">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="TextBlock.status-bar-text">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Application.Styles>
</Application>
