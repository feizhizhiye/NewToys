<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.MediaAssets.Views.Detail.AssetDetailView">
  <!--
    NT-016 资产详情卡。
    ⚠️ 外壳（340px 宽 / 背景 / 左边线）由 **Shell 的右详情列**提供（见 ShellView 的 DetailPanel），
       所以这里**⛔ 不再套 Border.detail-card**（否则双层卡片 + 双重内边距）。

    🔴 卡内**零操作按钮**（需求 §6.6 / NT-016 验收）：所有动作都在工具条 / 右键菜单。
       显示名的保存方式 = 输入框**失焦**即存（code-behind 转调 VM 的 SaveDisplayNameCommand）。
  -->
  <UserControl.Styles>
    <!--  本页专用：可选色片按钮（NT-018）。选中 = 强调色描边 + 强调色文字（⛔ 不用已删除的 CardSelectedBrush）  -->
    <Style Selector="Button.pick-chip">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Button.pick-chip:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.pick-chip.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="10">

      <!--  没选中时给一句引导  -->
      <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !ShowDetailBody}"
                 Text="在左侧列表里选中一个资产，这里显示它的详情。"/>

      <!--  v3.32 §4.8.3：示例态标识（下面是示例数据，不可编辑）  -->
      <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding IsDetailSample}"
                 Text="（示例数据）在左侧选中一个资产后，这里显示它的真实信息；示例态下卡片不可编辑。"/>

      <!--  v3.32 §4.8.3：示例态整卡禁用，⛔ 不让用户去改 / 保存一份假数据  -->
      <StackPanel Spacing="10" IsVisible="{Binding ShowDetailBody}" IsEnabled="{Binding !IsDetailSample}">

        <!--  ===== 显示名（唯一可编辑项）=====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="显示名（只改库里的名字，⛔ 不动磁盘文件）"/>
          <TextBox x:Name="DisplayNameBox" Text="{Binding DetailDisplayName, Mode=TwoWay}"
                   PlaceholderText="留空 = 用扫描时得到的标题"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 基本信息（只读）=====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="类型"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.TypeText}"/>

          <TextBlock Classes="field-label" Text="状态"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.StatusText}"/>

          <TextBlock Classes="field-label" Text="大小"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.SizeText}"/>

          <TextBlock Classes="field-label" Text="修改时间"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.ModifiedText}"/>

          <TextBlock Classes="field-label" Text="存储源"/>
          <TextBlock Classes="field-value" Text="{Binding DetailRow.StorageName}"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 文件路径（可复制）=====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="文件路径"/>
          <SelectableTextBlock Classes="field-value" Text="{Binding DetailRow.FilePath}" TextWrapping="Wrap"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap"
                     Text="重命名 / 移动 / 复制 / 删除**磁盘上的文件**是显式操作，在 NT-019 落地。"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 评分 / 描述（NT-018 可编辑，「💾 保存」落库） =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="评分（0~5）"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RatingChoices}"
                    SelectedItem="{Binding EditRating, Mode=TwoWay}"/>

          <TextBlock Classes="field-label" Text="描述"/>
          <TextBox AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap"
                   Text="{Binding EditDescription, Mode=TwoWay}"
                   PlaceholderText="随手记点什么（可留空）"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 组织信息（NT-018：点色片即打上 / 取消，最后「💾 保存」统一落库） =====  -->
        <StackPanel Spacing="6">
          <TextBlock Classes="field-label" Text="标签（点一下打上 / 取消）"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasTagPicks}"
                     Text="（还没有标签：到「标签管理」页新建，或用工具条的「🏷 加标签」）"/>
          <ItemsControl ItemsSource="{Binding TagPicks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="pick-chip" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].DataContext.ToggleTagCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="field-label" Text="分类（点一下加 / 去掉）"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasCategoryPicks}"
                     Text="（还没有分类：到「分类管理」页新建）"/>
          <ItemsControl ItemsSource="{Binding CategoryPicks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="pick-chip" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].DataContext.ToggleCategoryCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="field-label" Text="集合（点一下加 / 去掉；⚡ 智能集合不参与手工设置）"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasCollectionPicks}"
                     Text="（还没有集合：到「集合管理」页新建）"/>
          <ItemsControl ItemsSource="{Binding CollectionPicks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="pick-chip" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].DataContext.ToggleCollectionCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 保存 / 应用到文件 / 移入回收站（v3.29 定调：卡内允许「编辑 + 保存」） =====  -->
        <Button Classes="primary" Content="💾 保存" Command="{Binding SaveAssetDetailCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="把显示名 / 评分 / 描述 / 标签 / 分类 / 集合写进资产库（⛔ 不动磁盘文件）"/>
        <Button Classes="ghost" Content="↗ 应用到文件" Command="{Binding ApplyToFileCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="把名字**真写到磁盘文件上**（物理重命名：走任务队列 + 日志先行；同名冲突按「追加序号」，⛔ 不覆盖）"/>
        <Button Classes="danger-btn" Content="🗑 移入回收站" Command="{Binding MoveToTrashCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="软删除：只改库里的状态（⛔ 不动磁盘文件；在「回收站」页能恢复）"/>

        <Border Classes="divider-line"/>

        <!--  ===== NT-030：移动 / 复制（目标 = 已登记存储源；防穿越由服务保证） =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="移动到 / 复制到（目标存储源）"/>
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding TargetStorages}"
                    SelectedValue="{Binding SelectedTargetStorageId, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}"/>
          <Button Classes="ghost" Content="📁 移动到此源" Command="{Binding MoveToTargetCommand}"
                  HorizontalAlignment="Stretch"
                  ToolTip.Tip="把主文件位置移到选定的已登记存储源根内（⛔ 不越界写盘）"/>
          <Button Classes="ghost" Content="📋 复制到此源" Command="{Binding CopyToTargetCommand}"
                  HorizontalAlignment="Stretch"
                  ToolTip.Tip="复制一份到选定的已登记存储源根内（原文件不动）"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 关联（NT-018：只读列出；增删归后续） =====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="关联（字幕 / 封面 / 版本…）"/>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding !HasRelations}"
                     Text="（暂无关联；关联的增删在本轮之后落地）"/>
          <ItemsControl ItemsSource="{Binding Relations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,4">
                  <TextBlock Classes="field-value" Text="{Binding TypeText}"/>
                  <TextBlock Classes="hint-text" Text="{Binding TargetName}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 文件位置（一个资产可能有多份拷贝 / 多个路径）=====  -->
        <StackPanel Spacing="4">
          <TextBlock Classes="field-label" Text="文件位置"/>
          <ItemsControl ItemsSource="{Binding Locations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,6">
                  <!--  ⚠️ FileLocation 的属性就叫 Path → **必须写 `Path=Path`**：
                        简写的 `{Binding Path}` 会被解析成"给 Binding 的 Path 属性赋值"，绑不出东西。  -->
                  <SelectableTextBlock Classes="field-value" Text="{Binding Path=Path}" TextWrapping="Wrap"/>
                  <TextBlock Classes="hint-text" Text="{Binding Status}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint-text" TextWrapping="Wrap" IsVisible="{Binding DetailRow.IsMissing}"
                     Text="⚠ 这个文件在磁盘上找不到了（最近一次扫描没见到它）。"/>
        </StackPanel>

        <Border Classes="divider-line"/>

        <!--  ===== 操作日志入口（NT-018 逻辑操作 / NT-019 物理操作 才会产生记录）=====  -->
        <TextBlock Classes="hint-text" TextWrapping="Wrap"
                   Text="操作日志（谁在什么时候改了什么）随 NT-018 / NT-019 一起落地，届时会在这里给出入口。"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
