<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 最新稳定版 -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- MVVM 工具包 -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 本地数据库（视频库媒体信息索引；后续更多配置项复用同一个 newtoys.db） -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- 微软扩展 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
    <!-- HTML 解析（浏览器书签导入，Netscape 书签格式） -->
    <PackageVersion Include="AngleSharp" Version="1.3.0" />
    <!-- JS 引擎（网页抓取「整合脚本」对结果做二次处理） -->
    <PackageVersion Include="Jint" Version="3.1.2" />
    <!-- 邮件收发（备份中心投递 + 邮箱管理页：SMTP / IMAP，纯托管、平台中立） -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- 单元测试（src/NewToys.Tests，只测纯函数解析器；产物落 artifacts\tests\，⛔ 不进 Release 交付目录） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>