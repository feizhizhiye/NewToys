<UserControl
    x:Class="NewToys.VideoTools.Views.VideoBatchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:NewToys.VideoTools.Views">
    <!--  v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；工具条等收进列表列，详情卡从页面顶到底。  -->
    <Grid Margin="12" ColumnDefinitions="*,Auto">

        <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

            <!--
                操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
                Row0 保持空着（Auto → 高度 0），不动下面各行的行号。
            -->

            <!--  ==================== 工具条  ====================  -->
            <Border Grid.Row="1" Classes="toolbar">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">


                        <Button
                            x:Name="PickFilesBtn"
                            Margin="0,0,8,6"
                            Classes="primary"
                            Content="📂 添加文件"
                            ToolTip.Tip="按左边选的类型建任务；只是建任务，不立刻跑" />


                        <ComboBox
                            Width="220"
                            Margin="0,0,8,6"
                            ItemsSource="{Binding Presets}"
                            SelectedValue="{Binding DefaultPresetId, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}"
                            ToolTip.Tip="只影响随后加入的**转码**任务；已存在的任务在右侧详情卡里单独改">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>



                        <TextBox
                            Width="180"
                            Margin="0,0,8,6"
                            PlaceholderText="按文件名 / 输出过滤…"
                            Text="{Binding SearchText, Mode=TwoWay}" />

                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="primary"
                            Command="{Binding RunAllCommand}"
                            Content="▶▶ 批量运行"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip.Tip="按列表顺序依次处理（剪辑 / 转码各按自己的参数），跑完自动探测输出文件" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding RunSelectedCommand}"
                            Content="▶ 只跑选中"
                            IsEnabled="{Binding IsNotBusy}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding StopCommand}"
                            Content="⏹ 停止"
                            IsEnabled="{Binding IsRunning}" />

                        <!--  v3.12：详情卡里原本那排按钮全部上移到工具条（详情卡只留参数 + 命令）  -->
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding SaveCommand}"
                            Content="💾 保存修改"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="把详情卡里改的参数写回选中的任务" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding DeleteCommand}"
                            Content="🗑 删除"
                            IsEnabled="{Binding IsNotBusy}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="📂 输出目录"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding CopyCommandLineCommand}"
                            Content="📋 复制命令"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ResetCommandCommand}"
                            Content="↺ 重置为自动"
                            IsEnabled="{Binding IsArgsEdited}"
                            IsVisible="{Binding IsArgsEdited}"
                            ToolTip.Tip="丢弃手改的命令，恢复成由参数自动生成" />
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            x:Name="ExportBtn"
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Content="📤 导出任务"
                            ToolTip.Tip="把当前队列（剪辑 + 转码）导出成 JSON 文件，可用外部脚本批量加工后再导入" />
                        <Button
                            x:Name="ImportBtn"
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Content="📥 导入任务"
                            ToolTip.Tip="从导出的 JSON 里追加任务进当前队列（不覆盖已有）" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ClearFinishedCommand}"
                            Content="🧹 清理已结束"
                            IsEnabled="{Binding IsNotBusy}" />
                        <!--  v3.16.1 §6.4.11：只清页面缓存（⛔ 不叫"清除队列"，不动磁盘上的 json）  -->
                        <Button
                            Margin="0,0,4,4"
                            Classes="ghost"
                            Command="{Binding ClearCacheCommand}"
                            Content="🧹 清除缓存"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip.Tip="只清页面上的这条列表（不再显示它们）：⛔ 磁盘上的 config\video-tasks.json 不会动，点「📥 导入任务」可以再读回来" />
                        <Border
                            Width="1"
                            Height="18"
                            Margin="0,0,6,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,4"
                            Classes="primary"
                            Command="{Binding SendToPreviewCommand}"
                            Content="➡ 送预览"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="把选中的任务源文件送进「视频预览」页（一次只编一个，进入后自动载入）" />
                    </WrapPanel>
                    <Button
                        Grid.Column="1"
                        Classes="detail-toggle"
                        Command="{Binding ToggleDetailCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
                        <Panel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding !IsDetailVisible}"
                                Text="❯" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding IsDetailVisible}"
                                Text="❮" />
                        </Panel>
                    </Button>
                </Grid>
            </Border>


            <!--  ==================== 列表本体：剪辑 + 转码混排的统一队列  ====================  -->
            <Border
                Grid.Row="3"
                Padding="0"
                Classes="card">
                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0" Classes="list-header">
                        <!--  v3.20 §6.4.15：IsResizable = 表头列边界可拖动手动调列宽（事件在 code-behind 转给 VM）  -->
                        <v:ColumnGrid
                            x:Name="HeaderGrid"
                            ColumnSpecs="{Binding VisibleColumnSpecs}"
                            IsResizable="True"
                            LockedColumns="{Binding LockedColumnMask}">
                            <!--
                                v3.16.1：第一列 = 行首勾选框；表头改用**原生 CheckBox**（三态：全勾 ✓ / 部分 ■ / 没勾）
                                —— 之前用字符"☑"，字体渲染成一坨深色块，跟行内勾选框风格不搭。
                                点 = 全选/取消；右键 = 菜单（全选 / 取消选择 / 反选，与「视频列表」页同一套）。
                                外面套透明 Border：整个 34px 列格都是右键热区。
                                ⚠️ ContextMenu 挂在 Border 上，code-behind 同步 DataContext 用 HeaderCheckHost。
                            -->
                            <Border
                                x:Name="HeaderCheckHost"
                                Grid.Column="0"
                                Background="Transparent"
                                Cursor="Hand"
                                IsEnabled="{Binding HasItems}"
                                IsVisible="{Binding IsPickVisible}"
                                ToolTip.Tip="点 = 全选 / 取消；右键 = 全选 / 取消选择 / 反选">
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleAllCommand}"
                                    IsChecked="{Binding AllCheckedState, Mode=OneWay}" />
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding CheckAllCommand}" Header="☑ 全选（当前列表）" />
                                        <MenuItem Command="{Binding UncheckAllCommand}" Header="☐ 取消选择" />
                                        <MenuItem Command="{Binding InvertCheckedCommand}" Header="🔄 反选" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <Button
                                Grid.Column="1"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Kind"
                                Content="{Binding KindHeader}"
                                IsVisible="{Binding IsKindVisible}" />
                            <Button
                                Grid.Column="2"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Name"
                                Content="{Binding NameHeader}"
                                IsVisible="{Binding IsNameVisible}" />
                            <Button
                                Grid.Column="3"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Param"
                                Content="{Binding ParamHeader}"
                                IsVisible="{Binding IsParamVisible}" />
                            <Button
                                Grid.Column="4"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Before"
                                Content="{Binding BeforeHeader}"
                                IsVisible="{Binding IsBeforeVisible}" />
                            <Button
                                Grid.Column="5"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="After"
                                Content="{Binding AfterHeader}"
                                IsVisible="{Binding IsAfterVisible}" />
                            <Button
                                Grid.Column="6"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Status"
                                Content="{Binding StatusHeader}"
                                IsVisible="{Binding IsStatusVisible}" />
                            <TextBlock
                                Grid.Column="7"
                                Classes="list-cell"
                                FontWeight="SemiBold"
                                IsVisible="{Binding IsProgressVisible}"
                                Text="进度" />
                            <!--  v3.15 §6.4.8 扩充列（列索引 7~9，与 Columns 元数据一一对应）  -->
                            <Button
                                Grid.Column="8"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Source"
                                Content="{Binding SourceHeader}"
                                IsVisible="{Binding IsSourceVisible}" />
                            <Button
                                Grid.Column="9"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Command"
                                Content="{Binding CommandHeader}"
                                IsVisible="{Binding IsCommandVisible}" />
                            <Button
                                Grid.Column="10"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Created"
                                Content="{Binding CreatedHeader}"
                                IsVisible="{Binding IsCreatedVisible}" />
                            <v:ColumnGrid.ContextMenu>
                                <ContextMenu>
                                <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                      <Setter Property="Header" Value="{Binding Label}"/>
                                      <Setter Property="Command" Value="{Binding Command}"/>
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                    <Separator />
                                    <!--  v3.16：勾选列也进「列显隐」（⛔ IsChecked 必须 Mode=OneWay，翻转由 ToggleColumnCommand 独家负责）  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Pick"
                                        Header="勾选框"
                                        IsChecked="{Binding IsPickVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Kind"
                                        Header="类型"
                                        IsChecked="{Binding IsKindVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Name"
                                        Header="文件"
                                        IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Param"
                                        Header="参数"
                                        IsChecked="{Binding IsParamVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Before"
                                        Header="处理前"
                                        IsChecked="{Binding IsBeforeVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="After"
                                        Header="处理后"
                                        IsChecked="{Binding IsAfterVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Status"
                                        Header="状态"
                                        IsChecked="{Binding IsStatusVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Progress"
                                        Header="进度"
                                        IsChecked="{Binding IsProgressVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Source"
                                        Header="源文件"
                                        IsChecked="{Binding IsSourceVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Command"
                                        Header="命令摘要"
                                        IsChecked="{Binding IsCommandVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Created"
                                        Header="创建时间"
                                        IsChecked="{Binding IsCreatedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                </ContextMenu>
                            </v:ColumnGrid.ContextMenu>
                        </v:ColumnGrid>
                    </Border>

                    <ListBox
                        x:Name="TaskList"
                        Grid.Row="1"
                        Classes="list-page"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <Separator />
                                <MenuItem Command="{Binding SaveCommand}" Header="💾 保存修改" />
                                <MenuItem
                                    Command="{Binding RunSelectedCommand}"
                                    Header="▶ 只跑选中"
                                    IsEnabled="{Binding IsNotBusy}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding DeleteCommand}"
                                    Header="🗑 删除任务"
                                    IsEnabled="{Binding IsNotBusy}" />
                                <MenuItem Command="{Binding OpenOutputFolderCommand}" Header="📂 打开输出目录" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                                    <!--  v3.16 §6.4.10：行首勾选框（配合表头 ☑ 的 全选 / 取消 / 反选）  -->
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[ListBox].DataContext.ItemCheckedCommand}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsPickVisible}"
                                        ToolTip.Tip="勾上后可以配合表头 ☑ 做批量勾选" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsKindVisible}"
                                        Text="{Binding KindDisplay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsParamVisible}"
                                        Text="{Binding ParamDisplay}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsBeforeVisible}"
                                        Text="{Binding BeforeDisplay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Classes="list-cell accent"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsAfterVisible}"
                                        Text="{Binding OutputSizeDisplay}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsStatusVisible}"
                                        Text="{Binding StatusDisplay}" />
                                    <ProgressBar
                                        Grid.Column="7"
                                        Classes="task-progress"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsProgressVisible}"
                                        Maximum="100"
                                        Value="{Binding Progress}" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <TextBlock
                                        Grid.Column="8"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsSourceVisible}"
                                        Text="{Binding SourcePath}" />
                                    <!--
                                        命令摘要是 **VM 现算的**（不是模型属性）：往上找 ListBox 的 DataContext 调不了带参方法，
                                        所以这里绑到模型自带的 RawArgs / ParamDisplay 兜底显示；完整命令行仍在详情卡命令区。
                                    -->
                                    <TextBlock
                                        Grid.Column="9"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCommandVisible}"
                                        Text="{Binding CommandSummaryDisplay}" />
                                    <TextBlock
                                        Grid.Column="10"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCreatedVisible}"
                                        Text="{Binding CreatedDisplay}" />
                                </v:ColumnGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!--
            ==================== 右：详情卡（**只有参数 + 命令**，按钮都在上面工具条）
            ⚠️ 分区顺序与「视频预览」页一致：剪辑 → 转码 → 输出 → 命令（需求 §6.4.1）。
            ⚠️ Avalonia 12 的 ScrollBar 是**覆盖式**（槽落在 ScrollViewer 右缘之外 8px）→
            卡片 Padding 右 4 + 滚动内容 Margin 右 4，滚动条才不会压在内容上（规范 §3.6）
        -->
        <Border
            Grid.Column="1"
            Padding="12,12,4,12"
            Classes="detail-card"
            IsVisible="{Binding IsDetailVisible}">
            <ScrollViewer Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,0" Spacing="6">

                    <TextBlock
                        Classes="empty-hint"
                        IsVisible="{Binding !HasSelection}"
                        Text="在左侧选中一个任务：这里可以改它的参数（剪辑 = 区间 / 预设；转码 = 预设 / 编码器 / CRF / 分辨率），改完点工具条上的「💾 保存修改」。" />

                    <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="field-label" Text="类型 / 文件" />
                        <TextBlock
                            Classes="field-value"
                            FontWeight="SemiBold"
                            Text="{Binding Selected.Name}" />
                    </StackPanel>

                    <!--
                        ① 剪辑分区：与「视频预览」页**同一段**（标题行 = 勾选框 + 标题）。
                        v3.16 §6.4.1：勾选框在两页都**可交互** —— 批量页勾 / 取消 = 切换任务类型
                        （剪辑 ⇄ 转码 ⇄ 剪辑+转码），所以这里不再用 IsVisible 按类型藏整段。
                    -->
                    <Expander IsExpanded="{Binding IsCutSectionExpanded, Mode=TwoWay}" IsVisible="{Binding HasSelection}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CheckBox IsChecked="{Binding EditIsCut, Mode=TwoWay}" VerticalAlignment="Center"
                                          IsEnabled="{Binding HasSelection}"
                                          ToolTip.Tip="勾上 = 这条任务带剪辑区间（-ss / -to）；取消 = 变成纯转码任务"/>
                                <TextBlock Text="✂ 剪辑（截区间）" VerticalAlignment="Center" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="6">

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="开始（HH:MM:SS.mmm 或秒）" />
                                <TextBox
                                    Classes="code"
                                    PlaceholderText="00:00:00.000"
                                    Text="{Binding EditStart, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="结束（留空 = 到末尾）" />
                                <TextBox
                                    Classes="code"
                                    PlaceholderText="00:00:10.000"
                                    Text="{Binding EditEnd, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="剪切预设" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    ItemsSource="{Binding CutPresetOptions}"
                                    SelectedValue="{Binding EditCutPresetId, Mode=TwoWay}"
                                    SelectedValueBinding="{Binding Id}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Classes="field" IsVisible="{Binding IsCutReEncode}">
                                <TextBlock Classes="field-label" Text="重新编码时的 CRF（18~28 常用，越小越清晰）" />
                                <TextBox Classes="code" Text="{Binding EditCutCrf, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="自定义 ffmpeg 参数（追加在预设之后 → 可覆盖预设）" />
                                <TextBox
                                    MinHeight="40"
                                    AcceptsReturn="True"
                                    Classes="code"
                                    PlaceholderText="例：-vf scale=1280:-2"
                                    Text="{Binding EditExtraArgs, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                        </StackPanel>
                    </Expander>

                    <!--
                        ② 转码分区：同样与「视频预览」页同一段（标题行 = 勾选框 + 标题）。
                        v3.16 §6.4.1：勾选框可交互 —— 取消 = 变成纯剪辑任务；两段都勾 = "剪辑+转码"一条命令。
                        ⛔ 段内不再单独放一组"剪辑区间"输入（区间归剪辑分区，两页一致）。
                    -->
                    <Expander IsExpanded="{Binding IsTranscodeSectionExpanded, Mode=TwoWay}" IsVisible="{Binding HasSelection}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CheckBox IsChecked="{Binding EditIsTranscode, Mode=TwoWay}" VerticalAlignment="Center"
                                          IsEnabled="{Binding HasSelection}"
                                          ToolTip.Tip="勾上 = 这条任务带编码 / 画质参数；取消 = 变成纯剪辑任务"/>
                                <TextBlock Text="🔁 转码（换编码 / 格式）" VerticalAlignment="Center" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="6">

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="编码预设" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    ItemsSource="{Binding Presets}"
                                    SelectedValue="{Binding EditPresetId, Mode=TwoWay}"
                                    SelectedValueBinding="{Binding Id}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="编码器" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    SelectedIndex="{Binding EncoderIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="CPU（软件编码，兼容性最好）" />
                                    <ComboBoxItem Content="GPU（NVENC，N 卡）" />
                                </ComboBox>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Classes="hint-text"
                                    Text="{Binding SelectedEncoder, StringFormat='实际会用：{0}'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="容器 / 格式（决定输出文件后缀）" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    ItemsSource="{Binding ContainerOptions}"
                                    SelectedValue="{Binding EditContainer, Mode=TwoWay}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                                <StackPanel Grid.Column="0" Classes="field">
                                    <TextBlock Classes="field-label" Text="宽（0 = 按比例）" />
                                    <TextBox Classes="code" Text="{Binding EditTargetWidth, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Center"
                                    Text="×" />
                                <StackPanel Grid.Column="2" Classes="field">
                                    <TextBlock Classes="field-label" Text="高（0 = 不改）" />
                                    <TextBox Classes="code" Text="{Binding EditTargetHeight, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!--  v3.19 / NT-013：默认宽 / 高上限（源更大才缩、否则保原始；与显式宽高二选一）。
                                  ⛔ 已删「最大高度」字段（反馈：冗余）；默认值 1920×1080，可手改。  -->
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                                <StackPanel Grid.Column="0" Classes="field">
                                    <TextBlock Classes="field-label" Text="默认宽上限" />
                                    <TextBox Classes="code" Text="{Binding EditDefaultWidth, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="0,16,0,0" />
                                <StackPanel Grid.Column="2" Classes="field">
                                    <TextBlock Classes="field-label" Text="默认高上限" />
                                    <TextBox Classes="code" Text="{Binding EditDefaultHeight, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!--  v3.19 / NT-012：旋转 / 翻转（映射 ffmpeg -vf；与「视频预览」页同字段，两页一致）  -->
                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="旋转 / 翻转（视频方向不对时用）" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    ItemsSource="{Binding RotateChoices}"
                                    SelectedItem="{Binding SelectedRotate, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" FontSize="12" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Classes="field">
                                <TextBlock Classes="field-label" Text="码率模式" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    SelectedIndex="{Binding BitrateModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="CRF（恒定质量，推荐）" />
                                    <ComboBoxItem Content="目标码率（如 5000k / 5M）" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Classes="field" IsVisible="{Binding UseCrf}">
                                <TextBlock Classes="field-label" Text="CRF（0 = 用预设的值；18~28 常用）" />
                                <TextBox Classes="code" Text="{Binding EditCrf, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Classes="field" IsVisible="{Binding !UseCrf}">
                                <TextBlock Classes="field-label" Text="目标码率（如 5000k / 5M）" />
                                <TextBox
                                    Classes="code"
                                    PlaceholderText="5000k"
                                    Text="{Binding EditTargetBitrate, Mode=TwoWay}" />
                            </StackPanel>

                        </StackPanel>
                    </Expander>

                    <!--  v3.19 / NT-013：③④ 包一层，左右各 16 与 Expander 内容（Padding=16）两侧对齐  -->
                    <StackPanel Margin="16,0,16,0">
                    <!--  ③ 输出  -->
                    <StackPanel
                        Margin="0,2,0,0"
                        Classes="field"
                        IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="field-label" Text="输出文件（留空 = 自动命名，绝不覆盖已有文件）" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox
                                Grid.Column="0"
                                Classes="code"
                                Text="{Binding EditOutput, Mode=TwoWay}" />
                            <Button
                                x:Name="PickOutputBtn"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Padding="8,4"
                                Classes="ghost"
                                Content="📂" />
                        </Grid>
                    </StackPanel>

                    <!--  ④ 命令（自动生成 + 可手改；与「视频预览」页同一段结构）  -->
                    <Border Classes="divider-line" IsVisible="{Binding HasSelection}" />
                    <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="field-label" Text="将要执行的命令（改参数即时刷新，实际跑的就是这条）" />
                        <SelectableTextBlock
                            Classes="field-value"
                            Text="{Binding CommandPreview}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,8,0"
                        Classes="field"
                        IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="field-label" Text="ffmpeg 参数（可手动编辑；不含 ffmpeg.exe 与输出路径）" />
                        <TextBox
                            MinHeight="44"
                            AcceptsReturn="True"
                            Classes="code"
                            Text="{Binding EditArgs, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Classes="hint-text"
                            IsVisible="{Binding IsArgsEdited}"
                            Text="✎ 已手改：运行时以这里为准（工具条上「↺ 重置为自动」可撤销）。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    </StackPanel>

                    <!--  处理前 → 处理后（结果信息，不属于命令）  -->
                    <Border
                        Margin="0,0,8,0"
                        Classes="divider-line"
                        IsVisible="{Binding HasSelection}" />
                    <StackPanel
                        Margin="0,0,8,0"
                        IsVisible="{Binding HasSelection}"
                        Spacing="4">
                        <TextBlock Classes="section-title" Text="处理前 → 处理后" />
                        <ItemsControl ItemsSource="{Binding CompareRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="72,*">
                                        <TextBlock
                                            Grid.Column="0"
                                            Classes="field-value"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding Label}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <TextBlock Classes="field-value" Text="{Binding Before}" />
                                            <TextBlock
                                                Classes="field-value"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="→" />
                                            <TextBlock
                                                Classes="field-value"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Text="{Binding After}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="hint-text" Text="「后」这一列在跑完之后才有值（转码会自动用 ffprobe 探测输出文件）。" />
                    </StackPanel>

                    <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="field-label" Text="任务状态" />
                        <TextBlock Classes="field-value" Text="{Binding Selected.StatusDisplay}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Classes="hint-text"
                            Text="{Binding Selected.Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Classes="hint-text"
                        Text="任务只在这里排队：改完参数点工具条上的「💾 保存修改」，要跑的时候点「▶▶ 批量运行」。任务清单存 config\video-tasks.json，关掉软件再回来还在。"
                        TextWrapping="Wrap" />

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>