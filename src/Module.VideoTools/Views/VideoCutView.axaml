<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.VideoTools.Views.VideoCutView">

  <Grid RowDefinitions="Auto,*" Margin="16">

    <!--  ==================== 工具条：只三项 + 详情卡开关（v3.10：删「任务类型」单选）  ====================  -->
    <Border Grid.Row="0" Classes="toolbar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PickFileBtn" Classes="primary" Content="📂 选择视频" Margin="0,0,8,6"
                ToolTip.Tip="挑一个视频文件载入编辑器（这一页一次只编一个任务；载入后自动预览）"/>
        <Button Classes="primary" Content="➡ 发送到批处理" Margin="0,0,8,6"
                Command="{Binding SendToBatchCommand}"
                ToolTip.Tip="把当前这一条任务加入「批量处理」的队列（不立刻运行）"/>
        <Button Classes="ghost" Content="↺ 区间重置" Margin="0,0,8,6"
                Command="{Binding ResetRangeCommand}"
                ToolTip.Tip="开始归零、结束留空 = 整段"/>

        <Border Classes="divider-line" Width="1" Height="20" Margin="0,0,8,0"/>
        <Button Classes="ghost" Content="▤ 详情" Margin="0,0,8,6"
                IsVisible="{Binding !IsDetailVisible}"
                Command="{Binding ToggleDetailCommand}"
                ToolTip.Tip="展开右侧详情卡（任务类型 / 参数 / 命令）"/>
        <Button Classes="ghost" Content="❮ 收起详情" Margin="0,0,8,6"
                IsVisible="{Binding IsDetailVisible}"
                Command="{Binding ToggleDetailCommand}"
                ToolTip.Tip="收起右侧详情卡，把空间留给预览"/>

        <TextBlock Classes="hint-text" Text="{Binding DurationDisplay, StringFormat='源时长：{0}'}"
                   VerticalAlignment="Center" Margin="8,0,0,6"/>
      </WrapPanel>
    </Border>

    <!--  ==================== 主体：主内容区（类播放器）｜ 详情卡  ====================  -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">

      <!--  ==================== 主内容区：类播放器预览  ====================  -->
      <Border Grid.Column="0" Classes="card" Padding="14">
        <Grid RowDefinitions="*,Auto">

          <!--  大画面  -->
          <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True"
                  Background="{DynamicResource CodeBlockBrush}" MinHeight="240">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" MinHeight="240"/>
          </Border>

          <TextBlock Grid.Row="0" Classes="empty-hint" HorizontalAlignment="Center"
                     VerticalAlignment="Center" IsVisible="{Binding !HasSource}"
                     Text="点上面的「📂 选择视频」挑一个文件开始；也可以从「视频列表」页多选后点「✂ 命令生成·剪辑」把文件送过来（会自动预览）。"/>

          <!--  ==================== 下方：三条时间条（预览位置 / 开始 / 结束）  ====================  -->
          <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6" IsVisible="{Binding HasDuration}">

            <!--  ① 预览位置  -->
            <Grid ColumnDefinitions="72,*,64">
              <TextBlock Grid.Column="0" Classes="field-label" Text="预览位置" VerticalAlignment="Center"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TimelineMax}"
                      Value="{Binding PreviewTime, Mode=TwoWay}"
                      TickFrequency="0.5" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                      ToolTip.Tip="拖动：移动即抽这一帧（拖动中会丢帧，只认最后位置）"/>
              <TextBlock Grid.Column="2" Classes="field-value" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Text="{Binding PreviewTimeDisplay}"/>
            </Grid>

            <!--  ② 开始  -->
            <Grid ColumnDefinitions="72,*,64" IsVisible="{Binding RangeEnabled}">
              <TextBlock Grid.Column="0" Classes="field-label" Text="开始" VerticalAlignment="Center"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TimelineMax}"
                      Value="{Binding StartSeconds, Mode=TwoWay}"
                      TickFrequency="0.5" VerticalAlignment="Center"
                      ToolTip.Tip="剪辑区间的起点"/>
              <TextBlock Grid.Column="2" Classes="field-value" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Text="{Binding EditStart}"/>
            </Grid>

            <!--  ③ 结束  -->
            <Grid ColumnDefinitions="72,*,64" IsVisible="{Binding RangeEnabled}">
              <TextBlock Grid.Column="0" Classes="field-label" Text="结束" VerticalAlignment="Center"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TimelineMax}"
                      Value="{Binding EndSeconds, Mode=TwoWay}"
                      TickFrequency="0.5" VerticalAlignment="Center"
                      ToolTip.Tip="剪辑区间的终点；拖到最左 = 到末尾"/>
              <TextBlock Grid.Column="2" Classes="field-value" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Text="{Binding EditEnd}"/>
            </Grid>

          </StackPanel>

        </Grid>
      </Border>

      <!--  ==================== 右侧详情卡（可开合）  ====================  -->
      <!--  ⚠️ Avalonia 12 的 ScrollBar 是**覆盖式**（槽落在 ScrollViewer 右缘之外 8px）→
           卡片 Padding 右 8 + 滚动内容 Margin 右 8，滚动条才不会压在内容上（规范 §3.6）  -->
      <Border Grid.Column="1" Classes="detail-card" Padding="14,14,8,14"
              IsVisible="{Binding IsDetailVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0" Spacing="10">

            <TextBlock Classes="section-title" Text="任务类型（可多选）"/>
            <CheckBox Content="✂ 剪辑（截区间）" FontSize="12"
                      IsChecked="{Binding IsCut, Mode=TwoWay}"/>
            <CheckBox Content="🔁 转码（换编码 / 格式）" FontSize="12"
                      IsChecked="{Binding IsTranscode, Mode=TwoWay}"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="两个都勾 = 一条命令里既切区间又转码（ffmpeg 一次跑完）。"/>

            <Border Classes="divider-line"/>

            <!--  ==================== 剪辑设置（可折叠；不勾剪辑 → 折叠）  ====================  -->
            <Expander Header="✂ 剪辑设置" IsVisible="{Binding IsCut}"
                      IsExpanded="{Binding IsCutSectionExpanded, Mode=TwoWay}">
              <StackPanel Spacing="10" Margin="0,6,0,0">

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="开始时间（HH:MM:SS.mmm，拖上面的时间条也会同步）"/>
                  <TextBox Classes="code" Text="{Binding EditStart, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="结束时间（留空 = 到末尾）"/>
                  <TextBox Classes="code" Text="{Binding EditEnd, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="剪切预设"/>
                  <ComboBox ItemsSource="{Binding CutPresetOptions}"
                            SelectedValue="{Binding EditPresetId, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}"
                            HorizontalAlignment="Stretch" FontSize="12">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="重新编码时的 CRF（越小越清晰越大；18~28 常用）"/>
                  <TextBox Classes="code" Text="{Binding EditCrf, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="自定义 ffmpeg 参数（追加在预设之后，可覆盖预设）"/>
                  <TextBox Classes="code" Text="{Binding EditExtraArgs, Mode=TwoWay}" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="46"
                           PlaceholderText="例：-vf scale=1280:-2    或    -c:v libx265 -crf 26"/>
                  <TextBlock Classes="hint-text" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="ffmpeg 后写的同名参数会覆盖前面的，所以这里填 -c:v/-crf 之类能直接顶掉预设。"/>
                </StackPanel>

              </StackPanel>
            </Expander>

            <!--  ==================== 转码设置（可折叠；不勾转码 → 折叠）  ====================  -->
            <Expander Header="🔁 转码设置" IsVisible="{Binding IsTranscode}"
                      IsExpanded="{Binding IsTranscodeSectionExpanded, Mode=TwoWay}">
              <StackPanel Spacing="10" Margin="0,6,0,0">

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="编码（预设）"/>
                  <ComboBox ItemsSource="{Binding TranscodePresets}"
                            SelectedValue="{Binding EditTranscodePresetId, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}"
                            HorizontalAlignment="Stretch" FontSize="12">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="编码器"/>
                  <ComboBox SelectedIndex="{Binding EncoderIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" FontSize="12">
                    <ComboBoxItem Content="CPU（软件编码，兼容性最好）"/>
                    <ComboBoxItem Content="GPU（NVENC，N 卡）"/>
                  </ComboBox>
                  <TextBlock Classes="hint-text" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding EncoderPreview, StringFormat='实际会用：{0}'}"/>
                </StackPanel>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="容器 / 格式（决定输出文件后缀）"/>
                  <ComboBox ItemsSource="{Binding ContainerOptions}"
                            SelectedValue="{Binding EditContainer, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" FontSize="12"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                  <StackPanel Grid.Column="0" Classes="field">
                    <TextBlock Classes="field-label" Text="分辨率宽（0 = 按比例）"/>
                    <TextBox Classes="code" Text="{Binding EditTargetWidth, Mode=TwoWay}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="0,18,0,0"/>
                  <StackPanel Grid.Column="2" Classes="field">
                    <TextBlock Classes="field-label" Text="高（0 = 不改）"/>
                    <TextBox Classes="code" Text="{Binding EditTargetHeight, Mode=TwoWay}"/>
                  </StackPanel>
                </Grid>

                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="码率模式"/>
                  <ComboBox SelectedIndex="{Binding BitrateModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" FontSize="12">
                    <ComboBoxItem Content="CRF（恒定质量，推荐）"/>
                    <ComboBoxItem Content="目标码率（如 5000k / 5M）"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Classes="field" IsVisible="{Binding UseCrf}">
                  <TextBlock Classes="field-label" Text="CRF（0 = 用预设值；18~28 常用，越小越清晰）"/>
                  <TextBox Classes="code" Text="{Binding EditTranscodeCrf, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Classes="field" IsVisible="{Binding !UseCrf}">
                  <TextBlock Classes="field-label" Text="目标码率（如 5000k / 5M）"/>
                  <TextBox Classes="code" Text="{Binding EditTargetBitrate, Mode=TwoWay}"
                         PlaceholderText="5000k"/>
                </StackPanel>

              </StackPanel>
            </Expander>

            <Border Classes="divider-line"/>

            <!--  ==================== 输出  ====================  -->
            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="输出文件（留空 = 自动命名，绝不覆盖已有文件）"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Classes="code" Text="{Binding EditOutput, Mode=TwoWay}"/>
                <Button Grid.Column="1" x:Name="PickOutputBtn" Classes="ghost" Content="📂" Margin="4,0,0,0"
                        Padding="8,4"/>
              </Grid>
            </StackPanel>

            <!--  ==================== 命令（自动生成 + 可手改）  ====================  -->
            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="将要执行的命令（改参数即时刷新，与发送到批处理的那条同源）"/>
              <SelectableTextBlock Classes="field-value" Text="{Binding CommandPreview}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Classes="filter-btn" Content="📋 复制命令" Command="{Binding CopyCommandLineCommand}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="ffmpeg 参数（可手动编辑；不含 ffmpeg.exe 与输出路径）"/>
              <TextBox Classes="code" Text="{Binding EditArgs, Mode=TwoWay}" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="52"/>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Classes="ghost" Content="↺ 重置为自动" Command="{Binding ResetCommandCommand}"
                        IsVisible="{Binding IsArgsEdited}"
                        ToolTip.Tip="丢弃手改，恢复成由参数自动生成"/>
                <TextBlock Classes="hint-text" VerticalAlignment="Center" IsVisible="{Binding IsArgsEdited}"
                           Text="✎ 已手改：执行时以这里为准"/>
              </StackPanel>
            </StackPanel>

            <Border Classes="divider-line"/>

            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="这一页只负责「制定一条任务」：编好点「➡ 发送到批处理」入队，真正运行在「批量处理」页。剪辑默认 -c copy 不重新编码（秒级、无损，但起止会就近对齐关键帧）；要精确到帧就选「重新编码」。"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="⚠️ GPU 编码需要 N 卡 + 支持 NVENC 的 ffmpeg 版本；机器不支持时 ffmpeg 会直接报错，页面会如实显示错误原因。"/>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</UserControl>
