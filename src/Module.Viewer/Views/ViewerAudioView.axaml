<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NewToys.UI.Viewers"
             x:Class="NewToys.Viewer.Views.ViewerAudioView">
  <!--
    查看器页内容（文本阅读 / 图片查看 / 音频播放三页**共用同一份 XAML**）：
    条目条 + 渲染区（单图宿主 / 分屏网格叠放）+ 章节规则浮层 + 历史浮层。
    🔴 三份 XAML 必须保持完全一致（只有 x:Class 不同）：基类 ViewerPageBase 按 x:Name 取控件，
       少一个就抛「ViewerPage 的 XAML 缺少名为 X 的控件」。
    🔴 工具条由 Shell 的 ToolbarHost 渲染（VM 实现 IToolbarSource），本页 ⛔ 不写 Border.toolbar。
    🔴 渲染器全部来自 NewToys.UI（阅读器 / 图片 / 音频外壳），本模块只做分派与持久化。
  -->
  <UserControl.Styles>
    <!--  条目压到 20px 行高（默认项高撑得整条过高）  -->
    <Style Selector="ListBox#ArchiveList ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!--  条目条：压缩包内图片 / 同目录图片  -->
    <Border Grid.Row="0"
            Background="{DynamicResource ContentHeaderBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsArchive}"
            Padding="10,2">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <TextBlock VerticalAlignment="Center"
                   Classes="hint-text"
                   FontSize="11"
                   Margin="0,0,10,0"
                   Text="{Binding ArchiveInfo}" />
        <!--  节跳转：同目录图多到需要分节时才出现（每 100 张一节）  -->
        <ComboBox x:Name="SectionBox"
                  Grid.Column="1"
                  Width="86"
                  Height="22"
                  MinHeight="0"
                  Padding="6,0"
                  FontSize="11"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasSections}"
                  ItemsSource="{Binding SectionItems}"
                  SelectionChanged="OnSectionSelected"
                  ToolTip.Tip="每 100 张一节：选一节直接跳过去" />
        <ListBox x:Name="ArchiveList"
                 Grid.Column="2"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding ArchiveEntries}"
                 SelectionChanged="OnArchiveSelected">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <!--  节标：每 100 张一条竖线 + 范围（仅节首条可见）  -->
                <Border Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSectionStart}"
                        Background="{DynamicResource DividerBrush}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           Classes="hint-text"
                           IsVisible="{Binding IsSectionStart}"
                           Text="{Binding SectionLabel}" />
                <TextBlock MaxWidth="200"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!--  渲染区：单图宿主与分屏网格叠放，同一时刻只显示一个（切换由基类控制 IsVisible）  -->
    <Grid Grid.Row="1">
      <ui:ViewerHost x:Name="Host" />
      <Grid x:Name="SplitGrid"
            IsVisible="False"
            Background="{DynamicResource ContentBrush}" />
    </Grid>

    <!-- 章节规则浮层 -->
    <Border x:Name="RulePanel"
            Grid.Row="1"
            HorizontalAlignment="Right"
            Width="400"
            IsVisible="False"
            Background="{DynamicResource ContentHeaderBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <TextBlock Text="章节识别规则"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <ListBox x:Name="RuleList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Classes="hint-text"
                           Text="{Binding Pattern}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
          <TextBox x:Name="RuleNameBox" PlaceholderText="规则名（可空）" />
          <TextBox x:Name="RulePatternBox" PlaceholderText="正则，例如 ^\s*第\S+章" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="primary" Click="OnAddRule" Content="添加" />
            <Button Classes="ghost" Click="OnRemoveRule" Content="删除选中" />
            <Button Classes="ghost" Click="OnCloseRules" Content="收起" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6" Margin="0,10,0,0">
          <TextBlock Classes="hint-text" Text="试跑（贴一段样本文本，看能切出哪些标题）" />
          <TextBox x:Name="SampleBox"
                   Height="90"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   PlaceholderText="第一章 起点&#x0a;Chapter 2&#x0a;1、测试" />
          <Button Classes="ghost" Click="OnTestRules" Content="试跑当前正则" />
          <ScrollViewer Height="110">
            <TextBlock x:Name="TestResult" Classes="hint-text" TextWrapping="Wrap" />
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>

    <!--  历史浮层：工具条「🕘 历史」展开；点一项重新打开，打开后自动收起  -->
    <Border x:Name="HistoryPanel"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="320"
            MaxHeight="320"
            Margin="0,6,12,0"
            IsVisible="{Binding IsHistoryOpen}"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="6"
            BoxShadow="0 8 24 0 #55000000">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="10,7,6,4">
          <TextBlock Text="最近打开"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="ghost"
                    FontSize="11"
                    Padding="6,2"
                    Content="清空"
                    Command="{Binding ClearRecentCommand}" />
            <Button Classes="ghost"
                    FontSize="11"
                    Padding="6,2"
                    Content="✕"
                    Command="{Binding ToggleHistoryCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" MaxHeight="260" Padding="0,0,0,6">
          <ListBox x:Name="RecentList"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding RecentItems}"
                   SelectionChanged="OnRecentSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="11"
                           MaxWidth="280"
                           Text="{Binding}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
