<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NewToys.Tests</RootNamespace>
  </PropertyGroup>

  <!--  🔴 测试程序⛔ 落 artifacts\release\：那里是交付产物区，接受 accept.ps1 的产物核对
        （NewToys.exe + Modules\ 模块数），多出 TestHost / 测试 DLL 会污染交付目录。
        Debug 走 Directory.Build.props 的 artifacts\bin\<项目名>\，天然隔离。        -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutDir>$(RepoRoot)artifacts\tests\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 被测对象：包管理器输出解析（internal ⇒ 靠 Module.SystemTools.csproj 的 InternalsVisibleTo 打开） -->
    <ProjectReference Include="../Module.ScriptManager/Module.ScriptManager.csproj" />
    <!--  NT-096：软件包输出解析（FixedWidthTable / TsvRows / PackageOutputParser）随软件包页迁到系统工具。 -->
    <ProjectReference Include="../Module.SystemTools/Module.SystemTools.csproj" />
    <!--  列表页公共基类（ListPageViewModelBase / ListColumn / FilterClause）在 Shared；
          分页溢出、隐藏列占位、锁定列不可拖这些判据是纯逻辑，必须能独立断言。 -->
    <ProjectReference Include="../Shared/Shared.csproj" />
    <!--  视频工具的 ffmpeg 命令拼装（BuildCutArgs / BuildTranscodeArgs / 滤镜助手）：纯静态函数，
          拼错不报错、只产出坏文件，必须能独立断言。 -->
    <ProjectReference Include="../Module.VideoTools/Module.VideoTools.csproj" />
    <!--  页面类型索引（PageCatalog）：索引语义走样 = 页面空白 / 错页，运行期不报错，必须能独立断言。 -->
    <ProjectReference Include="../Core/Core.csproj" />
    <!--  书源规则求值器（RuleEvaluator / RuleSyntax / JsonPathLite）：规则写错只表现为「这个字段空」，
          运行期不报错，必须逐种语法元件独立断言。 -->
    <ProjectReference Include="../Module.Reading/Module.Reading.csproj" />
  </ItemGroup>

</Project>
