<UserControl
    x:Class="NewToys.VideoTools.Views.VideoListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:NewToys.VideoTools.Views">
    <!--
        v3.7 三列布局：根 Grid 只分「列表列 | 详情列」；状态行 / 工具条 / 筛选条**都收进列表列**，
        详情卡在右列、从页面顶到底（加上左树就是三列）。
    -->
    <Grid Margin="12" ColumnDefinitions="*,Auto">

        <!--  ==================== 列表列（状态行 / 工具条 / 筛选条 / 列表）  ====================  -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

            <!--
                操作行已取消（v3.9）：状态文本改由 Shell 底部状态栏统一显示（IStatusProvider）。
                Row0 保持空着（Auto → 高度 0），不动下面各行的行号。
            -->

            <!--
                ==================== 工具条  ====================
                目录**不来自设置**：每次手动选（v1.34 与设置解绑）；选过的目录只在本次运行内记住。
            -->
            <Border Grid.Row="1" Classes="toolbar">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBox
                            x:Name="FolderBox"
                            Width="300"
                            Margin="0,0,8,6"
                            PlaceholderText="如 D:\Videos（回车即扫描）"
                            Text="{Binding Folder, Mode=TwoWay}" />
                        <!--
                            v3.16：「视频库(.db)…」从本下拉里拿掉，独立成右边的「🗄 导入视频库(.db)」按钮
                            —— 文件夹路径天天变、库文件路径相对固定，两者不该共用一个入口。
                        -->
                        <SplitButton
                            x:Name="ImportSplit"
                            Margin="0,0,8,6"
                            Classes="ghost"
                            Content="📂 导入"
                            ToolTip.Tip="导入视频：选文件夹扫描 / 选单个视频文件追加；读视频库(.db) 用右边的「🗄 导入视频库(.db)」">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem
                                        x:Name="ImportFolderItem"
                                        Header="📁 文件夹…"
                                        ToolTip.Tip="选一个目录扫描（替换当前列表）" />
                                    <MenuItem
                                        x:Name="ImportFilesItem"
                                        Header="🎞 视频文件…"
                                        ToolTip.Tip="选一个或多个视频文件，追加进当前列表" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <!--  v3.19 / NT-011：删「🔍 扫描」按钮 —— 选中文件夹（📂 导入 → 文件夹…）或目录框回车即扫描，
                              独立扫描按钮冗余；「🔄 刷新」仍在（强制重扫）。  -->
                        <Button
                            Margin="0,0,8,6"
                            Classes="ghost"
                            Command="{Binding RefreshCommand}"
                            Content="🔄 刷新"
                            IsEnabled="{Binding !IsBusy}" />
                        <CheckBox
                            Margin="0,0,8,6"
                            Content="含子目录"
                            FontSize="12"
                            IsChecked="{Binding Recursive, Mode=TwoWay}" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,6"
                            PlaceholderText="按文件名 / 类型过滤…"
                            Text="{Binding SearchText, Mode=TwoWay}" />
                        <Button
                            Margin="0,0,8,6"
                            Classes="ghost"
                            Command="{Binding LoadAllMediaInfoCommand}"
                            Content="🔎 读取全部媒体信息"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="对还没有媒体信息的视频并发跑 ffprobe（并发度见「设置 → 通用」的最大并发数）；读完写进 data\newtoys.db 缓存，下次扫描直接命中" />

                        <!--  视频数据库（§6.4.3）：读外部 .db / 当前列表入库  -->
                        <Border
                            Width="1"
                            Height="20"
                            Margin="0,0,8,0"
                            Classes="divider-line" />
                        <Button
                            x:Name="ImportCatalogBtn"
                            Margin="0,0,4,6"
                            Classes="ghost"
                            Content="🗄 导入视频库(.db)"
                            ToolTip.Tip="点一下就挑一个视频库 .db 文件，把里面的记录读回列表（替换当前列表）；对话框默认定位到「设置 → 路径配置 → 导入导出默认目录」" />
                        <Button
                            Margin="0,0,4,6"
                            Classes="ghost"
                            Command="{Binding AddToCatalogCommand}"
                            Content="💾 加入视频库"
                            ToolTip.Tip="把当前列表（整个扫描结果）写进 SQLite 视频库；只存列表已有信息，未读的字段留空" />

                        <!--  多选 → 批量送进任务页（v1.35）  -->
                        <Border
                            Width="1"
                            Height="20"
                            Margin="0,0,8,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,6"
                            Classes="primary"
                            Command="{Binding SendToTranscodeCommand}"
                            IsEnabled="{Binding HasChecked}"
                            ToolTip.Tip="把勾选的文件批量生成**转码**任务，送到「批量处理」页（只是建任务，不立刻跑）">
                            <TextBlock Text="{Binding CheckedCount, StringFormat='➡ 批量处理 ({0})'}" />
                        </Button>
                        <Button
                            Margin="0,0,8,6"
                            Classes="ghost"
                            Command="{Binding SendToCutCommand}"
                            IsEnabled="{Binding HasChecked}"
                            ToolTip.Tip="把勾选的文件送进「视频预览」页，边看画面边定剪辑区间">
                            <TextBlock Text="{Binding CheckedCount, StringFormat='➡ 视频预览 ({0})'}" />
                        </Button>

                        <!--  v3.15 §6.4.9：收藏只从本页送过去（先入视频库的才能收藏）  -->
                        <Border
                            Width="1"
                            Height="20"
                            Margin="0,0,8,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,4,6"
                            Classes="ghost"
                            Command="{Binding AddToFavoritesCommand}"
                            Content="★ 收藏"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="把勾选的（一个都没勾就用当前选中的）加入「视频收藏」页；收藏必须来自视频库 —— 还没入库的会提示先点「💾 加入视频库」" />

                        <!--  v3.16 §6.4.11：清除列表（≈ 浏览器的无缓存刷新）  -->
                        <Border
                            Width="1"
                            Height="20"
                            Margin="0,0,8,0"
                            Classes="divider-line" />
                        <Button
                            Margin="0,0,8,6"
                            Classes="ghost"
                            Command="{Binding ClearListCommand}"
                            Content="🧹 清除列表"
                            ToolTip.Tip="清空当前列表（含勾选 / 筛选），回到空态；⛔ 不删除任何视频文件、不动视频库" />
                        <!--  v3.20 §6.4.6：「🏷 管理标签」从工具条移入**详情卡**（标签编辑区同行右侧）  -->
                    </WrapPanel>
                    <Button
                        Grid.Column="1"
                        Classes="detail-toggle"
                        Command="{Binding ToggleDetailCommand}"
                        ToolTip.Tip="显示 / 隐藏右侧详情（展开时自动选中第一项）">
                        <Panel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding !IsDetailVisible}"
                                Text="❯" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsVisible="{Binding IsDetailVisible}"
                                Text="❮" />
                        </Panel>
                    </Button>
                </Grid>
            </Border>


            <!--  ==================== 列表本体：可排序表头 + 列表（右键出更多功能）  ====================  -->
            <Border
                Grid.Row="3"
                Padding="0"
                Classes="card">
                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0" Classes="list-header">
                        <!--  v3.20 §6.4.15：IsResizable = 表头列边界可拖动手动调列宽（事件在 code-behind 转给 VM）  -->
                        <v:ColumnGrid
                            x:Name="HeaderGrid"
                            ColumnSpecs="{Binding VisibleColumnSpecs}"
                            IsResizable="True"
                            LockedColumns="{Binding LockedColumnMask}">
                            <!--
                                第一列 = 行首勾选框（多选，用来「发送到转码 / 剪切」）。
                                v3.16.1：表头改用**原生 CheckBox**（三态：全勾 ✓ / 部分 ■ / 没勾）——
                                之前用字符"☑"，字体渲染成一坨深色块，跟行内勾选框风格完全不搭。
                                点它 = 全选/取消（已全勾则取消）；右键 = 菜单（全选 / 取消选择 / 反选）。
                                外面套一层透明 Border：整个 34px 列格都是右键热区（列太窄，框本身不好点）。
                                ⚠️ ContextMenu 挂在 Border 上，code-behind 同步 DataContext 用 HeaderCheckHost。
                            -->
                            <Border
                                x:Name="HeaderCheckHost"
                                Grid.Column="0"
                                Background="Transparent"
                                Cursor="Hand"
                                IsEnabled="{Binding HasItems}"
                                IsVisible="{Binding IsPickVisible}"
                                ToolTip.Tip="点 = 全选 / 取消；右键 = 全选 / 取消选择 / 反选">
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleAllCommand}"
                                    IsChecked="{Binding AllCheckedState, Mode=OneWay}" />
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding CheckAllCommand}" Header="☑ 全选（当前列表）" />
                                        <MenuItem Command="{Binding UncheckAllCommand}" Header="☐ 取消选择" />
                                        <MenuItem Command="{Binding InvertCheckedCommand}" Header="🔄 反选" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <Button
                                Grid.Column="1"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Name"
                                Content="{Binding NameHeader}"
                                IsVisible="{Binding IsNameVisible}"
                                ToolTip.Tip="点一下按名称排序（同一列再点一次反向）" />
                            <Button
                                Grid.Column="2"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Type"
                                Content="{Binding TypeHeader}"
                                IsVisible="{Binding IsTypeVisible}" />
                            <Button
                                Grid.Column="3"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Size"
                                Content="{Binding SizeHeader}"
                                IsVisible="{Binding IsSizeVisible}" />
                            <Button
                                Grid.Column="4"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Duration"
                                Content="{Binding DurationHeader}"
                                IsVisible="{Binding IsDurationVisible}" />
                            <Button
                                Grid.Column="5"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Resolution"
                                Content="{Binding ResolutionHeader}"
                                IsVisible="{Binding IsResolutionVisible}" />
                            <Button
                                Grid.Column="6"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Codec"
                                Content="{Binding CodecHeader}"
                                IsVisible="{Binding IsCodecVisible}" />
                            <Button
                                Grid.Column="7"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Bitrate"
                                Content="{Binding BitrateHeader}"
                                IsVisible="{Binding IsBitrateVisible}" />
                            <Button
                                Grid.Column="8"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Modified"
                                Content="{Binding ModifiedHeader}"
                                IsVisible="{Binding IsModifiedVisible}" />
                            <!--  v3.15 §6.4.8 扩充列（列索引 9~15，与 Columns 元数据一一对应）  -->
                            <Button
                                Grid.Column="9"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Tags"
                                Content="{Binding TagsHeader}"
                                IsVisible="{Binding IsTagsVisible}" />
                            <Button
                                Grid.Column="10"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Fps"
                                Content="{Binding FpsHeader}"
                                IsVisible="{Binding IsFpsVisible}" />
                            <Button
                                Grid.Column="11"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Container"
                                Content="{Binding ContainerHeader}"
                                IsVisible="{Binding IsContainerVisible}" />
                            <Button
                                Grid.Column="12"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Audio"
                                Content="{Binding AudioHeader}"
                                IsVisible="{Binding IsAudioVisible}" />
                            <Button
                                Grid.Column="13"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Path"
                                Content="{Binding PathHeader}"
                                IsVisible="{Binding IsPathVisible}" />
                            <Button
                                Grid.Column="14"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Created"
                                Content="{Binding CreatedHeader}"
                                IsVisible="{Binding IsCreatedVisible}" />
                            <Button
                                Grid.Column="15"
                                Classes="col-header"
                                Command="{Binding SortCommand}"
                                CommandParameter="Favorite"
                                Content="{Binding FavoriteHeader}"
                                IsVisible="{Binding IsFavoriteVisible}"
                                ToolTip.Tip="★ = 已收藏（真值在 video_favorites 表）" />
                            <v:ColumnGrid.ContextMenu>
                                <ContextMenu>
                                <MenuItem Header="🔎 筛选" ItemsSource="{Binding QuickFilters}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                      <Setter Property="Header" Value="{Binding Label}"/>
                                      <Setter Property="Command" Value="{Binding Command}"/>
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                    <Separator />
                                    <!--  ⚠️ IsChecked 必须显式 Mode=OneWay：翻转由 ToggleColumnCommand 独家负责  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Pick"
                                        Header="勾选框"
                                        IsChecked="{Binding IsPickVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Name"
                                        Header="名称"
                                        IsEnabled="False" ToolTip.Tip="标识列固定显示，不可隐藏" IsChecked="{Binding IsNameVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Type"
                                        Header="类型"
                                        IsChecked="{Binding IsTypeVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Size"
                                        Header="大小"
                                        IsChecked="{Binding IsSizeVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Duration"
                                        Header="时长"
                                        IsChecked="{Binding IsDurationVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Resolution"
                                        Header="分辨率"
                                        IsChecked="{Binding IsResolutionVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Codec"
                                        Header="编码"
                                        IsChecked="{Binding IsCodecVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Bitrate"
                                        Header="码率"
                                        IsChecked="{Binding IsBitrateVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Modified"
                                        Header="修改时间"
                                        IsChecked="{Binding IsModifiedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Tags"
                                        Header="标签"
                                        IsChecked="{Binding IsTagsVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Fps"
                                        Header="帧率"
                                        IsChecked="{Binding IsFpsVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Container"
                                        Header="容器格式"
                                        IsChecked="{Binding IsContainerVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Audio"
                                        Header="音频编码"
                                        IsChecked="{Binding IsAudioVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Path"
                                        Header="路径"
                                        IsChecked="{Binding IsPathVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Created"
                                        Header="创建时间"
                                        IsChecked="{Binding IsCreatedVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                    <MenuItem
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="Favorite"
                                        Header="已收藏"
                                        IsChecked="{Binding IsFavoriteVisible, Mode=OneWay}"
                                        ToggleType="CheckBox" />
                                </ContextMenu>
                            </v:ColumnGrid.ContextMenu>
                        </v:ColumnGrid>
                    </Border>

                    <ListBox
                        x:Name="VideoList"
                        Grid.Row="1"
                        Classes="list-page"
                        ItemsSource="{Binding Videos}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        SelectionMode="Single">
                        <!--  v3.19 / NT-011：显式虚拟化 —— 数千视频只实例化可见行，滚动不卡（默认即是，这里写明意图）。  -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <!--  双击 = 播放；右键 = 更多功能  -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <Separator />
                                <MenuItem Command="{Binding PlayCommand}" Header="▶ 播放" />
                                <MenuItem Command="{Binding RevealInExplorerCommand}" Header="📂 在文件管理器中定位" />
                                <MenuItem Command="{Binding CopyPathCommand}" Header="📋 复制完整路径" />
                                <MenuItem Command="{Binding CopyFfmpegCommand}" Header="🧪 复制 ffmpeg 转码命令" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding SendToTranscodeCommand}"
                                    Header="➡ 发送到转码（勾选的）"
                                    IsEnabled="{Binding HasChecked}" />
                                <MenuItem
                                    Command="{Binding SendToCutCommand}"
                                    Header="➡ 发送到剪切（勾选的）"
                                    IsEnabled="{Binding HasChecked}" />
                                <Separator />
                                <MenuItem Command="{Binding LoadMediaInfoCommand}" Header="🔎 读取媒体信息（ffprobe）" />
                                <MenuItem
                                    Command="{Binding LoadAllMediaInfoCommand}"
                                    Header="🔎 读取全部媒体信息（多线程）"
                                    IsEnabled="{Binding IsNotBusy}" />
                                <Separator />
                                <MenuItem Command="{Binding RenameCommand}" Header="✏ 重命名…" />
                                <MenuItem Command="{Binding DeleteCommand}" Header="🗑 删除（移入回收站）…" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!--  行与表头共用同一份 VisibleColumnSpecs（规范 3.6 对齐铁律①）；每格 IsVisible 跟随列显隐。  -->
                                <v:ColumnGrid ColumnSpecs="{Binding $parent[ListBox].DataContext.VisibleColumnSpecs}">
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[ListBox].DataContext.ItemCheckedCommand}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsPickVisible}"
                                        ToolTip.Tip="勾上后可以批量「发送到转码 / 剪切」" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsNameVisible}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsTypeVisible}"
                                        Text="{Binding Extension}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsSizeVisible}"
                                        Text="{Binding SizeDisplay}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Classes="list-cell accent"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsDurationVisible}"
                                        Text="{Binding DurationDisplay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsResolutionVisible}"
                                        Text="{Binding ResolutionDisplay}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCodecVisible}"
                                        Text="{Binding CodecDisplay}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsBitrateVisible}"
                                        Text="{Binding BitRateDisplay}" />
                                    <TextBlock
                                        Grid.Column="8"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsModifiedVisible}"
                                        Text="{Binding ModifiedDisplay}" />
                                    <!--  v3.15 §6.4.8 扩充列  -->
                                    <!--  v3.20 §6.4.6：标签列改**色片（chip）**横排；超宽裁剪不换行（⛔ 不撑高行）  -->
                                    <ItemsControl
                                        Grid.Column="9"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsTagsVisible}"
                                        ItemsSource="{Binding TagChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="tag-chip" Background="{Binding SoftBrush}" BorderBrush="{Binding Brush}">
                                                    <TextBlock Classes="tag-chip-text" Foreground="{Binding Brush}" Text="{Binding Name}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Grid.Column="10"
                                        Classes="list-cell primary"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsFpsVisible}"
                                        Text="{Binding FpsDisplay}" />
                                    <TextBlock
                                        Grid.Column="11"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsContainerVisible}"
                                        Text="{Binding ContainerDisplay}" />
                                    <TextBlock
                                        Grid.Column="12"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsAudioVisible}"
                                        Text="{Binding AudioCodecDisplay}" />
                                    <TextBlock
                                        Grid.Column="13"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsPathVisible}"
                                        Text="{Binding FullPath}" />
                                    <TextBlock
                                        Grid.Column="14"
                                        Classes="list-cell"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsCreatedVisible}"
                                        Text="{Binding CreatedDisplay}" />
                                    <TextBlock
                                        Grid.Column="15"
                                        Classes="list-cell accent"
                                        IsVisible="{Binding $parent[ListBox].DataContext.IsFavoriteVisible}"
                                        Text="{Binding FavoriteDisplay}" />
                                </v:ColumnGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>

        <!--  右：选中视频的详情；宽度由共享样式 Border.detail-card 给 → 收起时整列不占位  -->
        <Border
            Grid.Column="1"
            Classes="detail-card"
            IsVisible="{Binding IsDetailVisible}">
            <Grid RowDefinitions="Auto,*">

                <!--  v3.19 / NT-011：详情卡操作按钮整排删除 —— 播放/定位/信息/路径/发送/重命名/删除都与工具条 + 右键菜单重复，
                      详情卡只留「只读信息 + 可编辑标签 + 标签管理（v3.20 移入）」。  -->
                <TextBlock
                    Grid.Row="0"
                    Classes="section-title"
                    Text="选中视频"
                    IsVisible="{Binding HasSelection}" />

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">

                        <TextBlock
                            Classes="empty-hint"
                            IsVisible="{Binding !HasSelection}"
                            Text="扫描一个目录后，在左侧列表里选中视频：这里会显示完整路径、大小、修改时间，以及分辨率 / 编码 / 码率 / 时长 —— 足够判断要不要剪辑或转码。勾上几行还能批量「发送到转码 / 剪切」。" />

                        <!--
                            §6.4.7 文件名**可编辑**：回车 / 失焦提交 → VideoFileService.RenameToAsync
                            （复用防穿越 + 同名检查）→ 同步 video_catalog / video_favorites 的 path；⛔ 不整目录重扫。
                            提交由代码后置（NameBox 的 KeyDown / LostFocus）触发，详情卡里不放按钮（规范 §6.4.1 第 3 条）。
                        -->
                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="文件名（可改 · 回车 / 失焦提交）" />
                            <TextBox
                                x:Name="NameBox"
                                FontSize="12"
                                Text="{Binding EditName, Mode=TwoWay}" />
                        </StackPanel>

                        <!--
                            §6.4.6 / v3.21：标签**只能选，不能手打** —— 色片来源 = 标签库（video_tags），
                            点一下 = 给当前视频打上 / 取消（即时写 video_catalog.tags，⛔ 没有保存按钮、⛔ 没有输入框）。
                            已打上 = 本色彩片；未打上 = 淡显（点它就打上）。
                            没入视频库的项会提示先点工具条「💾 加入视频库」。
                        -->
                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="field-label" Text="标签（点色片打上 / 取消）" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Classes="ghost"
                                    FontSize="11"
                                    Padding="6,2"
                                    Content="🏷 管理标签"
                                    Command="{Binding OpenTagManagerCommand}"
                                    ToolTip.Tip="标签库：搜索 / 改名 / 删除 / 新建（新建会存进标签库，改名或删除会作用到所有用到该标签的视频）" />
                            </Grid>
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding TagPicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,4,4"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleTagCommand}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            ToolTip.Tip="点一下打上 / 取消这个标签">
                                            <Border
                                                Classes="tag-chip"
                                                Classes.off="{Binding !IsApplied}"
                                                Background="{Binding SoftBrush}"
                                                BorderBrush="{Binding Brush}">
                                                <TextBlock
                                                    Classes="tag-chip-text"
                                                    Classes.off="{Binding !IsApplied}"
                                                    Foreground="{Binding Brush}"
                                                    Text="{Binding Name}" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="完整路径" />
                            <SelectableTextBlock Classes="field-value" Text="{Binding Selected.FullPath}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="类型 / 大小" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="field-value" Text="{Binding Selected.Extension}" />
                                <TextBlock Classes="field-value" Text="{Binding Selected.SizeDisplay}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="时长" />
                            <TextBlock Classes="field-value" Text="{Binding Selected.DurationDisplay}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="分辨率" />
                            <TextBlock Classes="field-value" Text="{Binding Selected.ResolutionDisplay}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="编码格式" />
                            <TextBlock Classes="field-value" Text="{Binding Selected.CodecDisplay}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="码率" />
                            <TextBlock Classes="field-value" Text="{Binding Selected.BitRateDisplay}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="修改时间" />
                            <TextBlock Classes="field-value" Text="{Binding Selected.ModifiedDisplay}" />
                        </StackPanel>

                        <StackPanel Classes="field" IsVisible="{Binding HasSelection}">
                            <TextBlock Classes="field-label" Text="媒体信息" />
                            <TextBlock
                                Classes="field-value"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding Selected.MediaStatus}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  v3.19 / NT-011：标签管理弹层（遮罩 + 居中卡片），盖在列表 + 详情之上  -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding IsTagManagerOpen}">
            <Border Classes="card" Width="430" MaxHeight="540" Padding="20" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="🏷 管理标签" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Classes="hint-text" TextWrapping="Wrap"
                               Text="改名 / 删除会作用到所有用到该标签的视频；「新建」直接存进标签库（还没用到任何视频也会留着）。"/>
                    <!--  v3.21：标签多了要能找 —— 按名称过滤（空 = 全部）  -->
                    <TextBox PlaceholderText="搜索标签…" Text="{Binding TagManagerFilter, Mode=TwoWay}"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TagManagerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!--  v3.20：行首色点与列表 / 详情卡 chip 同源同色  -->
                                            <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding CountDisplay}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" Content="✏ 改名" Margin="0,0,6,0"
                                                Command="{Binding $parent[UserControl].DataContext.RenameTagCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="2" Classes="danger-btn" Content="🗑" Padding="8,3"
                                                Command="{Binding $parent[UserControl].DataContext.DeleteTagCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Margin="0,0,8,0" PlaceholderText="新标签名…"
                                 Text="{Binding NewTagInput, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Classes="primary" Content="＋ 新建" Command="{Binding CreateTagCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="ghost" Content="🔄 刷新" Command="{Binding RefreshTagManagerCommand}"/>
                        <Button Grid.Column="2" Classes="ghost" Content="关闭" Command="{Binding CloseTagManagerCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
