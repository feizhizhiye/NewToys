<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NewToys.ScriptManager</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!--  NT-068：模块自建的观测库 data\script\script.db（不复用 Core 的 SqliteDatabase）  -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <!--  NT-063：ColumnGrid 等 View 层件来自 NewToys.UI（模块禁互引 / 禁引 Shell ⇒ 控件库是唯一解）  -->
    <ProjectReference Include="../UI/NewToys.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--  单元测试要测包管理器输出解析（FixedWidthTable / TsvRows / PackageOutputParser 均为 internal）。
          只对测试项目开放，⛔ 不改成 public —— 这三个是实现细节，不是模块对外契约。  -->
    <InternalsVisibleTo Include="NewToys.Tests" />
  </ItemGroup>
</Project>
