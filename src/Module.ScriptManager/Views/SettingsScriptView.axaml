<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.ScriptManager.Views"
             x:Class="NewToys.ScriptManager.Views.SettingsScriptView">
  <!--
    v3.64 / NT-061「脚本管理器」模块设置页（View/VM 归本模块，自行注册进 settings 分组，Key = settings-script / Order 110）。
    v3.65 / NT-062：三个解释器路径已回迁应用级（「设置 → 路径与配置」），本页只剩**脚本目录**一项。
    v3.65 / NT-062②：原**「软件源」页（Key settings-package）并入本页**（需求 §6.5）——
      不再是独立菜单项，内容以子控件形式内嵌在下方同一滚动区里（自带 ScrollViewer 已去掉，⛔ 不嵌套滚动）。
    规范 §4.9：路径 = 即时生效（失焦即落盘，⛔ 无保存按钮）；无效路径 ⇒ 底栏红字 + ⛔ 不写盘。
    状态文本由 Shell 底部状态栏统一显示（IStatusProvider），页脚也留一行便于就地查看。
    窄界面基线（NT-053）：根 ScrollViewer + 内容 MaxWidth 760 ⇒ 最窄 960×640（内容宽 720）可用。
  -->
  <Grid RowDefinitions="Auto,*">

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

        <!--  ============ ① 脚本目录 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="脚本目录" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <StackPanel Classes="field">
              <TextBlock Classes="field-label" Text="脚本目录（留空 = 默认目录）"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="360" PlaceholderText="留空 = 默认脚本目录"
                         Text="{Binding ScriptsFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <Button Classes="ghost" Content="📂 选目录…" Command="{Binding PickScriptsFolderCommand}"/>
                <Button Classes="ghost" Content="↺ 用默认" Command="{Binding ResetScriptsFolderCommand}"/>
              </StackPanel>
              <TextBlock Classes="hint-text" TextWrapping="Wrap"
                         Text="{Binding ScriptsFolderEffective, StringFormat='生效目录：{0}'}"/>
              <TextBlock Classes="hint-text" TextWrapping="Wrap"
                         Text="{Binding DefaultScriptsFolder, StringFormat='默认目录：{0}（用应用根 —— 多配置共享同一份脚本）'}"/>
            </StackPanel>

            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="「脚本库」页工具条上的「脚本目录」框和这里是同一份值：那条框改完（回车 / 点开别处）也写进本页的设置文件。"/>
          </StackPanel>
        </Border>

        <!--  ============ ② 说明 ============  -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="📄 设置文件" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{Binding ConfigFilePath}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="它在 config 目录下 —— 「设置 → 数据管理」的备份 / 导入会一起覆盖它。"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="三个解释器路径（pwsh / Python / Windows PowerShell 5.1）属于「运行环境」（应用级，跨配置共享），在「设置 → 路径与配置」页配置。"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap" Text="{Binding StatusText, StringFormat='状态：{0}'}"/>
          </StackPanel>
        </Border>

        <!--  ============ ③ 软件源（v3.65 / NT-062：原独立菜单项 settings-package 并入本页） ============
              DataContext 绑到 PackageSourceViewModel —— 子控件内部的所有绑定照旧（$parent[UserControl] 命中的是它自己）。  -->
        <Border Classes="card" Padding="0">
          <StackPanel Spacing="0" Margin="18,14">
            <TextBlock Text="软件源（winget）" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Classes="hint-text" TextWrapping="Wrap"
                       Text="原「设置 → 软件源」页 v3.65 起并入本页（不再单独占菜单项）；数据仍落 config\package.json，会被「数据管理」的备份一起带走。"/>
          </StackPanel>
        </Border>

        <v:PackageSourceView DataContext="{Binding PackageSource}" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
