<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.WebTools.Views.SystemHostsView">
  <!--
    「系统 Hosts」页（Key web-hosts-system，NT-110）：自绘四段（⛔ 不是列表页 —— 对象是「一份文件」而不是一批行）。
    ① 信息条（路径 / 大小 / 行数 / 受管块区间 / 权限）  ② 正文 + 动作条  ③ 备份列表
    🔴 写动作全部先备份后写；保存 / 还原前二次确认（确认框走 DialogHooks）。
  -->
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">

    <!--  ① 信息条  -->
    <Border Grid.Row="0" Classes="card" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Classes="section-title" Text="系统 Hosts 文件"/>
        <TextBlock Classes="field-value" Text="{Binding HostsPath}" FontFamily="Consolas"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="hint-text" Text="{Binding FileInfoText}"/>
          <TextBlock Classes="hint-text" Text="{Binding ManagedInfoText}"/>
          <TextBlock Classes="hint-text" Text="{Binding PermissionText}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!--  ② 正文 + 动作条  -->
    <Border Grid.Row="1" Classes="card" Padding="12">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="🔄 重读" Command="{Binding ReloadCommand}"
                  ToolTip.Tip="重新读一遍系统 hosts 文件"/>
          <Button Classes="ghost" Content="✏ 编辑" Command="{Binding StartEditCommand}"
                  IsVisible="{Binding !IsEditing}" IsEnabled="{Binding CanWrite}"
                  ToolTip.Tip="切到可编辑状态（需要管理员权限；保存前会二次确认并自动备份）"/>
          <Button Classes="primary" Content="💾 保存" Command="{Binding SaveEditCommand}"
                  IsVisible="{Binding IsEditing}"/>
          <Button Classes="ghost" Content="取消" Command="{Binding CancelEditCommand}"
                  IsVisible="{Binding IsEditing}"/>
          <Button Classes="ghost" Content="📦 新建备份" Command="{Binding NewBackupCommand}"
                  ToolTip.Tip="把当前系统 hosts 复制一份到备份目录（只读也能备份）"/>
          <Button Classes="ghost" Content="🧹 清除受管块" Command="{Binding ClearManagedCommand}"
                  IsEnabled="{Binding CanWrite}"
                  ToolTip.Tip="删掉本程序写入的那一段（用户自己写的行保留）；清除前自动备份"/>
          <CheckBox Content="只看受管块" IsChecked="{Binding ShowManagedOnly}"
                    IsVisible="{Binding !IsEditing}" VerticalAlignment="Center"/>
        </StackPanel>

        <!--  只读预览  -->
        <TextBox Grid.Row="1" Classes="code" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Text="{Binding PreviewText}" IsVisible="{Binding !IsEditing}"/>

        <!--  编辑态  -->
        <TextBox Grid.Row="1" Classes="code" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
      </Grid>
    </Border>

    <!--  ③ 备份列表  -->
    <Border Grid.Row="2" Classes="card" Padding="12" Height="200">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="section-title" Text="备份" VerticalAlignment="Center"/>
          <TextBlock Classes="hint-text" VerticalAlignment="Center"
                     Text="每次写系统 hosts 前都会自动备份；保留份数在「网络工具设置 → Hosts」里改。"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="160,120,*">
                <TextBlock Grid.Column="0" Classes="list-cell" Text="{Binding TimeText}"/>
                <TextBlock Grid.Column="1" Classes="list-cell" Text="{Binding SizeText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="2" Classes="list-cell" Text="{Binding Name}"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Classes="empty-hint" VerticalAlignment="Center"
                   IsVisible="{Binding !HasBackups}"
                   Text="还没有备份。点上面「📦 新建备份」，或应用一次方案（会自动备份）。"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="♻ 还原选中" Command="{Binding RestoreCommand}"
                  IsEnabled="{Binding CanWrite}"
                  ToolTip.Tip="把系统 hosts 整份换回这份备份（还原前会再备份当前文件）"/>
          <Button Classes="ghost" Content="🗑 删除备份" Command="{Binding DeleteBackupCommand}"
                  ToolTip.Tip="只删备份文件，不动系统 hosts"/>
          <Button Classes="ghost" Content="📂 打开备份目录" Command="{Binding OpenBackupFolderCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
