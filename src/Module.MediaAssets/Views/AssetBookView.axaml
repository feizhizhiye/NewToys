<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NewToys.MediaAssets.Views"
             x:Class="NewToys.MediaAssets.Views.AssetBookView">
  <!--
    NT-017 / v3.34：「书籍」页 = **薄壳**（与「视频」页同构，见 AssetVideoView.axaml 的说明）。
    页面本体复用 AssetAllView / AssetAllViewModel；差异只在 VM：PageKey = "assets-book" + 预设类型 = 书籍。
  -->
  <views:AssetAllView/>
</UserControl>
