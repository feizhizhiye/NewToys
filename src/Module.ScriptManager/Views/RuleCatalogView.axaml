<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             x:Class="NewToys.ScriptManager.Views.RuleCatalogView">
  <!--
    「抓取规则」的规则目录页（页 Key 仍为 web-scrape）：本页只管目录（.py 文件），
    命令列表与 HTML 调试在另一页（web-rule-editor）。
    列表本体 = <v:TableViewHost>：列显隐 / 排序键按 VM 的 ColumnLayout 对齐（🔴 声明顺序必须一致），
    故骨架的 HeaderArea 不填。
  -->
  <v:ListPageSkeleton EmptyMessage="还没有规则集。点「➕ 新建规则集」建一个。"
                      EmptyActionText="＋ 新建规则集"
                      EmptyActionCommand="{Binding NewRuleSetCommand}"
                      IsEmpty="{Binding !HasItems}">

    <v:ListPageSkeleton.ListArea>
      <v:TableViewHost x:Name="RuleSetList"
                       ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                       SelectionMode="Single">
        <v:TableViewHost.Columns>
          <TableViewColumn Width="2*">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>

          <TableViewColumn Width="3*" Binding="{Binding BaseUrl}"/>
          <TableViewColumn Width="1*" Binding="{Binding CategoryText}"/>
          <TableViewColumn Width="2.6*" Binding="{Binding DescText}"/>
          <TableViewColumn Width="1*" Binding="{Binding EnabledText}"/>
          <TableViewColumn Width="1.4*" Binding="{Binding LastRunText}"/>
        </v:TableViewHost.Columns>

        <v:TableViewHost.ContextMenu>
          <ContextMenu>
            <MenuItem Header="✏ 编辑规则" Command="{Binding EditRuleSetCommand}"/>
            <MenuItem Header="✓ 切换启用" Command="{Binding ToggleEnabledCommand}"/>
            <Separator/>
            <MenuItem Header="📝 打开文件" Command="{Binding OpenFileCommand}"/>
            <MenuItem Header="📂 打开目录" Command="{Binding OpenFolderCommand}"/>
            <Separator/>
            <MenuItem Header="📂 运行记录" Command="{Binding OpenRunsFolderCommand}"/>
            <MenuItem Header="📤 导出 CSV" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding HasRun}"/>
            <MenuItem Header="📤 导出 JSON" Command="{Binding ExportJsonCommand}" IsEnabled="{Binding HasRun}"/>
            <Separator/>
            <MenuItem Header="🗑 删除" Command="{Binding DeleteCommand}"/>
          </ContextMenu>
        </v:TableViewHost.ContextMenu>
      </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
