<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewToys.WebTools.Views.WebHomeView">
  <!-- 主区域：页头（🏠 工具箱首页）已移除 —— 左侧二级菜单已显示当前页名，内容区不再重复标题。 -->
  <Border Margin="24,16">
    <Border Classes="card">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
          <TextBlock Text="选择左侧二级菜单进入网络工具。" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Border>
</UserControl>
