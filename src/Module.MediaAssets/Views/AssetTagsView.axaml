<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:NewToys.UI.Controls"
             xmlns:m="using:NewToys.UI.Markup"
             x:Class="NewToys.MediaAssets.Views.AssetTagsView">
  <!--
    「标签管理」页：表格（名称 / 命名空间 / 颜色 / 使用数 / 创建时间）+ 详情卡（由 **Shell** 承载）。
    🔴 与「全部资产」页同构：**本页不带右栏**（VM 实现 IDetailPanelProvider，详情卡由 Shell 声明式渲染）。

    ⚠️ 列表本体 = <v:TableViewHost>（原生 TableView）：表头自带且粘顶、列宽可拖、行与单元格回收。
       ⇒ 骨架的 HeaderArea 不填（⛔ 别再写 Border.list-header / ColumnGrid）。
       ⇒ 列显隐 / 表头文案 / 排序键由控件按 VM 的 ColumnLayout 自动对齐，XAML ⛔ 不再写 IsXxxVisible 绑定。
       🔴 Columns 的声明顺序必须与 VM 的 ColumnLayout 一致。
  -->
  <v:ListPageSkeleton EmptyMessage="没有可显示的标签。点「新建标签」建第一个。"
                      EmptyActionText="＋ 新建标签"
                      EmptyActionCommand="{Binding NewTagCommand}"
                      IsEmpty="{Binding !HasItems}">

    <!--  ==================== ② 筛选条 ====================  -->
    <v:ListPageSkeleton.TopArea>
    <Border Classes="filter-bar">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" LineSpacing="4">
        <TextBlock Text="{Binding FilterSummary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="左键表头排序；右键表头选列 / 筛选" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </WrapPanel>
    </Border>
    </v:ListPageSkeleton.TopArea>

    <!--  ==================== ③ 列表本体  ====================  -->
    <v:ListPageSkeleton.ListArea>
        <v:TableViewHost x:Name="TagList" Classes="list-page"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionMode="Single">
          <v:TableViewHost.Columns>
            <TableViewColumn Width="2*">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="list-cell primary" Text="{Binding Name}"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="1.2*" Binding="{Binding NamespaceText}"/>

            <TableViewColumn Width="1*">
              <TableViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding ChipBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Classes="list-cell" Text="{Binding ColorHexText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>

            <TableViewColumn Width="0.9*" Binding="{Binding UsageText}"/>

            <TableViewColumn Width="1.4*" Binding="{Binding CreatedText}"/>
          </v:TableViewHost.Columns>

          <!--  行右键 = 针对单条的动作（§4.8 硬规则 9）；菜单顶部「▤ 列」「🔎 筛选」由页面给，DataContext 由控件同步  -->
          <v:TableViewHost.ContextMenu>
            <ContextMenu>
              <MenuItem Header="筛选" Icon="{m:Glyph IconSearch}" ItemsSource="{Binding QuickFilters}">
                <MenuItem.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding Label}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                  </ControlTheme>
                </MenuItem.ItemContainerTheme>
              </MenuItem>
              <Separator/>
              <MenuItem Header="重命名…" Icon="{m:Glyph IconEdit}" Command="{Binding RenameTagCommand}"/>
              <MenuItem Icon="🎨" Header="改颜色…" Command="{Binding ChangeColorCommand}" ToolTip.Tip="输入 #RRGGBB；也可以在详情卡点色板"/>
              <MenuItem Icon="🔗" Header="合并到…" Command="{Binding MergeTagCommand}" ToolTip.Tip="把当前标签的资产转给另一个标签，然后删掉自己"/>
              <Separator/>
              <MenuItem Header="删除标签" Icon="{m:Glyph IconTrash}" Command="{Binding DeleteTagCommand}"/>
            </ContextMenu>
          </v:TableViewHost.ContextMenu>
        </v:TableViewHost>
    </v:ListPageSkeleton.ListArea>
  </v:ListPageSkeleton>
</UserControl>
